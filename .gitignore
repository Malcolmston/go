# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
# ...but NOT the parity harnesses' COVERAGE.md. `core.ignorecase` is true on
# macOS, so `coverage.*` silently matched every parity/<lib>/COVERAGE.md and kept
# the whole API-inventory deliverable out of the repo.
!COVERAGE.md
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file.
#
# go.work IS tracked here: this repo is an aggregator whose whole point is that
# the submodules build against each other, and CI (go-workspace.yml,
# cross-compile.yml) plus the docs both assume one canonical member list. A
# per-developer go.work would drift from the set of submodules that actually
# have a go.mod.
#
# go.work.sum stays ignored — it is a local verification cache; every member
# module carries its own go.sum.
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Build output
/_site/
/integration

# Next.js build output. /out was the GitHub Pages static export, which has been
# removed; it is still ignored so a stray `next build` with output:'export' or an
# old working copy cannot commit a build tree.
/.next/
/out/

# Generated search + package-graph data (rebuilt by scripts/build-graph-data.mjs at deploy)
/api/_data/
/public/graph.json
/public/search-index.json
/public/parity.json
# root function deps
/node_modules/
/tsconfig.tsbuildinfo
/dist/
/playwright-report/
/test-results/
/coverage/
next-env.d.ts
*.tsbuildinfo
/genparity/genparity
/gendocs/gendocs
.vercel
.env*
