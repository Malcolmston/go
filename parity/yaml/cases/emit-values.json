          "i": 1,
          "f": 1.5,
          "b": true,
          "n": null,
          "s": "x"
        }
      ],
      "upstreamFn": "String(new yaml.Document(v))",
      "goFn": "yaml.Marshal(v)",
      "note": "plain scalars"
    },
