      "id": "schema-complex-key",
      "fn": "parseJSON",
      "args": [
        "? [1, 2]\n: v\n"
      ],
      "upstreamFn": "yaml.parseAllDocuments().map(d => d.toJS())",
      "goFn": "yaml.Parse + (*Node).Decode",
      "note": "a sequence used as a mapping key"
    },
    {
      "id": "schema-merge-key",
      "fn": "parseJSON",
      "args": [
        "base: &b {a: 1}\nderived:\n  <<: *b\n  b: 2\n"
      ],
      "upstreamFn": "yaml.parseAllDocuments().map(d => d.toJS())",
      "goFn": "yaml.Parse + (*Node).Decode",
      "note": "the merge key",
      "deviation": "the port resolves merge keys by default; yaml@2 needs {merge: true} and otherwise keeps a literal \"<<\" key"
    },
    {
      "id": "schema-alias-bomb",
      "fn": "parseJSON",
      "args": [
        "a: &a [x, x, x, x, x, x, x, x, x]\nb: &b [*a, *a, *a, *a, *a, *a, *a, *a, *a]\nc: &c [*b, *b, *b, *b, *b, *b, *b, *b, *b]\nd: [*c, *c, *c, *c, *c, *c, *c, *c, *c]\n"
      ],
      "upstreamFn": "yaml.parseAllDocuments().map(d => d.toJS())",
      "goFn": "yaml.Parse + (*Node).Decode",
      "note": "alias expansion: both sides guard against it, at different thresholds",
      "deviation": "API-DEVIATIONS.md, \"Alias-expansion budget\": the port allows 1<<21 nodes, where yaml@2 rejects this document outright"
    }
