{
  "group": "strings",
  "upstream": "redis-server@8.2.2",
  "encoding": "commands are arrays of UTF-8 argument strings; replies map integer->number, bulk string->string, nil->null, simple string->{\"status\":s}, array->array, error->{\"error\":true}",
  "cases": [
    {
      "id": "set-get-basic",
      "fn": "script",
      "args": [
        [
          {
            "op": "cmd",
            "args": [
              "SET",
              "k",
              "v1"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "GET",
              "k"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "GET",
              "missing"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "SET",
              "k",
              "v2"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "GET",
              "k"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "STRLEN",
              "k"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "APPEND",
              "k",
              "!"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "GET",
              "k"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "STRLEN",
              "k"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "APPEND",
              "fresh",
              "x"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "GET",
              "fresh"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "STRLEN",
              "missing"
            ]
          }
        ]
      ],
      "upstreamFn": "SET/GET/STRLEN/APPEND",
      "goFn": "Store.Do SET/GET/STRLEN/APPEND",
      "note": "SET returns +OK, GET of a missing key is nil, APPEND creates the key"
    },
    {
      "id": "set-empty-value",
      "fn": "script",
      "args": [
        [
          {
            "op": "cmd",
            "args": [
              "SET",
              "k",
              ""
            ]
          },
          {
            "op": "cmd",
            "args": [
              "GET",
              "k"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "STRLEN",
              "k"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "EXISTS",
              "k"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "APPEND",
              "k",
              "ab"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "GET",
              "k"
            ]
          }
        ]
      ],
      "upstreamFn": "SET/GET",
      "goFn": "Store.Do SET/GET",
      "note": "the empty string is a real value, not an absent key"
    },
    {
      "id": "set-nx-xx",
      "fn": "script",
      "args": [
        [
          {
            "op": "cmd",
            "args": [
              "SET",
              "a",
              "1",
              "NX"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "SET",
              "a",
              "2",
              "NX"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "GET",
              "a"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "SET",
              "a",
              "3",
              "XX"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "GET",
              "a"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "SET",
              "b",
              "1",
              "XX"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "EXISTS",
              "b"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "GET",
              "b"
            ]
          }
        ]
      ],
      "upstreamFn": "SET key value NX|XX",
      "goFn": "Store.Do SET .. NX|XX",
      "note": "a rejected NX/XX SET replies nil, not an error"
    },
    {
      "id": "set-nx-and-xx",
      "fn": "script",
      "args": [
        [
          {
            "op": "cmd",
            "args": [
              "SET",
              "a",
              "1",
              "NX",
              "XX"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "EXISTS",
              "a"
            ]
          }
        ]
      ],
      "upstreamFn": "SET key value NX XX",
      "goFn": "Store.Do SET .. NX XX",
      "note": "NX and XX together is a syntax error"
    },
    {
      "id": "set-ex-clears-on-plain-set",
      "fn": "script",
      "args": [
        [
          {
            "op": "cmd",
            "args": [
              "SET",
              "k",
              "v",
              "EX",
              "100"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "TTL",
              "k"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "SET",
              "k",
              "v2"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "TTL",
              "k"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "GET",
              "k"
            ]
          }
        ]
      ],
      "upstreamFn": "SET key value EX",
      "goFn": "Store.Do SET .. EX",
      "note": "a plain SET discards the previous TTL"
    },
    {
      "id": "set-keepttl",
      "fn": "script",
      "args": [
        [
          {
            "op": "cmd",
            "args": [
              "SET",
              "k",
              "v",
              "EX",
              "100"
