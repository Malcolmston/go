              "k"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "GET",
              "k"
            ]
          }
        ]
      ],
      "upstreamFn": "SET key value KEEPTTL",
      "goFn": "Store.Do SET .. KEEPTTL",
      "note": "KEEPTTL retains the TTL across a rewrite"
    },
    {
      "id": "set-px",
      "fn": "script",
      "args": [
        [
          {
            "op": "cmd",
            "args": [
              "SET",
              "k",
              "v",
              "PX",
              "100000"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "PTTL",
              "k"
            ],
            "round": 1000
          },
          {
            "op": "cmd",
            "args": [
              "TTL",
              "k"
            ]
          }
        ]
      ],
      "upstreamFn": "SET key value PX",
      "goFn": "Store.Do SET .. PX",
      "note": "PTTL rounded up to whole seconds for determinism"
    },
