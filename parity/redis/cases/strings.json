            "op": "cmd",
            "args": [
              "TTL",
              "k"
            ]
          },
          {
            "op": "cmd",
            "args": [
              "SET",
              "k",
              "v2",
              "KEEPTTL"
            ]
          },
          {
            "op": "cmd",
            "args": [
