{
  "group": "http",
  "upstream": "cheerio@1.0.0 + tough-cookie@5.1.2 + node WHATWG fetch/URL",
  "note": "Each side drives its own in-process loopback fixture server (identical routes) and reports the observable navigation result. Host:port is normalised to SRV. The oracle is node's WHATWG fetch (redirects, status) + URL (relative resolution) + tough-cookie (RFC 6265 jar).",
  "cases": [
    {
      "id": "http-status-200",
      "fn": "http",
      "args": [
        "status-200"
      ],
      "upstreamFn": "fetch/URL/tough-cookie",
      "goFn": "puppeteer.Page.Goto"
    },
    {
      "id": "http-status-201",
      "fn": "http",
      "args": [
        "status-201"
      ],
      "upstreamFn": "fetch/URL/tough-cookie",
      "goFn": "puppeteer.Page.Goto"
    },
    {
      "id": "http-status-404",
      "fn": "http",
      "args": [
        "status-404"
      ],
      "upstreamFn": "fetch/URL/tough-cookie",
      "goFn": "puppeteer.Page.Goto",
      "note": "a 4xx must not be reported as an error"
    },
    {
      "id": "http-status-500",
      "fn": "http",
      "args": [
        "status-500"
      ],
      "upstreamFn": "fetch/URL/tough-cookie",
      "goFn": "puppeteer.Page.Goto"
    },
    {
      "id": "http-status-204",
      "fn": "http",
      "args": [
        "status-204"
      ],
      "upstreamFn": "fetch/URL/tough-cookie",
      "goFn": "puppeteer.Page.Goto",
      "note": "no body at all"
    },
    {
      "id": "http-redirect-absolute",
      "fn": "http",
      "args": [
        "redirect-absolute"
      ],
      "upstreamFn": "fetch/URL/tough-cookie",
      "goFn": "puppeteer.Page.Goto",
      "note": "302 to an absolute URL"
    },
    {
      "id": "http-redirect-relative",
      "fn": "http",
      "args": [
        "redirect-relative"
      ],
      "upstreamFn": "fetch/URL/tough-cookie",
      "goFn": "puppeteer.Page.Goto",
      "note": "302 with a relative Location (../final)"
    },
    {
      "id": "http-redirect-pathonly",
      "fn": "http",
      "args": [
        "redirect-pathonly"
      ],
