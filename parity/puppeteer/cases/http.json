        "redirect-chain"
      ],
      "upstreamFn": "fetch/URL/tough-cookie",
      "goFn": "puppeteer.Page.Goto",
      "note": "three hops"
    },
    {
      "id": "http-redirect-no-follow",
      "fn": "http",
      "args": [
        "redirect-no-follow"
      ],
      "upstreamFn": "fetch/URL/tough-cookie",
      "goFn": "puppeteer.Page.Goto",
      "note": "redirect following disabled"
    },
