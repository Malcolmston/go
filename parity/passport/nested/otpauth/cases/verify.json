{
  "group": "verify",
  "upstream": "otpauth@9.5.1",
  "note": "Verifying a submitted code against an acceptance window, at fixed timestamps. Answers {ok, delta} where delta is the offset from the expected moving factor. The rejection corpus covers wrong codes, tampered codes, untrimmed codes, codes minted under another secret/algorithm/period/digit count, codes outside the window, and replayed HOTP counters.",
  "cases": [
    {
      "id": "verify-totp-current-window-0",
      "fn": "verify",
      "args": [
        {
          "type": "totp",
          "issuer": "Parity",
          "account": "alice",
          "secret": "JBSWY3DPEHPK3PXP",
          "algorithm": "SHA1",
          "digits": 6,
          "period": 30
        },
        "282760",
        0,
        0
      ],
      "upstreamFn": "TOTP/HOTP.validate",
      "goFn": "otpauth.Key.Verify",
      "note": "the code for this very step must verify",
      "acceptance": true
    },
