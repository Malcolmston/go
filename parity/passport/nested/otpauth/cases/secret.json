    {
      "id": "usable-digits-12",
      "fn": "usable",
      "args": [
        {
          "type": "totp",
          "issuer": "Parity",
          "account": "alice",
          "secret": "JBSWY3DPEHPK3PXP",
          "algorithm": "SHA1",
          "digits": 12,
          "period": 30
        }
      ],
      "upstreamFn": "new TOTP/HOTP + generate",
      "goFn": "otpauth.Key.Validate",
      "deviation": "RFC 4226 section 5.3 puts the code length at 6 to 8 digits (the port allows up to 10, the widest a 31-bit truncated HOTP value can fill); upstream accepts any digit count, including a 1-digit code with a 10-value search space. The port refuses the degenerate code spaces upstream permits"
    },
