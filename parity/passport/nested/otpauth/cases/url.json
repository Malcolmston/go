{
  "group": "url",
  "upstream": "otpauth@9.5.1",
  "note": "Rendering a Key back to an otpauth:// URI. Compared as {host, raw path, query as an object with sorted keys}: the format fixes no parameter order, but percent-encoding of the label is in scope.",
  "cases": [
    {
      "id": "url-totp-full",
      "fn": "url",
      "args": [
        {
          "type": "totp",
          "issuer": "Parity",
          "account": "alice",
          "secret": "JBSWY3DPEHPK3PXP",
          "algorithm": "SHA1",
          "digits": 6,
          "period": 30
        }
      ],
      "upstreamFn": "TOTP/HOTP.toString",
      "goFn": "otpauth.Key.URL"
    },
