          "algorithm": "SHA1",
          "digits": 6,
          "period": 30
        }
      ],
      "upstreamFn": "TOTP/HOTP.toString",
      "goFn": "otpauth.Key.URL",
      "deviation": "label percent-encoding: upstream runs the label through encodeURIComponent, so '@' becomes %40 and '&' becomes %26, while the port escapes only what the RFC 3986 path grammar requires. Both URIs are RFC 3986 equivalent and each side parses the other's form - see parse-totp-encoded-label"
