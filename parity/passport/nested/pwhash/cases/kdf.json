    {
      "id": "key-iterations-zero",
      "fn": "key",
      "args": [
        "password",
        "salt",
        0,
        20,
        "sha1"
      ],
      "upstreamFn": "pbkdf2.pbkdf2Sync",
      "goFn": "pwhash.Key",
      "note": "zero iterations is outside RFC 2898's c >= 1",
      "deviation": "pwhash.Key deliberately has no error return: it mirrors the signature the Go ecosystem's PBKDF2 has always had (golang.org/x/crypto/pbkdf2.Key), so an iteration count below 1 becomes 1 - the RFC 2898 minimum, never fewer - and a non-positive key length yields an empty key, where upstream throws. This is reachable only through the raw KDF: the credential path refuses both, which verify-iterations-zero and verify-iterations-negative confirm by rejecting on BOTH sides"
    },
