    {
      "id": "verify-empty-salt",
      "fn": "verifyKnownKey",
      "args": [
        "correct horse battery staple",
        "",
        1000,
        "sha256",
        "0db401841eeea56cb6469915fb67d5d2d607e891d3fe97403d77c9bbf68a0ada"
      ],
      "upstreamFn": "pbkdf2.pbkdf2Sync + crypto.timingSafeEqual",
      "goFn": "pwhash.Verify (via pwhash.Decode + pwhash.Key)",
      "note": "an unsalted stored hash",
      "acceptance": true,
      "deviation": "pwhash.Decode refuses a stored hash whose salt is empty: it is not producible by HashWithParams, so it means corruption or tampering, and an unsalted hash is exactly what salting exists to prevent. Upstream has no encoded form and no such check, so it verifies the password against the unsalted key. The port is the stricter side and keeps its check"
