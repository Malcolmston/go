    {
      "id": "verify-correct",
      "fn": "verifyKnownKey",
      "args": [
        "correct horse battery staple",
        "parity-fixed-salt",
        1000,
        "sha256",
        "72b639703a956a6d4ab151d9961bfa681bc25c98f18c58fa7f6de3dc36cf2b33"
      ],
      "upstreamFn": "pbkdf2.pbkdf2Sync + crypto.timingSafeEqual",
      "goFn": "pwhash.Verify (via pwhash.Decode + pwhash.Key)",
      "note": "the one credential that must verify",
      "acceptance": true
    },
