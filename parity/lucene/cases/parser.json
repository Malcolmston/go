{
  "group": "parser",
  "upstream": "lucene@9.11.1",
  "cases": [
    {"id": "p-term", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "search"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"},
    {"id": "p-two-terms", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "search library"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse", "note": "default operator is OR on both sides"},
    {"id": "p-field", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "title:lucene"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"},
    {"id": "p-field-two", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "title:java text:search"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"},
    {"id": "p-must-both", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "+search +library"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"},
    {"id": "p-must-not", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "search -library"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"},
    {"id": "p-only-negative", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "-java"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse", "note": "purely negative query"},
    {"id": "p-plus-minus", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "+network -neural"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"},
    {"id": "p-phrase", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "\"neural network\""}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"},
    {"id": "p-phrase-field", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "title:\"neural networks\""}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"},
    {"id": "p-phrase-required", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "+\"search engine\" -java"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"},
    {"id": "p-phrase-stopword", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "\"the network\""}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse", "note": "upstream drops the stop word from the phrase; the port keeps it and finds nothing"},
    {"id": "p-group", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "(search library) +java"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"},
    {"id": "p-group-nested", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "+(network neural) -models"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"},
    {"id": "p-prefix", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "net*"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"},
    {"id": "p-prefix-field", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "title:net*"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"},
    {"id": "p-range-inclusive", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "[a TO c]"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"},
    {"id": "p-range-exclusive", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "{lucene TO network}"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"},
    {"id": "p-range-field", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "title:[a TO d]"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"},
    {"id": "p-range-uppercase-bounds", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "[A TO C]"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse", "note": "does the parser normalise range bounds?"},
    {"id": "p-range-star", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "[t TO *]"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"},
    {"id": "p-matchall", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "*:*"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"},
    {"id": "p-empty", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": ""}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse", "note": "upstream yields an empty BooleanQuery (no matches); the port yields MatchAll"},
    {"id": "p-blank", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "   "}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"},
    {"id": "p-and-keyword", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "search AND library"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse", "note": "the port has no AND operator and indexes 'AND' as a literal term"},
    {"id": "p-or-keyword", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "search OR library"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse", "note": "the port treats OR as a literal term, which coincidentally yields the same set"},
    {"id": "p-not-keyword", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "search NOT library"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse", "note": "the port treats NOT as a literal term"},
    {"id": "p-and-not", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "network AND NOT neural"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"},
    {"id": "p-ampersands", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "search && library"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"},
    {"id": "p-fuzzy-n", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "netwrk~1"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse", "note": "the port lexes '~' as an ordinary term character, so the whole thing becomes one literal term"},
    {"id": "p-fuzzy-default", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "netwrk~"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"},
    {"id": "p-phrase-slop", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "\"trees graphs\"~2"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse", "note": "phrase slop is unsupported by the port"},
    {"id": "p-boost", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "search^3"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse", "note": "the port lexes '^' as an ordinary term character"},
    {"id": "p-boost-clause", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "search^3 library"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"},
    {"id": "p-wildcard-question", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "n?twork"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse", "note": "the port lexes '?' as an ordinary term character"},
    {"id": "p-wildcard-mid", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "n?t*rk"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"},
    {"id": "p-wildcard-leading", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "*work"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse", "note": "upstream rejects a leading wildcard by default; the port silently drops the star"},
    {"id": "p-regexp", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "/colou?r/"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse", "note": "the port has no regexp syntax"},
    {"id": "p-escaped-colon", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "lucene\\:action"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse", "note": "the port has no escape mechanism"},
    {"id": "p-leading-colon", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": ":search"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse", "note": "upstream raises a ParseException; the port silently skips the colon"},
    {"id": "p-unbalanced-paren", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "(search"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse", "note": "both sides must fail"},
    {"id": "p-extra-paren", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "search)"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse", "note": "both sides must fail"},
    {"id": "p-unterminated-quote", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "\"neural"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse", "note": "both sides must fail"},
    {"id": "p-bad-range", "fn": "parse", "args": [{"index": "stop", "topN": 20, "query": "[a c]"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse", "note": "missing TO separator"},
    {"id": "p-ranked-two-terms", "fn": "parseRanked", "args": [{"index": "stop", "topN": 20, "query": "search library"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse", "note": "ranked order of a parsed disjunction"},
    {"id": "p-ranked-field", "fn": "parseRanked", "args": [{"index": "stop", "topN": 20, "query": "lucene"}], "upstreamFn": "QueryParser.parse", "goFn": "lucene.Parser.Parse"}
  ]
}
