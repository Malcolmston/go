{
  "group": "query",
  "upstream": "lucene@9.11.1",
  "cases": [
    {"id": "q-term-search", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "term", "field": "text", "term": "search"}}], "upstreamFn": "TermQuery", "goFn": "lucene.NewTermQuery"},
    {"id": "q-term-uppercase", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "term", "field": "text", "term": "SEARCH"}}], "upstreamFn": "TermQuery", "goFn": "lucene.TermQuery", "note": "query term is normalised by the index analyzer on both sides"},
    {"id": "q-term-missing", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "term", "field": "text", "term": "zzzznope"}}], "upstreamFn": "TermQuery", "goFn": "lucene.TermQuery"},
    {"id": "q-term-stopword", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "term", "field": "text", "term": "the"}}], "upstreamFn": "TermQuery", "goFn": "lucene.TermQuery", "note": "stop word never reached the index"},
    {"id": "q-term-title", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "term", "field": "title", "term": "lucene"}}], "upstreamFn": "TermQuery", "goFn": "lucene.TermQuery"},
    {"id": "q-term-unknown-field", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "term", "field": "body", "term": "search"}}], "upstreamFn": "TermQuery", "goFn": "lucene.TermQuery", "note": "field absent from the index"},
    {"id": "q-term-repeated", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "term", "field": "text", "term": "lists"}}], "upstreamFn": "TermQuery", "goFn": "lucene.TermQuery", "note": "term frequency two in one document"},
    {"id": "q-term-idf-order", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "term", "field": "text", "term": "documents"}}], "upstreamFn": "BM25Similarity", "goFn": "lucene.bm25", "note": "ranked order over two documents of different length"},

    {"id": "q-phrase-two", "fn": "searchSet", "args": [{"index": "stop", "topN": 10, "query": {"type": "phrase", "field": "text", "terms": ["neural", "network"]}}], "upstreamFn": "PhraseQuery", "goFn": "lucene.NewPhraseQuery"},
    {"id": "q-phrase-three", "fn": "searchSet", "args": [{"index": "stop", "topN": 10, "query": {"type": "phrase", "field": "text", "terms": ["search", "engine", "indexes"]}}], "upstreamFn": "PhraseQuery", "goFn": "lucene.PhraseQuery"},
    {"id": "q-phrase-wrong-order", "fn": "searchSet", "args": [{"index": "stop", "topN": 10, "query": {"type": "phrase", "field": "text", "terms": ["network", "neural"]}}], "upstreamFn": "PhraseQuery", "goFn": "lucene.PhraseQuery", "note": "order matters"},
    {"id": "q-phrase-stopword-hole", "fn": "searchSet", "args": [{"index": "stop", "topN": 10, "query": {"type": "phrase", "field": "text", "terms": ["trees", "graphs"]}}], "upstreamFn": "PhraseQuery", "goFn": "lucene.PhraseQuery", "note": "'trees and graphs': StopFilter leaves a hole, so upstream needs slop; the port renumbers positions densely and matches"},
    {"id": "q-phrase-after-leading-stopword", "fn": "searchSet", "args": [{"index": "stop", "topN": 10, "query": {"type": "phrase", "field": "text", "terms": ["network", "protocol"]}}], "upstreamFn": "PhraseQuery", "goFn": "lucene.PhraseQuery"},
    {"id": "q-phrase-single", "fn": "searchSet", "args": [{"index": "stop", "topN": 10, "query": {"type": "phrase", "field": "text", "terms": ["lucene"]}}], "upstreamFn": "PhraseQuery", "goFn": "lucene.PhraseQuery", "note": "one-term phrase degenerates to a term query"},
    {"id": "q-phrase-empty", "fn": "searchSet", "args": [{"index": "stop", "topN": 10, "query": {"type": "phrase", "field": "text", "terms": []}}], "upstreamFn": "PhraseQuery", "goFn": "lucene.PhraseQuery"},
    {"id": "q-phrase-ranked", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "phrase", "field": "text", "terms": ["data"]}}], "upstreamFn": "PhraseQuery", "goFn": "lucene.PhraseQuery", "note": "ranked order for a phrase query"},

    {"id": "q-bool-must-two", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "bool", "clauses": [{"occur": "must", "query": {"type": "term", "field": "text", "term": "search"}}, {"occur": "must", "query": {"type": "term", "field": "text", "term": "library"}}]}}], "upstreamFn": "BooleanClause.Occur.MUST", "goFn": "lucene.Must"},
    {"id": "q-bool-should-two", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "bool", "clauses": [{"occur": "should", "query": {"type": "term", "field": "text", "term": "network"}}, {"occur": "should", "query": {"type": "term", "field": "text", "term": "lucene"}}]}}], "upstreamFn": "BooleanClause.Occur.SHOULD", "goFn": "lucene.Should"},
    {"id": "q-bool-must-not", "fn": "search", "args": [{"index": "stop", "topN": 20, "query": {"type": "bool", "clauses": [{"occur": "must", "query": {"type": "matchall"}}, {"occur": "must_not", "query": {"type": "term", "field": "text", "term": "java"}}]}}], "upstreamFn": "BooleanClause.Occur.MUST_NOT", "goFn": "lucene.MustNot"},
    {"id": "q-bool-should-must-not", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "bool", "clauses": [{"occur": "should", "query": {"type": "term", "field": "text", "term": "search"}}, {"occur": "must_not", "query": {"type": "term", "field": "text", "term": "library"}}]}}], "upstreamFn": "BooleanQuery", "goFn": "lucene.BooleanQuery"},
    {"id": "q-bool-only-must-not", "fn": "search", "args": [{"index": "stop", "topN": 20, "query": {"type": "bool", "clauses": [{"occur": "must_not", "query": {"type": "term", "field": "text", "term": "java"}}]}}], "upstreamFn": "BooleanQuery", "goFn": "lucene.BooleanQuery", "note": "purely negative query matches nothing"},
    {"id": "q-bool-must-plus-should", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "bool", "clauses": [{"occur": "must", "query": {"type": "term", "field": "text", "term": "search"}}, {"occur": "should", "query": {"type": "term", "field": "text", "term": "library"}}]}}], "upstreamFn": "BooleanQuery", "goFn": "lucene.BooleanQuery", "note": "Should only contributes score"},
    {"id": "q-bool-nested", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "bool", "clauses": [{"occur": "must", "query": {"type": "bool", "clauses": [{"occur": "should", "query": {"type": "term", "field": "text", "term": "network"}}, {"occur": "should", "query": {"type": "term", "field": "text", "term": "neural"}}]}}, {"occur": "must_not", "query": {"type": "term", "field": "text", "term": "models"}}]}}], "upstreamFn": "BooleanQuery", "goFn": "lucene.BooleanQuery"},
    {"id": "q-bool-cross-field", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "bool", "clauses": [{"occur": "should", "query": {"type": "term", "field": "title", "term": "search"}}, {"occur": "should", "query": {"type": "term", "field": "text", "term": "search"}}]}}], "upstreamFn": "BooleanQuery", "goFn": "lucene.BooleanQuery"},
    {"id": "q-bool-empty", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "bool", "clauses": []}}], "upstreamFn": "BooleanQuery.Builder", "goFn": "lucene.NewBooleanQuery"},
    {"id": "q-bool-unsatisfiable", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "bool", "clauses": [{"occur": "must", "query": {"type": "term", "field": "text", "term": "search"}}, {"occur": "must", "query": {"type": "term", "field": "text", "term": "packets"}}]}}], "upstreamFn": "BooleanQuery", "goFn": "lucene.BooleanQuery"},

    {"id": "q-prefix-net", "fn": "searchSet", "args": [{"index": "stop", "topN": 10, "query": {"type": "prefix", "field": "text", "prefix": "net"}}], "upstreamFn": "PrefixQuery", "goFn": "lucene.NewPrefixQuery"},
    {"id": "q-prefix-run", "fn": "searchSet", "args": [{"index": "stop", "topN": 10, "query": {"type": "prefix", "field": "text", "prefix": "run"}}], "upstreamFn": "PrefixQuery", "goFn": "lucene.PrefixQuery"},
    {"id": "q-prefix-uppercase", "fn": "searchSet", "args": [{"index": "stop", "topN": 10, "query": {"type": "prefix", "field": "text", "prefix": "NET"}}], "upstreamFn": "PrefixQuery", "goFn": "lucene.PrefixQuery", "note": "upstream PrefixQuery takes the term verbatim and so matches nothing; the port silently lowercases the prefix"},
    {"id": "q-prefix-nomatch", "fn": "searchSet", "args": [{"index": "stop", "topN": 10, "query": {"type": "prefix", "field": "text", "prefix": "zzz"}}], "upstreamFn": "PrefixQuery", "goFn": "lucene.PrefixQuery"},
    {"id": "q-prefix-empty", "fn": "searchSet", "args": [{"index": "stop", "topN": 20, "query": {"type": "prefix", "field": "text", "prefix": ""}}], "upstreamFn": "PrefixQuery", "goFn": "lucene.PrefixQuery", "note": "an empty prefix matches every term upstream; the port matches nothing"},
    {"id": "q-prefix-ranked", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "prefix", "field": "text", "prefix": "net"}}], "upstreamFn": "PrefixQuery", "goFn": "lucene.PrefixQuery", "note": "upstream rewrites to a blended constant score; the port sums BM25 per matching term"},

    {"id": "q-wildcard-mid", "fn": "searchSet", "args": [{"index": "stop", "topN": 10, "query": {"type": "wildcard", "field": "text", "pattern": "n?t*rk"}}], "upstreamFn": "WildcardQuery", "goFn": "lucene.NewWildcardQuery"},
    {"id": "q-wildcard-suffix", "fn": "searchSet", "args": [{"index": "stop", "topN": 10, "query": {"type": "wildcard", "field": "text", "pattern": "*ing"}}], "upstreamFn": "WildcardQuery", "goFn": "lucene.WildcardQuery"},
    {"id": "q-wildcard-question", "fn": "searchSet", "args": [{"index": "stop", "topN": 10, "query": {"type": "wildcard", "field": "text", "pattern": "colo?r"}}], "upstreamFn": "WildcardQuery", "goFn": "lucene.WildcardQuery"},
    {"id": "q-wildcard-star", "fn": "searchSet", "args": [{"index": "stop", "topN": 20, "query": {"type": "wildcard", "field": "text", "pattern": "*"}}], "upstreamFn": "WildcardQuery", "goFn": "lucene.WildcardQuery"},
    {"id": "q-wildcard-nomatch", "fn": "searchSet", "args": [{"index": "stop", "topN": 10, "query": {"type": "wildcard", "field": "text", "pattern": "zz*zz"}}], "upstreamFn": "WildcardQuery", "goFn": "lucene.WildcardQuery"},

    {"id": "q-regexp-optional", "fn": "searchSet", "args": [{"index": "stop", "topN": 10, "query": {"type": "regexp", "field": "text", "pattern": "colou?r"}}], "upstreamFn": "RegexpQuery", "goFn": "lucene.NewRegexpQuery"},
    {"id": "q-regexp-anchored", "fn": "searchSet", "args": [{"index": "stop", "topN": 10, "query": {"type": "regexp", "field": "text", "pattern": "net"}}], "upstreamFn": "RegexpQuery", "goFn": "lucene.RegexpQuery", "note": "patterns are anchored to whole terms on both sides"},
    {"id": "q-regexp-class", "fn": "searchSet", "args": [{"index": "stop", "topN": 20, "query": {"type": "regexp", "field": "text", "pattern": "[a-z]{4}"}}], "upstreamFn": "RegexpQuery", "goFn": "lucene.RegexpQuery"},
    {"id": "q-regexp-alternation", "fn": "searchSet", "args": [{"index": "stop", "topN": 10, "query": {"type": "regexp", "field": "text", "pattern": "lucene|java"}}], "upstreamFn": "RegexpQuery", "goFn": "lucene.RegexpQuery"},
    {"id": "q-regexp-star", "fn": "searchSet", "args": [{"index": "stop", "topN": 10, "query": {"type": "regexp", "field": "text", "pattern": "run.*"}}], "upstreamFn": "RegexpQuery", "goFn": "lucene.RegexpQuery", "note": "'.' means any character in both Lucene RegExp and RE2"},
    {"id": "q-regexp-invalid", "fn": "searchSet", "args": [{"index": "stop", "topN": 10, "query": {"type": "regexp", "field": "text", "pattern": "["}}], "upstreamFn": "RegexpQuery", "goFn": "lucene.NewRegexpQuery", "note": "both sides must reject the pattern"},

    {"id": "q-fuzzy-0", "fn": "searchSet", "args": [{"index": "stop", "topN": 10, "query": {"type": "fuzzy", "field": "text", "term": "network", "maxEdits": 0}}], "upstreamFn": "FuzzyQuery", "goFn": "lucene.NewFuzzyQuery"},
    {"id": "q-fuzzy-1", "fn": "searchSet", "args": [{"index": "stop", "topN": 10, "query": {"type": "fuzzy", "field": "text", "term": "netwrk", "maxEdits": 1}}], "upstreamFn": "FuzzyQuery", "goFn": "lucene.FuzzyQuery"},
    {"id": "q-fuzzy-transposition-1", "fn": "searchSet", "args": [{"index": "stop", "topN": 10, "query": {"type": "fuzzy", "field": "text", "term": "netwrok", "maxEdits": 1}}], "upstreamFn": "FuzzyQuery", "goFn": "lucene.FuzzyQuery", "note": "upstream default is Damerau-Levenshtein (transpositions cost one); the port uses plain Levenshtein"},
    {"id": "q-fuzzy-transposition-2", "fn": "searchSet", "args": [{"index": "stop", "topN": 10, "query": {"type": "fuzzy", "field": "text", "term": "netwrok", "maxEdits": 2}}], "upstreamFn": "FuzzyQuery", "goFn": "lucene.FuzzyQuery"},
    {"id": "q-fuzzy-2", "fn": "searchSet", "args": [{"index": "stop", "topN": 20, "query": {"type": "fuzzy", "field": "text", "term": "runer", "maxEdits": 2}}], "upstreamFn": "FuzzyQuery", "goFn": "lucene.FuzzyQuery"},
    {"id": "q-fuzzy-3", "fn": "searchSet", "args": [{"index": "stop", "topN": 20, "query": {"type": "fuzzy", "field": "text", "term": "network", "maxEdits": 3}}], "upstreamFn": "FuzzyQuery", "goFn": "lucene.FuzzyQuery", "note": "upstream caps maxEdits at 2 and throws; the port accepts any value"},

    {"id": "q-range-inclusive", "fn": "searchSet", "args": [{"index": "stop", "topN": 20, "query": {"type": "range", "field": "text", "lower": "a", "upper": "c", "includeLower": true, "includeUpper": true}}], "upstreamFn": "TermRangeQuery", "goFn": "lucene.NewRangeQuery"},
    {"id": "q-range-exclusive", "fn": "searchSet", "args": [{"index": "stop", "topN": 20, "query": {"type": "range", "field": "text", "lower": "lucene", "upper": "network", "includeLower": false, "includeUpper": false}}], "upstreamFn": "TermRangeQuery", "goFn": "lucene.RangeQuery"},
    {"id": "q-range-half-open", "fn": "searchSet", "args": [{"index": "stop", "topN": 20, "query": {"type": "range", "field": "text", "lower": "lucene", "upper": "network", "includeLower": true, "includeUpper": false}}], "upstreamFn": "TermRangeQuery", "goFn": "lucene.RangeQuery"},
    {"id": "q-range-unbounded-upper", "fn": "searchSet", "args": [{"index": "stop", "topN": 20, "query": {"type": "range", "field": "text", "lower": "t", "upper": "", "includeLower": true, "includeUpper": true}}], "upstreamFn": "TermRangeQuery", "goFn": "lucene.RangeQuery", "note": "empty string means unbounded in the port; null upstream"},
    {"id": "q-range-unbounded-lower", "fn": "searchSet", "args": [{"index": "stop", "topN": 20, "query": {"type": "range", "field": "text", "lower": "", "upper": "b", "includeLower": true, "includeUpper": true}}], "upstreamFn": "TermRangeQuery", "goFn": "lucene.RangeQuery"},
    {"id": "q-range-empty", "fn": "searchSet", "args": [{"index": "stop", "topN": 20, "query": {"type": "range", "field": "text", "lower": "m", "upper": "a", "includeLower": true, "includeUpper": true}}], "upstreamFn": "TermRangeQuery", "goFn": "lucene.RangeQuery", "note": "upper below lower"},
    {"id": "q-range-title", "fn": "searchSet", "args": [{"index": "stop", "topN": 20, "query": {"type": "range", "field": "title", "lower": "l", "upper": "s", "includeLower": true, "includeUpper": false}}], "upstreamFn": "TermRangeQuery", "goFn": "lucene.RangeQuery"},

    {"id": "q-boost-two", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "boost", "boost": 2, "query": {"type": "term", "field": "text", "term": "documents"}}}], "upstreamFn": "BoostQuery", "goFn": "lucene.NewBoostQuery", "note": "a uniform boost must not change ranked order"},
    {"id": "q-boost-flip", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "bool", "clauses": [{"occur": "should", "query": {"type": "term", "field": "text", "term": "search"}}, {"occur": "should", "query": {"type": "boost", "boost": 8, "query": {"type": "term", "field": "text", "term": "library"}}}]}}], "upstreamFn": "BoostQuery", "goFn": "lucene.BoostQuery", "note": "boost large enough to reorder"},
    {"id": "q-boost-fraction", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "bool", "clauses": [{"occur": "should", "query": {"type": "boost", "boost": 0.25, "query": {"type": "term", "field": "text", "term": "search"}}}, {"occur": "should", "query": {"type": "term", "field": "text", "term": "engine"}}]}}], "upstreamFn": "BoostQuery", "goFn": "lucene.BoostQuery"},
    {"id": "q-boost-zero", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "bool", "clauses": [{"occur": "should", "query": {"type": "boost", "boost": 0, "query": {"type": "term", "field": "text", "term": "documents"}}}, {"occur": "should", "query": {"type": "term", "field": "text", "term": "retrieval"}}]}}], "upstreamFn": "BoostQuery", "goFn": "lucene.NewBoostQuery", "note": "upstream honours a zero boost; the port silently rewrites it to one"},

    {"id": "q-const-one", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "constant", "score": 1, "query": {"type": "term", "field": "text", "term": "documents"}}}], "upstreamFn": "ConstantScoreQuery", "goFn": "lucene.NewConstantScoreQuery", "note": "all matches tie, so order is the id tie-break on both sides"},
    {"id": "q-const-prefix", "fn": "search", "args": [{"index": "stop", "topN": 20, "query": {"type": "constant", "score": 1, "query": {"type": "prefix", "field": "text", "prefix": "s"}}}], "upstreamFn": "ConstantScoreQuery", "goFn": "lucene.ConstantScoreQuery"},
    {"id": "q-const-two", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "bool", "clauses": [{"occur": "should", "query": {"type": "constant", "score": 2, "query": {"type": "term", "field": "text", "term": "documents"}}}, {"occur": "should", "query": {"type": "term", "field": "text", "term": "retrieval"}}]}}], "upstreamFn": "ConstantScoreQuery+BoostQuery", "goFn": "lucene.ConstantScoreQuery"},
    {"id": "q-const-zero", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "bool", "clauses": [{"occur": "should", "query": {"type": "constant", "score": 0, "query": {"type": "term", "field": "text", "term": "documents"}}}, {"occur": "should", "query": {"type": "term", "field": "text", "term": "retrieval"}}]}}], "upstreamFn": "ConstantScoreQuery+BoostQuery", "goFn": "lucene.NewConstantScoreQuery", "note": "the port silently rewrites a zero score to one"},

    {"id": "q-dismax-zero", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "dismax", "tieBreaker": 0, "disjuncts": [{"type": "term", "field": "text", "term": "search"}, {"type": "term", "field": "title", "term": "search"}]}}], "upstreamFn": "DisjunctionMaxQuery", "goFn": "lucene.NewDisjunctionMaxQuery"},
    {"id": "q-dismax-one", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "dismax", "tieBreaker": 1, "disjuncts": [{"type": "term", "field": "text", "term": "search"}, {"type": "term", "field": "title", "term": "search"}]}}], "upstreamFn": "DisjunctionMaxQuery", "goFn": "lucene.DisjunctionMaxQuery", "note": "tieBreaker 1 sums every matching clause"},
    {"id": "q-dismax-half", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "dismax", "tieBreaker": 0.5, "disjuncts": [{"type": "term", "field": "text", "term": "lucene"}, {"type": "term", "field": "title", "term": "lucene"}]}}], "upstreamFn": "DisjunctionMaxQuery", "goFn": "lucene.DisjunctionMaxQuery"},
    {"id": "q-dismax-single", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "dismax", "tieBreaker": 0, "disjuncts": [{"type": "term", "field": "text", "term": "network"}]}}], "upstreamFn": "DisjunctionMaxQuery", "goFn": "lucene.DisjunctionMaxQuery"},
    {"id": "q-dismax-empty", "fn": "search", "args": [{"index": "stop", "topN": 10, "query": {"type": "dismax", "tieBreaker": 0, "disjuncts": []}}], "upstreamFn": "DisjunctionMaxQuery", "goFn": "lucene.DisjunctionMaxQuery"},

    {"id": "q-matchall", "fn": "search", "args": [{"index": "stop", "topN": 20, "query": {"type": "matchall"}}], "upstreamFn": "MatchAllDocsQuery", "goFn": "lucene.MatchAllQuery"},
    {"id": "q-matchall-topn", "fn": "search", "args": [{"index": "stop", "topN": 3, "query": {"type": "matchall"}}], "upstreamFn": "MatchAllDocsQuery", "goFn": "lucene.MatchAllQuery", "note": "total must still report every match"},

    {"id": "q-terms-two", "fn": "searchSet", "args": [{"index": "stop", "topN": 20, "query": {"type": "terms", "field": "text", "terms": ["search", "lucene"]}}], "upstreamFn": "TermInSetQuery", "goFn": "lucene.NewTermsQuery"},
    {"id": "q-terms-duplicate", "fn": "searchSet", "args": [{"index": "stop", "topN": 20, "query": {"type": "terms", "field": "text", "terms": ["search", "search"]}}], "upstreamFn": "TermInSetQuery", "goFn": "lucene.TermsQuery"},
    {"id": "q-terms-empty", "fn": "searchSet", "args": [{"index": "stop", "topN": 20, "query": {"type": "terms", "field": "text", "terms": []}}], "upstreamFn": "TermInSetQuery", "goFn": "lucene.TermsQuery"},
    {"id": "q-terms-unknown", "fn": "searchSet", "args": [{"index": "stop", "topN": 20, "query": {"type": "terms", "field": "text", "terms": ["zzz", "lucene"]}}], "upstreamFn": "TermInSetQuery", "goFn": "lucene.TermsQuery"},

    {"id": "q-topn-one", "fn": "search", "args": [{"index": "stop", "topN": 1, "query": {"type": "term", "field": "text", "term": "documents"}}], "upstreamFn": "IndexSearcher.search", "goFn": "lucene.Index.Search"},

    {"id": "q-std-term-documents", "fn": "search", "args": [{"index": "standard", "topN": 10, "query": {"type": "term", "field": "text", "term": "documents"}}], "upstreamFn": "TermQuery+PorterStemFilter", "goFn": "lucene.TermQuery", "note": "stemming is self-consistent even where the two stemmers disagree"},
    {"id": "q-std-term-documentation", "fn": "search", "args": [{"index": "standard", "topN": 10, "query": {"type": "term", "field": "text", "term": "documentation"}}], "upstreamFn": "TermQuery+PorterStemFilter", "goFn": "lucene.TermQuery", "note": "Porter conflates documentation with documents; the port's stemmer does not"},
    {"id": "q-std-term-running", "fn": "search", "args": [{"index": "standard", "topN": 10, "query": {"type": "term", "field": "text", "term": "runners"}}], "upstreamFn": "TermQuery+PorterStemFilter", "goFn": "lucene.TermQuery"},
