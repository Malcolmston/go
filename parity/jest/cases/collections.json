{
  "group": "collections",
  "upstream": "expect@29.7.0",
  "note": "toContain / toContainEqual / toHaveLength / toMatchObject / toHaveProperty",
  "cases": [
    {"id": "contain-arr-hit", "fn": "toContain", "actual": [1, 2, 3], "args": [2], "upstreamFn": "expect().toContain", "goFn": "jest.Matcher.ToContain"},
    {"id": "contain-arr-miss", "fn": "toContain", "actual": [1, 2, 3], "args": [4], "upstreamFn": "expect().toContain", "goFn": "jest.Matcher.ToContain"},
    {"id": "contain-arr-reference", "fn": "toContain", "actual": [{"a": 1}], "args": [{"a": 1}], "note": "toContain uses reference equality, so a structurally equal object is not contained", "upstreamFn": "expect().toContain", "goFn": "jest.Matcher.ToContain"},
    {"id": "contain-arr-nan", "fn": "toContain", "actual": [1, {"$": "nan"}], "args": [{"$": "nan"}], "note": "toContain uses indexOf-like equality; NaN is a classic edge", "upstreamFn": "expect().toContain", "goFn": "jest.Matcher.ToContain"},
    {"id": "contain-arr-negzero", "fn": "toContain", "actual": [0], "args": [{"$": "negzero"}], "upstreamFn": "expect().toContain", "goFn": "jest.Matcher.ToContain"},
    {"id": "contain-arr-str-vs-num", "fn": "toContain", "actual": [1, 2], "args": ["1"], "upstreamFn": "expect().toContain", "goFn": "jest.Matcher.ToContain"},
    {"id": "contain-arr-null", "fn": "toContain", "actual": [null, 1], "args": [null], "upstreamFn": "expect().toContain", "goFn": "jest.Matcher.ToContain"},
    {"id": "contain-empty-arr", "fn": "toContain", "actual": [], "args": [1], "upstreamFn": "expect().toContain", "goFn": "jest.Matcher.ToContain"},
    {"id": "contain-set-hit", "fn": "toContain", "actual": {"$": "set", "values": [1, 2]}, "args": [2], "deviation": "Go has no Set type; the harness models one as map[any]struct{} and the port then checks keys", "upstreamFn": "expect().toContain", "goFn": "jest.Matcher.ToContain"},
    {"id": "contain-arr-not-miss", "fn": "toContain", "not": true, "actual": [1, 2], "args": [3], "upstreamFn": "expect().not.toContain", "goFn": "jest.Matcher.Not().ToContain"},

    {"id": "containequal-obj-hit", "fn": "toContainEqual", "actual": [{"a": 1}, {"b": 2}], "args": [{"a": 1}], "upstreamFn": "expect().toContainEqual", "goFn": "jest.Matcher.ToContainEqual"},
    {"id": "containequal-obj-miss", "fn": "toContainEqual", "actual": [{"a": 1}], "args": [{"a": 2}], "upstreamFn": "expect().toContainEqual", "goFn": "jest.Matcher.ToContainEqual"},
    {"id": "containequal-nested", "fn": "toContainEqual", "actual": [{"a": {"b": [1, 2]}}], "args": [{"a": {"b": [1, 2]}}], "upstreamFn": "expect().toContainEqual", "goFn": "jest.Matcher.ToContainEqual"},
    {"id": "containequal-scalar", "fn": "toContainEqual", "actual": [1, 2], "args": [2], "upstreamFn": "expect().toContainEqual", "goFn": "jest.Matcher.ToContainEqual"},
    {"id": "containequal-nan", "fn": "toContainEqual", "actual": [{"$": "nan"}], "args": [{"$": "nan"}], "upstreamFn": "expect().toContainEqual", "goFn": "jest.Matcher.ToContainEqual"},
    {"id": "containequal-undefined-prop", "fn": "toContainEqual", "actual": [{"$": "obj", "entries": [["a", 1], ["b", {"$": "undefined"}]]}], "args": [{"$": "obj", "entries": [["a", 1]]}], "upstreamFn": "expect().toContainEqual", "goFn": "jest.Matcher.ToContainEqual"},
    {"id": "containequal-empty", "fn": "toContainEqual", "actual": [], "args": [{"a": 1}], "upstreamFn": "expect().toContainEqual", "goFn": "jest.Matcher.ToContainEqual"},
    {"id": "containequal-not-miss", "fn": "toContainEqual", "not": true, "actual": [{"a": 1}], "args": [{"a": 2}], "upstreamFn": "expect().not.toContainEqual", "goFn": "jest.Matcher.Not().ToContainEqual"},

    {"id": "havelength-arr-ok", "fn": "toHaveLength", "actual": [1, 2, 3], "args": [3], "upstreamFn": "expect().toHaveLength", "goFn": "jest.Matcher.ToHaveLength"},
    {"id": "havelength-arr-wrong", "fn": "toHaveLength", "actual": [1, 2, 3], "args": [2], "upstreamFn": "expect().toHaveLength", "goFn": "jest.Matcher.ToHaveLength"},
    {"id": "havelength-empty-arr", "fn": "toHaveLength", "actual": [], "args": [0], "upstreamFn": "expect().toHaveLength", "goFn": "jest.Matcher.ToHaveLength"},
    {"id": "havelength-str", "fn": "toHaveLength", "actual": "abcd", "args": [4], "upstreamFn": "expect().toHaveLength", "goFn": "jest.Matcher.ToHaveLength"},
    {"id": "havelength-str-unicode", "fn": "toHaveLength", "actual": "é", "args": [1], "note": "JS counts UTF-16 code units; Go counts bytes", "upstreamFn": "expect().toHaveLength", "goFn": "jest.Matcher.ToHaveLength"},
    {"id": "havelength-str-astral", "fn": "toHaveLength", "actual": "😀", "args": [2], "note": "one astral char is 2 UTF-16 code units in JS and 4 bytes in Go", "upstreamFn": "expect().toHaveLength", "goFn": "jest.Matcher.ToHaveLength"},
    {"id": "havelength-sparse", "fn": "toHaveLength", "actual": {"$": "sparse", "length": 5, "values": {"0": 1}}, "args": [5], "upstreamFn": "expect().toHaveLength", "goFn": "jest.Matcher.ToHaveLength"},
    {"id": "havelength-map", "fn": "toHaveLength", "actual": {"$": "map", "entries": [["a", 1]]}, "args": [1], "note": "a JS Map has no .length, so upstream rejects it; Go maps do have a length", "upstreamFn": "expect().toHaveLength", "goFn": "jest.Matcher.ToHaveLength"},
    {"id": "havelength-obj", "fn": "toHaveLength", "actual": {"a": 1}, "args": [1], "note": "a plain object has no .length in JS", "upstreamFn": "expect().toHaveLength", "goFn": "jest.Matcher.ToHaveLength"},
    {"id": "havelength-number", "fn": "toHaveLength", "actual": 3, "args": [3], "upstreamFn": "expect().toHaveLength", "goFn": "jest.Matcher.ToHaveLength"},
    {"id": "havelength-not-wrong", "fn": "toHaveLength", "not": true, "actual": [1], "args": [2], "upstreamFn": "expect().not.toHaveLength", "goFn": "jest.Matcher.Not().ToHaveLength"},

    {"id": "matchobject-subset", "fn": "toMatchObject", "actual": {"a": 1, "b": 2, "c": 3}, "args": [{"a": 1, "c": 3}], "upstreamFn": "expect().toMatchObject", "goFn": "jest.Matcher.ToMatchObject"},
    {"id": "matchobject-wrong-value", "fn": "toMatchObject", "actual": {"a": 1, "b": 2}, "args": [{"a": 2}], "upstreamFn": "expect().toMatchObject", "goFn": "jest.Matcher.ToMatchObject"},
    {"id": "matchobject-missing-key", "fn": "toMatchObject", "actual": {"a": 1}, "args": [{"z": 1}], "upstreamFn": "expect().toMatchObject", "goFn": "jest.Matcher.ToMatchObject"},
    {"id": "matchobject-nested-subset", "fn": "toMatchObject", "actual": {"a": {"b": 1, "c": 2}}, "args": [{"a": {"b": 1}}], "upstreamFn": "expect().toMatchObject", "goFn": "jest.Matcher.ToMatchObject"},
    {"id": "matchobject-nested-wrong", "fn": "toMatchObject", "actual": {"a": {"b": 1}}, "args": [{"a": {"b": 2}}], "upstreamFn": "expect().toMatchObject", "goFn": "jest.Matcher.ToMatchObject"},
    {"id": "matchobject-array-exact", "fn": "toMatchObject", "actual": {"a": [1, 2, 3]}, "args": [{"a": [1, 2, 3]}], "upstreamFn": "expect().toMatchObject", "goFn": "jest.Matcher.ToMatchObject"},
    {"id": "matchobject-array-subset-rejected", "fn": "toMatchObject", "actual": {"a": [1, 2, 3]}, "args": [{"a": [1, 2]}], "note": "arrays must match in length under toMatchObject", "upstreamFn": "expect().toMatchObject", "goFn": "jest.Matcher.ToMatchObject"},
    {"id": "matchobject-with-asymmetric", "fn": "toMatchObject", "actual": {"a": 1, "b": "hi"}, "args": [{"a": {"$": "any", "type": "Number"}}], "upstreamFn": "expect().toMatchObject", "goFn": "jest.Matcher.ToMatchObject"},
    {"id": "matchobject-undefined-expected", "fn": "toMatchObject", "actual": {"$": "obj", "entries": [["a", 1]]}, "args": [{"$": "obj", "entries": [["b", {"$": "undefined"}]]}], "upstreamFn": "expect().toMatchObject", "goFn": "jest.Matcher.ToMatchObject"},
    {"id": "matchobject-empty-expected", "fn": "toMatchObject", "actual": {"a": 1}, "args": [{}], "upstreamFn": "expect().toMatchObject", "goFn": "jest.Matcher.ToMatchObject"},
    {"id": "matchobject-not-wrong", "fn": "toMatchObject", "not": true, "actual": {"a": 1}, "args": [{"a": 2}], "upstreamFn": "expect().not.toMatchObject", "goFn": "jest.Matcher.Not().ToMatchObject"},

    {"id": "haveproperty-flat", "fn": "toHaveProperty", "actual": {"a": 1}, "args": ["a"], "upstreamFn": "expect().toHaveProperty", "goFn": "jest.Matcher.ToHaveProperty"},
    {"id": "haveproperty-flat-missing", "fn": "toHaveProperty", "actual": {"a": 1}, "args": ["z"], "upstreamFn": "expect().toHaveProperty", "goFn": "jest.Matcher.ToHaveProperty"},
    {"id": "haveproperty-flat-value", "fn": "toHaveProperty", "actual": {"a": 1}, "args": ["a", 1], "upstreamFn": "expect().toHaveProperty", "goFn": "jest.Matcher.ToHaveProperty"},
    {"id": "haveproperty-flat-wrong-value", "fn": "toHaveProperty", "actual": {"a": 1}, "args": ["a", 2], "upstreamFn": "expect().toHaveProperty", "goFn": "jest.Matcher.ToHaveProperty"},
    {"id": "haveproperty-dotted", "fn": "toHaveProperty", "actual": {"a": {"b": {"c": 7}}}, "args": ["a.b.c", 7], "upstreamFn": "expect().toHaveProperty", "goFn": "jest.Matcher.ToHaveProperty"},
    {"id": "haveproperty-dotted-missing", "fn": "toHaveProperty", "actual": {"a": {"b": {}}}, "args": ["a.b.c"], "upstreamFn": "expect().toHaveProperty", "goFn": "jest.Matcher.ToHaveProperty"},
    {"id": "haveproperty-array-index", "fn": "toHaveProperty", "actual": {"items": [{"name": "x"}]}, "args": ["items[0].name", "x"], "upstreamFn": "expect().toHaveProperty", "goFn": "jest.Matcher.ToHaveProperty"},
    {"id": "haveproperty-array-index-oob", "fn": "toHaveProperty", "actual": {"items": [1]}, "args": ["items[3]"], "upstreamFn": "expect().toHaveProperty", "goFn": "jest.Matcher.ToHaveProperty"},
    {"id": "haveproperty-undefined-value", "fn": "toHaveProperty", "actual": {"$": "obj", "entries": [["a", {"$": "undefined"}]]}, "args": ["a"], "note": "the key exists but holds undefined", "upstreamFn": "expect().toHaveProperty", "goFn": "jest.Matcher.ToHaveProperty"},
    {"id": "haveproperty-undefined-value-explicit", "fn": "toHaveProperty", "actual": {"$": "obj", "entries": [["a", {"$": "undefined"}]]}, "args": ["a", {"$": "undefined"}], "upstreamFn": "expect().toHaveProperty", "goFn": "jest.Matcher.ToHaveProperty"},
    {"id": "haveproperty-deep-value-object", "fn": "toHaveProperty", "actual": {"a": {"b": 1}}, "args": ["a", {"b": 1}], "upstreamFn": "expect().toHaveProperty", "goFn": "jest.Matcher.ToHaveProperty"},
    {"id": "haveproperty-asymmetric-value", "fn": "toHaveProperty", "actual": {"a": "hi"}, "args": ["a", {"$": "any", "type": "String"}], "upstreamFn": "expect().toHaveProperty", "goFn": "jest.Matcher.ToHaveProperty"},
    {"id": "haveproperty-not-missing", "fn": "toHaveProperty", "not": true, "actual": {"a": 1}, "args": ["z"], "upstreamFn": "expect().not.toHaveProperty", "goFn": "jest.Matcher.Not().ToHaveProperty"},
    {"id": "haveproperty-on-array-root", "fn": "toHaveProperty", "actual": [10, 20], "args": ["1", 20], "upstreamFn": "expect().toHaveProperty", "goFn": "jest.Matcher.ToHaveProperty"}
  ]
}
