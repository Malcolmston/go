{
  "group": "numbers",
  "upstream": "expect@29.7.0",
  "note": "ordering matchers and toBeCloseTo. JS's toBeCloseTo takes a digit count; the port takes an absolute epsilon, so the harness converts precision p to 10^-p/2 and the default-argument case is the interesting one.",
  "cases": [
    {
      "id": "gt-true",
      "fn": "toBeGreaterThan",
      "actual": 3,
      "args": [
        2
      ],
      "upstreamFn": "expect().toBeGreaterThan",
      "goFn": "jest.Matcher.ToBeGreaterThan"
    },
    {
      "id": "gt-false",
      "fn": "toBeGreaterThan",
      "actual": 2,
      "args": [
        3
      ],
      "upstreamFn": "expect().toBeGreaterThan",
      "goFn": "jest.Matcher.ToBeGreaterThan"
    },
    {
      "id": "gt-equal",
      "fn": "toBeGreaterThan",
      "actual": 2,
      "args": [
        2
      ],
      "upstreamFn": "expect().toBeGreaterThan",
      "goFn": "jest.Matcher.ToBeGreaterThan"
    },
    {
      "id": "gt-negative",
      "fn": "toBeGreaterThan",
      "actual": -1,
      "args": [
        -2
      ],
      "upstreamFn": "expect().toBeGreaterThan",
      "goFn": "jest.Matcher.ToBeGreaterThan"
    },
    {
      "id": "gt-nan-left",
      "fn": "toBeGreaterThan",
      "actual": {
        "$": "nan"
      },
      "args": [
        1
      ],
