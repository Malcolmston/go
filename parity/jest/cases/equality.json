{
  "group": "equality",
  "upstream": "expect@29.7.0",
  "note": "toBe / toEqual / toStrictEqual. Every case reports only whether the assertion held.",
  "cases": [
    {"id": "tobe-num-same", "fn": "toBe", "actual": 1, "args": [1], "upstreamFn": "expect().toBe", "goFn": "jest.Matcher.ToBe"},
    {"id": "tobe-num-diff", "fn": "toBe", "actual": 1, "args": [2], "upstreamFn": "expect().toBe", "goFn": "jest.Matcher.ToBe"},
    {"id": "tobe-num-not-diff", "fn": "toBe", "not": true, "actual": 1, "args": [2], "upstreamFn": "expect().not.toBe", "goFn": "jest.Matcher.Not().ToBe"},
    {"id": "tobe-num-not-same", "fn": "toBe", "not": true, "actual": 1, "args": [1], "upstreamFn": "expect().not.toBe", "goFn": "jest.Matcher.Not().ToBe"},
    {"id": "tobe-str-same", "fn": "toBe", "actual": "abc", "args": ["abc"], "upstreamFn": "expect().toBe", "goFn": "jest.Matcher.ToBe"},
    {"id": "tobe-str-diff", "fn": "toBe", "actual": "abc", "args": ["abd"], "upstreamFn": "expect().toBe", "goFn": "jest.Matcher.ToBe"},
    {"id": "tobe-bool-same", "fn": "toBe", "actual": true, "args": [true], "upstreamFn": "expect().toBe", "goFn": "jest.Matcher.ToBe"},
    {"id": "tobe-zero-vs-negzero", "fn": "toBe", "actual": 0, "args": [{"$": "negzero"}], "note": "Object.is(0,-0) is false in JS; Go's == says they are equal", "upstreamFn": "expect().toBe", "goFn": "jest.Matcher.ToBe"},
    {"id": "tobe-negzero-vs-negzero", "fn": "toBe", "actual": {"$": "negzero"}, "args": [{"$": "negzero"}], "upstreamFn": "expect().toBe", "goFn": "jest.Matcher.ToBe"},
    {"id": "tobe-nan-vs-nan", "fn": "toBe", "actual": {"$": "nan"}, "args": [{"$": "nan"}], "note": "toBe uses Object.is, so NaN toBe NaN passes in JS; Go's == says NaN != NaN", "upstreamFn": "expect().toBe", "goFn": "jest.Matcher.ToBe"},
    {"id": "tobe-obj-structural", "fn": "toBe", "actual": {"a": 1}, "args": [{"a": 1}], "note": "distinct references in JS; the port falls back to a deep comparison", "upstreamFn": "expect().toBe", "goFn": "jest.Matcher.ToBe"},
    {"id": "tobe-arr-structural", "fn": "toBe", "actual": [1, 2], "args": [[1, 2]], "upstreamFn": "expect().toBe", "goFn": "jest.Matcher.ToBe"},
    {"id": "tobe-undefined-undefined", "fn": "toBe", "actual": {"$": "undefined"}, "args": [{"$": "undefined"}], "upstreamFn": "expect().toBe", "goFn": "jest.Matcher.ToBe"},
    {"id": "tobe-null-null", "fn": "toBe", "actual": null, "args": [null], "upstreamFn": "expect().toBe", "goFn": "jest.Matcher.ToBe"},
    {"id": "tobe-null-vs-undefined", "fn": "toBe", "actual": null, "args": [{"$": "undefined"}], "deviation": "Go has a single nil, so null and undefined collapse to the same value", "upstreamFn": "expect().toBe", "goFn": "jest.Matcher.ToBe"},
    {"id": "tobe-str-vs-num", "fn": "toBe", "actual": "1", "args": [1], "upstreamFn": "expect().toBe", "goFn": "jest.Matcher.ToBe"},
    {"id": "tobe-inf", "fn": "toBe", "actual": {"$": "inf"}, "args": [{"$": "inf"}], "upstreamFn": "expect().toBe", "goFn": "jest.Matcher.ToBe"},
    {"id": "tobe-inf-vs-ninf", "fn": "toBe", "actual": {"$": "inf"}, "args": [{"$": "ninf"}], "upstreamFn": "expect().toBe", "goFn": "jest.Matcher.ToBe"},

    {"id": "toequal-num-same", "fn": "toEqual", "actual": 1, "args": [1], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-obj-same", "fn": "toEqual", "actual": {"a": 1, "b": {"c": 2}}, "args": [{"a": 1, "b": {"c": 2}}], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-obj-diff-value", "fn": "toEqual", "actual": {"a": 1, "b": {"c": 2}}, "args": [{"a": 1, "b": {"c": 3}}], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-obj-extra-key", "fn": "toEqual", "actual": {"a": 1, "b": 2}, "args": [{"a": 1}], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-obj-key-order", "fn": "toEqual", "actual": {"$": "obj", "entries": [["b", 2], ["a", 1]]}, "args": [{"$": "obj", "entries": [["a", 1], ["b", 2]]}], "note": "key order must not matter", "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-undefined-prop-ignored", "fn": "toEqual", "actual": {"$": "obj", "entries": [["a", 1], ["b", {"$": "undefined"}]]}, "args": [{"$": "obj", "entries": [["a", 1]]}], "note": "toEqual ignores properties whose value is undefined", "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-absent-prop-vs-undefined", "fn": "toEqual", "actual": {"$": "obj", "entries": [["a", 1]]}, "args": [{"$": "obj", "entries": [["a", 1], ["b", {"$": "undefined"}]]}], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-nan-vs-nan", "fn": "toEqual", "actual": {"$": "nan"}, "args": [{"$": "nan"}], "note": "jest's structural equality treats NaN as equal to NaN", "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-nan-in-array", "fn": "toEqual", "actual": [1, {"$": "nan"}], "args": [[1, {"$": "nan"}]], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-zero-vs-negzero", "fn": "toEqual", "actual": 0, "args": [{"$": "negzero"}], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-arr-same", "fn": "toEqual", "actual": [1, 2, 3], "args": [[1, 2, 3]], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-arr-diff-length", "fn": "toEqual", "actual": [1, 2], "args": [[1, 2, 3]], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-arr-nested", "fn": "toEqual", "actual": [[1, [2]], 3], "args": [[[1, [2]], 3]], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-sparse-vs-dense", "fn": "toEqual", "actual": {"$": "sparse", "length": 2, "values": {"1": 1}}, "args": [[{"$": "undefined"}, 1]], "deviation": "Go slices have no holes; a hole is decoded as a nil element", "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-sparse-vs-sparse", "fn": "toEqual", "actual": {"$": "sparse", "length": 3, "values": {"0": 1}}, "args": [{"$": "sparse", "length": 3, "values": {"0": 1}}], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-map-same", "fn": "toEqual", "actual": {"$": "map", "entries": [["a", 1], ["b", 2]]}, "args": [{"$": "map", "entries": [["a", 1], ["b", 2]]}], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-map-diff-order", "fn": "toEqual", "actual": {"$": "map", "entries": [["b", 2], ["a", 1]]}, "args": [{"$": "map", "entries": [["a", 1], ["b", 2]]}], "note": "Map insertion order must not matter", "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-map-diff-value", "fn": "toEqual", "actual": {"$": "map", "entries": [["a", 1]]}, "args": [{"$": "map", "entries": [["a", 2]]}], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-map-vs-obj", "fn": "toEqual", "actual": {"$": "map", "entries": [["a", 1]]}, "args": [{"a": 1}], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-set-same", "fn": "toEqual", "actual": {"$": "set", "values": [1, 2, 3]}, "args": [{"$": "set", "values": [1, 2, 3]}], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-set-diff-order", "fn": "toEqual", "actual": {"$": "set", "values": [3, 1, 2]}, "args": [{"$": "set", "values": [1, 2, 3]}], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-set-diff-member", "fn": "toEqual", "actual": {"$": "set", "values": [1, 2]}, "args": [{"$": "set", "values": [1, 3]}], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-set-vs-array", "fn": "toEqual", "actual": {"$": "set", "values": [1, 2]}, "args": [[1, 2]], "deviation": "Go has no Set type; the harness models one as map[any]struct{}", "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-date-same", "fn": "toEqual", "actual": {"$": "date", "iso": "2020-01-02T03:04:05.000Z"}, "args": [{"$": "date", "iso": "2020-01-02T03:04:05.000Z"}], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-date-diff", "fn": "toEqual", "actual": {"$": "date", "iso": "2020-01-02T03:04:05.000Z"}, "args": [{"$": "date", "iso": "2021-01-02T03:04:05.000Z"}], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-regexp-same", "fn": "toEqual", "actual": {"$": "regexp", "source": "a+b"}, "args": [{"$": "regexp", "source": "a+b"}], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-regexp-diff", "fn": "toEqual", "actual": {"$": "regexp", "source": "a+b"}, "args": [{"$": "regexp", "source": "a*b"}], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-cyclic-same", "fn": "toEqual", "actual": {"$": "cyclic", "entries": [["a", 1]]}, "args": [{"$": "cyclic", "entries": [["a", 1]]}], "note": "must terminate, not blow the stack", "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-cyclic-diff", "fn": "toEqual", "actual": {"$": "cyclic", "entries": [["a", 1]]}, "args": [{"$": "cyclic", "entries": [["a", 2]]}], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-error-same-message", "fn": "toEqual", "actual": {"$": "error", "ctor": "Error", "message": "boom"}, "args": [{"$": "error", "ctor": "Error", "message": "boom"}], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-error-diff-message", "fn": "toEqual", "actual": {"$": "error", "ctor": "Error", "message": "boom"}, "args": [{"$": "error", "ctor": "Error", "message": "bang"}], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-not-diff", "fn": "toEqual", "not": true, "actual": {"a": 1}, "args": [{"a": 2}], "upstreamFn": "expect().not.toEqual", "goFn": "jest.Matcher.Not().ToEqual"},
    {"id": "toequal-empty-obj", "fn": "toEqual", "actual": {}, "args": [{}], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},
    {"id": "toequal-empty-arr-vs-obj", "fn": "toEqual", "actual": [], "args": [{}], "upstreamFn": "expect().toEqual", "goFn": "jest.Matcher.ToEqual"},

    {"id": "tostrict-num-same", "fn": "toStrictEqual", "actual": 1, "args": [1], "upstreamFn": "expect().toStrictEqual", "goFn": "jest.Matcher.ToStrictEqual"},
    {"id": "tostrict-obj-same", "fn": "toStrictEqual", "actual": {"a": 1, "b": {"c": 2}}, "args": [{"a": 1, "b": {"c": 2}}], "upstreamFn": "expect().toStrictEqual", "goFn": "jest.Matcher.ToStrictEqual"},
    {"id": "tostrict-undefined-prop-counts", "fn": "toStrictEqual", "actual": {"$": "obj", "entries": [["a", 1], ["b", {"$": "undefined"}]]}, "args": [{"$": "obj", "entries": [["a", 1]]}], "note": "unlike toEqual, toStrictEqual does not ignore an undefined property", "upstreamFn": "expect().toStrictEqual", "goFn": "jest.Matcher.ToStrictEqual"},
    {"id": "tostrict-sparse-vs-dense", "fn": "toStrictEqual", "actual": {"$": "sparse", "length": 2, "values": {"1": 1}}, "args": [[{"$": "undefined"}, 1]], "deviation": "Go slices have no holes", "upstreamFn": "expect().toStrictEqual", "goFn": "jest.Matcher.ToStrictEqual"},
    {"id": "tostrict-nan-vs-nan", "fn": "toStrictEqual", "actual": {"$": "nan"}, "args": [{"$": "nan"}], "upstreamFn": "expect().toStrictEqual", "goFn": "jest.Matcher.ToStrictEqual"},
    {"id": "tostrict-zero-vs-negzero", "fn": "toStrictEqual", "actual": 0, "args": [{"$": "negzero"}], "upstreamFn": "expect().toStrictEqual", "goFn": "jest.Matcher.ToStrictEqual"},
    {"id": "tostrict-str-vs-num", "fn": "toStrictEqual", "actual": "1", "args": [1], "upstreamFn": "expect().toStrictEqual", "goFn": "jest.Matcher.ToStrictEqual"},
    {"id": "tostrict-null-vs-undefined", "fn": "toStrictEqual", "actual": null, "args": [{"$": "undefined"}], "deviation": "Go has a single nil", "upstreamFn": "expect().toStrictEqual", "goFn": "jest.Matcher.ToStrictEqual"},
    {"id": "tostrict-map-same", "fn": "toStrictEqual", "actual": {"$": "map", "entries": [["a", 1]]}, "args": [{"$": "map", "entries": [["a", 1]]}], "upstreamFn": "expect().toStrictEqual", "goFn": "jest.Matcher.ToStrictEqual"},
    {"id": "tostrict-set-same", "fn": "toStrictEqual", "actual": {"$": "set", "values": [1, 2]}, "args": [{"$": "set", "values": [1, 2]}], "upstreamFn": "expect().toStrictEqual", "goFn": "jest.Matcher.ToStrictEqual"},
    {"id": "tostrict-date-same", "fn": "toStrictEqual", "actual": {"$": "date", "iso": "2020-01-02T03:04:05.000Z"}, "args": [{"$": "date", "iso": "2020-01-02T03:04:05.000Z"}], "upstreamFn": "expect().toStrictEqual", "goFn": "jest.Matcher.ToStrictEqual"},
    {"id": "tostrict-arr-vs-obj", "fn": "toStrictEqual", "actual": [1], "args": [{"0": 1}], "upstreamFn": "expect().toStrictEqual", "goFn": "jest.Matcher.ToStrictEqual"},
    {"id": "tostrict-not-diff", "fn": "toStrictEqual", "not": true, "actual": {"a": 1}, "args": [{"a": 2}], "upstreamFn": "expect().not.toStrictEqual", "goFn": "jest.Matcher.Not().ToStrictEqual"},
    {"id": "tostrict-cyclic-same", "fn": "toStrictEqual", "actual": {"$": "cyclic", "entries": [["a", 1]]}, "args": [{"$": "cyclic", "entries": [["a", 1]]}], "upstreamFn": "expect().toStrictEqual", "goFn": "jest.Matcher.ToStrictEqual"}
  ]
}
