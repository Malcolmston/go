    {
      "id": "sel-type",
      "fn": "chain",
      "args": [
        "selectors",
        [
          [
            "find",
            "p"
          ]
        ],
        "texts"
      ],
      "upstreamFn": "$",
      "goFn": "Document.Find"
    },
