{
  "group": "forms-and-statics",
  "upstream": "cheerio@1.0.0",
  "cases": [
    {
      "id": "form-serialize-array",
      "fn": "chain",
      "args": [
        "form",
        [
          [
            "find",
            "#f"
          ],
          [
            "serializeArray"
          ]
        ]
      ],
      "upstreamFn": "Cheerio.prototype.serializeArray",
      "goFn": "Selection.SerializeArray",
      "deviation": "cheerio submits a multiple-select option's text; because the options carry a value attribute the port submits the value per the HTML form-submission spec (upstream is the outlier)."
    },
    {
      "id": "form-serialize",
      "fn": "chain",
      "args": [
        "form",
        [
          [
            "find",
            "#f"
          ],
          [
            "serialize"
          ]
        ]
      ],
      "upstreamFn": "Cheerio.prototype.serialize",
      "goFn": "Selection.Serialize",
      "deviation": "cheerio submits a multiple-select option's text; because the options carry a value attribute the port submits the value per the HTML form-submission spec (upstream is the outlier)."
    },
    {
      "id": "form-serialize-inputs-only",
      "fn": "chain",
      "args": [
        "form",
        [
          [
            "find",
            "input"
          ],
          [
            "serializeArray"
          ]
        ]
      ],
      "upstreamFn": "Cheerio.prototype.serializeArray",
      "goFn": "Selection.SerializeArray"
    },
    {
      "id": "form-serialize-select-multiple",
      "fn": "chain",
      "args": [
        "form",
        [
          [
            "find",
            "select[name=multi]"
          ],
          [
            "serializeArray"
          ]
        ]
      ],
      "upstreamFn": "Cheerio.prototype.serializeArray",
      "goFn": "Selection.SerializeArray",
      "deviation": "cheerio submits a multiple-select option's text; because the options carry a value attribute the port submits the value per the HTML form-submission spec (upstream is the outlier)."
    },
    {
      "id": "form-serialize-empty",
      "fn": "chain",
      "args": [
        "manip",
        [
          [
            "find",
            "#box"
          ],
          [
            "serializeArray"
          ]
        ]
      ],
      "upstreamFn": "Cheerio.prototype.serializeArray",
      "goFn": "Selection.SerializeArray"
    },
    {
      "id": "form-serialize-encoding",
      "fn": "chain",
      "args": [
        "manip",
        [
          [
            "find",
            "#box"
          ],
          [
            "html",
            "<form><input name=\"a b\" value=\"x&y=z\"></form>"
          ],
          [
            "find",
            "form"
          ],
          [
            "serialize"
          ]
        ]
      ],
      "upstreamFn": "Cheerio.prototype.serialize",
      "goFn": "Selection.Serialize"
    },
    {
      "id": "static-text-nodes",
      "fn": "static.text",
      "args": [
        "selectors",
        "p"
      ],
      "upstreamFn": "$.text",
      "goFn": "cheerio.TextOf"
    },
    {
      "id": "static-text-empty",
      "fn": "static.text",
      "args": [
        "selectors",
        "blockquote"
      ],
      "upstreamFn": "$.text",
      "goFn": "cheerio.TextOf"
    },
    {
      "id": "static-html-nodes",
      "fn": "static.html",
      "args": [
        "selectors",
        "li"
      ],
      "upstreamFn": "$.html",
      "goFn": "cheerio.RenderNodes"
    },
    {
      "id": "static-html-escapes",
      "fn": "static.html",
      "args": [
        "escape-out",
        "#x"
      ],
      "upstreamFn": "$.html",
      "goFn": "cheerio.RenderNodes"
    },
    {
      "id": "static-contains-true",
