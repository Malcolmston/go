    },
    {
      "id": "static-parsehtml-empty",
      "fn": "static.parseHTML",
      "args": [
        ""
      ],
      "upstreamFn": "$.parseHTML",
      "goFn": "cheerio.ParseHTML",
      "note": "upstream returns null for empty input"
    }
  ]
}
