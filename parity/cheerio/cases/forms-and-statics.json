    },
    {
      "id": "static-parsehtml-simple",
      "fn": "static.parseHTML",
      "args": [
        "<p>a</p><p>b</p>"
      ],
      "upstreamFn": "$.parseHTML",
      "goFn": "cheerio.ParseHTML"
    },
    {
      "id": "static-parsehtml-text",
      "fn": "static.parseHTML",
      "args": [
        "hello & goodbye"
      ],
      "upstreamFn": "$.parseHTML",
      "goFn": "cheerio.ParseHTML"
    },
    {
      "id": "static-parsehtml-table",
