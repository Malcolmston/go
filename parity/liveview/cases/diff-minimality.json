{
  "group": "diff-minimality",
  "upstream": "phoenix_live_view@1.2.9",
  "note": "Render, change one assign, render again, and compare the DIFF: which slots are present, and whether the statics are re-sent. render_diff marks only the assigns whose value actually changed; render_diff_reassign marks every assign changed, the shape produced by a view that re-assigns unconditionally.",
  "cases": [
    {
      "id": "min-count-only",
      "fn": "render_diff",
      "args": [
        "counter",
        {
          "label": "Counter",
          "count": 0
        },
        {
          "label": "Counter",
          "count": 1
        }
      ],
      "upstreamFn": "Phoenix.LiveView.Diff.render/4",
      "goFn": "liveview.DiffRendered",
      "note": "only slot 1 may travel, and no \"s\""
    },
    {
      "id": "min-label-only",
      "fn": "render_diff",
      "args": [
        "counter",
        {
          "label": "A",
          "count": 0
        },
        {
          "label": "B",
          "count": 0
        }
      ],
      "upstreamFn": "Phoenix.LiveView.Diff.render/4",
      "goFn": "liveview.DiffRendered"
    },
    {
      "id": "min-both",
      "fn": "render_diff",
      "args": [
        "counter",
        {
          "label": "A",
          "count": 0
        },
        {
          "label": "B",
          "count": 1
        }
      ],
      "upstreamFn": "Phoenix.LiveView.Diff.render/4",
      "goFn": "liveview.DiffRendered"
    },
    {
      "id": "min-nothing",
      "fn": "render_diff",
      "args": [
        "counter",
        {
          "label": "A",
          "count": 0
        },
        {
          "label": "A",
          "count": 0
        }
      ],
      "upstreamFn": "Phoenix.LiveView.Diff.render/4",
      "goFn": "liveview.DiffRendered",
      "note": "identical renders must produce an empty diff"
    },
    {
      "id": "min-empty-to-value",
      "fn": "render_diff",
      "args": [
        "one",
        {
          "a": ""
        },
        {
          "a": "x"
        }
      ],
      "upstreamFn": "Phoenix.LiveView.Diff.render/4",
      "goFn": "liveview.DiffRendered"
