        {
          "b": 1,
          "a": 2
        }
      ],
      "upstreamFn": "keys_unsorted/0",
      "goFn": "keys_unsorted/0",
      "note": "jq keeps insertion order",
      "deviation": "object key order is not preserved (map[string]any); keys_unsorted == keys"
    },
