{
  "group": "objects",
  "upstream": "jq@1.7.1",
  "encoding": "args = [jq program, input JSON value, optional $variables object]; value = the complete output stream as a JSON array",
  "cases": [
    {
      "id": "to-entries",
      "fn": "run",
      "args": [
        "to_entries",
        {
          "a": 1,
          "b": 2
        }
      ],
      "upstreamFn": "to_entries/0",
      "goFn": "to_entries/0"
    },
    {
      "id": "to-entries-array-err",
      "fn": "run",
      "args": [
        "to_entries",
        [
          1,
          2
        ]
      ],
      "upstreamFn": "to_entries/0",
      "goFn": "to_entries/0"
    },
    {
      "id": "from-entries",
      "fn": "run",
      "args": [
        "from_entries",
        [
          {
            "key": "a",
            "value": 1
          },
          {
            "name": "b",
            "value": 2
          }
        ]
      ],
      "upstreamFn": "from_entries/0",
      "goFn": "from_entries/0"
    },
    {
      "id": "from-entries-kv",
      "fn": "run",
      "args": [
        "from_entries",
        [
          {
            "k": "a",
            "v": 1
          }
        ]
      ],
      "upstreamFn": "from_entries/0",
      "goFn": "from_entries/0",
      "note": "jq 1.7 does not accept a bare `k` as the key alias"
    },
    {
      "id": "with-entries",
      "fn": "run",
      "args": [
        "with_entries(.value += 1)",
        {
          "a": 1,
          "b": 2
        }
      ],
      "upstreamFn": "with_entries/1",
      "goFn": "with_entries/1"
    },
    {
      "id": "with-entries-nonobj-err",
      "fn": "run",
      "args": [
        "with_entries(.)",
        [
          1
        ]
      ],
      "upstreamFn": "with_entries/1",
      "goFn": "with_entries/1",
      "note": "jq rejects an array input; the port turns the index into a key"
    },
    {
      "id": "keys",
      "fn": "run",
      "args": [
        "keys",
        {
          "b": 1,
          "a": 2
