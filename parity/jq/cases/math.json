    {
      "id": "math-trig",
      "fn": "run",
      "args": [
        "def r: .*1e12|round|./1e12; [(0.5|asin|r),(0.5|acos|r),(0.5|atan|r),(0.5|sin|r),(0.5|cos|r),(0.5|tan|r)]",
        null
      ],
      "upstreamFn": "asin/0",
      "goFn": "asin/0",
      "note": "rounded to 12 decimals to take libm ULP noise out of play"
    },
    {
      "id": "math-hyper",
