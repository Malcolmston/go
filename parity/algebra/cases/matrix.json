      "args": [[[1, 2, 3, 4], [2, 4, 6, 8]]],
      "mode": "exact",
      "upstreamFn": "sympy.Matrix.rank",
      "goFn": "matrix.Matrix.Rank"
    },
    {
      "id": "charpoly-2x2",
      "fn": "charpoly",
      "args": [[[1, 2], [3, 4]]],
      "mode": "exact",
      "upstreamFn": "sympy.Matrix.charpoly",
      "goFn": "matrix.Matrix.CharPoly"
    },
    {
      "id": "charpoly-3x3",
      "fn": "charpoly",
      "args": [[[2, -1, 0], [-1, 2, -1], [0, -1, 2]]],
