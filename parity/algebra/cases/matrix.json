      "upstreamFn": "sympy.Matrix.inv",
      "goFn": "matrix.Matrix.Inverse"
    },
    {
      "id": "inverse-singular",
      "fn": "inverse",
      "args": [[[1, 2], [2, 4]]],
      "mode": "exact",
      "upstreamFn": "sympy.Matrix.inv",
      "goFn": "matrix.Matrix.Inverse",
      "note": "must fail on both"
    },
    {
      "id": "inverse-nonsquare",
      "fn": "inverse",
      "args": [[[1, 2, 3], [4, 5, 6]]],
      "mode": "exact",
      "upstreamFn": "sympy.Matrix.inv",
      "goFn": "matrix.Matrix.Inverse",
      "note": "must fail on both"
    },
    {
      "id": "transpose-2x3",
      "fn": "transpose",
      "args": [[[1, 2, 3], [4, 5, 6]]],
