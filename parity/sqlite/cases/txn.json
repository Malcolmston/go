      "args": [
        {
          "setup": [
            "CREATE TABLE d (a INTEGER)",
            {
              "txn": "begin"
            },
            "INSERT INTO d (a) VALUES (1)",
            {
              "txn": "rollback"
            },
            "INSERT INTO d (a) VALUES (2)"
          ],
          "query": "SELECT a AS a FROM d ORDER BY a"
        }
      ],
      "upstreamFn": "work after a ROLLBACK",
      "goFn": "sqlite: work after a ROLLBACK"
    },
    {
      "id": "txn-rollback-update",
      "fn": "script",
      "args": [
        {
          "setup": [
            "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT, qty INTEGER, price REAL)",
            "INSERT INTO t (id, name, qty, price) VALUES (1,'apple',3,1.5),(2,'banana',7,0.25),(3,'cherry',NULL,2.0),(4,'date',7,1.5)",
            {
              "txn": "begin"
            },
            "UPDATE t SET qty = 0",
            {
              "txn": "rollback"
            }
          ],
          "query": "SELECT id AS id, qty AS q FROM t ORDER BY id"
        }
      ],
      "upstreamFn": "ROLLBACK of an UPDATE",
      "goFn": "sqlite: ROLLBACK of an UPDATE"
    },
    {
      "id": "txn-rollback-delete",
      "fn": "script",
      "args": [
        {
          "setup": [
            "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT, qty INTEGER, price REAL)",
            "INSERT INTO t (id, name, qty, price) VALUES (1,'apple',3,1.5),(2,'banana',7,0.25),(3,'cherry',NULL,2.0),(4,'date',7,1.5)",
            {
              "txn": "begin"
            },
            "DELETE FROM t",
            {
              "txn": "rollback"
            }
          ],
          "query": "SELECT count(*) AS c FROM t"
        }
      ],
