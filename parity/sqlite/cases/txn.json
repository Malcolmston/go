{
  "group": "txn",
  "upstream": "sqlite3@3.45.3",
  "cases": [
    {
      "id": "txn-commit-visible",
      "fn": "script",
      "args": [
        {
          "setup": [
            "CREATE TABLE d (a INTEGER)",
            {
              "txn": "begin"
            },
            "INSERT INTO d (a) VALUES (1)",
            {
              "txn": "commit"
            }
          ],
          "query": "SELECT a AS a FROM d ORDER BY a"
        }
      ],
      "upstreamFn": "BEGIN ... COMMIT persists",
      "goFn": "sqlite: BEGIN ... COMMIT persists"
    },
    {
      "id": "txn-rollback-discards",
      "fn": "script",
      "args": [
        {
          "setup": [
            "CREATE TABLE d (a INTEGER)",
            "INSERT INTO d (a) VALUES (1)",
            {
              "txn": "begin"
            },
            "INSERT INTO d (a) VALUES (2)",
            {
              "txn": "rollback"
            }
          ],
          "query": "SELECT count(*) AS c FROM d"
        }
      ],
      "upstreamFn": "BEGIN ... ROLLBACK discards",
      "goFn": "sqlite: BEGIN ... ROLLBACK discards"
    },
    {
      "id": "txn-rollback-then-insert",
