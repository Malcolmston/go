    {
      "id": "txn-savepoint",
      "fn": "script",
      "args": [
        {
          "setup": [
            "CREATE TABLE d (a INTEGER)",
            "SAVEPOINT s1",
            "INSERT INTO d (a) VALUES (1)",
            "RELEASE s1"
          ],
          "query": "SELECT a AS a FROM d ORDER BY a"
        }
      ],
      "upstreamFn": "SAVEPOINT / RELEASE",
      "goFn": "sqlite: SAVEPOINT / RELEASE"
    },
    {
      "id": "txn-rollback-to-savepoint",
      "fn": "script",
      "args": [
        {
          "setup": [
            "CREATE TABLE d (a INTEGER)",
            "SAVEPOINT s1",
            "INSERT INTO d (a) VALUES (1)",
            "ROLLBACK TO s1"
          ],
          "query": "SELECT count(*) AS c FROM d"
        }
      ],
      "upstreamFn": "ROLLBACK TO SAVEPOINT",
      "goFn": "sqlite: ROLLBACK TO SAVEPOINT"
