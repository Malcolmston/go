{
  "group": "is",
  "upstream": "type-is@1.6.18",
  "note": "typeis.is(value, types) — normalise the Content-Type value, then walk the candidates in order and return the first one that matches. A candidate containing '*' or starting with '+' reports the concrete type instead of itself.",
  "cases": [
    { "id": "is-exact", "fn": "is", "args": ["application/json", ["application/json"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is" },
    { "id": "is-exact-miss", "fn": "is", "args": ["application/json", ["text/html"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is" },
    { "id": "is-with-params", "fn": "is", "args": ["application/json; charset=utf-8", ["application/json"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is", "note": "parameters are stripped before matching" },
    { "id": "is-ext-json", "fn": "is", "args": ["application/json", ["json"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is", "note": "the candidate is echoed back as given, not expanded" },
    { "id": "is-ext-html", "fn": "is", "args": ["text/html", ["html"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is" },
    { "id": "is-ext-csv", "fn": "is", "args": ["text/csv", ["csv"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is" },
    { "id": "is-ext-svg", "fn": "is", "args": ["image/svg+xml", ["svg"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is" },
    { "id": "is-ext-unknown", "fn": "is", "args": ["application/json", ["bogusext"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is", "note": "an unknown extension normalises to false and can never match" },
    { "id": "is-urlencoded", "fn": "is", "args": ["application/x-www-form-urlencoded", ["urlencoded"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is" },
    { "id": "is-multipart", "fn": "is", "args": ["multipart/form-data; boundary=abc", ["multipart"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is", "note": "\"multipart\" expands to multipart/*, which contains a '*', so the concrete type is returned" },
    { "id": "is-suffix-json", "fn": "is", "args": ["application/vnd.api+json", ["+json"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is", "note": "a '+' candidate reports the concrete type" },
    { "id": "is-suffix-json-miss", "fn": "is", "args": ["application/json", ["+json"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is" },
    { "id": "is-suffix-xml", "fn": "is", "args": ["image/svg+xml", ["+xml"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is" },
    { "id": "is-wildcard-star-star", "fn": "is", "args": ["application/json", ["*/*"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is" },
    { "id": "is-wildcard-subtype", "fn": "is", "args": ["text/html", ["text/*"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is" },
    { "id": "is-wildcard-type", "fn": "is", "args": ["application/json", ["*/json"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is" },
    { "id": "is-first-match-wins", "fn": "is", "args": ["application/json", ["text/html", "application/json", "*/*"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is", "note": "candidate order decides, not specificity" },
    { "id": "is-wildcard-before-exact", "fn": "is", "args": ["application/json", ["*/*", "application/json"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is" },
    { "id": "is-multiple-miss", "fn": "is", "args": ["image/png", ["text/html", "application/json", "text/*"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is" },
    { "id": "is-case-insensitive-value", "fn": "is", "args": ["APPLICATION/JSON", ["application/json"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is", "note": "the value is lower-cased by normalisation" },
    { "id": "is-uppercase-candidate", "fn": "is", "args": ["application/json", ["APPLICATION/JSON"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is", "note": "the candidate is not lower-cased, so this must not match" },
    { "id": "is-invalid-value", "fn": "is", "args": ["bogus", ["*/*"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is" },
    { "id": "is-empty-value", "fn": "is", "args": ["", ["*/*"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is" },
    { "id": "is-trailing-semicolon-value", "fn": "is", "args": ["application/json;", ["*/*"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is", "note": "an unparseable value is rejected outright" },
    { "id": "is-no-types", "fn": "is", "args": ["application/json; charset=utf-8", null], "upstreamFn": "typeis.is", "goFn": "typeis.Is", "note": "with no candidates the normalised type is returned" },
    { "id": "is-no-types-invalid", "fn": "is", "args": ["bogus", null], "upstreamFn": "typeis.is", "goFn": "typeis.Is" },
    { "id": "is-empty-candidate", "fn": "is", "args": ["application/json", [""]], "upstreamFn": "typeis.is", "goFn": "typeis.Is", "note": "an empty candidate normalises to false and is skipped" },
    { "id": "is-empty-candidate-then-hit", "fn": "is", "args": ["application/json", ["", "application/json"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is" },
    { "id": "is-text-star-on-charset", "fn": "is", "args": ["text/plain; charset=utf-8", ["text/*"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is" },
    { "id": "is-urlencoded-vs-multipart", "fn": "is", "args": ["multipart/form-data", ["urlencoded", "multipart"]], "upstreamFn": "typeis.is", "goFn": "typeis.Is" }
  ]
}
