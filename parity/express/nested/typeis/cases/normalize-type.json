{
  "group": "normalize-type",
  "upstream": "type-is@1.6.18",
  "note": "The internal normalizeType, reached by calling typeis.is(value) with no candidate types: parse the Content-Type value with media-typer, drop its parameters and reformat it. Anything media-typer rejects — including a stray trailing ';' — yields false.",
  "cases": [
    { "id": "nt-plain", "fn": "normalizeType", "args": ["application/json"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType" },
    { "id": "nt-with-charset", "fn": "normalizeType", "args": ["application/json; charset=utf-8"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType" },
    { "id": "nt-no-space-param", "fn": "normalizeType", "args": ["text/html;charset=iso-8859-1"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType" },
    { "id": "nt-quoted-param", "fn": "normalizeType", "args": ["text/plain; charset=\"utf-8\""], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType" },
    { "id": "nt-escaped-quoted-param", "fn": "normalizeType", "args": ["text/plain; x=\"a\\\"b\""], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType" },
    { "id": "nt-two-params", "fn": "normalizeType", "args": ["multipart/form-data; boundary=x; charset=utf-8"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType" },
    { "id": "nt-uppercase", "fn": "normalizeType", "args": ["APPLICATION/JSON"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType" },
    { "id": "nt-surrounding-space", "fn": "normalizeType", "args": ["  application/json  "], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType", "note": "the type grammar allows leading and trailing spaces" },
    { "id": "nt-tab-padded", "fn": "normalizeType", "args": ["\tapplication/json"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType", "note": "a tab is not a space: the grammar rejects it" },
    { "id": "nt-suffix", "fn": "normalizeType", "args": ["application/vnd.api+json"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType", "note": "the subtype is split at the last '+' and reassembled" },
    { "id": "nt-svg", "fn": "normalizeType", "args": ["image/svg+xml"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType" },
    { "id": "nt-trailing-plus", "fn": "normalizeType", "args": ["text/html+"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType", "note": "an empty suffix is dropped on reformat, so the '+' disappears" },
    { "id": "nt-double-plus", "fn": "normalizeType", "args": ["text/html++x"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType", "note": "the residual subtype \"html+\" fails the subtype grammar" },
    { "id": "nt-empty", "fn": "normalizeType", "args": [""], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType" },
    { "id": "nt-no-slash", "fn": "normalizeType", "args": ["bogus"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType" },
    { "id": "nt-wildcard", "fn": "normalizeType", "args": ["*/*"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType", "note": "'*' is not in the media-type grammar" },
    { "id": "nt-subtype-wildcard", "fn": "normalizeType", "args": ["text/*"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType" },
    { "id": "nt-invalid-chars", "fn": "normalizeType", "args": ["text/html**"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType" },
    { "id": "nt-empty-subtype", "fn": "normalizeType", "args": ["text/"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType" },
    { "id": "nt-empty-type", "fn": "normalizeType", "args": ["/json"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType" },
    { "id": "nt-trailing-semicolon", "fn": "normalizeType", "args": ["text/html;"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType", "note": "a ';' with no parameter after it is a parse error, not something to ignore" },
    { "id": "nt-double-semicolon", "fn": "normalizeType", "args": ["application/json;;"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType" },
    { "id": "nt-param-no-value", "fn": "normalizeType", "args": ["text/html; charset"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType" },
    { "id": "nt-param-bad-name", "fn": "normalizeType", "args": ["text/html; char set=utf-8"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType" },
    { "id": "nt-param-trailing-junk", "fn": "normalizeType", "args": ["text/html; charset=utf-8 junk"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType" },
    { "id": "nt-type-starts-with-punct", "fn": "normalizeType", "args": ["-text/html"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType", "note": "the first character must be alphanumeric" },
    { "id": "nt-subtype-starts-with-punct", "fn": "normalizeType", "args": ["text/-html"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType" },
    { "id": "nt-type-with-dot", "fn": "normalizeType", "args": ["te.xt/html"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType", "note": "'.' is allowed in a subtype but not in a type" },
    { "id": "nt-urlencoded", "fn": "normalizeType", "args": ["application/x-www-form-urlencoded"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType" },
    { "id": "nt-octet-stream", "fn": "normalizeType", "args": ["application/octet-stream"], "upstreamFn": "typeis.is", "goFn": "typeis.NormalizeType" }
  ]
}
