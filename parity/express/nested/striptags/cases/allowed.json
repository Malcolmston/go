{
  "group": "allowed",
  "upstream": "striptags@3.2.0",
  "note": "The allowable_tags argument. Upstream takes an ARRAY verbatim (new Set(arr): no bracket stripping, no lower-casing) but scans a STRING with /<(\\w*)>/g, so the two forms are separate fns here. The tag name a tag is matched against is always lower-cased by normalize_tag.",
  "cases": [
    { "id": "arr-p", "fn": "stripAllowedArray", "args": ["<p>hello <b>world</b></p>", ["p"]], "upstreamFn": "striptags", "goFn": "striptags.StripTagsWith" },
    { "id": "arr-p-b", "fn": "stripAllowedArray", "args": ["<p>hello <b>world</b></p>", ["p", "b"]], "upstreamFn": "striptags", "goFn": "striptags.StripTagsWith" },
    { "id": "arr-empty", "fn": "stripAllowedArray", "args": ["<p>a</p>", []], "upstreamFn": "striptags", "goFn": "striptags.StripTagsWith" },
    { "id": "arr-keeps-attrs", "fn": "stripAllowedArray", "args": ["<a href=\"x\" onclick=\"alert(1)\">y</a>", ["a"]], "upstreamFn": "striptags", "goFn": "striptags.StripTagsWith", "note": "an allowed tag keeps ALL its attributes verbatim on both sides: striptags is not a sanitizer" },
    { "id": "arr-keeps-close", "fn": "stripAllowedArray", "args": ["<p>a</p>", ["p"]], "upstreamFn": "striptags", "goFn": "striptags.StripTagsWith", "note": "the closing form of an allowed tag is kept too" },
    { "id": "arr-allowed-mixed-case-input", "fn": "stripAllowedArray", "args": ["<P>a</P>", ["p"]], "upstreamFn": "striptags", "goFn": "striptags.StripTagsWith", "note": "the tag in the input is upper case; the allowlist entry is lower case: normalize_tag lower-cases so this matches" },
    { "id": "arr-selfclose", "fn": "stripAllowedArray", "args": ["a<br/>b", ["br"]], "upstreamFn": "striptags", "goFn": "striptags.StripTagsWith" },
    { "id": "arr-script-allowed", "fn": "stripAllowedArray", "args": ["<script>alert(1)</script>", ["script"]], "upstreamFn": "striptags", "goFn": "striptags.StripTagsWith", "note": "allowing script is the caller's decision and both sides honour it" },
    { "id": "arr-comment-still-removed", "fn": "stripAllowedArray", "args": ["a<!-- x -->b", ["p"]], "upstreamFn": "striptags", "goFn": "striptags.StripTagsWith", "note": "comments are removed regardless of the allowlist" },
    { "id": "arr-attr-name-tag", "fn": "stripAllowedArray", "args": ["<p title=\"<b>\">x</p>", ["p"]], "upstreamFn": "striptags", "goFn": "striptags.StripTagsWith" },
    { "id": "arr-namespaced", "fn": "stripAllowedArray", "args": ["<foo:bar>x</foo:bar>", ["foo:bar"]], "upstreamFn": "striptags", "goFn": "striptags.StripTagsWith" },
    { "id": "arr-nonexistent", "fn": "stripAllowedArray", "args": ["<p>a</p>", ["blockquote"]], "upstreamFn": "striptags", "goFn": "striptags.StripTagsWith" },
    { "id": "arr-doctype-not-allowed", "fn": "stripAllowedArray", "args": ["<!DOCTYPE html><p>a</p>", ["p"]], "upstreamFn": "striptags", "goFn": "striptags.StripTagsWith" },
    { "id": "arr-brackets", "fn": "stripAllowedArray", "args": ["<p>a</p>", ["<p>"]], "upstreamFn": "striptags", "goFn": "striptags.StripTagsWith", "deviation": "array entries: upstream uses them verbatim, so a bracketed \"<p>\" can never match the lower-cased bare tag name and the tag is stripped; the port accepts either spelling", "note": "upstream: '' — port: '<p>a</p>'" },
    { "id": "arr-upper-entry", "fn": "stripAllowedArray", "args": ["<p>a</p>", ["P"]], "upstreamFn": "striptags", "goFn": "striptags.StripTagsWith", "deviation": "array entries: upstream compares case-sensitively against an already lower-cased tag name, so an upper-case entry can never match anything; the port lower-cases entries" },
    { "id": "str-p", "fn": "stripAllowedString", "args": ["<p>hello <b>world</b></p>", "<p>"], "upstreamFn": "striptags", "goFn": "striptags.StripTags" },
    { "id": "str-p-b", "fn": "stripAllowedString", "args": ["<a href=x>l</a><p>hi</p><b>c</b>", "<p><b>"], "upstreamFn": "striptags", "goFn": "striptags.StripTags" },
    { "id": "str-empty", "fn": "stripAllowedString", "args": ["<p>a</p>", ""], "upstreamFn": "striptags", "goFn": "striptags.StripTags" },
    { "id": "str-no-brackets", "fn": "stripAllowedString", "args": ["<p>a</p>", "p"], "upstreamFn": "striptags", "goFn": "striptags.StripTags", "deviation": "string form: upstream's /<(\\w*)>/g finds no bracketed name in \"p\" so nothing is allowed; the port also accepts a bare name" },
    { "id": "str-junk", "fn": "stripAllowedString", "args": ["<p>a</p>", "<>"], "upstreamFn": "striptags", "goFn": "striptags.StripTags", "note": "<> names no tag on either side" },
    { "id": "str-trailing-space", "fn": "stripAllowedString", "args": ["<p>a</p>", "<p >"], "upstreamFn": "striptags", "goFn": "striptags.StripTags", "deviation": "string form: \\w* stops at the space so upstream extracts nothing; the port trims the entry" },
    { "id": "str-comma-separated", "fn": "stripAllowedString", "args": ["<p>a</p><b>c</b>", "<p>,<b>"], "upstreamFn": "striptags", "goFn": "striptags.StripTags", "note": "the regex ignores the separator on both sides" },
    { "id": "str-close-form", "fn": "stripAllowedString", "args": ["<p>a</p>", "</p>"], "upstreamFn": "striptags", "goFn": "striptags.StripTags", "deviation": "string form: /<(\\w*)>/ does not match \"</p>\" (the slash is not \\w) so upstream allows nothing; the port strips the slash" },
    { "id": "str-unterminated", "fn": "stripAllowedString", "args": ["<p>a</p>", "<p"], "upstreamFn": "striptags", "goFn": "striptags.StripTags", "note": "no closing bracket: neither side extracts a name" },
    { "id": "str-upper", "fn": "stripAllowedString", "args": ["<p>a</p>", "<P>"], "upstreamFn": "striptags", "goFn": "striptags.StripTags", "deviation": "string form: upstream keeps the extracted name's case, so \"<P>\" never matches the lower-cased tag name; the port lower-cases it" },
    { "id": "str-digits", "fn": "stripAllowedString", "args": ["<h1>a</h1>", "<h1>"], "upstreamFn": "striptags", "goFn": "striptags.StripTags", "note": "\\w covers digits, so h1 extracts on both sides" },
    { "id": "str-underscore", "fn": "stripAllowedString", "args": ["<my_tag>a</my_tag>", "<my_tag>"], "upstreamFn": "striptags", "goFn": "striptags.StripTags" },
    { "id": "str-hyphen", "fn": "stripAllowedString", "args": ["<my-tag>a</my-tag>", "<my-tag>"], "upstreamFn": "striptags", "goFn": "striptags.StripTags", "deviation": "string form: \"-\" is not \\w so upstream extracts nothing from \"<my-tag>\"; the port accepts the whole name, which is what a custom-element allowlist needs" }
  ]
}
