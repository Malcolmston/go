{
  "group": "decode",
  "upstream": "html-entities@2.6.0",
  "note": "decode(text, {level, scope}) and decodeEntity(entity, {level}). Defaults: level all, scope body (strict at level xml). Body scope accepts the legacy semicolon-less named references, which is exactly how a browser reads an HTML body.",
  "cases": [
    { "id": "dec-empty", "fn": "decode", "args": [""], "upstreamFn": "decode", "goFn": "htmlentities.Decode" },
    { "id": "dec-plain", "fn": "decode", "args": ["nothing to do here"], "upstreamFn": "decode", "goFn": "htmlentities.Decode" },
    { "id": "dec-specials", "fn": "decode", "args": ["&lt;a href=&quot;x&quot;&gt;Tom &amp; Jerry&apos;s"], "upstreamFn": "decode", "goFn": "htmlentities.Decode" },
    { "id": "dec-common-named", "fn": "decode", "args": ["&copy;&nbsp;&mdash;&ndash;&hellip;&trade;&reg;"], "upstreamFn": "decode", "goFn": "htmlentities.Decode" },
    { "id": "dec-rare-named", "fn": "decode", "args": ["&Zopf;&fjlig;&NotEqualTilde;&bnequiv;"], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "deep in the HTML5 table, including multi-code-point replacements" },
    { "id": "dec-uppercase-named", "fn": "decode", "args": ["&AMP;&LT;&GT;&QUOT;&COPY;"], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "the upper-case legacy spellings are distinct table entries" },
    { "id": "dec-unknown-named", "fn": "decode", "args": ["&unknownentity;&nosuch;"], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "left exactly as found" },
    { "id": "dec-bare-amp", "fn": "decode", "args": ["a & b"], "upstreamFn": "decode", "goFn": "htmlentities.Decode" },
    { "id": "dec-trailing-amp", "fn": "decode", "args": ["trailing &"], "upstreamFn": "decode", "goFn": "htmlentities.Decode" },
    { "id": "dec-incomplete", "fn": "decode", "args": ["&a"], "upstreamFn": "decode", "goFn": "htmlentities.Decode" },
    { "id": "dec-legacy-nosemi", "fn": "decode", "args": ["&amp&lt&gt"], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "body scope: the legacy semicolon-less forms DO decode" },
    { "id": "dec-legacy-nosemi-suffix", "fn": "decode", "args": ["&copyx"], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "the match is greedy over [0-9a-zA-Z]+, so \"copyx\" is looked up and fails; then the shorter legacy alternative wins" },
    { "id": "dec-legacy-not-in-list", "fn": "decode", "args": ["&Zopf"], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "only the legacy names may drop the semicolon; a modern name may not" },
    { "id": "dec-double-encoded", "fn": "decode", "args": ["&amp;lt;"], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "decode is a single pass: no second-order tag appears" },
    { "id": "dec-xss-roundtrip", "fn": "decode", "args": ["&lt;script&gt;alert(1)&lt;/script&gt;"], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "decoding is the dangerous direction; both sides must agree byte for byte" },
    { "id": "dec-decimal", "fn": "decode", "args": ["&#233;&#60;&#38;"], "upstreamFn": "decode", "goFn": "htmlentities.Decode" },
    { "id": "dec-hex-lower", "fn": "decode", "args": ["&#xe9;&#x3c;"], "upstreamFn": "decode", "goFn": "htmlentities.Decode" },
    { "id": "dec-hex-upper-x", "fn": "decode", "args": ["&#XE9;"], "upstreamFn": "decode", "goFn": "htmlentities.Decode" },
    { "id": "dec-decimal-astral", "fn": "decode", "args": ["&#128514;&#x1F600;"], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "above U+FFFF: upstream builds the surrogate pair, the port writes the rune" },
    { "id": "dec-decimal-leading-zeros", "fn": "decode", "args": ["&#0000233;"], "upstreamFn": "decode", "goFn": "htmlentities.Decode" },
    { "id": "dec-numeric-nosemi", "fn": "decode", "args": ["&#233 and &#x41 done"], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "body scope makes the semicolon optional for numeric references too" },
    { "id": "dec-numeric-nul", "fn": "decode", "args": ["&#0;"], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "NUL is remapped to U+FFFD, not passed through" },
    { "id": "dec-numeric-c1", "fn": "decode", "args": ["&#128;&#133;&#145;&#153;&#159;"], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "the Windows-1252 remapping of the C1 range that the HTML spec mandates" },
    { "id": "dec-numeric-c1-gap", "fn": "decode", "args": ["&#129;&#141;&#144;&#157;"], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "the C1 code points with no Windows-1252 counterpart are taken literally" },
    { "id": "dec-numeric-out-of-range", "fn": "decode", "args": ["&#x110000;&#1114111;"], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "upstream tests >= 0x10FFFF, so U+10FFFF itself becomes U+FFFD" },
    { "id": "dec-numeric-huge", "fn": "decode", "args": ["&#99999999999999999999;"], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "far beyond int64" },
    { "id": "dec-numeric-max-valid", "fn": "decode", "args": ["&#1114110;"], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "U+10FFFE is one below the cutoff and survives" },
    { "id": "dec-numeric-surrogate", "fn": "decode", "args": ["&#xD800;"], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "deviation": "a numeric reference to an unpaired surrogate: upstream's UTF-16 output keeps the lone surrogate, which a Go string cannot hold, so the port yields U+FFFD" },
    { "id": "dec-numeric-malformed", "fn": "decode", "args": ["&#zz;&#;&#x;&#-3;"], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "none of these match the reference pattern, so all pass through" },
    { "id": "dec-tab-newline-entities", "fn": "decode", "args": ["a&Tab;b&NewLine;c"], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "named entities whose replacement IS a control character" },
    { "id": "dec-long-name", "fn": "decode", "args": ["&aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa;"], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "a very long unknown name must not be truncated or partially consumed" },
    { "id": "dec-adjacent", "fn": "decode", "args": ["&amp;&amp;&#38;&#x26;"], "upstreamFn": "decode", "goFn": "htmlentities.Decode" },
    { "id": "dec-inside-text", "fn": "decode", "args": ["before&nbsp;middle&mdash;after"], "upstreamFn": "decode", "goFn": "htmlentities.Decode" },
    { "id": "dec-cjk-and-entity", "fn": "decode", "args": ["日本&copy;語"], "upstreamFn": "decode", "goFn": "htmlentities.Decode" },

    { "id": "dec-scope-body-explicit", "fn": "decode", "args": ["&amp", { "scope": "body" }], "upstreamFn": "decode", "goFn": "htmlentities.Decode" },
    { "id": "dec-scope-strict-nosemi", "fn": "decode", "args": ["&amp", { "scope": "strict" }], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "strict scope leaves a semicolon-less reference alone" },
    { "id": "dec-scope-strict-semi", "fn": "decode", "args": ["&amp;", { "scope": "strict" }], "upstreamFn": "decode", "goFn": "htmlentities.Decode" },
    { "id": "dec-scope-strict-legacy-name", "fn": "decode", "args": ["&copy &copy;", { "scope": "strict" }], "upstreamFn": "decode", "goFn": "htmlentities.Decode" },
    { "id": "dec-scope-attribute-equals", "fn": "decode", "args": ["?a&copy=1", { "scope": "attribute" }], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "the HTML attribute rule: a reference followed by = is not a reference" },
    { "id": "dec-scope-attribute-semi", "fn": "decode", "args": ["?a&copy;=1", { "scope": "attribute" }], "upstreamFn": "decode", "goFn": "htmlentities.Decode" },
    { "id": "dec-scope-attribute-nosemi", "fn": "decode", "args": ["?a&copy&b", { "scope": "attribute" }], "upstreamFn": "decode", "goFn": "htmlentities.Decode" },
    { "id": "dec-scope-body-equals", "fn": "decode", "args": ["?a&copy=1", { "scope": "body" }], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "body scope has no = rule, so this DOES decode" },

    { "id": "dec-level-xml-default-scope", "fn": "decode", "args": ["&copy;&amp;&amp", { "level": "xml" }], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "level xml defaults to strict scope and knows only the five XML entities" },
    { "id": "dec-level-xml-body", "fn": "decode", "args": ["&amp&copy;", { "level": "xml", "scope": "body" }], "upstreamFn": "decode", "goFn": "htmlentities.Decode" },
    { "id": "dec-level-html4", "fn": "decode", "args": ["&copy;&mdash;&Zopf;", { "level": "html4" }], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "html4 has &copy; but not &mdash;'s HTML5 siblings" },
    { "id": "dec-level-html4-nosemi", "fn": "decode", "args": ["&copy&notin;", { "level": "html4" }], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "the html4 body pattern lists &notin; specially" },
    { "id": "dec-level-html5", "fn": "decode", "args": ["&copy;&mdash;&Zopf;", { "level": "html5" }], "upstreamFn": "decode", "goFn": "htmlentities.Decode" },
    { "id": "dec-level-all", "fn": "decode", "args": ["&copy;&mdash;&Zopf;", { "level": "all" }], "upstreamFn": "decode", "goFn": "htmlentities.Decode" },
    { "id": "dec-level-html5-ambiguous", "fn": "decode", "args": ["&notin;&notindot;&ltcc;&gtcc;", { "level": "html5" }], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "note": "the names the upstream body pattern has to list ahead of the generic alternative" },
    { "id": "dec-unknown-level", "fn": "decode", "args": ["&copy;", { "level": "notALevel" }], "upstreamFn": "decode", "goFn": "htmlentities.Decode", "deviation": "an unrecognized level is undefined behaviour upstream (the regex table lookup yields undefined and String.replace throws); the port falls back to level all" },
    { "id": "dec-empty-options", "fn": "decode", "args": ["&amp", {}], "upstreamFn": "decode", "goFn": "htmlentities.Decode" },

    { "id": "ent-named", "fn": "decodeEntity", "args": ["&copy;"], "upstreamFn": "decodeEntity", "goFn": "htmlentities.DecodeEntity" },
    { "id": "ent-decimal", "fn": "decodeEntity", "args": ["&#233;"], "upstreamFn": "decodeEntity", "goFn": "htmlentities.DecodeEntity" },
    { "id": "ent-hex", "fn": "decodeEntity", "args": ["&#xe9;"], "upstreamFn": "decodeEntity", "goFn": "htmlentities.DecodeEntity" },
    { "id": "ent-unknown", "fn": "decodeEntity", "args": ["&zzz;"], "upstreamFn": "decodeEntity", "goFn": "htmlentities.DecodeEntity" },
    { "id": "ent-nosemi", "fn": "decodeEntity", "args": ["&amp"], "upstreamFn": "decodeEntity", "goFn": "htmlentities.DecodeEntity", "note": "decodeEntity ignores the scope rules entirely" },
    { "id": "ent-empty", "fn": "decodeEntity", "args": [""], "upstreamFn": "decodeEntity", "goFn": "htmlentities.DecodeEntity" },
    { "id": "ent-not-an-entity", "fn": "decodeEntity", "args": ["plain"], "upstreamFn": "decodeEntity", "goFn": "htmlentities.DecodeEntity" },
    { "id": "ent-level-xml", "fn": "decodeEntity", "args": ["&copy;", { "level": "xml" }], "upstreamFn": "decodeEntity", "goFn": "htmlentities.DecodeEntity" },
    { "id": "ent-level-html4", "fn": "decodeEntity", "args": ["&Zopf;", { "level": "html4" }], "upstreamFn": "decodeEntity", "goFn": "htmlentities.DecodeEntity" },
    { "id": "ent-out-of-range", "fn": "decodeEntity", "args": ["&#x110000;"], "upstreamFn": "decodeEntity", "goFn": "htmlentities.DecodeEntity" },
    { "id": "ent-astral", "fn": "decodeEntity", "args": ["&#128514;"], "upstreamFn": "decodeEntity", "goFn": "htmlentities.DecodeEntity" },
    { "id": "ent-hash-only", "fn": "decodeEntity", "args": ["&#;"], "upstreamFn": "decodeEntity", "goFn": "htmlentities.DecodeEntity", "note": "upstream reaches String.fromCharCode(NaN), which is U+0000; the port reproduces that" },
    { "id": "ent-hex-empty", "fn": "decodeEntity", "args": ["&#x;"], "upstreamFn": "decodeEntity", "goFn": "htmlentities.DecodeEntity", "note": "same NaN path via the hex branch" },

    { "id": "rt-specials", "fn": "roundTrip", "args": ["<a href=\"x\">Tom & Jerry's</a>"], "upstreamFn": "encode/decode", "goFn": "htmlentities.Encode/Decode" },
    { "id": "rt-nonascii", "fn": "roundTrip", "args": ["café © 日本 😂", { "mode": "nonAscii" }], "upstreamFn": "encode/decode", "goFn": "htmlentities.Encode/Decode" },
    { "id": "rt-nonascii-xml", "fn": "roundTrip", "args": ["café ©", { "mode": "nonAscii", "level": "xml" }], "upstreamFn": "encode/decode", "goFn": "htmlentities.Encode/Decode" },
    { "id": "rt-extensive", "fn": "roundTrip", "args": ["a<b>&\"'-!@#", { "mode": "extensive" }], "upstreamFn": "encode/decode", "goFn": "htmlentities.Encode/Decode" },
    { "id": "rt-hex", "fn": "roundTrip", "args": ["é😂", { "mode": "nonAscii", "level": "xml", "numeric": "hexadecimal" }], "upstreamFn": "encode/decode", "goFn": "htmlentities.Encode/Decode" },
    { "id": "rt-already-entity", "fn": "roundTrip", "args": ["&amp; &lt;"], "upstreamFn": "encode/decode", "goFn": "htmlentities.Encode/Decode", "note": "double-encoding then decoding once must NOT come back to raw markup" }
  ]
}
