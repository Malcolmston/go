{
  "group": "inc",
  "upstream": "semver@7.8.5",
  "note": "inc() at every release level. The subtle rules: \"major\"/\"minor\"/\"patch\" on a prerelease of an otherwise-unreleased version just drop the prerelease (inc(\"1.0.0-1\",\"major\") is \"1.0.0\"), while the pre* levels always bump their field first (inc(\"1.0.0-1\",\"premajor\") is \"2.0.0-0\"). \"release\" needs an existing prerelease. An unusable input makes upstream return null, mapped to a failure on both sides.",
  "cases": [
    { "id": "i-major",            "fn": "inc",   "args": ["1.2.3", "major"],            "upstreamFn": "semver.inc", "goFn": "semver.Inc" },
    { "id": "i-major-from-pre",   "fn": "inc",   "args": ["1.0.0-1", "major"],          "upstreamFn": "semver.inc", "goFn": "semver.Inc", "note": "already an unreleased 1.0.0: no bump" },
    { "id": "i-major-pre-minor",  "fn": "inc",   "args": ["1.2.0-1", "major"],          "upstreamFn": "semver.inc", "goFn": "semver.Inc", "note": "minor is non-zero, so major does bump" },
    { "id": "i-major-pre-patch",  "fn": "inc",   "args": ["1.0.4-1", "major"],          "upstreamFn": "semver.inc", "goFn": "semver.Inc" },
    { "id": "i-minor",            "fn": "inc",   "args": ["1.2.3", "minor"],            "upstreamFn": "semver.inc", "goFn": "semver.Inc" },
    { "id": "i-minor-from-pre",   "fn": "inc",   "args": ["1.2.0-0", "minor"],          "upstreamFn": "semver.inc", "goFn": "semver.Inc", "note": "no bump: 1.2.0 was never released" },
    { "id": "i-minor-pre-patch",  "fn": "inc",   "args": ["1.2.4-0", "minor"],          "upstreamFn": "semver.inc", "goFn": "semver.Inc" },
    { "id": "i-patch",            "fn": "inc",   "args": ["1.2.3", "patch"],            "upstreamFn": "semver.inc", "goFn": "semver.Inc" },
    { "id": "i-patch-from-pre",   "fn": "inc",   "args": ["1.2.3-0", "patch"],          "upstreamFn": "semver.inc", "goFn": "semver.Inc", "note": "a prerelease just becomes its release" },
    { "id": "i-patch-build",      "fn": "inc",   "args": ["1.2.3+build.9", "patch"],    "upstreamFn": "semver.inc", "goFn": "semver.Inc", "note": "build metadata is cleared" },
    { "id": "i-premajor",         "fn": "inc",   "args": ["1.2.3", "premajor"],         "upstreamFn": "semver.inc", "goFn": "semver.Inc" },
    { "id": "i-premajor-frompre", "fn": "inc",   "args": ["1.0.0-1", "premajor"],       "upstreamFn": "semver.inc", "goFn": "semver.Inc", "note": "contrast with i-major-from-pre: premajor always bumps" },
    { "id": "i-preminor",         "fn": "inc",   "args": ["1.2.3", "preminor"],         "upstreamFn": "semver.inc", "goFn": "semver.Inc" },
    { "id": "i-preminor-frompre", "fn": "inc",   "args": ["1.2.0-1", "preminor"],       "upstreamFn": "semver.inc", "goFn": "semver.Inc" },
    { "id": "i-prepatch",         "fn": "inc",   "args": ["1.2.3", "prepatch"],         "upstreamFn": "semver.inc", "goFn": "semver.Inc" },
    { "id": "i-prepatch-frompre", "fn": "inc",   "args": ["1.2.3-4", "prepatch"],       "upstreamFn": "semver.inc", "goFn": "semver.Inc", "note": "the prerelease is dropped before the patch bump" },
    { "id": "i-prerelease-plain", "fn": "inc",   "args": ["1.2.3", "prerelease"],       "upstreamFn": "semver.inc", "goFn": "semver.Inc", "note": "acts like prepatch on a release version" },
    { "id": "i-prerelease-num",   "fn": "inc",   "args": ["1.2.3-0", "prerelease"],     "upstreamFn": "semver.inc", "goFn": "semver.Inc" },
    { "id": "i-prerelease-named", "fn": "inc",   "args": ["1.2.3-beta.0", "prerelease"],"upstreamFn": "semver.inc", "goFn": "semver.Inc" },
    { "id": "i-prerelease-nonum", "fn": "inc",   "args": ["1.2.3-beta", "prerelease"],  "upstreamFn": "semver.inc", "goFn": "semver.Inc", "note": "no numeric identifier to bump: one is appended" },
    { "id": "i-prerelease-mid",   "fn": "inc",   "args": ["1.2.3-1.beta", "prerelease"],"upstreamFn": "semver.inc", "goFn": "semver.Inc", "note": "the rightmost numeric identifier is the counter" },
    { "id": "i-prerelease-9",     "fn": "inc",   "args": ["1.2.3-a.9", "prerelease"],   "upstreamFn": "semver.inc", "goFn": "semver.Inc" },
    { "id": "i-release",          "fn": "inc",   "args": ["1.2.3-rc.1", "release"],     "upstreamFn": "semver.inc", "goFn": "semver.Inc" },
    { "id": "i-release-nopre",    "fn": "inc",   "args": ["1.2.3", "release"],          "upstreamFn": "semver.inc", "goFn": "semver.Inc", "note": "upstream returns null, the port errors" },
    { "id": "i-bogus-level",      "fn": "inc",   "args": ["1.2.3", "bogus"],            "upstreamFn": "semver.inc", "goFn": "semver.Inc" },
    { "id": "i-empty-level",      "fn": "inc",   "args": ["1.2.3", ""],                 "upstreamFn": "semver.inc", "goFn": "semver.Inc" },
    { "id": "i-invalid-version",  "fn": "inc",   "args": ["1.2", "patch"],              "upstreamFn": "semver.inc", "goFn": "semver.Inc" },
    { "id": "i-v-prefix",         "fn": "inc",   "args": ["v1.2.3", "patch"],           "upstreamFn": "semver.inc", "goFn": "semver.Inc" },
    { "id": "id-premajor-beta",   "fn": "incId", "args": ["1.2.3", "premajor", "beta"],      "upstreamFn": "semver.inc", "goFn": "semver.IncWith" },
    { "id": "id-preminor-beta",   "fn": "incId", "args": ["1.2.3", "preminor", "beta"],      "upstreamFn": "semver.inc", "goFn": "semver.IncWith" },
    { "id": "id-prepatch-beta",   "fn": "incId", "args": ["1.2.3", "prepatch", "beta"],      "upstreamFn": "semver.inc", "goFn": "semver.IncWith" },
    { "id": "id-prerel-same",     "fn": "incId", "args": ["1.2.4-beta.0", "prerelease", "beta"], "upstreamFn": "semver.inc", "goFn": "semver.IncWith", "note": "same identifier: only the counter advances" },
    { "id": "id-prerel-other",    "fn": "incId", "args": ["1.2.4-beta.0", "prerelease", "alpha"], "upstreamFn": "semver.inc", "goFn": "semver.IncWith", "note": "different identifier: restart at .0" },
    { "id": "id-prerel-nonum",    "fn": "incId", "args": ["1.2.4-beta", "prerelease", "beta"],    "upstreamFn": "semver.inc", "goFn": "semver.IncWith" },
    { "id": "id-prerel-fresh",    "fn": "incId", "args": ["1.2.3", "prerelease", "rc"],      "upstreamFn": "semver.inc", "goFn": "semver.IncWith" },
    { "id": "id-prerel-numeric",  "fn": "incId", "args": ["1.2.3", "prerelease", "0"],       "upstreamFn": "semver.inc", "goFn": "semver.IncWith", "note": "a numeric identifier is still just an identifier" },
    { "id": "id-single-char",     "fn": "incId", "args": ["1.2.3", "prepatch", "x"],         "upstreamFn": "semver.inc", "goFn": "semver.IncWith" },
    { "id": "id-major-ignores",   "fn": "incId", "args": ["1.2.3", "major", "beta"],         "upstreamFn": "semver.inc", "goFn": "semver.IncWith", "note": "a non-pre level ignores the identifier" },
    { "id": "id-release-ignores", "fn": "incId", "args": ["1.2.3-rc.1", "release", "beta"],  "upstreamFn": "semver.inc", "goFn": "semver.IncWith" },
    { "id": "id-bad-identifier",  "fn": "incId", "args": ["1.2.3", "prepatch", "bad id"],    "upstreamFn": "semver.inc", "goFn": "semver.IncWith", "note": "an identifier that is not a legal prerelease identifier" },
    { "id": "im-major",           "fn": "incMajorMethod", "args": ["1.2.3"],           "upstreamFn": "SemVer#inc", "goFn": "Version.IncMajor" },
    { "id": "im-major-pre",       "fn": "incMajorMethod", "args": ["2.0.0-alpha.1"],   "upstreamFn": "SemVer#inc", "goFn": "Version.IncMajor" },
    { "id": "im-minor",           "fn": "incMinorMethod", "args": ["1.2.3"],           "upstreamFn": "SemVer#inc", "goFn": "Version.IncMinor" },
    { "id": "im-minor-pre",       "fn": "incMinorMethod", "args": ["1.3.0-alpha.1"],   "upstreamFn": "SemVer#inc", "goFn": "Version.IncMinor" },
    { "id": "im-patch",           "fn": "incPatchMethod", "args": ["1.2.3"],           "upstreamFn": "SemVer#inc", "goFn": "Version.IncPatch" },
    { "id": "im-patch-pre",       "fn": "incPatchMethod", "args": ["1.2.4-alpha.1"],   "upstreamFn": "SemVer#inc", "goFn": "Version.IncPatch" },
    { "id": "im-patch-invalid",   "fn": "incPatchMethod", "args": ["nope"],            "upstreamFn": "SemVer#inc", "goFn": "Version.IncPatch" }
  ]
}
