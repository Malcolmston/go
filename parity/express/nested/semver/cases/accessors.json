{
  "group": "accessors",
  "upstream": "semver@7.8.5",
  "note": "Field accessors, Core and clean. prerelease() returns an array upstream (numeric identifiers as numbers) and null when there is none; the runners join it with \".\" and map null to a failure so it compares against the port's string return. clean() is deliberately looser than parse(): it strips leading \"=\" and \"v\" characters and surrounding whitespace first.",
  "cases": [
    { "id": "a-major",         "fn": "major",      "args": ["1.2.3"],              "upstreamFn": "semver.major",      "goFn": "semver.Major" },
    { "id": "a-major-pre",     "fn": "major",      "args": ["7.0.0-rc.1+b"],       "upstreamFn": "semver.major",      "goFn": "semver.Major" },
    { "id": "a-major-big",     "fn": "major",      "args": ["9007199254740991.1.2"], "upstreamFn": "semver.major",    "goFn": "semver.Major", "note": "MAX_SAFE_INTEGER survives the JSON round trip exactly" },
    { "id": "a-major-invalid", "fn": "major",      "args": ["1.2"],                "upstreamFn": "semver.major",      "goFn": "semver.Major" },
    { "id": "a-minor",         "fn": "minor",      "args": ["1.2.3"],              "upstreamFn": "semver.minor",      "goFn": "semver.Minor" },
    { "id": "a-minor-zero",    "fn": "minor",      "args": ["v4.0.9"],             "upstreamFn": "semver.minor",      "goFn": "semver.Minor" },
    { "id": "a-minor-invalid", "fn": "minor",      "args": ["oops"],               "upstreamFn": "semver.minor",      "goFn": "semver.Minor" },
    { "id": "a-patch",         "fn": "patch",      "args": ["1.2.3"],              "upstreamFn": "semver.patch",      "goFn": "semver.Patch" },
    { "id": "a-patch-pre",     "fn": "patch",      "args": ["1.2.3-0"],            "upstreamFn": "semver.patch",      "goFn": "semver.Patch" },
    { "id": "a-patch-invalid", "fn": "patch",      "args": [""],                   "upstreamFn": "semver.patch",      "goFn": "semver.Patch" },
    { "id": "a-pre-one",       "fn": "prerelease", "args": ["1.2.3-alpha"],        "upstreamFn": "semver.prerelease", "goFn": "semver.Prerelease" },
    { "id": "a-pre-mixed",     "fn": "prerelease", "args": ["1.2.3-alpha.1"],      "upstreamFn": "semver.prerelease", "goFn": "semver.Prerelease" },
    { "id": "a-pre-numeric",   "fn": "prerelease", "args": ["1.2.3-0.1.2"],        "upstreamFn": "semver.prerelease", "goFn": "semver.Prerelease" },
    { "id": "a-pre-with-build","fn": "prerelease", "args": ["1.2.3-rc.1+build.9"], "upstreamFn": "semver.prerelease", "goFn": "semver.Prerelease", "note": "build metadata is not part of the prerelease" },
    { "id": "a-pre-none",      "fn": "prerelease", "args": ["1.2.3"],              "upstreamFn": "semver.prerelease", "goFn": "semver.Prerelease", "note": "upstream null vs the port's empty string: both mapped to a failure" },
    { "id": "a-pre-invalid",   "fn": "prerelease", "args": ["nope"],               "upstreamFn": "semver.prerelease", "goFn": "semver.Prerelease" },
    { "id": "a-core-plain",    "fn": "core",       "args": ["1.2.3"],              "upstreamFn": "SemVer#major/minor/patch", "goFn": "Version.Core" },
    { "id": "a-core-pre",      "fn": "core",       "args": ["1.2.3-rc.1+b.2"],     "upstreamFn": "SemVer#major/minor/patch", "goFn": "Version.Core" },
    { "id": "a-core-invalid",  "fn": "core",       "args": ["1.2.3.4"],            "upstreamFn": "SemVer#major/minor/patch", "goFn": "Version.Core" },
    { "id": "cl-plain",        "fn": "clean",      "args": ["1.2.3"],              "upstreamFn": "semver.clean",      "goFn": "semver.Clean" },
    { "id": "cl-spaces",       "fn": "clean",      "args": ["  1.2.3  "],          "upstreamFn": "semver.clean",      "goFn": "semver.Clean" },
    { "id": "cl-v",            "fn": "clean",      "args": ["v1.2.3"],             "upstreamFn": "semver.clean",      "goFn": "semver.Clean" },
    { "id": "cl-eq-v",         "fn": "clean",      "args": ["=v1.2.3"],            "upstreamFn": "semver.clean",      "goFn": "semver.Clean", "note": "clean strips any run of leading = and v" },
    { "id": "cl-eq",           "fn": "clean",      "args": [" =1.2.3 "],           "upstreamFn": "semver.clean",      "goFn": "semver.Clean" },
    { "id": "cl-build",        "fn": "clean",      "args": ["1.2.3+build.1"],      "upstreamFn": "semver.clean",      "goFn": "semver.Clean", "note": "upstream clean() drops build metadata", "deviation": "the port's canonical rendering keeps build metadata (Version.String, and Clean which builds on it); node-semver's SemVer#version drops it and keeps the original text in .raw, which the Go type has no equivalent of" },
    { "id": "cl-pre",          "fn": "clean",      "args": ["v1.2.3-rc.1"],        "upstreamFn": "semver.clean",      "goFn": "semver.Clean" },
    { "id": "cl-partial",      "fn": "clean",      "args": ["1.2"],                "upstreamFn": "semver.clean",      "goFn": "semver.Clean", "note": "clean does not fill in missing fields" },
    { "id": "cl-range",        "fn": "clean",      "args": ["^1.2.3"],             "upstreamFn": "semver.clean",      "goFn": "semver.Clean" },
    { "id": "cl-garbage",      "fn": "clean",      "args": ["release 1.2.3"],      "upstreamFn": "semver.clean",      "goFn": "semver.Clean" },
    { "id": "cl-uppercase-v",  "fn": "clean",      "args": ["V1.2.3"],             "upstreamFn": "semver.clean",      "goFn": "semver.Clean", "note": "clean's strip set is [=v], lowercase only" }
  ]
}
