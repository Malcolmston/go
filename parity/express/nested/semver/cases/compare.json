{
  "group": "compare",
  "upstream": "semver@7.8.5",
  "note": "Precedence: numeric fields numerically, a prerelease ranks below its release, prerelease identifiers left to right (numeric numerically, alphanumeric in ASCII order, numeric below alphanumeric, shorter set below longer), build metadata ignored entirely. Upstream throws on an invalid version here; the port panics from MustParse, which the runner reports as a failure.",
  "cases": [
    { "id": "c-major",          "fn": "compare",       "args": ["2.0.0", "1.9.9"],                  "upstreamFn": "semver.compare",  "goFn": "semver.Compare" },
    { "id": "c-minor",          "fn": "compare",       "args": ["1.2.0", "1.10.0"],                 "upstreamFn": "semver.compare",  "goFn": "semver.Compare", "note": "numeric, not lexical: 2 < 10" },
    { "id": "c-patch",          "fn": "compare",       "args": ["1.2.3", "1.2.4"],                  "upstreamFn": "semver.compare",  "goFn": "semver.Compare" },
    { "id": "c-equal",          "fn": "compare",       "args": ["1.2.3", "1.2.3"],                  "upstreamFn": "semver.compare",  "goFn": "semver.Compare" },
    { "id": "c-v-prefix",       "fn": "compare",       "args": ["v1.2.3", "1.2.3"],                 "upstreamFn": "semver.compare",  "goFn": "semver.Compare" },
    { "id": "c-build-ignored",  "fn": "compare",       "args": ["1.2.3+a", "1.2.3+b"],              "upstreamFn": "semver.compare",  "goFn": "semver.Compare", "note": "build metadata never affects precedence" },
    { "id": "c-build-vs-none",  "fn": "compare",       "args": ["1.2.3+a", "1.2.3"],                "upstreamFn": "semver.compare",  "goFn": "semver.Compare" },
    { "id": "c-pre-below",      "fn": "compare",       "args": ["1.2.3-alpha", "1.2.3"],            "upstreamFn": "semver.compare",  "goFn": "semver.Compare" },
    { "id": "c-pre-alpha-beta", "fn": "compare",       "args": ["1.2.3-alpha", "1.2.3-beta"],       "upstreamFn": "semver.compare",  "goFn": "semver.Compare" },
    { "id": "c-pre-num",        "fn": "compare",       "args": ["1.2.3-2", "1.2.3-10"],             "upstreamFn": "semver.compare",  "goFn": "semver.Compare", "note": "numeric identifiers compare numerically" },
    { "id": "c-pre-num-vs-alp", "fn": "compare",       "args": ["1.2.3-1", "1.2.3-alpha"],          "upstreamFn": "semver.compare",  "goFn": "semver.Compare", "note": "numeric ranks below alphanumeric" },
    { "id": "c-pre-shorter",    "fn": "compare",       "args": ["1.2.3-alpha", "1.2.3-alpha.1"],    "upstreamFn": "semver.compare",  "goFn": "semver.Compare", "note": "a shorter identifier set ranks lower" },
    { "id": "c-pre-ascii",      "fn": "compare",       "args": ["1.2.3-Alpha", "1.2.3-alpha"],      "upstreamFn": "semver.compare",  "goFn": "semver.Compare", "note": "ASCII order: uppercase sorts first" },
    { "id": "c-pre-rc-vs-beta", "fn": "compare",       "args": ["1.0.0-rc.1", "1.0.0-beta.11"],     "upstreamFn": "semver.compare",  "goFn": "semver.Compare" },
    { "id": "c-pre-beta-nums",  "fn": "compare",       "args": ["1.0.0-beta.2", "1.0.0-beta.11"],   "upstreamFn": "semver.compare",  "goFn": "semver.Compare" },
    { "id": "c-big-fields",     "fn": "compare",       "args": ["9007199254740991.0.0", "1.0.0"],   "upstreamFn": "semver.compare",  "goFn": "semver.Compare", "note": "MAX_SAFE_INTEGER major must not overflow the comparison" },
    { "id": "c-invalid-left",   "fn": "compare",       "args": ["bogus", "1.2.3"],                  "upstreamFn": "semver.compare",  "goFn": "semver.Compare", "note": "both sides must fail" },
    { "id": "c-invalid-right",  "fn": "compare",       "args": ["1.2.3", "1.2"],                    "upstreamFn": "semver.compare",  "goFn": "semver.Compare" },
    { "id": "rc-major",         "fn": "rcompare",      "args": ["2.0.0", "1.9.9"],                  "upstreamFn": "semver.rcompare", "goFn": "-semver.Compare" },
    { "id": "rc-equal",         "fn": "rcompare",      "args": ["1.2.3", "1.2.3+x"],                "upstreamFn": "semver.rcompare", "goFn": "-semver.Compare" },
    { "id": "rc-pre",           "fn": "rcompare",      "args": ["1.0.0-alpha", "1.0.0"],            "upstreamFn": "semver.rcompare", "goFn": "-semver.Compare" },
    { "id": "cm-method-lt",     "fn": "compareMethod", "args": ["1.2.3", "1.2.4"],                  "upstreamFn": "SemVer#compare",  "goFn": "Version.Compare" },
    { "id": "cm-method-eq",     "fn": "compareMethod", "args": ["1.2.3-a.1", "1.2.3-a.1"],          "upstreamFn": "SemVer#compare",  "goFn": "Version.Compare" },
    { "id": "cm-method-gt",     "fn": "compareMethod", "args": ["1.2.3", "1.2.3-rc.1"],             "upstreamFn": "SemVer#compare",  "goFn": "Version.Compare" },
    { "id": "b-gt-true",        "fn": "gt",            "args": ["1.2.4", "1.2.3"],                  "upstreamFn": "semver.gt",       "goFn": "semver.GT" },
    { "id": "b-gt-false",       "fn": "gt",            "args": ["1.2.3", "1.2.3"],                  "upstreamFn": "semver.gt",       "goFn": "semver.GT" },
    { "id": "b-gt-pre",         "fn": "gt",            "args": ["1.2.3", "1.2.3-rc"],               "upstreamFn": "semver.gt",       "goFn": "semver.GT" },
    { "id": "b-gte-eq",         "fn": "gte",           "args": ["1.2.3", "1.2.3"],                  "upstreamFn": "semver.gte",      "goFn": "semver.GTE" },
    { "id": "b-gte-false",      "fn": "gte",           "args": ["1.2.3", "1.2.4"],                  "upstreamFn": "semver.gte",      "goFn": "semver.GTE" },
    { "id": "b-lt-true",        "fn": "lt",            "args": ["1.2.3", "1.10.0"],                 "upstreamFn": "semver.lt",       "goFn": "semver.LT" },
    { "id": "b-lt-false",       "fn": "lt",            "args": ["1.10.0", "1.2.3"],                 "upstreamFn": "semver.lt",       "goFn": "semver.LT" },
    { "id": "b-lte-eq",         "fn": "lte",           "args": ["1.2.3+b", "1.2.3"],                "upstreamFn": "semver.lte",      "goFn": "semver.LTE" },
    { "id": "b-lte-false",      "fn": "lte",           "args": ["2.0.0", "1.2.3"],                  "upstreamFn": "semver.lte",      "goFn": "semver.LTE" },
    { "id": "b-eq-build",       "fn": "eq",            "args": ["1.2.3+a", "1.2.3+b"],              "upstreamFn": "semver.eq",       "goFn": "semver.EQ" },
    { "id": "b-eq-false",       "fn": "eq",            "args": ["1.2.3-a", "1.2.3"],                "upstreamFn": "semver.eq",       "goFn": "semver.EQ" },
    { "id": "b-neq-true",       "fn": "neq",           "args": ["1.2.3", "1.2.4"],                  "upstreamFn": "semver.neq",      "goFn": "semver.NEQ" },
    { "id": "b-neq-false",      "fn": "neq",           "args": ["v1.2.3", "1.2.3"],                 "upstreamFn": "semver.neq",      "goFn": "semver.NEQ" },
    { "id": "b-eq-invalid",     "fn": "eq",            "args": ["1.2.3", "nope"],                   "upstreamFn": "semver.eq",       "goFn": "semver.EQ", "note": "both sides must fail" },
    { "id": "m-lessthan",       "fn": "lessThan",      "args": ["1.0.0-alpha.1", "1.0.0-alpha.2"],  "upstreamFn": "SemVer#compare",  "goFn": "Version.LessThan" },
    { "id": "m-lessthan-false", "fn": "lessThan",      "args": ["1.0.0", "1.0.0-alpha.2"],          "upstreamFn": "SemVer#compare",  "goFn": "Version.LessThan" },
    { "id": "m-greaterthan",    "fn": "greaterThan",   "args": ["1.0.1", "1.0.0"],                  "upstreamFn": "SemVer#compare",  "goFn": "Version.GreaterThan" },
    { "id": "m-greater-false",  "fn": "greaterThan",   "args": ["1.0.0+z", "1.0.0"],                "upstreamFn": "SemVer#compare",  "goFn": "Version.GreaterThan" },
    { "id": "m-equal",          "fn": "equalVersion",  "args": ["1.0.0+z", "1.0.0+y"],              "upstreamFn": "SemVer#compare",  "goFn": "Version.Equal" },
    { "id": "m-equal-false",    "fn": "equalVersion",  "args": ["1.0.0-0", "1.0.0"],                "upstreamFn": "SemVer#compare",  "goFn": "Version.Equal" },
    { "id": "s-sort-basic",     "fn": "sort",          "args": [["2.0.0", "1.0.0", "1.10.0", "1.2.0"]],                    "upstreamFn": "semver.sort", "goFn": "semver.Sort" },
    { "id": "s-sort-pre",       "fn": "sort",          "args": [["1.0.0", "1.0.0-rc.1", "1.0.0-beta.11", "1.0.0-alpha"]],  "upstreamFn": "semver.sort", "goFn": "semver.Sort" },
    { "id": "s-sort-build",     "fn": "sort",          "args": [["1.0.0+b", "1.0.0+a"]],                                   "upstreamFn": "semver.sort", "goFn": "semver.Sort", "note": "sort() breaks precedence ties with compareBuild, so +a sorts before +b" },
    { "id": "s-sort-vprefix",   "fn": "sort",          "args": [["v3.0.0", "2.0.0", "v1.0.0"]],                            "upstreamFn": "semver.sort", "goFn": "semver.Sort" },
    { "id": "s-sort-empty",     "fn": "sort",          "args": [[]],                                                       "upstreamFn": "semver.sort", "goFn": "semver.Sort" },
    { "id": "s-sort-one",       "fn": "sort",          "args": [["1.2.3"]],                                                "upstreamFn": "semver.sort", "goFn": "semver.Sort" },
    { "id": "s-sort-invalid",   "fn": "sort",          "args": [["1.2.3", "nope"]],                                        "upstreamFn": "semver.sort", "goFn": "semver.Sort", "note": "upstream throws, the port panics from MustParse: both must fail" }
  ]
}
