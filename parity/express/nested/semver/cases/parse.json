{
  "group": "parse",
  "upstream": "semver@7.8.5",
  "note": "Version parsing and validity. Upstream's strict parse() accepts an optional lowercase leading \"v\" and trims surrounding whitespace, but rejects \"=\" prefixes, an uppercase \"V\", partial versions, leading zeros in a numeric field, empty prerelease/build sections, components above Number.MAX_SAFE_INTEGER, and strings longer than MAX_LENGTH (256). valid() returning null is mapped to a failure on both sides.",
  "cases": [
    { "id": "p-basic",           "fn": "valid",         "args": ["1.2.3"],                     "upstreamFn": "semver.valid", "goFn": "semver.Parse" },
    { "id": "p-zero",            "fn": "valid",         "args": ["0.0.0"],                     "upstreamFn": "semver.valid", "goFn": "semver.Parse" },
    { "id": "p-lead-v",          "fn": "valid",         "args": ["v1.2.3"],                    "upstreamFn": "semver.valid", "goFn": "semver.Parse", "note": "lowercase v is allowed" },
    { "id": "p-lead-V",          "fn": "valid",         "args": ["V1.2.3"],                    "upstreamFn": "semver.valid", "goFn": "semver.Parse", "note": "the FULL regex is v?, lowercase only: upstream rejects" },
    { "id": "p-lead-eq",         "fn": "valid",         "args": ["=1.2.3"],                    "upstreamFn": "semver.valid", "goFn": "semver.Parse", "note": "\"=\" is a loose-mode prefix only; strict parse rejects it" },
    { "id": "p-lead-eq-v",       "fn": "valid",         "args": ["=v1.2.3"],                   "upstreamFn": "semver.valid", "goFn": "semver.Parse" },
    { "id": "p-space-both",      "fn": "valid",         "args": ["  1.2.3  "],                 "upstreamFn": "semver.valid", "goFn": "semver.Parse", "note": "parse trims" },
    { "id": "p-space-inner",     "fn": "valid",         "args": ["1. 2.3"],                    "upstreamFn": "semver.valid", "goFn": "semver.Parse" },
    { "id": "p-tab",            "fn": "valid",          "args": ["\t1.2.3\n"],                 "upstreamFn": "semver.valid", "goFn": "semver.Parse" },
    { "id": "p-build",           "fn": "valid",         "args": ["1.2.3+build.5"],             "upstreamFn": "semver.valid", "goFn": "semver.Parse", "note": "valid() drops build metadata from its answer", "deviation": "the port's canonical rendering keeps build metadata (Version.String, and Clean which builds on it); node-semver's SemVer#version drops it and keeps the original text in .raw, which the Go type has no equivalent of" },
    { "id": "p-build-only-dash", "fn": "valid",         "args": ["1.2.3+---"],                 "upstreamFn": "semver.valid", "goFn": "semver.Parse", "deviation": "the port's canonical rendering keeps build metadata (Version.String, and Clean which builds on it); node-semver's SemVer#version drops it and keeps the original text in .raw, which the Go type has no equivalent of" },
    { "id": "p-build-empty",     "fn": "valid",         "args": ["1.2.3+"],                    "upstreamFn": "semver.valid", "goFn": "semver.Parse" },
    { "id": "p-build-dot-empty", "fn": "valid",         "args": ["1.2.3+a..b"],                "upstreamFn": "semver.valid", "goFn": "semver.Parse" },
    { "id": "p-build-bang",      "fn": "valid",         "args": ["1.2.3+a!b"],                 "upstreamFn": "semver.valid", "goFn": "semver.Parse" },
    { "id": "p-build-leadzero",  "fn": "valid",         "args": ["1.2.3+007"],                 "upstreamFn": "semver.valid", "goFn": "semver.Parse", "note": "build identifiers may have leading zeros", "deviation": "the port's canonical rendering keeps build metadata (Version.String, and Clean which builds on it); node-semver's SemVer#version drops it and keeps the original text in .raw, which the Go type has no equivalent of" },
    { "id": "p-pre-alpha",       "fn": "versionString", "args": ["1.2.3-alpha"],               "upstreamFn": "semver.parse", "goFn": "semver.Parse" },
    { "id": "p-pre-dotted",      "fn": "versionString", "args": ["1.2.3-alpha.1.2"],           "upstreamFn": "semver.parse", "goFn": "semver.Parse" },
    { "id": "p-pre-and-build",   "fn": "versionString", "args": ["1.2.3-alpha.1+build.5"],     "upstreamFn": "semver.parse", "goFn": "semver.Parse", "deviation": "the port's canonical rendering keeps build metadata (Version.String, and Clean which builds on it); node-semver's SemVer#version drops it and keeps the original text in .raw, which the Go type has no equivalent of" },
    { "id": "p-pre-numeric-0",   "fn": "versionString", "args": ["1.2.3-0"],                   "upstreamFn": "semver.parse", "goFn": "semver.Parse" },
    { "id": "p-pre-leadzero",    "fn": "versionString", "args": ["1.2.3-01"],                  "upstreamFn": "semver.parse", "goFn": "semver.Parse", "note": "numeric prerelease identifiers may not have leading zeros" },
    { "id": "p-pre-alnum-zero",  "fn": "versionString", "args": ["1.2.3-0a"],                  "upstreamFn": "semver.parse", "goFn": "semver.Parse", "note": "alphanumeric, so 0a is fine" },
    { "id": "p-pre-empty",       "fn": "versionString", "args": ["1.2.3-"],                    "upstreamFn": "semver.parse", "goFn": "semver.Parse" },
    { "id": "p-pre-dash",        "fn": "versionString", "args": ["1.2.3--"],                   "upstreamFn": "semver.parse", "goFn": "semver.Parse", "note": "\"-\" is a legal alphanumeric identifier" },
    { "id": "p-pre-dash-word",   "fn": "versionString", "args": ["1.2.3-alpha-beta"],          "upstreamFn": "semver.parse", "goFn": "semver.Parse" },
    { "id": "p-pre-dot-empty",   "fn": "versionString", "args": ["1.2.3-a..b"],                "upstreamFn": "semver.parse", "goFn": "semver.Parse" },
    { "id": "p-pre-underscore",  "fn": "versionString", "args": ["1.2.3-a_b"],                 "upstreamFn": "semver.parse", "goFn": "semver.Parse" },
    { "id": "p-partial-2",       "fn": "isValid",       "args": ["1.2"],                       "upstreamFn": "semver.valid", "goFn": "semver.Valid" },
    { "id": "p-partial-1",       "fn": "isValid",       "args": ["1"],                         "upstreamFn": "semver.valid", "goFn": "semver.Valid" },
    { "id": "p-four-fields",     "fn": "isValid",       "args": ["1.2.3.4"],                   "upstreamFn": "semver.valid", "goFn": "semver.Valid" },
    { "id": "p-empty",           "fn": "isValid",       "args": [""],                          "upstreamFn": "semver.valid", "goFn": "semver.Valid" },
    { "id": "p-space-only",      "fn": "isValid",       "args": ["   "],                       "upstreamFn": "semver.valid", "goFn": "semver.Valid" },
    { "id": "p-words",           "fn": "isValid",       "args": ["not a version"],             "upstreamFn": "semver.valid", "goFn": "semver.Valid" },
    { "id": "p-leadzero-major",  "fn": "isValid",       "args": ["01.2.3"],                    "upstreamFn": "semver.valid", "goFn": "semver.Valid" },
    { "id": "p-leadzero-minor",  "fn": "isValid",       "args": ["1.02.3"],                    "upstreamFn": "semver.valid", "goFn": "semver.Valid" },
    { "id": "p-leadzero-patch",  "fn": "isValid",       "args": ["1.2.03"],                    "upstreamFn": "semver.valid", "goFn": "semver.Valid" },
    { "id": "p-neg-major",       "fn": "isValid",       "args": ["-1.2.3"],                    "upstreamFn": "semver.valid", "goFn": "semver.Valid" },
    { "id": "p-plus-major",      "fn": "isValid",       "args": ["+1.2.3"],                    "upstreamFn": "semver.valid", "goFn": "semver.Valid" },
    { "id": "p-star",            "fn": "isValid",       "args": ["1.2.x"],                     "upstreamFn": "semver.valid", "goFn": "semver.Valid" },
    { "id": "p-max-safe",        "fn": "isValid",       "args": ["9007199254740991.0.0"],      "upstreamFn": "semver.valid", "goFn": "semver.Valid", "note": "exactly Number.MAX_SAFE_INTEGER" },
    { "id": "p-over-max-safe",   "fn": "isValid",       "args": ["9007199254740992.0.0"],      "upstreamFn": "semver.valid", "goFn": "semver.Valid", "note": "one past MAX_SAFE_INTEGER: rejected" },
    { "id": "p-huge-minor",      "fn": "isValid",       "args": ["1.99999999999999999999.0"],  "upstreamFn": "semver.valid", "goFn": "semver.Valid", "note": "20 digits: far past MAX_SAFE_INTEGER, must not wrap or overflow" },
    { "id": "p-huge-patch",      "fn": "isValid",       "args": ["1.0.18446744073709551617"],  "upstreamFn": "semver.valid", "goFn": "semver.Valid", "note": "past uint64 range too" },
    { "id": "p-too-long",        "fn": "isValid",       "args": ["1.2.3-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "upstreamFn": "semver.valid", "goFn": "semver.Valid", "note": "longer than MAX_LENGTH (256)" },
    { "id": "p-at-max-length",   "fn": "isValid",       "args": ["1.2.3-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "upstreamFn": "semver.valid", "goFn": "semver.Valid", "note": "exactly 256 characters: accepted" }
  ]
}
