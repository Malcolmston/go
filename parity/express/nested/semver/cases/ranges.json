{
  "group": "ranges",
  "upstream": "semver@7.8.5",
  "note": "The npm range grammar: caret, tilde (and the \"~>\" alias), the bare comparators, x/X/* wildcards, hyphen ranges, whitespace AND within a set and \"||\" between sets. Prerelease versions only satisfy a set when some comparator in that same set names the same major.minor.patch and itself carries a prerelease. satisfies() swallows an invalid range and answers false; Range#test propagates it, so the rangeTest and rangeValid cases are where range validation is actually measured.",
  "cases": [
    { "id": "r-caret-hit",        "fn": "satisfies", "args": ["1.2.4", "^1.2.3"],            "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-caret-minor-up",   "fn": "satisfies", "args": ["1.9.0", "^1.2.3"],            "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-caret-major-up",   "fn": "satisfies", "args": ["2.0.0", "^1.2.3"],            "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-caret-below",      "fn": "satisfies", "args": ["1.2.2", "^1.2.3"],            "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-caret-zero-minor", "fn": "satisfies", "args": ["0.3.0", "^0.2.3"],            "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies", "note": "^0.2.3 is >=0.2.3 <0.3.0" },
    { "id": "r-caret-zero-patch", "fn": "satisfies", "args": ["0.0.4", "^0.0.3"],            "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies", "note": "^0.0.3 is >=0.0.3 <0.0.4" },
    { "id": "r-caret-zero-in",    "fn": "satisfies", "args": ["0.2.9", "^0.2.3"],            "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-caret-x-minor",    "fn": "satisfies", "args": ["1.9.9", "^1.x"],              "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-caret-zero-x",     "fn": "satisfies", "args": ["0.9.9", "^0.x"],              "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-caret-star",       "fn": "satisfies", "args": ["5.0.0", "^*"],                "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-caret-bare-major", "fn": "satisfies", "args": ["1.5.0", "^1"],                "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-caret-space",      "fn": "satisfies", "args": ["1.5.0", "^ 1.2.0"],           "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies", "note": "whitespace after the operator is stripped" },
    { "id": "r-tilde-patch",      "fn": "satisfies", "args": ["1.2.9", "~1.2.3"],            "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-tilde-minor-up",   "fn": "satisfies", "args": ["1.3.0", "~1.2.3"],            "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-tilde-bare-minor", "fn": "satisfies", "args": ["1.2.9", "~1.2"],              "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-tilde-bare-major", "fn": "satisfies", "args": ["1.9.9", "~1"],                "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-tilde-major-up",   "fn": "satisfies", "args": ["2.0.0", "~1"],                "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-tilde-arrow",      "fn": "satisfies", "args": ["1.2.9", "~>1.2"],             "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies", "note": "the \"~>\" alias" },
    { "id": "r-tilde-x",          "fn": "satisfies", "args": ["1.2.9", "~1.2.x"],            "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-gte-hit",          "fn": "satisfies", "args": ["1.2.3", ">=1.2.3"],           "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-gte-miss",         "fn": "satisfies", "args": ["1.2.2", ">=1.2.3"],           "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-gt-eq",            "fn": "satisfies", "args": ["1.2.3", ">1.2.3"],            "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-lt-hit",           "fn": "satisfies", "args": ["1.2.2", "<1.2.3"],            "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-lte-eq",           "fn": "satisfies", "args": ["1.2.3", "<=1.2.3"],           "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-eq-hit",           "fn": "satisfies", "args": ["1.2.3", "=1.2.3"],            "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-eq-miss",          "fn": "satisfies", "args": ["1.2.4", "=1.2.3"],            "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-eq-build",         "fn": "satisfies", "args": ["1.2.3+b", "=1.2.3"],          "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-bare-exact",       "fn": "satisfies", "args": ["1.2.3", "1.2.3"],             "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-gt-partial",       "fn": "satisfies", "args": ["2.0.0", ">1"],                "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies", "note": ">1 expands to >=2.0.0" },
    { "id": "r-gt-partial-in",    "fn": "satisfies", "args": ["1.9.9", ">1"],                "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-gt-partial-minor", "fn": "satisfies", "args": ["1.3.0", ">1.2"],              "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-lt-partial",       "fn": "satisfies", "args": ["1.0.0", "<1"],                "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies", "note": "<1 expands to <1.0.0" },
    { "id": "r-lt-partial-below", "fn": "satisfies", "args": ["0.9.9", "<1"],                "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-lte-partial",      "fn": "satisfies", "args": ["1.9.9", "<=1"],               "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies", "note": "<=1 expands to <2.0.0" },
    { "id": "r-gte-partial",      "fn": "satisfies", "args": ["1.0.0", ">=1"],               "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-x-star",           "fn": "satisfies", "args": ["9.9.9", "*"],                 "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-x-lower",          "fn": "satisfies", "args": ["1.2.9", "1.2.x"],             "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-x-upper",          "fn": "satisfies", "args": ["1.9.9", "1.X"],               "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-x-star-minor",     "fn": "satisfies", "args": ["1.2.9", "1.2.*"],             "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-x-miss",           "fn": "satisfies", "args": ["2.0.0", "1.x"],               "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-x-empty-range",    "fn": "satisfies", "args": ["3.4.5", ""],                  "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies", "note": "the empty range means any version" },
    { "id": "r-x-spaces-range",   "fn": "satisfies", "args": ["3.4.5", "   "],               "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-hyphen-in",        "fn": "satisfies", "args": ["1.5.0", "1.2.3 - 2.3.4"],     "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-hyphen-hi-eq",     "fn": "satisfies", "args": ["2.3.4", "1.2.3 - 2.3.4"],     "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies", "note": "the upper bound is inclusive" },
    { "id": "r-hyphen-above",     "fn": "satisfies", "args": ["2.3.5", "1.2.3 - 2.3.4"],     "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-hyphen-lo",        "fn": "satisfies", "args": ["1.2.2", "1.2.3 - 2.3.4"],     "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-hyphen-hi-part",   "fn": "satisfies", "args": ["2.3.9", "1.2.3 - 2.3"],       "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies", "note": "partial upper bound: <2.4.0" },
    { "id": "r-hyphen-hi-part2",  "fn": "satisfies", "args": ["2.4.0", "1.2.3 - 2.3"],       "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-hyphen-hi-major",  "fn": "satisfies", "args": ["2.9.9", "1.2.3 - 2"],         "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies", "note": "partial upper bound: <3.0.0" },
    { "id": "r-hyphen-lo-part",   "fn": "satisfies", "args": ["1.0.0", "1 - 2.3.4"],         "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies", "note": "partial lower bound floors to 1.0.0" },
    { "id": "r-and-space",        "fn": "satisfies", "args": ["1.5.0", ">=1.2.0 <2.0.0"],    "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-and-space-miss",   "fn": "satisfies", "args": ["2.0.0", ">=1.2.0 <2.0.0"],    "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-and-partial",      "fn": "satisfies", "args": ["1.2.3", ">=1.2 <1.3"],        "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-and-op-space",     "fn": "satisfies", "args": ["1.5.0", ">= 1.2.0 < 2.0.0"],  "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-and-comma",        "fn": "satisfies", "args": ["1.5.0", ">=1.2.0, <2.0.0"],   "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies", "note": "npm has no comma AND: upstream rejects the range and answers false" },
    { "id": "r-or-first",         "fn": "satisfies", "args": ["1.2.7", "1.2.7 || >=1.2.9 <2.0.0"], "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-or-second",        "fn": "satisfies", "args": ["1.4.6", "1.2.7 || >=1.2.9 <2.0.0"], "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-or-neither",       "fn": "satisfies", "args": ["1.2.8", "1.2.7 || >=1.2.9 <2.0.0"], "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-or-nospace",       "fn": "satisfies", "args": ["2.5.0", "1.x||2.x"],          "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-or-empty-side",    "fn": "satisfies", "args": ["7.0.0", "1.2.3 || "],         "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies", "note": "an empty alternative is the any-version range" },
    { "id": "r-pre-not-in-caret", "fn": "satisfies", "args": ["1.2.4-beta.1", "^1.2.3"],     "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies", "note": "a prerelease of a different tuple never satisfies" },
    { "id": "r-pre-same-tuple",   "fn": "satisfies", "args": ["1.2.3-beta.1", "^1.2.3-alpha"], "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies", "note": "same tuple and the comparator has a prerelease" },
    { "id": "r-pre-below-lo",     "fn": "satisfies", "args": ["1.2.3-alpha.1", "^1.2.3-beta"], "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-pre-gte-same",     "fn": "satisfies", "args": ["1.2.3-rc.2", ">=1.2.3-rc.1"], "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-pre-gte-plain",    "fn": "satisfies", "args": ["1.2.4-rc.1", ">=1.2.3"],      "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-pre-exact",        "fn": "satisfies", "args": ["1.2.3-rc.1", "1.2.3-rc.1"],   "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-pre-vs-x",         "fn": "satisfies", "args": ["1.2.3-rc.1", "*"],            "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies", "note": "* does not admit prereleases by default" },
    { "id": "r-pre-vs-and",       "fn": "satisfies", "args": ["1.2.3-rc.1", ">=1.0.0 <2.0.0"], "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies" },
    { "id": "r-pre-caret-upper",  "fn": "satisfies", "args": ["2.0.0-rc.1", "^1.2.3"],       "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies", "note": "^1.2.3 has upper bound <2.0.0-0, so not even 2.0.0-rc.1" },
    { "id": "r-bad-version",      "fn": "satisfies", "args": ["nope", "^1.0.0"],             "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies", "note": "satisfies answers false rather than throwing" },
    { "id": "r-bad-range",        "fn": "satisfies", "args": ["9.9.9", "garbage"],           "upstreamFn": "semver.satisfies", "goFn": "semver.Satisfies", "note": "an unparseable range must never admit a version" },
    { "id": "rt-hit",             "fn": "rangeTest", "args": ["1.2.4", "^1.2.3"],            "upstreamFn": "Range#test",       "goFn": "Range.Test" },
    { "id": "rt-miss",            "fn": "rangeTest", "args": ["2.0.0", "^1.2.3"],            "upstreamFn": "Range#test",       "goFn": "Range.Test" },
    { "id": "rt-union",           "fn": "rangeTest", "args": ["2.5.0", "1.x || 2.x"],        "upstreamFn": "Range#test",       "goFn": "Range.Test" },
    { "id": "rt-bad-range",       "fn": "rangeTest", "args": ["1.2.3", "garbage"],           "upstreamFn": "Range#test",       "goFn": "Range.Test", "note": "unlike satisfies, both sides must fail here" },
    { "id": "rt-bad-version",     "fn": "rangeTest", "args": ["1.2", "^1.0.0"],              "upstreamFn": "Range#test",       "goFn": "Range.Test", "note": "Range#test catches an invalid version and answers false; the Go runner reports the same, since Range.Test cannot be handed one" },
    { "id": "rv-caret",           "fn": "rangeValid", "args": ["^1.2.3"],                    "upstreamFn": "semver.validRange", "goFn": "semver.ParseRange" },
    { "id": "rv-tilde",           "fn": "rangeValid", "args": ["~1.2"],                      "upstreamFn": "semver.validRange", "goFn": "semver.ParseRange" },
    { "id": "rv-star",            "fn": "rangeValid", "args": ["*"],                         "upstreamFn": "semver.validRange", "goFn": "semver.ParseRange" },
    { "id": "rv-empty",           "fn": "rangeValid", "args": [""],                          "upstreamFn": "semver.validRange", "goFn": "semver.ParseRange" },
    { "id": "rv-union",           "fn": "rangeValid", "args": ["1.2.7 || >=1.2.9 <2.0.0"],   "upstreamFn": "semver.validRange", "goFn": "semver.ParseRange" },
    { "id": "rv-hyphen",          "fn": "rangeValid", "args": ["1.2.3 - 2.3.4"],             "upstreamFn": "semver.validRange", "goFn": "semver.ParseRange" },
    { "id": "rv-pre",             "fn": "rangeValid", "args": [">=1.2.3-rc.1 <2.0.0"],       "upstreamFn": "semver.validRange", "goFn": "semver.ParseRange" },
    { "id": "rv-build",           "fn": "rangeValid", "args": [">=1.2.3+build.1"],           "upstreamFn": "semver.validRange", "goFn": "semver.ParseRange" },
    { "id": "rv-garbage",         "fn": "rangeValid", "args": ["garbage"],                   "upstreamFn": "semver.validRange", "goFn": "semver.ParseRange", "note": "a bare word is not a range" },
    { "id": "rv-comma",           "fn": "rangeValid", "args": [">=1.0.0, <2.0.0"],           "upstreamFn": "semver.validRange", "goFn": "semver.ParseRange", "note": "commas are not AND separators in npm ranges" },
    { "id": "rv-op-only",         "fn": "rangeValid", "args": [">="],                        "upstreamFn": "semver.validRange", "goFn": "semver.ParseRange" },
    { "id": "rv-double-op",       "fn": "rangeValid", "args": [">=>1.2.3"],                  "upstreamFn": "semver.validRange", "goFn": "semver.ParseRange" },
    { "id": "rv-caret-word",      "fn": "rangeValid", "args": ["^latest"],                   "upstreamFn": "semver.validRange", "goFn": "semver.ParseRange" },
    { "id": "rv-tilde-word",      "fn": "rangeValid", "args": ["~beta"],                     "upstreamFn": "semver.validRange", "goFn": "semver.ParseRange" },
    { "id": "rv-four-fields",     "fn": "rangeValid", "args": ["1.2.3.4"],                   "upstreamFn": "semver.validRange", "goFn": "semver.ParseRange" },
    { "id": "rv-dangling-pre",    "fn": "rangeValid", "args": [">=1.2.3-"],                  "upstreamFn": "semver.validRange", "goFn": "semver.ParseRange" },
    { "id": "rv-lead-zero",       "fn": "rangeValid", "args": [">=01.2.3"],                  "upstreamFn": "semver.validRange", "goFn": "semver.ParseRange" },
    { "id": "rv-x-then-num",      "fn": "rangeValid", "args": ["1.x.3"],                     "upstreamFn": "semver.validRange", "goFn": "semver.ParseRange", "note": "once a field is a wildcard the rest must be too" },
    { "id": "rv-hyphen-bad-hi",   "fn": "rangeValid", "args": ["1.2.3 - nope"],              "upstreamFn": "semver.validRange", "goFn": "semver.ParseRange" },
    { "id": "rv-hyphen-bad-lo",   "fn": "rangeValid", "args": ["nope - 2.0.0"],              "upstreamFn": "semver.validRange", "goFn": "semver.ParseRange" },
    { "id": "rv-union-bad-side",  "fn": "rangeValid", "args": ["1.2.3 || garbage"],          "upstreamFn": "semver.validRange", "goFn": "semver.ParseRange" },
    { "id": "rv-huge-field",      "fn": "rangeValid", "args": [">=99999999999999999999.0.0"], "upstreamFn": "semver.validRange", "goFn": "semver.ParseRange", "note": "past MAX_SAFE_INTEGER" },
    { "id": "rv-url",             "fn": "rangeValid", "args": ["https://example.com/a.tgz"], "upstreamFn": "semver.validRange", "goFn": "semver.ParseRange", "note": "the sort of string an npm dependency field really contains" },
    { "id": "rv-tag",             "fn": "rangeValid", "args": ["latest"],                    "upstreamFn": "semver.validRange", "goFn": "semver.ParseRange" },
    { "id": "rs-caret",           "fn": "rangeString", "args": ["^1.2.3"],                   "upstreamFn": "Range#range",      "goFn": "Range.String", "deviation": "upstream Range#range is the normalised comparator set (\">=1.2.3 <2.0.0-0\"); the port's Range.String returns the expression it was parsed from" },
    { "id": "rs-star",            "fn": "rangeString", "args": ["*"],                        "upstreamFn": "Range#range",      "goFn": "Range.String", "deviation": "upstream normalises \"*\" to the empty comparator set; the port echoes \"*\"" }
  ]
}
