{
  "group": "parse-invalid",
  "upstream": "ms@4.0.0-nightly.202508271359",
  "note": "Errors are cases too. Upstream signals failure two ways — it throws for a non-string / empty / over-long input and returns NaN for input that does not match the grammar — and the runner turns both into ok:false. The port must also refuse.",
  "cases": [
    { "id": "p-err-empty",         "fn": "parse", "args": [""],              "upstreamFn": "ms.parse", "goFn": "ms.Parse", "note": "upstream throws for an empty string" },
    { "id": "p-err-spaces-only",   "fn": "parse", "args": ["   "],           "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-err-word",          "fn": "parse", "args": ["foo"],           "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-err-unit-only",     "fn": "parse", "args": ["s"],             "upstreamFn": "ms.parse", "goFn": "ms.Parse", "note": "a unit with no number" },
    { "id": "p-err-unknown-unit",  "fn": "parse", "args": ["1 fortnight"],   "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-err-unknown-short", "fn": "parse", "args": ["1x"],            "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-err-two-numbers",   "fn": "parse", "args": ["1 2 s"],         "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-err-trailing-space","fn": "parse", "args": ["1s "],           "upstreamFn": "ms.parse", "goFn": "ms.Parse", "note": "the grammar is anchored, so a trailing space is not allowed" },
    { "id": "p-err-leading-space", "fn": "parse", "args": [" 1s"],           "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-err-plus-sign",     "fn": "parse", "args": ["+1s"],           "upstreamFn": "ms.parse", "goFn": "ms.Parse", "note": "only a leading minus is accepted" },
    { "id": "p-err-exponent",      "fn": "parse", "args": ["1e3"],           "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-err-exponent-unit", "fn": "parse", "args": ["1e3ms"],         "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-err-dot-only",      "fn": "parse", "args": ["."],             "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-err-trailing-dot",  "fn": "parse", "args": ["1.s"],           "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-err-nan",           "fn": "parse", "args": ["NaN"],           "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-err-infinity",      "fn": "parse", "args": ["Infinity"],      "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-err-comma",         "fn": "parse", "args": ["1,5h"],          "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-err-two-units",     "fn": "parse", "args": ["1h30m"],         "upstreamFn": "ms.parse", "goFn": "ms.Parse", "note": "compound durations are not supported by either side" },
    { "id": "p-err-underscore",    "fn": "parse", "args": ["1_000ms"],       "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-err-newline",       "fn": "parse", "args": ["1s\n"],          "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-err-tab-sep",       "fn": "parse", "args": ["1\ts"],          "upstreamFn": "ms.parse", "goFn": "ms.Parse", "note": "only literal spaces separate number and unit" },
    { "id": "p-err-too-long",      "fn": "parse", "args": ["11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111"], "upstreamFn": "ms.parse", "goFn": "ms.Parse", "note": "102 chars: over the 100-character guard, so refused before matching" },
    { "id": "p-err-unicode-digit", "fn": "parse", "args": ["١h"],            "upstreamFn": "ms.parse", "goFn": "ms.Parse", "note": "non-ASCII digits are not numbers" },
    { "id": "p-err-strict-word",   "fn": "parseStrict", "args": ["fortnight"], "upstreamFn": "ms.parseStrict", "goFn": "ms.Parse", "note": "parseStrict is parse with a narrowed argument type; it refuses the same inputs at runtime" },
    { "id": "p-err-ms-empty",      "fn": "msString",    "args": [""],         "upstreamFn": "ms",  "goFn": "ms.Parse", "note": "through the dual-dispatch default export" },
    { "id": "p-err-overflow-1e30", "fn": "parse", "args": ["1000000000000000000000000000000"], "upstreamFn": "ms.parse", "goFn": "ms.Parse", "deviation": "upstream returns an unbounded JavaScript number (1e30); a Go time.Duration is int64 nanoseconds and caps at about 292 years, so the port reports an explicit range error rather than silently wrapping.", "note": "1e30 ms" },
    { "id": "p-err-overflow-years","fn": "parse", "args": ["100000y"],        "upstreamFn": "ms.parse", "goFn": "ms.Parse", "deviation": "100000 years exceeds the ~292-year span of a time.Duration; upstream has no such bound.", "note": "beyond the int64 nanosecond range" }
  ]
}
