{
  "group": "parse-short",
  "upstream": "ms@4.0.0-nightly.202508271359",
  "note": "Short unit spellings, signs, fractions and whitespace. Fractions are binary-exact (halves/quarters) so neither side is compared across a float rounding artefact.",
  "cases": [
    { "id": "p-bare-number",   "fn": "parse", "args": ["100"],    "upstreamFn": "ms.parse", "goFn": "ms.Parse", "note": "no unit means milliseconds" },
    { "id": "p-bare-zero",     "fn": "parse", "args": ["0"],      "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-bare-big",      "fn": "parse", "args": ["1000000"],"upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-ms",            "fn": "parse", "args": ["100ms"],  "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-ms-zero",       "fn": "parse", "args": ["0ms"],    "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-s",             "fn": "parse", "args": ["1s"],     "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-m",             "fn": "parse", "args": ["1m"],     "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-h",             "fn": "parse", "args": ["1h"],     "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-d",             "fn": "parse", "args": ["1d"],     "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-w",             "fn": "parse", "args": ["1w"],     "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-y",             "fn": "parse", "args": ["1y"],     "upstreamFn": "ms.parse", "goFn": "ms.Parse", "note": "a year is 365.25 days" },
    { "id": "p-mo",            "fn": "parse", "args": ["1mo"],    "upstreamFn": "ms.parse", "goFn": "ms.Parse", "note": "a month is a twelfth of a 365.25-day year" },
    { "id": "p-multi-digit",   "fn": "parse", "args": ["30d"],    "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-half-s",        "fn": "parse", "args": ["0.5s"],   "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-quarter-h",     "fn": "parse", "args": ["0.25h"],  "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-leading-dot",   "fn": "parse", "args": [".5s"],    "upstreamFn": "ms.parse", "goFn": "ms.Parse", "note": "the number grammar allows a bare fraction" },
    { "id": "p-frac-ms",       "fn": "parse", "args": ["0.5ms"],  "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-frac-day",      "fn": "parse", "args": ["1.5d"],   "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-neg-s",         "fn": "parse", "args": ["-1s"],    "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-neg-frac-h",    "fn": "parse", "args": ["-1.5h"],  "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-neg-bare",      "fn": "parse", "args": ["-100"],   "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-neg-leading-dot","fn": "parse","args": ["-.5s"],   "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-space-single",  "fn": "parse", "args": ["1 s"],    "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-space-multi",   "fn": "parse", "args": ["1   s"],  "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-upper-unit",    "fn": "parse", "args": ["1H"],     "upstreamFn": "ms.parse", "goFn": "ms.Parse", "note": "unit matching is case-insensitive" },
    { "id": "p-upper-word",    "fn": "parse", "args": ["1.5 Hours"], "upstreamFn": "ms.parse", "goFn": "ms.Parse" },
    { "id": "p-mixed-case",    "fn": "parse", "args": ["2 DaYs"], "upstreamFn": "ms.parse", "goFn": "ms.Parse" }
  ]
}
