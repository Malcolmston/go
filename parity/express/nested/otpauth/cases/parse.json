{
  "group": "parse",
  "upstream": "otpauth@9.5.1",
  "note": "Key-URI parsing, including everything URI.parse refuses: a missing or non-base32 secret, an HOTP URI with no counter, a non-positive period or digits, an unknown algorithm, an unknown type and a wrong scheme.",
  "cases": [
    {
      "id": "parse-totp-full",
      "fn": "parse",
      "args": [
        "otpauth://totp/ACME%20Co:alice@example.com?issuer=ACME%20Co&secret=JBSWY3DPEHPK3PXP&algorithm=SHA256&digits=8&period=60"
      ],
      "upstreamFn": "URI.parse",
      "goFn": "otpauth.Parse"
    },
    {
      "id": "parse-totp-minimal",
      "fn": "parse",
      "args": [
        "otpauth://totp/alice?secret=JBSWY3DPEHPK3PXP"
      ],
      "upstreamFn": "URI.parse",
      "goFn": "otpauth.Parse"
    },
    {
      "id": "parse-totp-defaults-filled",
      "fn": "parse",
      "args": [
        "otpauth://totp/ACME:alice?issuer=ACME&secret=JBSWY3DPEHPK3PXP"
      ],
      "upstreamFn": "URI.parse",
      "goFn": "otpauth.Parse"
    },
