      "args": [
        "otpauth://totp/LabelIssuer:alice?issuer=QueryIssuer&secret=JBSWY3DPEHPK3PXP"
      ],
      "upstreamFn": "URI.parse",
      "goFn": "otpauth.Parse",
      "note": "the query parameter wins"
    },
    {
      "id": "parse-totp-encoded-colon",
