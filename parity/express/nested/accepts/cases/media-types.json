{
  "group": "media-types",
  "upstream": "accepts@1.3.8",
  "note": "accepts(req).type(...offers) and accepts(req).types() — Accept header negotiation, extension shorthands resolved through the MIME table, q-value ordering, wildcards and malformed headers.",
  "cases": [
    { "id": "type-exact", "fn": "type", "args": [{ "Accept": "text/html" }, ["text/html"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type" },
    { "id": "type-exact-miss", "fn": "type", "args": [{ "Accept": "text/html" }, ["application/json"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type", "note": "nothing acceptable -> false / \"\"" },
    { "id": "type-first-of-two", "fn": "type", "args": [{ "Accept": "text/html, application/json" }, ["application/json", "text/html"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type", "note": "equal q: the client's order decides, not the offer order" },
    { "id": "type-q-order", "fn": "type", "args": [{ "Accept": "text/html;q=0.2, application/json;q=0.9" }, ["text/html", "application/json"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type" },
    { "id": "type-q-zero-excluded", "fn": "type", "args": [{ "Accept": "text/html;q=0, application/json" }, ["text/html", "application/json"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type", "note": "q=0 means unacceptable" },
    { "id": "type-q-zero-only", "fn": "type", "args": [{ "Accept": "text/html;q=0" }, ["text/html"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type" },
    { "id": "type-star-star", "fn": "type", "args": [{ "Accept": "*/*" }, ["text/html", "application/json"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type" },
    { "id": "type-subtype-star", "fn": "type", "args": [{ "Accept": "text/*" }, ["application/json", "text/plain"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type" },
    { "id": "type-specificity-beats-order", "fn": "type", "args": [{ "Accept": "*/*, text/plain" }, ["text/html", "text/plain"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type", "note": "exact match outranks the wildcard even though the wildcard came first" },
    { "id": "type-specificity-vs-q", "fn": "type", "args": [{ "Accept": "text/*;q=0.9, text/plain;q=0.5" }, ["text/html", "text/plain"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type", "note": "upstream picks by specificity before quality" },
    { "id": "type-no-header", "fn": "type", "args": [{}, ["application/json", "text/html"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type", "note": "no Accept header at all -> first offer, unfiltered" },
    { "id": "type-empty-header", "fn": "type", "args": [{ "Accept": "" }, ["application/json"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type", "note": "present but empty: falsy upstream, so also the first offer" },
    { "id": "type-ext-html", "fn": "type", "args": [{ "Accept": "text/html" }, ["html"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type", "note": "extension shorthand resolved via mime.lookup; the offer is echoed back verbatim" },
    { "id": "type-ext-json", "fn": "type", "args": [{ "Accept": "application/json" }, ["json"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type" },
    { "id": "type-ext-csv", "fn": "type", "args": [{ "Accept": "text/csv" }, ["csv"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type" },
    { "id": "type-ext-png", "fn": "type", "args": [{ "Accept": "image/*" }, ["png"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type" },
    { "id": "type-ext-pdf", "fn": "type", "args": [{ "Accept": "application/pdf" }, ["pdf"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type" },
    { "id": "type-ext-svg", "fn": "type", "args": [{ "Accept": "image/svg+xml" }, ["svg"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type" },
    { "id": "type-ext-woff2", "fn": "type", "args": [{ "Accept": "font/woff2" }, ["woff2"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type" },
    { "id": "type-ext-dotted", "fn": "type", "args": [{ "Accept": "text/plain" }, [".txt"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type", "note": "mime.lookup accepts a leading dot" },
    { "id": "type-ext-unknown", "fn": "type", "args": [{ "Accept": "*/*" }, ["bogusext"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type", "note": "unknown extension: mime.lookup returns false and the offer is dropped, so nothing is acceptable" },
    { "id": "type-ext-unknown-among-known", "fn": "type", "args": [{ "Accept": "*/*" }, ["bogusext", "json"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type" },
    { "id": "type-ext-urlencoded", "fn": "type", "args": [{ "Accept": "application/x-www-form-urlencoded" }, ["urlencoded"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type", "note": "not a mime-types extension: unknown to mime.lookup" },
    { "id": "type-case-insensitive", "fn": "type", "args": [{ "Accept": "TEXT/HTML" }, ["text/html"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type" },
    { "id": "type-offer-uppercase", "fn": "type", "args": [{ "Accept": "text/html" }, ["TEXT/HTML"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type" },
    { "id": "type-params-in-header", "fn": "type", "args": [{ "Accept": "text/html;level=1" }, ["text/html"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type", "note": "a header param the offer does not carry makes the spec unmatchable" },
    { "id": "type-params-in-offer", "fn": "type", "args": [{ "Accept": "text/html;level=1" }, ["text/html;level=1"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type" },
    { "id": "type-quoted-comma-param", "fn": "type", "args": [{ "Accept": "text/html;foo=\"bar,baz\", application/json" }, ["application/json", "text/html"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type", "note": "a comma inside a quoted parameter must not split the header" },
    { "id": "type-malformed-no-slash", "fn": "type", "args": [{ "Accept": "bogus" }, ["text/html"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type", "note": "an entry with no slash is discarded" },
    { "id": "type-malformed-mixed", "fn": "type", "args": [{ "Accept": "bogus, text/html" }, ["text/html"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type" },
    { "id": "type-malformed-q", "fn": "type", "args": [{ "Accept": "text/html;q=notanumber" }, ["text/html"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type", "note": "parseFloat yields NaN upstream, so the entry has no quality and is dropped" },
    { "id": "type-empty-q", "fn": "type", "args": [{ "Accept": "text/html;q=" }, ["text/html"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type" },
    { "id": "type-q-above-one", "fn": "type", "args": [{ "Accept": "text/html;q=2, application/json" }, ["application/json", "text/html"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type" },
    { "id": "type-trailing-comma", "fn": "type", "args": [{ "Accept": "text/html," }, ["text/html"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type" },
    { "id": "type-whitespace-noise", "fn": "type", "args": [{ "Accept": "  text/html ;  q=0.8  ,  application/json ; q=0.9 " }, ["text/html", "application/json"]], "upstreamFn": "accepts.type", "goFn": "Accepts.Type" },
    { "id": "type-no-offers-is-types", "fn": "types", "args": [{ "Accept": "text/html, application/json;q=0.5" }], "upstreamFn": "accepts.types", "goFn": "Accepts.Types" },
    { "id": "types-q-sorted", "fn": "types", "args": [{ "Accept": "text/plain;q=0.1, text/html;q=0.9, application/json;q=0.5" }], "upstreamFn": "accepts.types", "goFn": "Accepts.Types" },
    { "id": "types-drops-q-zero", "fn": "types", "args": [{ "Accept": "text/plain;q=0, text/html" }], "upstreamFn": "accepts.types", "goFn": "Accepts.Types" },
    { "id": "types-no-header", "fn": "types", "args": [{}], "upstreamFn": "accepts.types", "goFn": "Accepts.Types", "note": "absent header defaults to */*" },
    { "id": "types-empty-header", "fn": "types", "args": [{ "Accept": "" }], "upstreamFn": "accepts.types", "goFn": "Accepts.Types", "note": "present but empty -> no acceptable types" },
    { "id": "types-keeps-wildcards", "fn": "types", "args": [{ "Accept": "text/*, */*;q=0.1" }], "upstreamFn": "accepts.types", "goFn": "Accepts.Types" },
    { "id": "types-strips-params", "fn": "types", "args": [{ "Accept": "text/html;level=1;q=0.8, application/json" }], "upstreamFn": "accepts.types", "goFn": "Accepts.Types", "note": "the reported values are type/subtype only" },
    { "id": "types-preserves-case", "fn": "types", "args": [{ "Accept": "Text/HTML" }], "upstreamFn": "accepts.types", "goFn": "Accepts.Types", "note": "upstream echoes the header's casing" },
    { "id": "types-all-malformed", "fn": "types", "args": [{ "Accept": "bogus, alsobogus" }], "upstreamFn": "accepts.types", "goFn": "Accepts.Types" }
  ]
}
