{
  "group": "encodings",
  "upstream": "accepts@1.3.8",
  "note": "accepts(req).encoding(...offers) and accepts(req).encodings() — Accept-Encoding negotiation, including the implicit \"identity\" encoding.",
  "cases": [
    { "id": "enc-exact", "fn": "encoding", "args": [{ "Accept-Encoding": "gzip" }, ["gzip"]], "upstreamFn": "accepts.encoding", "goFn": "Accepts.Encoding" },
    { "id": "enc-miss", "fn": "encoding", "args": [{ "Accept-Encoding": "gzip" }, ["br"]], "upstreamFn": "accepts.encoding", "goFn": "Accepts.Encoding" },
    { "id": "enc-q-order", "fn": "encoding", "args": [{ "Accept-Encoding": "gzip;q=0.2, br;q=0.9" }, ["gzip", "br"]], "upstreamFn": "accepts.encoding", "goFn": "Accepts.Encoding" },
    { "id": "enc-q-zero", "fn": "encoding", "args": [{ "Accept-Encoding": "gzip;q=0, deflate" }, ["gzip", "deflate"]], "upstreamFn": "accepts.encoding", "goFn": "Accepts.Encoding" },
    { "id": "enc-star", "fn": "encoding", "args": [{ "Accept-Encoding": "*" }, ["gzip", "br"]], "upstreamFn": "accepts.encoding", "goFn": "Accepts.Encoding" },
    { "id": "enc-star-with-exclusion", "fn": "encoding", "args": [{ "Accept-Encoding": "*, gzip;q=0" }, ["gzip", "br"]], "upstreamFn": "accepts.encoding", "goFn": "Accepts.Encoding" },
    { "id": "enc-exact-beats-star", "fn": "encoding", "args": [{ "Accept-Encoding": "*;q=0.9, br;q=0.5" }, ["gzip", "br"]], "upstreamFn": "accepts.encoding", "goFn": "Accepts.Encoding" },
    { "id": "enc-identity-implicit", "fn": "encoding", "args": [{ "Accept-Encoding": "gzip" }, ["identity"]], "upstreamFn": "accepts.encoding", "goFn": "Accepts.Encoding", "note": "identity is acceptable unless explicitly refused" },
    { "id": "enc-identity-refused", "fn": "encoding", "args": [{ "Accept-Encoding": "gzip, identity;q=0" }, ["identity"]], "upstreamFn": "accepts.encoding", "goFn": "Accepts.Encoding" },
    { "id": "enc-identity-refused-via-star", "fn": "encoding", "args": [{ "Accept-Encoding": "gzip, *;q=0" }, ["identity"]], "upstreamFn": "accepts.encoding", "goFn": "Accepts.Encoding", "note": "*;q=0 covers identity too" },
    { "id": "enc-identity-loses-to-gzip", "fn": "encoding", "args": [{ "Accept-Encoding": "gzip" }, ["identity", "gzip"]], "upstreamFn": "accepts.encoding", "goFn": "Accepts.Encoding", "note": "the implicit identity has a minimal quality, so gzip wins" },
    { "id": "enc-identity-explicit-wins", "fn": "encoding", "args": [{ "Accept-Encoding": "identity;q=1, gzip;q=0.5" }, ["gzip", "identity"]], "upstreamFn": "accepts.encoding", "goFn": "Accepts.Encoding" },
    { "id": "enc-no-header", "fn": "encoding", "args": [{}, ["gzip"]], "upstreamFn": "accepts.encoding", "goFn": "Accepts.Encoding", "note": "absent Accept-Encoding implies identity only" },
    { "id": "enc-no-header-identity", "fn": "encoding", "args": [{}, ["identity"]], "upstreamFn": "accepts.encoding", "goFn": "Accepts.Encoding" },
    { "id": "enc-empty-header", "fn": "encoding", "args": [{ "Accept-Encoding": "" }, ["gzip"]], "upstreamFn": "accepts.encoding", "goFn": "Accepts.Encoding" },
    { "id": "enc-empty-header-identity", "fn": "encoding", "args": [{ "Accept-Encoding": "" }, ["identity"]], "upstreamFn": "accepts.encoding", "goFn": "Accepts.Encoding" },
    { "id": "enc-case-insensitive", "fn": "encoding", "args": [{ "Accept-Encoding": "GZIP" }, ["gzip"]], "upstreamFn": "accepts.encoding", "goFn": "Accepts.Encoding" },
    { "id": "enc-offer-case", "fn": "encoding", "args": [{ "Accept-Encoding": "gzip" }, ["GZIP"]], "upstreamFn": "accepts.encoding", "goFn": "Accepts.Encoding" },
    { "id": "enc-malformed-q", "fn": "encoding", "args": [{ "Accept-Encoding": "gzip;q=zzz" }, ["gzip"]], "upstreamFn": "accepts.encoding", "goFn": "Accepts.Encoding" },
    { "id": "enc-trailing-comma", "fn": "encoding", "args": [{ "Accept-Encoding": "gzip," }, ["gzip"]], "upstreamFn": "accepts.encoding", "goFn": "Accepts.Encoding" },
    { "id": "enc-whitespace-noise", "fn": "encoding", "args": [{ "Accept-Encoding": " deflate ; q=0.3 , gzip ; q=0.8 " }, ["deflate", "gzip"]], "upstreamFn": "accepts.encoding", "goFn": "Accepts.Encoding" },
    { "id": "encs-all", "fn": "encodings", "args": [{ "Accept-Encoding": "gzip;q=0.3, br;q=0.9, deflate" }], "upstreamFn": "accepts.encodings", "goFn": "Accepts.Encodings", "note": "identity is appended as the least preferred" },
    { "id": "encs-no-header", "fn": "encodings", "args": [{}], "upstreamFn": "accepts.encodings", "goFn": "Accepts.Encodings" },
    { "id": "encs-empty-header", "fn": "encodings", "args": [{ "Accept-Encoding": "" }], "upstreamFn": "accepts.encodings", "goFn": "Accepts.Encodings" },
    { "id": "encs-drops-q-zero", "fn": "encodings", "args": [{ "Accept-Encoding": "gzip;q=0, br" }], "upstreamFn": "accepts.encodings", "goFn": "Accepts.Encodings" },
    { "id": "encs-identity-refused", "fn": "encodings", "args": [{ "Accept-Encoding": "gzip, identity;q=0" }], "upstreamFn": "accepts.encodings", "goFn": "Accepts.Encodings" },
    { "id": "encs-with-star", "fn": "encodings", "args": [{ "Accept-Encoding": "gzip, *;q=0.1" }], "upstreamFn": "accepts.encodings", "goFn": "Accepts.Encodings" },
    { "id": "encs-explicit-identity", "fn": "encodings", "args": [{ "Accept-Encoding": "identity;q=0.5, gzip" }], "upstreamFn": "accepts.encodings", "goFn": "Accepts.Encodings" }
  ]
}
