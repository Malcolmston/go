    {
      "id": "unterminated-end-tag-nospace",
      "fn": "sanitize",
      "args": [
        "<p>a</p"
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "an unterminated end tag still closes its element"
    },
    {
      "id": "unterminated-end-tag-space",
      "fn": "sanitize",
      "args": [
        "<p>a</p "
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "deviation": "htmlparser2 flushes the unterminated end tag and then emits the trailing whitespace it had buffered as a text node; the port drops the incomplete fragment entirely"
    },
    {
      "id": "unterminated-end-tag-alone",
      "fn": "sanitize",
      "args": [
        "a</b"
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize"
    },
    {
      "id": "unterminated-end-tag-space-name",
      "fn": "sanitize",
      "args": [
        "<p>a</ p>"
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "no name after \"</\": the close tag is dropped and <p> is closed at the end of the input"
    },
    {
      "id": "unclosed-nested-deep",
      "fn": "sanitize",
      "args": [
        "<div><p><b>x"
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "three unclosed elements must all be closed, innermost first"
    },
    {
      "id": "unclosed-with-void",
      "fn": "sanitize",
      "args": [
        "<div><br><p>x"
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "the void element must not be waiting on the stack when the others are closed"
    }
