        "a<br>b<hr>c<wbr>d"
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "wbr is allowed by default but is NOT on the default selfClosing list"
    },
    {
      "id": "void-nonvoid-in-selfclosing",
      "fn": "sanitize",
      "args": [
        "<p>x</p>y",
        {
          "selfClosing": [
            "p"
          ]
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "naming a normal element in selfClosing suppresses its end tag but does not stop it from having children, so the source </p> is absorbed rather than becoming a second element"
    },
