    },
    {
      "id": "pol-mode-recursive-escape-script",
      "fn": "sanitize",
      "args": [
        "<foo><script>alert(1)</script></foo>",
        {
          "disallowedTagsMode": "recursiveEscape"
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize"
    },
    {
      "id": "pol-mode-escape-selfclosing",
      "fn": "sanitize",
      "args": [
        "<foo/>x",
        {
          "disallowedTagsMode": "escape"
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize"
    },
