{
  "group": "policy",
  "upstream": "sanitize-html@2.17.6",
  "note": "Configuration: allowedTags, allowedAttributes, allowedClasses, the scheme options, nonTextTags, selfClosing, disallowedTagsMode and textFilter. Upstream merges a supplied options object over sanitizeHtml.defaults, and both runners do the same, so a case only states what it overrides.",
  "cases": [
    {
      "id": "pol-tags-subset",
      "fn": "sanitize",
      "args": [
        "<p>a</p><b>b</b><i>c</i>",
        {
          "allowedTags": [
            "b"
          ]
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize"
    },
    {
      "id": "pol-tags-empty",
      "fn": "sanitize",
      "args": [
        "<p>a</p><script>alert(1)</script>",
        {
          "allowedTags": []
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "an empty allowlist still drops script CONTENT, because script is a nonTextTag"
    },
    {
      "id": "pol-tags-all",
      "fn": "sanitize",
      "args": [
        "<p onclick=\"alert(1)\">a</p><blink>b</blink>",
        {
          "allowedTags": false
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "allowedTags:false means every tag; the Go runner translates that to the port's \"*\""
    },
    {
      "id": "pol-tags-all-script",
      "fn": "sanitize",
      "args": [
        "<script>alert(1)</script>",
        {
          "allowedTags": false
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "with every tag allowed, an allowed nonTextTag keeps its raw content — upstream warns about this on stderr"
    },
    {
      "id": "pol-tags-star-literal",
      "fn": "sanitize",
      "args": [
        "<p>a</p>",
        {
          "allowedTags": [
            "*"
          ]
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "deviation": "upstream has no wildcard for allowedTags, so [\"*\"] permits only a tag literally named \"*\" and strips <p>; the port reads \"*\" as \"every tag\""
    },
    {
      "id": "pol-tags-case",
      "fn": "sanitize",
      "args": [
        "<P>a</P>",
        {
          "allowedTags": [
            "p"
          ]
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "tag names are compared lower-cased"
    },
    {
      "id": "pol-tags-allowlist-uppercase",
      "fn": "sanitize",
      "args": [
        "<p>a</p>",
        {
          "allowedTags": [
            "P"
          ]
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "deviation": "upstream compares the lower-cased tag name against the allowlist verbatim, so an upper-case entry never matches; the port lower-cases the allowlist"
    },
    {
      "id": "pol-tags-script-allowed",
      "fn": "sanitize",
      "args": [
        "<script>alert(1)</script>",
        {
          "allowedTags": [
            "script"
          ]
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "the caller explicitly allows script: both sides keep the raw body"
    },
    {
      "id": "pol-tags-style-allowed",
      "fn": "sanitize",
      "args": [
        "<style>b{color:red}</style>",
        {
          "allowedTags": [
            "style"
          ]
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize"
    },
    {
      "id": "pol-tags-textarea-allowed",
      "fn": "sanitize",
      "args": [
        "<textarea><b>x</b></textarea>",
        {
          "allowedTags": [
            "textarea"
          ]
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize"
    },
    {
      "id": "pol-tags-img-default-attrs",
      "fn": "sanitize",
      "args": [
        "<img src=\"/a.png\" alt=\"a\" width=\"1\" height=\"2\" loading=\"lazy\" title=\"t\" id=\"z\">",
        {
          "allowedTags": [
            "img"
          ]
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "the default allowedAttributes for img survive the merge; id does not"
    },
    {
      "id": "pol-attrs-star",
      "fn": "sanitize",
      "args": [
        "<p id=\"a\" class=\"b\">x</p>",
        {
          "allowedAttributes": {
            "*": [
              "id"
            ]
          }
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize"
    },
    {
      "id": "pol-attrs-per-tag",
      "fn": "sanitize",
      "args": [
        "<p id=\"a\">x</p><b id=\"c\">y</b>",
        {
          "allowedAttributes": {
            "p": [
              "id"
            ]
          }
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize"
    },
    {
      "id": "pol-attrs-glob-data",
      "fn": "sanitize",
      "args": [
        "<p data-a=\"1\" data-b=\"2\" dataX=\"3\">x</p>",
        {
          "allowedAttributes": {
            "p": [
              "data-*"
            ]
          }
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize"
    },
    {
      "id": "pol-attrs-glob-mid",
      "fn": "sanitize",
      "args": [
        "<p axb=\"1\" ab=\"2\">x</p>",
        {
          "allowedAttributes": {
            "p": [
              "a*b"
            ]
          }
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "upstream turns the glob into a regex, so a * in the middle works"
    },
    {
      "id": "pol-attrs-none",
      "fn": "sanitize",
      "args": [
        "<a href=\"/x\">y</a>",
        {
          "allowedAttributes": {}
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize"
    },
    {
      "id": "pol-attrs-null",
      "fn": "sanitize",
      "args": [
        "<a href=\"javascript:alert(1)\" onclick=\"alert(2)\">y</a>",
        {
          "allowedAttributes": null
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "allowedAttributes:null means ALLOW EVERY attribute upstream; the scheme check still runs",
      "deviation": "allowedAttributes:null means ALLOW EVERY ATTRIBUTE upstream. The Go zero value of a map is nil, so reading nil as \"allow everything\" would make Options{} silently permit event handlers; the port treats nil as \"nothing beyond the defaults\" and spells allow-all as {\"*\": {\"*\"}}"
    },
    {
      "id": "pol-attrs-case",
      "fn": "sanitize",
      "args": [
        "<p ID=\"a\">x</p>",
        {
          "allowedAttributes": {
            "p": [
              "id"
            ]
          }
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize"
    },
    {
      "id": "pol-attrs-empty-value",
      "fn": "sanitize",
      "args": [
        "<p id=\"\" title=\"\">x</p>",
        {
          "allowedAttributes": {
            "p": [
              "id",
              "title"
            ]
          }
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "upstream drops an empty-valued non-boolean attribute unless it is in allowedEmptyAttributes"
    },
    {
      "id": "pol-attrs-empty-alt",
      "fn": "sanitize",
      "args": [
        "<img src=\"/a.png\" alt=\"\">",
        {
          "allowedTags": [
            "img"
          ]
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "alt IS in allowedEmptyAttributes, so an empty alt is kept"
    },
    {
      "id": "pol-attrs-boolean",
      "fn": "sanitize",
      "args": [
        "<input disabled>",
        {
          "allowedTags": [
            "input"
          ],
          "allowedAttributes": {
            "input": [
              "disabled"
            ]
          }
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "a valueless boolean attribute"
    },
    {
      "id": "pol-attrs-value-with-apostrophe",
      "fn": "sanitize",
      "args": [
        "<p title=\"it's\">x</p>",
        {
          "allowedAttributes": {
            "p": [
              "title"
            ]
          }
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "the output is double-quoted, so an apostrophe needs no escaping"
    },
    {
      "id": "pol-attrs-value-with-amp",
      "fn": "sanitize",
      "args": [
        "<p title=\"a&b &amp; c\">x</p>",
        {
          "allowedAttributes": {
            "p": [
              "title"
            ]
          }
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize"
    },
    {
      "id": "pol-attrs-value-newline",
      "fn": "sanitize",
      "args": [
        "<p title=\"a\nb\">x</p>",
        {
          "allowedAttributes": {
            "p": [
              "title"
            ]
          }
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize"
    },
    {
      "id": "pol-classes-filter",
      "fn": "sanitize",
      "args": [
        "<p class=\"ok bad also-ok\">x</p>",
        {
          "allowedClasses": {
            "p": [
              "ok",
              "also-ok"
            ]
          }
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize"
    },
    {
      "id": "pol-classes-glob",
      "fn": "sanitize",
      "args": [
        "<p class=\"pfx-a pfx-b other\">x</p>",
        {
          "allowedClasses": {
            "p": [
              "pfx-*"
            ]
          }
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize"
    },
    {
      "id": "pol-classes-star-tag",
      "fn": "sanitize",
      "args": [
        "<p class=\"ok bad\">x</p><b class=\"ok\">y</b>",
        {
          "allowedClasses": {
            "*": [
              "ok"
            ]
          }
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize"
    },
    {
      "id": "pol-classes-none-survive",
      "fn": "sanitize",
      "args": [
        "<p class=\"bad\">x</p>",
        {
          "allowedClasses": {
            "p": [
              "ok"
            ]
          }
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "no class survives: the attribute itself must go"
    },
    {
      "id": "pol-classes-implicit-permission",
      "fn": "sanitize",
      "args": [
        "<p class=\"ok\">x</p>",
        {
          "allowedClasses": {
            "p": [
              "ok"
            ]
          },
          "allowedAttributes": {}
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "naming a tag in allowedClasses implicitly permits its class attribute"
    },
    {
      "id": "pol-classes-star-class",
      "fn": "sanitize",
      "args": [
        "<p class=\"anything at all\">x</p>",
        {
          "allowedClasses": {
            "p": [
              "*"
            ]
          }
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize"
    },
    {
      "id": "pol-classes-multiple-spaces",
      "fn": "sanitize",
      "args": [
        "<p class=\"  ok   bad  \">x</p>",
        {
          "allowedClasses": {
            "p": [
              "ok"
            ]
          }
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize"
    },
    {
      "id": "pol-schemes-custom",
      "fn": "sanitize",
      "args": [
        "<a href=\"gopher://x\">y</a><a href=\"http://x\">z</a>",
        {
          "allowedSchemes": [
            "gopher"
          ]
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize"
    },
    {
      "id": "pol-schemes-empty",
      "fn": "sanitize",
      "args": [
        "<a href=\"http://x\">y</a><a href=\"/rel\">z</a>",
        {
          "allowedSchemes": []
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "an empty scheme allowlist rejects every scheme but keeps relative URLs"
    },
    {
      "id": "pol-schemes-by-tag",
      "fn": "sanitize",
      "args": [
        "<a href=\"ftp://x\">y</a><img src=\"ftp://x\">",
        {
          "allowedTags": [
            "a",
            "img"
          ],
          "allowedSchemesByTag": {
            "a": [
              "https"
            ]
          }
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "a per-tag override replaces the global list for that tag only"
    },
    {
      "id": "pol-schemes-by-tag-empty",
      "fn": "sanitize",
      "args": [
        "<a href=\"https://x\">y</a>",
        {
          "allowedSchemesByTag": {
            "a": []
          }
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize"
    },
    {
      "id": "pol-scheme-attrs-narrowed",
      "fn": "sanitize",
      "args": [
        "<a href=\"javascript:alert(1)\">y</a>",
        {
          "allowedSchemesAppliedToAttributes": [
            "src"
          ]
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "if href is not on the list, its URL is NOT checked — both sides let the payload through, which is the caller's doing"
    },
    {
      "id": "pol-scheme-attrs-action",
      "fn": "sanitize",
      "args": [
        "<form action=\"javascript:alert(1)\">x</form>",
        {
          "allowedTags": [
            "form"
          ],
          "allowedAttributes": {
            "form": [
              "action"
            ]
          }
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "action is on the DEFAULT scheme-checked list upstream"
    },
    {
      "id": "pol-scheme-attrs-formaction",
      "fn": "sanitize",
      "args": [
        "<button formaction=\"javascript:alert(1)\">x</button>",
        {
          "allowedTags": [
            "button"
          ],
          "allowedAttributes": {
            "button": [
              "formaction"
            ]
          }
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize",
      "note": "formaction on a submit button is a live javascript: sink"
    },
    {
      "id": "pol-scheme-attrs-poster",
      "fn": "sanitize",
      "args": [
        "<video poster=\"javascript:alert(1)\">x</video>",
        {
          "allowedTags": [
            "video"
          ],
          "allowedAttributes": {
            "video": [
              "poster"
            ]
          }
        }
      ],
      "upstreamFn": "sanitizeHtml",
      "goFn": "sanitizehtml.Sanitize"
    },
    {
      "id": "pol-scheme-attrs-xlink",
      "fn": "sanitize",
