{
  "group": "format-auto",
  "upstream": "bytes@3.1.2",
  "note": "bytes.format(number) with default options: two decimal places, trailing zeros trimmed, unit auto-selected as the largest whose magnitude is <= abs(value). The boundary rule is `mag >= map.X`, so each unit is probed at its exact threshold, one byte below and one byte above. Rounding is Number.prototype.toFixed, which breaks ties away from zero.",
  "cases": [
    { "id": "fa-zero",         "fn": "format", "args": [0],                    "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-one",          "fn": "format", "args": [1],                    "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-500",          "fn": "format", "args": [500],                  "upstreamFn": "bytes.format", "goFn": "bytes.Format", "note": "Readme: 500 -> '500B'" },
    { "id": "fa-999",          "fn": "format", "args": [999],                  "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-1000",         "fn": "format", "args": [1000],                 "upstreamFn": "bytes.format", "goFn": "bytes.Format", "note": "Readme: 1000 -> '1000B', the ladder is binary" },
    { "id": "fa-kb-under",     "fn": "format", "args": [1023],                 "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-kb",           "fn": "format", "args": [1024],                 "upstreamFn": "bytes.format", "goFn": "bytes.Format", "note": "test/bytes.js: bytes(1024) === '1KB'" },
    { "id": "fa-kb-over",      "fn": "format", "args": [1025],                 "upstreamFn": "bytes.format", "goFn": "bytes.Format", "note": "1.0009765625 rounds to 1.00 and then trims to '1KB'" },
    { "id": "fa-kb-1p5",       "fn": "format", "args": [1536],                 "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-mb-under",     "fn": "format", "args": [1048575],              "upstreamFn": "bytes.format", "goFn": "bytes.Format", "note": "still KB, and 1023.999 rounds up to '1024KB'" },
    { "id": "fa-mb",           "fn": "format", "args": [1048576],              "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-mb-over",      "fn": "format", "args": [1048577],              "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-mb-1p5",       "fn": "format", "args": [1572864],              "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-gb-under",     "fn": "format", "args": [1073741823],           "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-gb",           "fn": "format", "args": [1073741824],           "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-gb-over",      "fn": "format", "args": [1073741825],           "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-gb-1p5",       "fn": "format", "args": [1610612736],           "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-tb-under",     "fn": "format", "args": [1099511627775],        "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-tb",           "fn": "format", "args": [1099511627776],        "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-tb-over",      "fn": "format", "args": [1099511627777],        "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-pb-under",     "fn": "format", "args": [1125899906842623],     "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-pb",           "fn": "format", "args": [1125899906842624],     "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-pb-over",      "fn": "format", "args": [1125899906842625],     "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-pb-1p5",       "fn": "format", "args": [1688849860263936],     "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-pb-2",         "fn": "format", "args": [2251799813685248],     "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-int64max",     "fn": "format", "args": [9223372036854775807],  "upstreamFn": "bytes.format", "goFn": "bytes.Format", "note": "8191.999... PB rounds to '8192PB' on both sides even though the double has already lost the last bits" },
    { "id": "fa-int64min",     "fn": "format", "args": [-9223372036854775808], "upstreamFn": "bytes.format", "goFn": "bytes.Format", "note": "exactly -2^63 = -8192PB; negating it in place would overflow" },
    { "id": "fa-neg-1",        "fn": "format", "args": [-1],                   "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-neg-100",      "fn": "format", "args": [-100],                 "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-neg-1023",     "fn": "format", "args": [-1023],                "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-neg-kb",       "fn": "format", "args": [-1024],                "upstreamFn": "bytes.format", "goFn": "bytes.Format", "note": "the sign is kept; unit selection uses the magnitude" },
    { "id": "fa-neg-kb-1p5",   "fn": "format", "args": [-1536],                "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-neg-mb",       "fn": "format", "args": [-1048576],             "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-neg-gb-1p5",   "fn": "format", "args": [-1610612736],          "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-tie-1p125",    "fn": "format", "args": [1152],                 "upstreamFn": "bytes.format", "goFn": "bytes.Format", "note": "1.125 is an exact binary tie; toFixed(2) rounds away from zero -> 1.13" },
    { "id": "fa-tie-1p375",    "fn": "format", "args": [1408],                 "upstreamFn": "bytes.format", "goFn": "bytes.Format", "note": "1.375 -> 1.38 under either tie rule" },
    { "id": "fa-tie-3p125",    "fn": "format", "args": [3200],                 "upstreamFn": "bytes.format", "goFn": "bytes.Format", "note": "3.125 -> 3.13, not 3.12" },
    { "id": "fa-tie-neg",      "fn": "format", "args": [-1152],                "upstreamFn": "bytes.format", "goFn": "bytes.Format", "note": "toFixed splits the sign off first, so -1.125 -> '-1.13'" },
    { "id": "fa-round-1p156",  "fn": "format", "args": [1184],                 "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-round-1p205",  "fn": "format", "args": [1234],                 "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-round-mb",     "fn": "format", "args": [1234567],              "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-round-gb",     "fn": "format", "args": [1234567890],           "upstreamFn": "bytes.format", "goFn": "bytes.Format" },
    { "id": "fa-trim-all",     "fn": "format", "args": [2048],                 "upstreamFn": "bytes.format", "goFn": "bytes.Format", "note": "'2.00' trims to '2'" }
  ]
}
