{
  "group": "format-options",
  "upstream": "bytes@3.1.2",
  "note": "bytes.format(number, options) over every field of the options object and combinations of them. Upstream order of operations is: pick the unit (option first, auto-select only if the option is falsy or unrecognised) -> divide -> toFixed(decimalPlaces) -> trim trailing zeros unless fixedDecimals -> insert thousandsSeparator into the integer part only -> concatenate unitSeparator and the unit spelling as the caller wrote it.",
  "cases": [
    { "id": "fo-empty-opts",     "fn": "formatOpts", "args": [1024, {}],                                     "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },

    { "id": "fo-dp0-1740",       "fn": "formatOpts", "args": [1740, {"decimalPlaces": 0}],                   "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts", "note": "Readme: format(1024*1.7, {decimalPlaces:0}) -> '2KB'" },
    { "id": "fo-dp0-1536",       "fn": "formatOpts", "args": [1536, {"decimalPlaces": 0}],                   "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts", "note": "1.5 -> '2'" },
    { "id": "fo-dp0-2560",       "fn": "formatOpts", "args": [2560, {"decimalPlaces": 0}],                   "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts", "note": "2.5 -> '3': ties go away from zero, not to even" },
    { "id": "fo-dp0-neg-2560",   "fn": "formatOpts", "args": [-2560, {"decimalPlaces": 0}],                  "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts", "note": "-2.5 -> '-3'" },
    { "id": "fo-dp0-neg-small",  "fn": "formatOpts", "args": [-100, {"decimalPlaces": 0, "unit": "KB"}],     "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts", "note": "toFixed prefixes the sign before rounding the magnitude, so this is '-0KB'" },
    { "id": "fo-dp1",            "fn": "formatOpts", "args": [1536, {"decimalPlaces": 1}],                   "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-dp1-1434",       "fn": "formatOpts", "args": [1434, {"decimalPlaces": 1}],                   "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-dp2",            "fn": "formatOpts", "args": [1234567, {"decimalPlaces": 2}],               "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-dp3-1034",       "fn": "formatOpts", "args": [1034, {"decimalPlaces": 3}],                   "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts", "note": "toFixed gives '1.010'; the trim regexp /(?:\\.0*|(\\.[^0]+)0+)$/ cannot match a fraction that starts with 0, so the trailing zero SURVIVES upstream" },
    { "id": "fo-dp3-trim",       "fn": "formatOpts", "args": [1536, {"decimalPlaces": 3}],                   "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts", "note": "'1.500' does trim, to '1.5'" },
    { "id": "fo-dp4-1034",       "fn": "formatOpts", "args": [1034, {"decimalPlaces": 4}],                   "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-dp5",            "fn": "formatOpts", "args": [1234567, {"decimalPlaces": 5}],               "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-dp10",           "fn": "formatOpts", "args": [1234567, {"decimalPlaces": 10}],              "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-dp20-trim",      "fn": "formatOpts", "args": [1536, {"decimalPlaces": 20}],                  "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-dp0-zero",       "fn": "formatOpts", "args": [0, {"decimalPlaces": 0}],                      "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-dp-negative",    "fn": "formatOpts", "args": [1536, {"decimalPlaces": -1}],                  "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts", "deviation": "toFixed throws RangeError for digits outside 0..100; FormatOpts returns a string and has no error channel, so the port clamps into range instead" },
    { "id": "fo-dp-101",         "fn": "formatOpts", "args": [1536, {"decimalPlaces": 101}],                 "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts", "deviation": "as fo-dp-negative: upstream throws RangeError, the port clamps to 100" },
    { "id": "fo-dp-null",        "fn": "formatOpts", "args": [1536, {"decimalPlaces": null}],                "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts", "deviation": "upstream only checks `!== undefined`, so an explicit null becomes toFixed(null) == toFixed(0); a Go *int cannot distinguish JSON null from an absent key, so the default of 2 applies" },

    { "id": "fo-fixed",          "fn": "formatOpts", "args": [1024, {"fixedDecimals": true}],                "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-fixed-false",    "fn": "formatOpts", "args": [1024, {"fixedDecimals": false}],               "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-fixed-b",        "fn": "formatOpts", "args": [500, {"fixedDecimals": true}],                 "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-fixed-zero",     "fn": "formatOpts", "args": [0, {"fixedDecimals": true}],                   "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-fixed-dp0",      "fn": "formatOpts", "args": [1024, {"fixedDecimals": true, "decimalPlaces": 0}],  "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-fixed-dp4",      "fn": "formatOpts", "args": [1073741824, {"fixedDecimals": true, "decimalPlaces": 4}], "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-fixed-neg",      "fn": "formatOpts", "args": [-1536, {"fixedDecimals": true}],               "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },

    { "id": "fo-thou-1000",      "fn": "formatOpts", "args": [1000, {"thousandsSeparator": " "}],            "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts", "note": "test/bytes.js and Readme: '1 000B'" },
    { "id": "fo-thou-999",       "fn": "formatOpts", "args": [999, {"thousandsSeparator": ","}],             "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts", "note": "three digits get no separator" },
    { "id": "fo-thou-empty",     "fn": "formatOpts", "args": [1000, {"thousandsSeparator": ""}],             "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts", "note": "falsy separator means none" },
    { "id": "fo-thou-dot",       "fn": "formatOpts", "args": [1000, {"thousandsSeparator": "."}],            "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-thou-7digit",    "fn": "formatOpts", "args": [1234567, {"thousandsSeparator": ",", "unit": "B"}], "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-thou-neg",       "fn": "formatOpts", "args": [-1234567, {"thousandsSeparator": ",", "unit": "B"}], "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts", "note": "\\B fails between the sign and the first digit, so the sign is left alone" },
    { "id": "fo-thou-4digit",    "fn": "formatOpts", "args": [1048575, {"thousandsSeparator": ","}],          "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts", "note": "rounds to 1024 KB first, then groups" },
    { "id": "fo-thou-frac",      "fn": "formatOpts", "args": [1234567, {"thousandsSeparator": ",", "unit": "B", "fixedDecimals": true}], "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts", "note": "only the integer part is grouped" },
    { "id": "fo-thou-15digit",   "fn": "formatOpts", "args": [1125899906842624, {"thousandsSeparator": ",", "unit": "b"}], "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-thou-multichar", "fn": "formatOpts", "args": [1234567, {"thousandsSeparator": "__", "unit": "B"}], "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },

    { "id": "fo-usep-space",     "fn": "formatOpts", "args": [1024, {"unitSeparator": " "}],                 "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts", "note": "Readme: '1 KB'" },
    { "id": "fo-usep-dash",      "fn": "formatOpts", "args": [1024, {"unitSeparator": "-"}],                 "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-usep-empty",     "fn": "formatOpts", "args": [1024, {"unitSeparator": ""}],                  "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-usep-b",         "fn": "formatOpts", "args": [500, {"unitSeparator": " "}],                  "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-usep-neg",       "fn": "formatOpts", "args": [-1536, {"unitSeparator": " "}],                "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },

    { "id": "fo-unit-KB",        "fn": "formatOpts", "args": [1048576, {"unit": "KB"}],                      "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-unit-kb-lower",  "fn": "formatOpts", "args": [1048576, {"unit": "kb"}],                      "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts", "note": "the caller's spelling is echoed, only the lookup is case-folded" },
    { "id": "fo-unit-Mb-mixed",  "fn": "formatOpts", "args": [1073741824, {"unit": "Mb"}],                   "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-unit-B",         "fn": "formatOpts", "args": [2048, {"unit": "B"}],                          "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-unit-b-lower",   "fn": "formatOpts", "args": [2048, {"unit": "b"}],                          "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-unit-GB-small",  "fn": "formatOpts", "args": [1024, {"unit": "GB"}],                         "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts", "note": "underflows to '0GB' after trimming" },
    { "id": "fo-unit-PB-small",  "fn": "formatOpts", "args": [1024, {"unit": "PB"}],                         "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-unit-TB",        "fn": "formatOpts", "args": [1099511627776, {"unit": "tb"}],                "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-unit-bogus",     "fn": "formatOpts", "args": [1048576, {"unit": "bananas"}],                 "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts", "note": "unrecognised unit falls back to auto-selection" },
    { "id": "fo-unit-empty",     "fn": "formatOpts", "args": [1048576, {"unit": ""}],                        "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-unit-kib",       "fn": "formatOpts", "args": [1048576, {"unit": "KiB"}],                     "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts", "note": "'KiB' is not in the map either" },
    { "id": "fo-unit-zero",      "fn": "formatOpts", "args": [0, {"unit": "KB"}],                            "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-unit-neg",       "fn": "formatOpts", "args": [-1073741824, {"unit": "MB"}],                  "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-unit-b-2pow53",  "fn": "formatOpts", "args": [9007199254740993, {"unit": "B"}],              "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts", "deviation": "2^53+1 is not representable as a double, so upstream can only ever print the even neighbour; the port holds the exact int64" },

    { "id": "fo-all-fields",     "fn": "formatOpts", "args": [1610612736, {"decimalPlaces": 1, "fixedDecimals": true, "thousandsSeparator": ",", "unitSeparator": " ", "unit": "MB"}], "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-all-fields-neg", "fn": "formatOpts", "args": [-1610612736, {"decimalPlaces": 3, "fixedDecimals": false, "thousandsSeparator": " ", "unitSeparator": "_", "unit": "kb"}], "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-combo-tie",      "fn": "formatOpts", "args": [-1152, {"decimalPlaces": 2, "unitSeparator": " "}], "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-combo-fixed-thou","fn": "formatOpts","args": [1234567890, {"fixedDecimals": true, "thousandsSeparator": ",", "unit": "KB"}], "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" },
    { "id": "fo-combo-dp0-thou", "fn": "formatOpts", "args": [1234567890, {"decimalPlaces": 0, "thousandsSeparator": ",", "unit": "B"}], "upstreamFn": "bytes.format", "goFn": "bytes.FormatOpts" }
  ]
}
