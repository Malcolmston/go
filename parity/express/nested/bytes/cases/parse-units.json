{
  "group": "parse-units",
  "upstream": "bytes@3.1.2",
  "note": "bytes.parse(string) with a unit suffix. Upstream's grammar is /^((-|\\+)?(\\d+(?:\\.\\d+)?)) *(kb|mb|gb|tb|pb)$/i — note that `b` is NOT in the alternation and the pattern is anchored, so anything it does not match (including a `b` suffix, a tab before the unit, or any surrounding whitespace) falls through to JavaScript's parseInt(val, 10). Units are binary and case-insensitive; the product is Math.floor'd.",
  "cases": [
    { "id": "pu-kb-lower",     "fn": "parse", "args": ["1kb"],       "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-kb-upper",     "fn": "parse", "args": ["1KB"],       "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-kb-mixed-a",   "fn": "parse", "args": ["1Kb"],       "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-kb-mixed-b",   "fn": "parse", "args": ["1kB"],       "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-mb-lower",     "fn": "parse", "args": ["1mb"],       "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-mb-upper",     "fn": "parse", "args": ["1MB"],       "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-mb-mixed",     "fn": "parse", "args": ["1Mb"],       "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-gb-lower",     "fn": "parse", "args": ["1gb"],       "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-gb-upper",     "fn": "parse", "args": ["1GB"],       "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-gb-mixed",     "fn": "parse", "args": ["1gB"],       "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-tb-lower",     "fn": "parse", "args": ["1tb"],       "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-tb-upper",     "fn": "parse", "args": ["1TB"],       "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-pb-lower",     "fn": "parse", "args": ["1pb"],       "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-pb-upper",     "fn": "parse", "args": ["1PB"],       "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-b-lower",      "fn": "parse", "args": ["1b"],        "upstreamFn": "bytes.parse", "goFn": "bytes.Parse", "note": "`b` is absent from the grammar; parseInt(\"1b\") == 1 gets the same answer by accident" },
    { "id": "pu-b-upper",      "fn": "parse", "args": ["1B"],        "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-b-frac",       "fn": "parse", "args": ["1.5b"],      "upstreamFn": "bytes.parse", "goFn": "bytes.Parse", "note": "parseInt stops at the dot: 1, which happens to equal floor(1.5)" },
    { "id": "pu-b-neg-frac",   "fn": "parse", "args": ["-1.5b"],     "upstreamFn": "bytes.parse", "goFn": "bytes.Parse", "note": "parseInt gives -1 where floor(-1.5) would give -2" },
    { "id": "pu-b-big",        "fn": "parse", "args": ["4096b"],     "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-kb-frac",      "fn": "parse", "args": ["1.5kb"],     "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-kb-frac-25",   "fn": "parse", "args": ["1.25kb"],    "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-kb-frac-half", "fn": "parse", "args": ["0.5kb"],     "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-kb-frac-tiny", "fn": "parse", "args": ["0.0001kb"],  "upstreamFn": "bytes.parse", "goFn": "bytes.Parse", "note": "floor(0.1024) == 0" },
    { "id": "pu-kb-neg",       "fn": "parse", "args": ["-1kb"],      "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-kb-neg-frac",  "fn": "parse", "args": ["-1.5kb"],    "upstreamFn": "bytes.parse", "goFn": "bytes.Parse", "note": "matches the grammar, so Math.floor(-1536) == -1536" },
    { "id": "pu-kb-neg-tiny",  "fn": "parse", "args": ["-0.0001kb"], "upstreamFn": "bytes.parse", "goFn": "bytes.Parse", "note": "floor(-0.1024) == -1, floored toward -Infinity" },
    { "id": "pu-kb-plus",      "fn": "parse", "args": ["+1kb"],      "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-kb-plus-frac", "fn": "parse", "args": ["+1.5kb"],    "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-kb-space",     "fn": "parse", "args": ["1 kb"],      "upstreamFn": "bytes.parse", "goFn": "bytes.Parse", "note": "the grammar allows spaces before the unit" },
    { "id": "pu-kb-spaces",    "fn": "parse", "args": ["1   kb"],    "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-kb-tab",       "fn": "parse", "args": ["1\tkb"],     "upstreamFn": "bytes.parse", "goFn": "bytes.Parse", "note": "a tab is not ` `, so the grammar misses and parseInt yields 1" },
    { "id": "pu-kb-lead-space","fn": "parse", "args": [" 1kb"],      "upstreamFn": "bytes.parse", "goFn": "bytes.Parse", "note": "anchored grammar: leading whitespace demotes this to parseInt -> 1 byte, NOT 1024" },
    { "id": "pu-kb-trail-space","fn": "parse","args": ["1kb "],      "upstreamFn": "bytes.parse", "goFn": "bytes.Parse", "note": "trailing whitespace likewise demotes to parseInt -> 1" },
    { "id": "pu-kb-newline",   "fn": "parse", "args": ["\n1kb"],     "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-kb-zero",      "fn": "parse", "args": ["0kb"],       "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-kb-neg-zero",  "fn": "parse", "args": ["-0kb"],      "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-pb-frac",      "fn": "parse", "args": ["1.5pb"],     "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-tb-1023",      "fn": "parse", "args": ["1023tb"],    "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-gb-frac-long", "fn": "parse", "args": ["2.75gb"],    "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-word-byte",    "fn": "parse", "args": ["1 byte"],    "upstreamFn": "bytes.parse", "goFn": "bytes.Parse", "note": "no grammar match; parseInt salvages the leading 1" },
    { "id": "pu-word-kilo",    "fn": "parse", "args": ["5 kilobytes"],"upstreamFn": "bytes.parse","goFn": "bytes.Parse", "note": "parseInt -> 5 BYTES, silently ignoring the unit the caller wrote" },
    { "id": "pu-unit-zb",      "fn": "parse", "args": ["1zb"],       "upstreamFn": "bytes.parse", "goFn": "bytes.Parse", "note": "unknown unit is not rejected: parseInt -> 1" },
    { "id": "pu-unit-kib",     "fn": "parse", "args": ["1kib"],      "upstreamFn": "bytes.parse", "goFn": "bytes.Parse" },
    { "id": "pu-unit-only-kb", "fn": "parse", "args": ["kb"],        "upstreamFn": "bytes.parse", "goFn": "bytes.Parse", "note": "no digits at all: both sides must fail" }
  ]
}
