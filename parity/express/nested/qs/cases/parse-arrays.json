{
  "group": "parse-arrays",
  "upstream": "qs@6.15.3",
  "note": "Empty-bracket pushes and numeric-index arrays, including gaps, out-of-order indices and indices past arrayLimit. The arrayLimit guard is the reason a[999999]=x cannot be used to force a huge allocation: past the limit the index becomes an ordinary object key. Note that upstream's test is index < arrayLimit, so the limit value itself is already out of range.",
  "cases": [
    { "id": "a-push-one",          "fn": "parse", "args": ["a[]=b"],                    "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "a-push-two",          "fn": "parse", "args": ["a[]=b&a[]=c"],              "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "a-push-three",        "fn": "parse", "args": ["a[]=1&a[]=2&a[]=3"],        "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "a-push-empty-value",  "fn": "parse", "args": ["a[]="],                     "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "a-push-no-equals",    "fn": "parse", "args": ["a[]"],                      "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "a-index-zero",        "fn": "parse", "args": ["a[0]=b"],                   "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "a-index-pair",        "fn": "parse", "args": ["a[0]=b&a[1]=c"],            "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "a-index-gap",         "fn": "parse", "args": ["a[1]=b&a[15]=c"],           "upstreamFn": "qs.parse", "goFn": "qs.Parse", "note": "holes are compacted away by default" },
    { "id": "a-index-single-gap",  "fn": "parse", "args": ["a[1]=b"],                   "upstreamFn": "qs.parse", "goFn": "qs.Parse", "note": "index 1 with nothing at 0 compacts to a one-element array" },
    { "id": "a-index-out-of-order", "fn": "parse", "args": ["a[2]=c&a[0]=a&a[1]=b"],    "upstreamFn": "qs.parse", "goFn": "qs.Parse", "note": "indices order the result, not appearance" },
    { "id": "a-index-reverse",     "fn": "parse", "args": ["a[3]=d&a[2]=c"],            "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "a-index-limit-edge",  "fn": "parse", "args": ["a[19]=b"],                  "upstreamFn": "qs.parse", "goFn": "qs.Parse", "note": "the last index that is still an array at the default limit of 20" },
    { "id": "a-index-limit-at",    "fn": "parse", "args": ["a[20]=b"],                  "upstreamFn": "qs.parse", "goFn": "qs.Parse", "note": "upstream tests index < arrayLimit, so 20 is already an object key" },
    { "id": "a-index-past-limit",  "fn": "parse", "args": ["a[21]=b"],                  "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "a-index-huge",        "fn": "parse", "args": ["a[999999]=b"],              "upstreamFn": "qs.parse", "goFn": "qs.Parse", "note": "adversarial: a short input must not allocate a million slots" },
    { "id": "a-index-overflow",    "fn": "parse", "args": ["a[99999999999999999999]=b"], "upstreamFn": "qs.parse", "goFn": "qs.Parse", "note": "not a canonical integer once round-tripped, so an ordinary key" },
    { "id": "a-index-leading-zero", "fn": "parse", "args": ["a[01]=b"],                 "upstreamFn": "qs.parse", "goFn": "qs.Parse", "note": "'01' is not canonical, so an object key" },
    { "id": "a-index-negative",    "fn": "parse", "args": ["a[-1]=b"],                  "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "a-index-plus",        "fn": "parse", "args": ["a[+1]=b"],                  "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "a-index-mixed-key",   "fn": "parse", "args": ["a[0]=b&a[x]=c"],            "upstreamFn": "qs.parse", "goFn": "qs.Parse", "note": "one non-index sibling turns the whole thing into an object" },
    { "id": "a-index-then-push",   "fn": "parse", "args": ["a[0]=b&a[]=c"],             "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "a-push-then-index",   "fn": "parse", "args": ["a[]=b&a[0]=c"],             "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "a-nested-index",      "fn": "parse", "args": ["a[0][b]=c&a[1][b]=d"],      "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "a-nested-push",       "fn": "parse", "args": ["a[b][]=1&a[b][]=2"],        "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "a-array-of-arrays",   "fn": "parse", "args": ["a[0][]=1&a[1][]=2"],        "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "a-limit-1",           "fn": "parse", "args": ["a[0]=b&a[1]=c", { "arrayLimit": 1 }], "upstreamFn": "qs.parse", "goFn": "qs.ParseWith", "note": "arrayLimit 1: only index 0 can be an array slot" },
    { "id": "a-limit-0",           "fn": "parse", "args": ["a[0]=b", { "arrayLimit": -1 }],       "upstreamFn": "qs.parse", "goFn": "qs.ParseWith", "note": "the port spells 'never build arrays from indices' as a negative limit; upstream reaches the same place with arrayLimit 0" },
    { "id": "a-limit-large",       "fn": "parse", "args": ["a[100]=b", { "arrayLimit": 200 }],    "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "a-push-limit-1",      "fn": "parse", "args": ["a[]=1&a[]=2", { "arrayLimit": 1 }],       "upstreamFn": "qs.parse", "goFn": "qs.ParseWith", "note": "one push over the limit already forces the object fallback" },
    { "id": "a-many-empty",        "fn": "parse", "args": ["a[][][]=1"],                     "upstreamFn": "qs.parse", "goFn": "qs.Parse", "note": "three pushes deep" },
    { "id": "a-index-in-push",     "fn": "parse", "args": ["a[][0]=b"],                      "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "a-push-in-index",     "fn": "parse", "args": ["a[0][]=b"],                      "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "a-limit-push-over",   "fn": "parse", "args": ["a[]=1&a[]=2&a[]=3", { "arrayLimit": 2 }], "upstreamFn": "qs.parse", "goFn": "qs.ParseWith", "note": "more pushes than arrayLimit: upstream falls back to an index-keyed object" }
  ]
}
