{
  "group": "stringify-options",
  "upstream": "qs@6.15.3",
  "note": "Each documented stringify option, over the same handful of inputs. \"sort\" is the harness's own knob rather than the port's: it is the code-unit key comparator upstream needs to match the port's always-sorted output, and the Go runner ignores it.",
  "cases": [
    { "id": "t-af-indices",       "fn": "stringify", "args": [{ "a": ["b", "c"] }, { "arrayFormat": "indices" }],   "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-af-brackets",      "fn": "stringify", "args": [{ "a": ["b", "c"] }, { "arrayFormat": "brackets" }],  "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-af-repeat",        "fn": "stringify", "args": [{ "a": ["b", "c"] }, { "arrayFormat": "repeat" }],    "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-af-comma",         "fn": "stringify", "args": [{ "a": ["b", "c"] }, { "arrayFormat": "comma" }],     "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-af-comma-one",     "fn": "stringify", "args": [{ "a": ["b"] }, { "arrayFormat": "comma" }],          "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-af-comma-encode",  "fn": "stringify", "args": [{ "a": ["b c", "d"] }, { "arrayFormat": "comma" }],   "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith", "note": "the joined value is encoded as one component, so the ',' itself is escaped" },
    { "id": "t-af-indices-nested", "fn": "stringify", "args": [{ "a": { "b": ["1", "2"] } }, { "arrayFormat": "indices" }],  "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-af-brackets-nested", "fn": "stringify", "args": [{ "a": { "b": ["1", "2"] } }, { "arrayFormat": "brackets" }], "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-af-repeat-nested", "fn": "stringify", "args": [{ "a": { "b": ["1", "2"] } }, { "arrayFormat": "repeat" }],    "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-af-brackets-objects", "fn": "stringify", "args": [{ "a": [{ "b": "1" }] }, { "arrayFormat": "brackets" }],    "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-af-repeat-objects", "fn": "stringify", "args": [{ "a": [{ "b": "1" }, { "b": "2" }] }, { "arrayFormat": "repeat" }], "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-fmt-3986",         "fn": "stringify", "args": [{ "a": "b c" }, { "format": "RFC3986" }],             "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-fmt-1738",         "fn": "stringify", "args": [{ "a": "b c" }, { "format": "RFC1738" }],             "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith", "note": "RFC1738 writes a space as '+'" },
    { "id": "t-fmt-1738-parens",  "fn": "stringify", "args": [{ "a": "(b)" }, { "format": "RFC1738" }],             "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith", "note": "RFC1738 leaves parentheses unescaped" },
    { "id": "t-fmt-1738-nested",  "fn": "stringify", "args": [{ "a": { "b c": "d e" } }, { "format": "RFC1738" }],   "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-fmt-1738-array",   "fn": "stringify", "args": [{ "a": ["b c"] }, { "format": "RFC1738" }],           "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-fmt-bad",          "fn": "stringify", "args": [{ "a": "b" }, { "format": "RFC9999" }],               "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith", "deviation": "Upstream throws a TypeError for an unknown format. StringifyWith returns only a string, so an unrecognised Format selects FormatRFC3986, the documented default, rather than raising.", "note": "see express/API-DEVIATIONS.md" },
    { "id": "t-prefix-on",        "fn": "stringify", "args": [{ "a": "b" }, { "addQueryPrefix": true }],            "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-prefix-empty",     "fn": "stringify", "args": [{}, { "addQueryPrefix": true }],                      "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith", "note": "no prefix on an empty result" },
    { "id": "t-prefix-off",       "fn": "stringify", "args": [{ "a": "b" }, { "addQueryPrefix": false }],           "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-delim-semi",       "fn": "stringify", "args": [{ "a": "b", "c": "d" }, { "delimiter": ";" }],        "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-delim-comma",      "fn": "stringify", "args": [{ "a": "b", "c": "d" }, { "delimiter": "," }],        "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-dots-on",          "fn": "stringify", "args": [{ "a": { "b": "c" } }, { "allowDots": true }],        "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-dots-deep",        "fn": "stringify", "args": [{ "a": { "b": { "c": "d" } } }, { "allowDots": true }], "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-dots-array",       "fn": "stringify", "args": [{ "a": { "b": ["1", "2"] } }, { "allowDots": true }],  "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith", "note": "allowDots does not change how array indices are keyed" },
    { "id": "t-encode-false",     "fn": "stringify", "args": [{ "a": { "b": "c" } }, { "encode": false }],          "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith", "note": "brackets stay literal" },
    { "id": "t-encode-false-space", "fn": "stringify", "args": [{ "a b": "c d" }, { "encode": false }],             "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-encode-false-array", "fn": "stringify", "args": [{ "a": ["b", "c"] }, { "encode": false }],          "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-values-only",      "fn": "stringify", "args": [{ "a": { "b": "c d" } }, { "encodeValuesOnly": true }], "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith", "note": "keys verbatim, values encoded" },
    { "id": "t-values-only-array", "fn": "stringify", "args": [{ "a": ["b c", "d"] }, { "encodeValuesOnly": true }],  "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-skip-nulls",       "fn": "stringify", "args": [{ "a": "b", "c": null }, { "skipNulls": true }],       "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-skip-nulls-nested", "fn": "stringify", "args": [{ "a": { "b": null, "c": "d" } }, { "skipNulls": true }], "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-null-strict",      "fn": "stringify", "args": [{ "a": null, "b": "" }, { "strictNullHandling": true }], "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith", "note": "null loses its '=' entirely; '' keeps it" },
    { "id": "t-null-strict-nested", "fn": "stringify", "args": [{ "a": { "b": null } }, { "strictNullHandling": true }], "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-empty-arrays-on",  "fn": "stringify", "args": [{ "a": [] }, { "allowEmptyArrays": true }],            "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-empty-arrays-nested", "fn": "stringify", "args": [{ "a": { "b": [] } }, { "allowEmptyArrays": true }],  "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-empty-arrays-off", "fn": "stringify", "args": [{ "a": [] }, { "allowEmptyArrays": false }],           "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "t-combo",            "fn": "stringify", "args": [{ "a": { "b": ["1", "2"] }, "c": "d e" }, { "arrayFormat": "brackets", "format": "RFC1738", "addQueryPrefix": true }], "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith", "note": "options compose" }
  ]
}
