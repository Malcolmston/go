{
  "group": "stringify-basic",
  "upstream": "qs@6.15.3",
  "note": "Serialisation with the upstream defaults: arrayFormat 'indices', RFC3986 encoding, '&' delimiter, no query prefix. Key order is part of the output string, so the harness hands upstream its own `sort` option with a code-unit comparator — the same order the port's sort.Strings gives. Array indices are keys too, so these cases keep arrays under ten elements, where \"0\"..\"9\" sort identically as text and as numbers.",
  "cases": [
    { "id": "s-empty",            "fn": "stringify", "args": [{}],                                    "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith", "note": "an empty object serialises to the empty string" },
    { "id": "s-single",           "fn": "stringify", "args": [{ "a": "b" }],                          "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "s-two",              "fn": "stringify", "args": [{ "a": "b", "c": "d" }],                "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "s-order",            "fn": "stringify", "args": [{ "z": "1", "a": "2", "M": "3" }],       "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith", "note": "code-unit order puts 'M' before 'a'" },
    { "id": "s-empty-value",      "fn": "stringify", "args": [{ "a": "" }],                           "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "s-empty-key",        "fn": "stringify", "args": [{ "": "b" }],                           "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "s-nested-one",       "fn": "stringify", "args": [{ "a": { "b": "c" } }],                 "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith", "note": "brackets are percent-encoded by default" },
    { "id": "s-nested-two",       "fn": "stringify", "args": [{ "a": { "b": { "c": "d" } } }],         "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "s-nested-five",      "fn": "stringify", "args": [{ "a": { "b": { "c": { "d": { "e": "f" } } } } }], "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith", "note": "stringify has no depth cap" },
    { "id": "s-nested-siblings",  "fn": "stringify", "args": [{ "a": { "b": "1", "c": "2" } }],        "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "s-empty-object",     "fn": "stringify", "args": [{ "a": {} }],                           "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith", "note": "an empty object contributes nothing" },
    { "id": "s-empty-object-deep", "fn": "stringify", "args": [{ "a": { "b": {} }, "c": "d" }],        "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "s-array-default",    "fn": "stringify", "args": [{ "a": ["b", "c"] }],                   "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith", "note": "the default arrayFormat is 'indices'" },
    { "id": "s-array-one",        "fn": "stringify", "args": [{ "a": ["b"] }],                        "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "s-array-empty",      "fn": "stringify", "args": [{ "a": [] }],                           "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "s-array-of-objects", "fn": "stringify", "args": [{ "a": [{ "b": "1" }, { "b": "2" }] }],  "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "s-array-nested",     "fn": "stringify", "args": [{ "a": [["b", "c"]] }],                 "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "s-object-of-arrays", "fn": "stringify", "args": [{ "a": { "b": ["1", "2"] } }],           "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "s-space-value",      "fn": "stringify", "args": [{ "a": "b c" }],                        "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith", "note": "RFC3986 writes a space as %20" },
    { "id": "s-space-key",        "fn": "stringify", "args": [{ "a b": "c" }],                        "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "s-reserved-value",   "fn": "stringify", "args": [{ "a": "b&c=d?e#f" }],                  "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith", "note": "every reserved character must be escaped or the output re-parses differently" },
    { "id": "s-unreserved",       "fn": "stringify", "args": [{ "a": "-._~AZaz09" }],                 "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith", "note": "the unreserved set survives verbatim" },
    { "id": "s-parens",           "fn": "stringify", "args": [{ "a": "(b)" }],                        "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith", "note": "parentheses are escaped under RFC3986" },
    { "id": "s-utf8",             "fn": "stringify", "args": [{ "a": "✓" }],                          "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "s-utf8-key",         "fn": "stringify", "args": [{ "✓": "a" }],                          "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "s-astral",           "fn": "stringify", "args": [{ "a": "😀" }],                          "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith", "note": "a surrogate pair must encode as four UTF-8 octets" },
    { "id": "s-bracket-in-key",   "fn": "stringify", "args": [{ "a[b]": "c" }],                       "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith", "note": "literal brackets in a key encode the same as structural ones" },
    { "id": "s-bool",             "fn": "stringify", "args": [{ "a": true, "b": false }],             "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "s-number",           "fn": "stringify", "args": [{ "a": 1, "b": 0, "c": -12 }],          "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "s-null",             "fn": "stringify", "args": [{ "a": null }],                         "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith", "note": "without strictNullHandling a null is the empty string" },
    { "id": "s-null-nested",      "fn": "stringify", "args": [{ "a": { "b": null } }],                "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" },
    { "id": "s-proto-key",        "fn": "stringify", "args": [{ "__proto__": "x" }],                  "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith", "note": "stringify has no prototype guard: the key is emitted as data" },
    { "id": "s-constructor-key",  "fn": "stringify", "args": [{ "constructor": { "prototype": { "x": "y" } } }], "upstreamFn": "qs.stringify", "goFn": "qs.StringifyWith" }
  ]
}
