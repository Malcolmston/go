{
  "group": "parse-options",
  "upstream": "qs@6.15.3",
  "note": "The documented parse options are part of the upstream surface, so each one gets cases. Numeric limits use the port's convention — 0 means 'the documented default', a negative value means 'no limit' — and case files spell upstream's Infinity as the string \"Infinity\" so the same JSON feeds both runners.",
  "cases": [
    { "id": "o-delim-semi",        "fn": "parse", "args": ["a=b;c=d", { "delimiter": ";" }],                "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-delim-comma",       "fn": "parse", "args": ["a=b,c=d", { "delimiter": "," }],                "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-delim-unused",      "fn": "parse", "args": ["a=b&c=d", { "delimiter": ";" }],                "upstreamFn": "qs.parse", "goFn": "qs.ParseWith", "note": "with ';' the whole '&'-joined string is one pair" },
    { "id": "o-delim-multichar",   "fn": "parse", "args": ["a=b--c=d", { "delimiter": "--" }],              "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-prefix-on",         "fn": "parse", "args": ["?a=b&c=d", { "ignoreQueryPrefix": true }],      "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-prefix-off",        "fn": "parse", "args": ["?a=b&c=d", { "ignoreQueryPrefix": false }],     "upstreamFn": "qs.parse", "goFn": "qs.ParseWith", "note": "explicitly off: '?a' is the key" },
    { "id": "o-prefix-only",       "fn": "parse", "args": ["?", { "ignoreQueryPrefix": true }],             "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-prefix-double",     "fn": "parse", "args": ["??a=b", { "ignoreQueryPrefix": true }],         "upstreamFn": "qs.parse", "goFn": "qs.ParseWith", "note": "only one '?' is stripped" },
    { "id": "o-dots-one",          "fn": "parse", "args": ["a.b=c", { "allowDots": true }],                 "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-dots-two",          "fn": "parse", "args": ["a.b.c=d", { "allowDots": true }],               "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-dots-mixed",        "fn": "parse", "args": ["a.b[c]=d", { "allowDots": true }],              "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-dots-bracket-first", "fn": "parse", "args": ["a[b].c=d", { "allowDots": true }],             "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-dots-trailing",     "fn": "parse", "args": ["a.=b", { "allowDots": true }],                  "upstreamFn": "qs.parse", "goFn": "qs.ParseWith", "note": "a '.' with nothing after it is literal" },
    { "id": "o-dots-leading",      "fn": "parse", "args": [".a=b", { "allowDots": true }],                  "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-dots-double",       "fn": "parse", "args": ["a..b=c", { "allowDots": true }],                "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-dots-index",        "fn": "parse", "args": ["a.0=b&a.1=c", { "allowDots": true }],           "upstreamFn": "qs.parse", "goFn": "qs.ParseWith", "note": "dotted numeric segments still build an array" },
    { "id": "o-dots-off",          "fn": "parse", "args": ["a.b=c", { "allowDots": false }],                "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-param-limit-1",     "fn": "parse", "args": ["a=b&c=d&e=f", { "parameterLimit": 1 }],         "upstreamFn": "qs.parse", "goFn": "qs.ParseWith", "note": "surplus pairs are silently dropped, not an error" },
    { "id": "o-param-limit-2",     "fn": "parse", "args": ["a=b&c=d&e=f", { "parameterLimit": 2 }],         "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-param-limit-big",   "fn": "parse", "args": ["a=b&c=d", { "parameterLimit": 1000 }],          "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-param-limit-inf",   "fn": "parse", "args": ["a=b&c=d", { "parameterLimit": "Infinity" }],    "upstreamFn": "qs.parse", "goFn": "qs.ParseWith", "note": "upstream Infinity, port negative: no limit" },
    { "id": "o-depth-1",           "fn": "parse", "args": ["a[b][c]=d", { "depth": 1 }],                    "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-depth-2",           "fn": "parse", "args": ["a[b][c][d]=e", { "depth": 2 }],                 "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-depth-10",          "fn": "parse", "args": ["a[b][c][d][e][f][g]=h", { "depth": 10 }],       "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-depth-inf",         "fn": "parse", "args": ["a[b][c][d][e][f][g]=h", { "depth": "Infinity" }], "upstreamFn": "qs.parse", "goFn": "qs.ParseWith", "note": "no cap at all" },
    { "id": "o-depth-zero",        "fn": "parse", "args": ["a[b]=c", { "depth": 0 }],                       "upstreamFn": "qs.parse", "goFn": "qs.ParseWith", "deviation": "The port's int options use 0 to mean 'the documented default', so upstream's depth: 0 — which disables bracket parsing so that 'a[b]' stays one literal key — is not expressible. Parse such input with net/url instead.", "note": "see express/API-DEVIATIONS.md" },
    { "id": "o-null-strict",       "fn": "parse", "args": ["a&b=", { "strictNullHandling": true }],         "upstreamFn": "qs.parse", "goFn": "qs.ParseWith", "note": "a bare key is null, an empty value is ''" },
    { "id": "o-null-strict-nested", "fn": "parse", "args": ["a[b]", { "strictNullHandling": true }],        "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-null-strict-off",   "fn": "parse", "args": ["a&b=", { "strictNullHandling": false }],        "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-comma-on",          "fn": "parse", "args": ["a=b,c", { "comma": true }],                     "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-comma-three",       "fn": "parse", "args": ["a=b,c,d", { "comma": true }],                   "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-comma-off",         "fn": "parse", "args": ["a=b,c", { "comma": false }],                    "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-comma-nested",      "fn": "parse", "args": ["a[b]=c,d", { "comma": true }],                  "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-comma-empty",       "fn": "parse", "args": ["a=,", { "comma": true }],                       "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-empty-arrays-on",   "fn": "parse", "args": ["a[]=", { "allowEmptyArrays": true }],           "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" },
    { "id": "o-empty-arrays-off",  "fn": "parse", "args": ["a[]=", { "allowEmptyArrays": false }],          "upstreamFn": "qs.parse", "goFn": "qs.ParseWith" }
  ]
}
