{
  "group": "parse-nesting",
  "upstream": "qs@6.15.3",
  "note": "Bracket nesting at every depth, including past the default depth cap of five. Beyond the cap upstream stops consuming brackets and stores the whole unconsumed remainder as one literal key, which is what keeps a hostile key from allocating one object per bracket pair.",
  "cases": [
    { "id": "n-one",              "fn": "parse", "args": ["a[b]=c"],                          "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "n-two",              "fn": "parse", "args": ["a[b][c]=d"],                       "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "n-three",            "fn": "parse", "args": ["a[b][c][d]=e"],                    "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "n-four",             "fn": "parse", "args": ["a[b][c][d][e]=f"],                 "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "n-five",             "fn": "parse", "args": ["a[b][c][d][e][f]=g"],              "upstreamFn": "qs.parse", "goFn": "qs.Parse", "note": "exactly at the default depth" },
    { "id": "n-six-past-cap",     "fn": "parse", "args": ["a[b][c][d][e][f][g]=h"],           "upstreamFn": "qs.parse", "goFn": "qs.Parse", "note": "one level past the cap: the remainder becomes the literal key '[g]'" },
    { "id": "n-eight-past-cap",   "fn": "parse", "args": ["a[b][c][d][e][f][g][h][i]=j"],     "upstreamFn": "qs.parse", "goFn": "qs.Parse", "note": "three levels past the cap" },
    { "id": "n-siblings",         "fn": "parse", "args": ["a[b]=c&a[d]=e"],                   "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "n-siblings-deep",    "fn": "parse", "args": ["a[b][c]=1&a[b][d]=2&a[e]=3"],      "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "n-two-roots",        "fn": "parse", "args": ["a[b]=c&d[e]=f"],                   "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "n-empty-inner-key",  "fn": "parse", "args": ["a[]=b"],                           "upstreamFn": "qs.parse", "goFn": "qs.Parse", "note": "an empty bracket pair makes an array" },
    { "id": "n-empty-then-key",   "fn": "parse", "args": ["a[][b]=c"],                        "upstreamFn": "qs.parse", "goFn": "qs.Parse", "note": "an array of objects" },
    { "id": "n-key-then-empty",   "fn": "parse", "args": ["a[b][]=c"],                        "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "n-unterminated",     "fn": "parse", "args": ["a[b=c"],                           "upstreamFn": "qs.parse", "goFn": "qs.Parse", "note": "no closing bracket: the remainder stays literal" },
    { "id": "n-unterminated-deep", "fn": "parse", "args": ["a[b][c=d"],                       "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "n-nested-brackets",  "fn": "parse", "args": ["a[b[c]]=d"],                       "upstreamFn": "qs.parse", "goFn": "qs.Parse", "note": "brackets inside a group are balanced, not split" },
    { "id": "n-leading-bracket",  "fn": "parse", "args": ["[a]=b"],                           "upstreamFn": "qs.parse", "goFn": "qs.Parse", "note": "no parent before the first '['" },
    { "id": "n-leading-bracket-deep", "fn": "parse", "args": ["[a][b]=c"],                    "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "n-double-close",     "fn": "parse", "args": ["a[b]]=c"],                         "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "n-empty-bracket-key", "fn": "parse", "args": ["a[]b=c"],                         "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "n-scalar-then-nest", "fn": "parse", "args": ["a=b&a[c]=d"],                      "upstreamFn": "qs.parse", "goFn": "qs.Parse", "note": "a scalar seen before an object at the same path" },
    { "id": "n-nest-then-scalar", "fn": "parse", "args": ["a[c]=d&a=b"],                      "upstreamFn": "qs.parse", "goFn": "qs.Parse", "note": "and the other way round" },
    { "id": "n-deep-then-shallow", "fn": "parse", "args": ["a[b][c]=1&a[b]=2"],               "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "n-empty-mid",        "fn": "parse", "args": ["a[b][][c]=d"],                    "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "n-only-brackets",    "fn": "parse", "args": ["[]=a"],                            "upstreamFn": "qs.parse", "goFn": "qs.Parse", "note": "a key that is nothing but an empty bracket pair" },
    { "id": "n-open-only",        "fn": "parse", "args": ["[=a"],                             "upstreamFn": "qs.parse", "goFn": "qs.Parse" },
    { "id": "n-hundred-brackets", "fn": "parse", "args": ["a[b][c][d][e][f][g][h][i][j][k][l][m][n][o][p][q][r][s][t][u][v][w][x][y][z]=1"], "upstreamFn": "qs.parse", "goFn": "qs.Parse", "note": "adversarial: 25 bracket levels must still cost only the capped five" }
  ]
}
