    {
      "id": "rej-wrong-secret",
      "fn": "verify",
      "args": [
        "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpYXQiOjE3MDAwMDAwMDAsInN1YiI6InVzZXItMSJ9.Qc-1lRaHILrMAgqzr_O-Gw7py7JklrpE7L65-pBzUFc",
        {
          "kind": "oct",
          "secret": "a-completely-different-secret-value"
        },
        {
          "clockTimestamp": 1700000100,
          "algorithms": [
            "HS256"
          ]
        }
      ],
      "upstreamFn": "jwt.verify",
      "goFn": "jsonwebtoken.Verify",
      "note": "must fail on both sides"
    },
