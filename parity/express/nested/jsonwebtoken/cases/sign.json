        },
        {
          "expiresIn": 3600
        }
      ],
      "upstreamFn": "jwt.sign",
      "goFn": "jsonwebtoken.Sign",
      "note": "exp is measured from the payload iat"
    },
    {
      "id": "sign-not-before-seconds",
      "fn": "sign",
      "args": [
        {
          "iat": 1700000000
        },
        {
          "kind": "oct",
          "secret": "parity-hmac-secret-256-bits-long-enough"
        },
        {
          "notBefore": 60
        }
      ],
      "upstreamFn": "jwt.sign",
      "goFn": "jsonwebtoken.Sign"
    },
    {
      "id": "sign-expires-and-not-before",
      "fn": "sign",
      "args": [
        {
          "iat": 1700000000
        },
        {
          "kind": "oct",
          "secret": "parity-hmac-secret-256-bits-long-enough"
        },
        {
          "expiresIn": 3600,
          "notBefore": 60
        }
      ],
      "upstreamFn": "jwt.sign",
      "goFn": "jsonwebtoken.Sign"
    },
    {
      "id": "sign-negative-expires-in",
      "fn": "sign",
      "args": [
        {
          "iat": 1700000000
        },
        {
          "kind": "oct",
          "secret": "parity-hmac-secret-256-bits-long-enough"
        },
        {
          "expiresIn": -3600
        }
      ],
      "upstreamFn": "jwt.sign",
      "goFn": "jsonwebtoken.Sign",
      "note": "a negative expiresIn mints an already-expired token",
      "deviation": "the port treats only a positive ExpiresIn as set, since a time.Duration has no \"absent\" value; upstream honours a negative one"
    },
    {
      "id": "sign-zero-expires-in",
      "fn": "sign",
      "args": [
        {
          "iat": 1700000000
        },
        {
          "kind": "oct",
          "secret": "parity-hmac-secret-256-bits-long-enough"
        },
        {
          "expiresIn": 0
        }
      ],
      "upstreamFn": "jwt.sign",
      "goFn": "jsonwebtoken.Sign",
      "note": "zero means \"expires at iat\" upstream",
      "deviation": "the port treats a zero ExpiresIn as \"option not set\", since a time.Duration has no \"absent\" value"
    },
