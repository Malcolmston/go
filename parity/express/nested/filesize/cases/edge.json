    {
      "id": "err-not-a-number",
      "fn": "filesize",
      "args": [
        "abc"
      ],
      "upstreamFn": "filesize",
      "goFn": "filesize.FileSize",
      "note": "ERROR case: Number('abc') is NaN, so upstream throws"
    },
    {
      "id": "edge-max-safe-integer",
      "fn": "filesize",
      "args": [
        9007199254740991
      ],
      "upstreamFn": "filesize",
      "goFn": "filesize.FileSize"
    },
