{
  "group": "edge",
  "upstream": "filesize@11.0.22",
  "note": "Combined options, non-finite and non-numeric input (upstream throws), and the extremes of the range.",
  "cases": [
    {
      "id": "comb-iec-round0",
      "fn": "filesizeOpts",
      "args": [
        1536,
        {
          "standard": "iec",
          "round": 0
        }
      ],
      "upstreamFn": "filesize",
      "goFn": "filesize.FileSizeOpts"
    },
    {
      "id": "comb-jedec-round1",
      "fn": "filesizeOpts",
      "args": [
        1536,
        {
          "standard": "jedec",
          "round": 1
        }
      ],
      "upstreamFn": "filesize",
      "goFn": "filesize.FileSizeOpts"
    },
    {
      "id": "comb-base2-round3",
      "fn": "filesizeOpts",
      "args": [
        1234567,
        {
          "base": 2,
          "round": 3
        }
      ],
      "upstreamFn": "filesize",
      "goFn": "filesize.FileSizeOpts"
    },
    {
      "id": "comb-si-round0-neg",
      "fn": "filesizeOpts",
      "args": [
        -1234567,
        {
          "standard": "si",
          "round": 0
        }
      ],
      "upstreamFn": "filesize",
      "goFn": "filesize.FileSizeOpts"
    },
    {
      "id": "comb-empty-opts",
      "fn": "filesizeOpts",
      "args": [
        1337,
        {}
      ],
      "upstreamFn": "filesize",
      "goFn": "filesize.FileSizeOpts",
      "note": "an empty options object must behave like the defaults"
    },
    {
      "id": "comb-null-opts",
      "fn": "filesize",
      "args": [
        1337
      ],
      "upstreamFn": "filesize",
      "goFn": "filesize.FileSize"
    },
    {
      "id": "err-nan",
      "fn": "filesize",
      "args": [
        "NaN"
      ],
      "upstreamFn": "filesize",
      "goFn": "filesize.FileSize",
      "note": "ERROR case: upstream throws TypeError('Invalid number')"
    },
    {
      "id": "err-infinity",
      "fn": "filesize",
      "args": [
        "Infinity"
      ],
      "upstreamFn": "filesize",
      "goFn": "filesize.FileSize",
      "note": "ERROR case: upstream throws"
    },
    {
      "id": "err-neg-infinity",
