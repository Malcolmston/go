    { "id": "ext-image-svg", "fn": "extension", "args": ["image/svg+xml"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-image-webp", "fn": "extension", "args": ["image/webp"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-image-x-icon", "fn": "extension", "args": ["image/x-icon"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-image-ms-icon", "fn": "extension", "args": ["image/vnd.microsoft.icon"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-image-bmp", "fn": "extension", "args": ["image/bmp"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-image-tiff", "fn": "extension", "args": ["image/tiff"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension", "note": "\"tif\" is listed first" },
    { "id": "ext-video-mp4", "fn": "extension", "args": ["video/mp4"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-video-mpeg", "fn": "extension", "args": ["video/mpeg"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-video-quicktime", "fn": "extension", "args": ["video/quicktime"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension", "note": "\"qt\" is listed before \"mov\"" },
    { "id": "ext-video-webm", "fn": "extension", "args": ["video/webm"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-video-x-msvideo", "fn": "extension", "args": ["video/x-msvideo"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-audio-mpeg", "fn": "extension", "args": ["audio/mpeg"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension", "note": "\"mpga\" is listed before \"mp3\"" },
    { "id": "ext-audio-mp4", "fn": "extension", "args": ["audio/mp4"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-audio-ogg", "fn": "extension", "args": ["audio/ogg"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-audio-wav", "fn": "extension", "args": ["audio/wav"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-audio-wave", "fn": "extension", "args": ["audio/wave"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-audio-opus", "fn": "extension", "args": ["audio/opus"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension", "note": "mime-db lists no extension for audio/opus" },
    { "id": "ext-audio-flac", "fn": "extension", "args": ["audio/flac"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-audio-x-flac", "fn": "extension", "args": ["audio/x-flac"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-font-woff", "fn": "extension", "args": ["font/woff"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-font-woff2", "fn": "extension", "args": ["font/woff2"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-font-ttf", "fn": "extension", "args": ["font/ttf"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-font-otf", "fn": "extension", "args": ["font/otf"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-with-params", "fn": "extension", "args": ["image/svg+xml; charset=utf-8"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension", "note": "parameters are stripped before lookup" },
    { "id": "ext-uppercase", "fn": "extension", "args": ["TEXT/HTML"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-leading-space", "fn": "extension", "args": ["  text/html"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-unknown", "fn": "extension", "args": ["bogus/type"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-empty", "fn": "extension", "args": [""], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-not-a-type", "fn": "extension", "args": ["nonsense"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" }
