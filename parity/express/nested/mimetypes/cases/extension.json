{
  "group": "extension",
  "upstream": "mime-types@2.1.35",
  "note": "mime.extension(type) — the first extension mime-db lists for a type, which is not always the most familiar one (audio/mpeg is \"mpga\", video/quicktime is \"qt\").",
  "cases": [
    { "id": "ext-text-html", "fn": "extension", "args": ["text/html"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-text-css", "fn": "extension", "args": ["text/css"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-text-plain", "fn": "extension", "args": ["text/plain"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-text-csv", "fn": "extension", "args": ["text/csv"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-text-markdown", "fn": "extension", "args": ["text/markdown"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension", "note": "\"markdown\" comes before \"md\" in mime-db" },
    { "id": "ext-text-yaml", "fn": "extension", "args": ["text/yaml"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-text-calendar", "fn": "extension", "args": ["text/calendar"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-text-xml", "fn": "extension", "args": ["text/xml"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-text-javascript", "fn": "extension", "args": ["text/javascript"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension", "note": "mime-db lists no extensions for text/javascript at this version" },
    { "id": "ext-app-javascript", "fn": "extension", "args": ["application/javascript"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-app-json", "fn": "extension", "args": ["application/json"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-app-xml", "fn": "extension", "args": ["application/xml"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-app-pdf", "fn": "extension", "args": ["application/pdf"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-app-zip", "fn": "extension", "args": ["application/zip"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
