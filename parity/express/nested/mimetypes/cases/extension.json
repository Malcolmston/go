    { "id": "ext-app-rar", "fn": "extension", "args": ["application/vnd.rar"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-app-7z", "fn": "extension", "args": ["application/x-7z-compressed"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-app-wasm", "fn": "extension", "args": ["application/wasm"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-app-octet-stream", "fn": "extension", "args": ["application/octet-stream"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-app-msword", "fn": "extension", "args": ["application/msword"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
