    { "id": "ext-app-powerpoint", "fn": "extension", "args": ["application/vnd.ms-powerpoint"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-app-rtf", "fn": "extension", "args": ["application/rtf"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-app-fontobject", "fn": "extension", "args": ["application/vnd.ms-fontobject"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-app-ld-json", "fn": "extension", "args": ["application/ld+json"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
    { "id": "ext-image-png", "fn": "extension", "args": ["image/png"], "upstreamFn": "mime.extension", "goFn": "mimetypes.Extension" },
