{
  "group": "encodings",
  "upstream": "negotiator@0.6.3",
  "note": "Negotiator#encoding / #encodings — Accept-Encoding parsing plus the implicit \"identity\" encoding that upstream injects at minimal quality.",
  "cases": [
    { "id": "enc-all-no-header", "fn": "encodings", "args": [{}, null], "upstreamFn": "Negotiator#encodings", "goFn": "Negotiator.Encodings", "note": "no header: only the implicit identity is acceptable" },
    { "id": "enc-all-empty-header", "fn": "encodings", "args": [{ "Accept-Encoding": "" }, null], "upstreamFn": "Negotiator#encodings", "goFn": "Negotiator.Encodings" },
    { "id": "enc-all-sorted", "fn": "encodings", "args": [{ "Accept-Encoding": "gzip;q=0.3, br;q=0.9, deflate" }, null], "upstreamFn": "Negotiator#encodings", "goFn": "Negotiator.Encodings", "note": "identity is appended last at its minimal implicit quality" },
    { "id": "enc-all-drops-q-zero", "fn": "encodings", "args": [{ "Accept-Encoding": "gzip;q=0, br" }, null], "upstreamFn": "Negotiator#encodings", "goFn": "Negotiator.Encodings" },
    { "id": "enc-all-keeps-star", "fn": "encodings", "args": [{ "Accept-Encoding": "gzip, *;q=0.1" }, null], "upstreamFn": "Negotiator#encodings", "goFn": "Negotiator.Encodings", "note": "the wildcard is reported verbatim and satisfies identity, so no identity is appended" },
    { "id": "enc-all-explicit-identity", "fn": "encodings", "args": [{ "Accept-Encoding": "identity;q=0.5, gzip" }, null], "upstreamFn": "Negotiator#encodings", "goFn": "Negotiator.Encodings" },
    { "id": "enc-all-identity-refused", "fn": "encodings", "args": [{ "Accept-Encoding": "gzip, identity;q=0" }, null], "upstreamFn": "Negotiator#encodings", "goFn": "Negotiator.Encodings" },
    { "id": "enc-all-star-refused", "fn": "encodings", "args": [{ "Accept-Encoding": "gzip, *;q=0" }, null], "upstreamFn": "Negotiator#encodings", "goFn": "Negotiator.Encodings" },
    { "id": "enc-all-preserves-case", "fn": "encodings", "args": [{ "Accept-Encoding": "GZIP" }, null], "upstreamFn": "Negotiator#encodings", "goFn": "Negotiator.Encodings" },
    { "id": "enc-all-malformed-q", "fn": "encodings", "args": [{ "Accept-Encoding": "gzip;q=abc" }, null], "upstreamFn": "Negotiator#encodings", "goFn": "Negotiator.Encodings" },
    { "id": "enc-all-trailing-comma", "fn": "encodings", "args": [{ "Accept-Encoding": "gzip," }, null], "upstreamFn": "Negotiator#encodings", "goFn": "Negotiator.Encodings" },
    { "id": "enc-all-internal-space", "fn": "encodings", "args": [{ "Accept-Encoding": "gzip deflate" }, null], "upstreamFn": "Negotiator#encodings", "goFn": "Negotiator.Encodings", "note": "the encoding grammar forbids whitespace in the token" },
    { "id": "enc-pick-exact", "fn": "encoding", "args": [{ "Accept-Encoding": "gzip" }, ["gzip"]], "upstreamFn": "Negotiator#encoding", "goFn": "Negotiator.Encoding" },
    { "id": "enc-pick-miss", "fn": "encoding", "args": [{ "Accept-Encoding": "gzip" }, ["br"]], "upstreamFn": "Negotiator#encoding", "goFn": "Negotiator.Encoding" },
    { "id": "enc-pick-q", "fn": "encoding", "args": [{ "Accept-Encoding": "gzip;q=0.2, br;q=0.9" }, ["gzip", "br"]], "upstreamFn": "Negotiator#encoding", "goFn": "Negotiator.Encoding" },
    { "id": "enc-pick-q-zero", "fn": "encoding", "args": [{ "Accept-Encoding": "gzip;q=0, deflate" }, ["gzip", "deflate"]], "upstreamFn": "Negotiator#encoding", "goFn": "Negotiator.Encoding" },
    { "id": "enc-pick-star", "fn": "encoding", "args": [{ "Accept-Encoding": "*" }, ["gzip", "br"]], "upstreamFn": "Negotiator#encoding", "goFn": "Negotiator.Encoding" },
    { "id": "enc-pick-star-exclusion", "fn": "encoding", "args": [{ "Accept-Encoding": "*, gzip;q=0" }, ["gzip", "br"]], "upstreamFn": "Negotiator#encoding", "goFn": "Negotiator.Encoding" },
    { "id": "enc-pick-exact-over-star", "fn": "encoding", "args": [{ "Accept-Encoding": "*;q=0.9, br;q=0.5" }, ["gzip", "br"]], "upstreamFn": "Negotiator#encoding", "goFn": "Negotiator.Encoding" },
    { "id": "enc-pick-identity-implicit", "fn": "encoding", "args": [{ "Accept-Encoding": "gzip" }, ["identity"]], "upstreamFn": "Negotiator#encoding", "goFn": "Negotiator.Encoding" },
    { "id": "enc-pick-identity-loses", "fn": "encoding", "args": [{ "Accept-Encoding": "gzip" }, ["identity", "gzip"]], "upstreamFn": "Negotiator#encoding", "goFn": "Negotiator.Encoding", "note": "the implicit identity has the minimum quality, so gzip wins" },
    { "id": "enc-pick-identity-refused", "fn": "encoding", "args": [{ "Accept-Encoding": "gzip, identity;q=0" }, ["identity"]], "upstreamFn": "Negotiator#encoding", "goFn": "Negotiator.Encoding" },
    { "id": "enc-pick-identity-refused-star", "fn": "encoding", "args": [{ "Accept-Encoding": "gzip, *;q=0" }, ["identity"]], "upstreamFn": "Negotiator#encoding", "goFn": "Negotiator.Encoding" },
    { "id": "enc-pick-identity-explicit-wins", "fn": "encoding", "args": [{ "Accept-Encoding": "identity;q=1, gzip;q=0.5" }, ["gzip", "identity"]], "upstreamFn": "Negotiator#encoding", "goFn": "Negotiator.Encoding" },
    { "id": "enc-pick-no-header-gzip", "fn": "encoding", "args": [{}, ["gzip"]], "upstreamFn": "Negotiator#encoding", "goFn": "Negotiator.Encoding" },
    { "id": "enc-pick-no-header-identity", "fn": "encoding", "args": [{}, ["identity"]], "upstreamFn": "Negotiator#encoding", "goFn": "Negotiator.Encoding" },
    { "id": "enc-pick-empty-header-gzip", "fn": "encoding", "args": [{ "Accept-Encoding": "" }, ["gzip"]], "upstreamFn": "Negotiator#encoding", "goFn": "Negotiator.Encoding" },
    { "id": "enc-pick-empty-header-identity", "fn": "encoding", "args": [{ "Accept-Encoding": "" }, ["identity"]], "upstreamFn": "Negotiator#encoding", "goFn": "Negotiator.Encoding" },
    { "id": "enc-pick-case-header", "fn": "encoding", "args": [{ "Accept-Encoding": "GZIP" }, ["gzip"]], "upstreamFn": "Negotiator#encoding", "goFn": "Negotiator.Encoding" },
    { "id": "enc-pick-case-available", "fn": "encoding", "args": [{ "Accept-Encoding": "gzip" }, ["GZIP"]], "upstreamFn": "Negotiator#encoding", "goFn": "Negotiator.Encoding" },
    { "id": "enc-list-multi", "fn": "encodings", "args": [{ "Accept-Encoding": "gzip;q=0.5, br;q=0.9, deflate;q=0.1" }, ["deflate", "gzip", "br"]], "upstreamFn": "Negotiator#encodings", "goFn": "Negotiator.Encodings" },
    { "id": "enc-list-with-identity", "fn": "encodings", "args": [{ "Accept-Encoding": "gzip" }, ["gzip", "identity", "br"]], "upstreamFn": "Negotiator#encodings", "goFn": "Negotiator.Encodings" },
    { "id": "enc-list-star-keeps-order", "fn": "encodings", "args": [{ "Accept-Encoding": "*" }, ["br", "gzip"]], "upstreamFn": "Negotiator#encodings", "goFn": "Negotiator.Encodings" },
    { "id": "enc-list-empty-result", "fn": "encodings", "args": [{ "Accept-Encoding": "gzip" }, ["br"]], "upstreamFn": "Negotiator#encodings", "goFn": "Negotiator.Encodings" },
    { "id": "enc-alias-preferred", "fn": "preferredEncoding", "args": [{ "Accept-Encoding": "gzip;q=0.1, br" }, ["gzip", "br"]], "upstreamFn": "Negotiator#preferredEncoding", "goFn": "Negotiator.Encoding", "note": "backwards-compatibility alias" }
  ]
}
