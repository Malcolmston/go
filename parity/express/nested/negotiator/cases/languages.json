{
  "group": "languages",
  "upstream": "negotiator@0.6.3",
  "note": "Negotiator#language / #languages — Accept-Language parsing, prefix matching, wildcards, q-values and malformed input.",
  "cases": [
    { "id": "lang-all-no-header", "fn": "languages", "args": [{}, null], "upstreamFn": "Negotiator#languages", "goFn": "Negotiator.Languages", "note": "absent header defaults to *" },
    { "id": "lang-all-empty-header", "fn": "languages", "args": [{ "Accept-Language": "" }, null], "upstreamFn": "Negotiator#languages", "goFn": "Negotiator.Languages" },
    { "id": "lang-all-sorted", "fn": "languages", "args": [{ "Accept-Language": "en;q=0.3, fr;q=0.9, de" }, null], "upstreamFn": "Negotiator#languages", "goFn": "Negotiator.Languages" },
    { "id": "lang-all-drops-q-zero", "fn": "languages", "args": [{ "Accept-Language": "en;q=0, fr" }, null], "upstreamFn": "Negotiator#languages", "goFn": "Negotiator.Languages" },
    { "id": "lang-all-keeps-star", "fn": "languages", "args": [{ "Accept-Language": "fr, *;q=0.1" }, null], "upstreamFn": "Negotiator#languages", "goFn": "Negotiator.Languages" },
    { "id": "lang-all-preserves-case", "fn": "languages", "args": [{ "Accept-Language": "EN-us" }, null], "upstreamFn": "Negotiator#languages", "goFn": "Negotiator.Languages" },
    { "id": "lang-all-malformed-q", "fn": "languages", "args": [{ "Accept-Language": "en;q=abc" }, null], "upstreamFn": "Negotiator#languages", "goFn": "Negotiator.Languages" },
    { "id": "lang-all-invalid-tag", "fn": "languages", "args": [{ "Accept-Language": "en_US" }, null], "upstreamFn": "Negotiator#languages", "goFn": "Negotiator.Languages", "note": "the grammar wants tag[-subtag], so an underscore is not a valid tag" },
    { "id": "lang-all-trailing-comma", "fn": "languages", "args": [{ "Accept-Language": "en," }, null], "upstreamFn": "Negotiator#languages", "goFn": "Negotiator.Languages" },
    { "id": "lang-all-three-part", "fn": "languages", "args": [{ "Accept-Language": "zh-Hant-TW" }, null], "upstreamFn": "Negotiator#languages", "goFn": "Negotiator.Languages", "note": "a three-part tag does not match the two-part grammar" },
    { "id": "lang-pick-exact", "fn": "language", "args": [{ "Accept-Language": "en" }, ["en"]], "upstreamFn": "Negotiator#language", "goFn": "Negotiator.Language" },
    { "id": "lang-pick-miss", "fn": "language", "args": [{ "Accept-Language": "en" }, ["fr"]], "upstreamFn": "Negotiator#language", "goFn": "Negotiator.Language" },
    { "id": "lang-pick-q", "fn": "language", "args": [{ "Accept-Language": "en;q=0.3, fr;q=0.7" }, ["en", "fr"]], "upstreamFn": "Negotiator#language", "goFn": "Negotiator.Language" },
    { "id": "lang-pick-q-zero", "fn": "language", "args": [{ "Accept-Language": "en;q=0, fr" }, ["en", "fr"]], "upstreamFn": "Negotiator#language", "goFn": "Negotiator.Language" },
    { "id": "lang-pick-star", "fn": "language", "args": [{ "Accept-Language": "*" }, ["en", "fr"]], "upstreamFn": "Negotiator#language", "goFn": "Negotiator.Language" },
    { "id": "lang-pick-star-exclusion", "fn": "language", "args": [{ "Accept-Language": "*, en;q=0" }, ["en", "fr"]], "upstreamFn": "Negotiator#language", "goFn": "Negotiator.Language" },
    { "id": "lang-pick-prefix-header-broad", "fn": "language", "args": [{ "Accept-Language": "en" }, ["en-US"]], "upstreamFn": "Negotiator#language", "goFn": "Negotiator.Language", "note": "a prefix-only spec matches a more specific available tag" },
    { "id": "lang-pick-prefix-offer-broad", "fn": "language", "args": [{ "Accept-Language": "en-US" }, ["en"]], "upstreamFn": "Negotiator#language", "goFn": "Negotiator.Language", "note": "specify() also matches when the available tag is the bare prefix" },
    { "id": "lang-pick-subtag-mismatch", "fn": "language", "args": [{ "Accept-Language": "en-US" }, ["en-GB"]], "upstreamFn": "Negotiator#language", "goFn": "Negotiator.Language" },
    { "id": "lang-pick-exact-beats-prefix", "fn": "language", "args": [{ "Accept-Language": "en, en-US" }, ["en-US"]], "upstreamFn": "Negotiator#language", "goFn": "Negotiator.Language" },
    { "id": "lang-pick-specificity-over-q", "fn": "language", "args": [{ "Accept-Language": "en;q=0.9, en-US;q=0.5" }, ["en-US"]], "upstreamFn": "Negotiator#language", "goFn": "Negotiator.Language" },
    { "id": "lang-pick-case-header", "fn": "language", "args": [{ "Accept-Language": "EN-us" }, ["en-US"]], "upstreamFn": "Negotiator#language", "goFn": "Negotiator.Language" },
    { "id": "lang-pick-case-available", "fn": "language", "args": [{ "Accept-Language": "en-us" }, ["EN-US"]], "upstreamFn": "Negotiator#language", "goFn": "Negotiator.Language" },
    { "id": "lang-pick-no-header", "fn": "language", "args": [{}, ["fr", "en"]], "upstreamFn": "Negotiator#language", "goFn": "Negotiator.Language" },
    { "id": "lang-pick-empty-header", "fn": "language", "args": [{ "Accept-Language": "" }, ["fr", "en"]], "upstreamFn": "Negotiator#language", "goFn": "Negotiator.Language" },
    { "id": "lang-pick-three-part-available", "fn": "language", "args": [{ "Accept-Language": "zh" }, ["zh-Hant-TW"]], "upstreamFn": "Negotiator#language", "goFn": "Negotiator.Language" },
    { "id": "lang-pick-invalid-available", "fn": "language", "args": [{ "Accept-Language": "*" }, ["en_US"]], "upstreamFn": "Negotiator#language", "goFn": "Negotiator.Language", "note": "an available value that fails the tag grammar can never match" },
    { "id": "lang-list-multi", "fn": "languages", "args": [{ "Accept-Language": "en;q=0.5, fr;q=0.9, de;q=0.1" }, ["de", "en", "fr"]], "upstreamFn": "Negotiator#languages", "goFn": "Negotiator.Languages" },
    { "id": "lang-list-filters", "fn": "languages", "args": [{ "Accept-Language": "en" }, ["fr", "en", "de"]], "upstreamFn": "Negotiator#languages", "goFn": "Negotiator.Languages" },
    { "id": "lang-list-star-keeps-order", "fn": "languages", "args": [{ "Accept-Language": "*" }, ["fr", "en", "de"]], "upstreamFn": "Negotiator#languages", "goFn": "Negotiator.Languages" },
    { "id": "lang-list-prefix-group", "fn": "languages", "args": [{ "Accept-Language": "en" }, ["en-US", "en-GB", "en"]], "upstreamFn": "Negotiator#languages", "goFn": "Negotiator.Languages", "note": "the exact match outranks the two prefix matches" },
    { "id": "lang-alias-preferred", "fn": "preferredLanguage", "args": [{ "Accept-Language": "fr;q=0.2, en" }, ["fr", "en"]], "upstreamFn": "Negotiator#preferredLanguage", "goFn": "Negotiator.Language", "note": "backwards-compatibility alias" }
  ]
}
