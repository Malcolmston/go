{
  "group": "media-types",
  "upstream": "negotiator@0.6.3",
  "note": "Negotiator#mediaType / #mediaTypes — Accept header parsing, q-values, specificity ordering, media-type parameters, quoted parameters and malformed input.",
  "cases": [
    { "id": "mt-all-no-header", "fn": "mediaTypes", "args": [{}, null], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes", "note": "RFC 2616 sec 14.2: an absent Accept header means */*" },
    { "id": "mt-all-empty-header", "fn": "mediaTypes", "args": [{ "Accept": "" }, null], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes", "note": "present but empty is not the same as absent" },
    { "id": "mt-all-simple", "fn": "mediaTypes", "args": [{ "Accept": "text/html" }, null], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes" },
    { "id": "mt-all-sorted", "fn": "mediaTypes", "args": [{ "Accept": "text/plain;q=0.1, text/html;q=0.9, application/json;q=0.5" }, null], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes" },
    { "id": "mt-all-stable-on-tie", "fn": "mediaTypes", "args": [{ "Accept": "text/html, application/json, text/plain" }, null], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes", "note": "equal quality keeps the header order" },
    { "id": "mt-all-drops-q-zero", "fn": "mediaTypes", "args": [{ "Accept": "text/html;q=0, application/json" }, null], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes" },
    { "id": "mt-all-strips-params", "fn": "mediaTypes", "args": [{ "Accept": "text/html;level=1;q=0.8" }, null], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes" },
    { "id": "mt-all-preserves-case", "fn": "mediaTypes", "args": [{ "Accept": "Text/HTML" }, null], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes" },
    { "id": "mt-all-wildcards", "fn": "mediaTypes", "args": [{ "Accept": "text/*, */*;q=0.1" }, null], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes" },
    { "id": "mt-all-malformed-dropped", "fn": "mediaTypes", "args": [{ "Accept": "bogus, text/html" }, null], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes", "note": "an entry with no slash does not match the media-type grammar" },
    { "id": "mt-all-malformed-only", "fn": "mediaTypes", "args": [{ "Accept": "bogus" }, null], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes" },
    { "id": "mt-all-empty-subtype", "fn": "mediaTypes", "args": [{ "Accept": "text/" }, null], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes" },
    { "id": "mt-all-empty-type", "fn": "mediaTypes", "args": [{ "Accept": "/html" }, null], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes" },
    { "id": "mt-all-internal-space", "fn": "mediaTypes", "args": [{ "Accept": "text/html extra" }, null], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes", "note": "the subtype grammar forbids whitespace, so the whole entry is invalid" },
    { "id": "mt-all-space-before-slash", "fn": "mediaTypes", "args": [{ "Accept": "text /html" }, null], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes" },
    { "id": "mt-all-malformed-q", "fn": "mediaTypes", "args": [{ "Accept": "text/html;q=abc" }, null], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes", "note": "parseFloat gives NaN, which is not > 0, so the entry is unacceptable" },
    { "id": "mt-all-empty-q", "fn": "mediaTypes", "args": [{ "Accept": "text/html;q=" }, null], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes" },
    { "id": "mt-all-bare-q", "fn": "mediaTypes", "args": [{ "Accept": "text/html;q" }, null], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes" },
    { "id": "mt-all-trailing-comma", "fn": "mediaTypes", "args": [{ "Accept": "text/html," }, null], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes" },
    { "id": "mt-all-quoted-comma", "fn": "mediaTypes", "args": [{ "Accept": "text/html;foo=\"bar,baz\", application/json" }, null], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes" },
    { "id": "mt-pick-exact", "fn": "mediaType", "args": [{ "Accept": "text/html" }, ["text/html"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType" },
    { "id": "mt-pick-miss", "fn": "mediaType", "args": [{ "Accept": "text/html" }, ["application/json"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType" },
    { "id": "mt-pick-client-order", "fn": "mediaType", "args": [{ "Accept": "text/html, application/json" }, ["application/json", "text/html"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType", "note": "on a quality tie the client's ordering wins over the server's" },
    { "id": "mt-pick-q", "fn": "mediaType", "args": [{ "Accept": "text/html;q=0.2, application/json;q=0.9" }, ["text/html", "application/json"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType" },
    { "id": "mt-pick-specificity", "fn": "mediaType", "args": [{ "Accept": "*/*, text/plain" }, ["text/html", "text/plain"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType" },
    { "id": "mt-pick-specificity-over-q", "fn": "mediaType", "args": [{ "Accept": "text/*;q=0.9, text/plain;q=0.5" }, ["text/html", "text/plain"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType", "note": "getMediaTypePriority compares specificity before quality" },
    { "id": "mt-pick-subtype-star", "fn": "mediaType", "args": [{ "Accept": "text/*" }, ["application/json", "text/plain"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType" },
    { "id": "mt-pick-type-star", "fn": "mediaType", "args": [{ "Accept": "*/json" }, ["application/json"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType", "note": "a wildcard type with a concrete subtype is legal in the grammar" },
    { "id": "mt-pick-q-zero", "fn": "mediaType", "args": [{ "Accept": "text/html;q=0, application/json" }, ["text/html", "application/json"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType" },
    { "id": "mt-pick-q-zero-specific", "fn": "mediaType", "args": [{ "Accept": "*/*, text/html;q=0" }, ["text/html", "application/json"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType", "note": "the more specific q=0 refusal beats the wildcard" },
    { "id": "mt-pick-no-header", "fn": "mediaType", "args": [{}, ["application/json", "text/html"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType" },
    { "id": "mt-pick-empty-header", "fn": "mediaType", "args": [{ "Accept": "" }, ["application/json"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType", "note": "an empty header accepts nothing" },
    { "id": "mt-pick-case", "fn": "mediaType", "args": [{ "Accept": "TEXT/HTML" }, ["text/html"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType" },
    { "id": "mt-pick-available-case", "fn": "mediaType", "args": [{ "Accept": "text/html" }, ["TEXT/HTML"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType", "note": "the available value is echoed with its original casing" },
    { "id": "mt-pick-param-required", "fn": "mediaType", "args": [{ "Accept": "text/html;level=1" }, ["text/html"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType", "note": "a spec parameter the available type lacks makes the spec inapplicable" },
    { "id": "mt-pick-param-match", "fn": "mediaType", "args": [{ "Accept": "text/html;level=1" }, ["text/html;level=1"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType" },
    { "id": "mt-pick-param-wrong-value", "fn": "mediaType", "args": [{ "Accept": "text/html;level=1" }, ["text/html;level=2"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType" },
    { "id": "mt-pick-param-wildcard-value", "fn": "mediaType", "args": [{ "Accept": "text/html;level=*" }, ["text/html;level=2"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType", "note": "specify() treats a spec parameter value of * as matching anything" },
    { "id": "mt-pick-param-two", "fn": "mediaType", "args": [{ "Accept": "text/html;a=1;b=2" }, ["text/html;a=1;b=2"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType", "note": "the parameter contribution to specificity is a single bit, not a count" },
    { "id": "mt-pick-param-vs-plain", "fn": "mediaType", "args": [{ "Accept": "text/html;a=1;b=2;q=0.5, text/html;q=0.4" }, ["text/html;a=1;b=2"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType" },
    { "id": "mt-pick-param-quoted", "fn": "mediaType", "args": [{ "Accept": "text/html;foo=\"bar\"" }, ["text/html;foo=bar"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType", "note": "quotes around a spec parameter value are stripped" },
    { "id": "mt-pick-param-case", "fn": "mediaType", "args": [{ "Accept": "text/html;Level=ONE" }, ["text/html;level=one"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType", "note": "parameter names and values compare case-insensitively" },
    { "id": "mt-pick-params-after-q-ignored", "fn": "mediaType", "args": [{ "Accept": "text/html;q=0.5;level=1" }, ["text/html"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType", "note": "parsing stops at q, so level is an accept-extension and not part of matching" },
    { "id": "mt-pick-invalid-available", "fn": "mediaType", "args": [{ "Accept": "*/*" }, ["bogus"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType", "note": "an available value that is not a media type can never match" },
    { "id": "mt-pick-malformed-header", "fn": "mediaType", "args": [{ "Accept": "bogus" }, ["text/html"]], "upstreamFn": "Negotiator#mediaType", "goFn": "Negotiator.MediaType" },
    { "id": "mt-list-multi", "fn": "mediaTypes", "args": [{ "Accept": "text/html;q=0.5, application/json;q=0.9, text/plain;q=0.1" }, ["text/plain", "text/html", "application/json"]], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes" },
    { "id": "mt-list-filters-unacceptable", "fn": "mediaTypes", "args": [{ "Accept": "text/html" }, ["application/json", "text/html", "text/plain"]], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes" },
    { "id": "mt-list-wildcard-keeps-server-order", "fn": "mediaTypes", "args": [{ "Accept": "*/*" }, ["text/plain", "application/json", "text/html"]], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes" },
    { "id": "mt-list-duplicate-available", "fn": "mediaTypes", "args": [{ "Accept": "text/html" }, ["text/html", "text/html"]], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes", "note": "upstream maps back through indexOf, which collapses duplicates" },
    { "id": "mt-list-empty-result", "fn": "mediaTypes", "args": [{ "Accept": "image/png" }, ["text/html"]], "upstreamFn": "Negotiator#mediaTypes", "goFn": "Negotiator.MediaTypes" },
    { "id": "mt-alias-preferred", "fn": "preferredMediaType", "args": [{ "Accept": "text/html;q=0.2, application/json" }, ["text/html", "application/json"]], "upstreamFn": "Negotiator#preferredMediaType", "goFn": "Negotiator.MediaType", "note": "backwards-compatibility alias" }
  ]
}
