{
  "group": "sign",
  "upstream": "cookie-signature@1.2.2",
  "note": "Fixed secrets throughout. cookie-signature is a deterministic HMAC-SHA256 over the value, so no clock, key generation or randomness is involved.",
  "cases": [
    {
      "id": "sign-simple",
      "fn": "sign",
      "args": [
        "s:sessionid123",
        "parity-cookie-secret-abc123"
      ],
      "upstreamFn": "cookieSignature.sign",
      "goFn": "cookiesignature.Sign"
    },
    {
      "id": "sign-empty",
      "fn": "sign",
      "args": [
        "",
        "parity-cookie-secret-abc123"
      ],
      "upstreamFn": "cookieSignature.sign",
      "goFn": "cookiesignature.Sign"
    },
    {
      "id": "sign-single-char",
      "fn": "sign",
      "args": [
        "x",
        "parity-cookie-secret-abc123"
      ],
