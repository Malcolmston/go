{
  "group": "routing-basic",
  "upstream": "express@4.21.2",
  "note": "Static path matching, HTTP verbs, route precedence, fallthrough and HEAD-for-GET. `fn` names an app fixture built identically by both runners; args[0] is the request to replay. The compared value is {status, headers, body}.",
  "cases": [
    { "id": "default404-hit", "fn": "route.default404", "args": [{ "method": "GET", "path": "/x" }], "upstreamFn": "app.get", "goFn": "Router.Get" },
    { "id": "default404-miss", "fn": "route.default404", "args": [{ "method": "GET", "path": "/y" }], "upstreamFn": "finalhandler", "goFn": "Application.ServeHTTP", "note": "the framework's own unmatched-route response" },
    { "id": "default404-miss-method", "fn": "route.default404", "args": [{ "method": "POST", "path": "/x" }], "upstreamFn": "finalhandler", "goFn": "Application.ServeHTTP" },
    { "id": "basic-root", "fn": "route.basic", "args": [{ "method": "GET", "path": "/" }], "upstreamFn": "app.get", "goFn": "Router.Get" },
    { "id": "basic-a", "fn": "route.basic", "args": [{ "method": "GET", "path": "/a" }], "upstreamFn": "app.get", "goFn": "Router.Get" },
    { "id": "basic-ab", "fn": "route.basic", "args": [{ "method": "GET", "path": "/a/b" }], "upstreamFn": "app.get", "goFn": "Router.Get" },
    { "id": "basic-abc", "fn": "route.basic", "args": [{ "method": "GET", "path": "/a/b/c" }], "upstreamFn": "app.get", "goFn": "Router.Get" },
    { "id": "basic-404", "fn": "route.basic", "args": [{ "method": "GET", "path": "/nope" }], "upstreamFn": "app.get", "goFn": "Router.Get", "note": "no route matches -> terminal 404 handler" },
    { "id": "basic-404-deep", "fn": "route.basic", "args": [{ "method": "GET", "path": "/a/b/c/d" }], "upstreamFn": "app.get", "goFn": "Router.Get" },
    { "id": "basic-post", "fn": "route.basic", "args": [{ "method": "POST", "path": "/a" }], "upstreamFn": "app.post", "goFn": "Router.Post" },
    { "id": "basic-put", "fn": "route.basic", "args": [{ "method": "PUT", "path": "/a" }], "upstreamFn": "app.put", "goFn": "Router.Put" },
    { "id": "basic-delete", "fn": "route.basic", "args": [{ "method": "DELETE", "path": "/a" }], "upstreamFn": "app.delete", "goFn": "Router.Delete" },
    { "id": "basic-patch", "fn": "route.basic", "args": [{ "method": "PATCH", "path": "/a" }], "upstreamFn": "app.patch", "goFn": "Router.Patch" },
    { "id": "basic-options-route", "fn": "route.basic", "args": [{ "method": "OPTIONS", "path": "/opt" }], "upstreamFn": "app.options", "goFn": "Router.Options" },
    { "id": "basic-options-auto", "fn": "route.basic", "args": [{ "method": "OPTIONS", "path": "/a" }], "upstreamFn": "app.options", "goFn": "Router.Options", "note": "express auto-answers OPTIONS with an Allow header" },
    { "id": "basic-method-not-allowed", "fn": "route.basic", "args": [{ "method": "PUT", "path": "/a/b" }], "upstreamFn": "app.get", "goFn": "Router.Get", "note": "wrong method on an existing path -> 404, not 405" },
    { "id": "basic-head-explicit", "fn": "route.basic", "args": [{ "method": "HEAD", "path": "/headonly" }], "upstreamFn": "app.head", "goFn": "Router.Head" },
    { "id": "basic-head-for-get", "fn": "route.basic", "args": [{ "method": "HEAD", "path": "/a" }], "upstreamFn": "app.head", "goFn": "Router.Head", "note": "express serves HEAD from a GET route with an empty body" },
    { "id": "basic-head-for-get-root", "fn": "route.basic", "args": [{ "method": "HEAD", "path": "/" }], "upstreamFn": "app.head", "goFn": "Router.Head" },
    { "id": "basic-all-get", "fn": "route.basic", "args": [{ "method": "GET", "path": "/all" }], "upstreamFn": "app.all", "goFn": "Router.All" },
    { "id": "basic-all-post", "fn": "route.basic", "args": [{ "method": "POST", "path": "/all" }], "upstreamFn": "app.all", "goFn": "Router.All" },
    { "id": "basic-all-delete", "fn": "route.basic", "args": [{ "method": "DELETE", "path": "/all" }], "upstreamFn": "app.all", "goFn": "Router.All" },
    { "id": "basic-dup-first-wins", "fn": "route.basic", "args": [{ "method": "GET", "path": "/dup" }], "upstreamFn": "app.get", "goFn": "Router.Get", "note": "two identical routes: the first registered wins" },
    { "id": "basic-order-param-first", "fn": "route.basic", "args": [{ "method": "GET", "path": "/order/static" }], "upstreamFn": "app.get", "goFn": "Router.Get", "note": "param route registered first shadows the later static route" },
    { "id": "basic-order-static-first", "fn": "route.basic", "args": [{ "method": "GET", "path": "/order2/static" }], "upstreamFn": "app.get", "goFn": "Router.Get" },
    { "id": "basic-order-static-first-param", "fn": "route.basic", "args": [{ "method": "GET", "path": "/order2/other" }], "upstreamFn": "app.get", "goFn": "Router.Get" },
    { "id": "basic-chain", "fn": "route.basic", "args": [{ "method": "GET", "path": "/chain" }], "upstreamFn": "app.get", "goFn": "Router.Get", "note": "several handlers on one route, first calls next()" },
    { "id": "basic-fallthrough-404", "fn": "route.basic", "args": [{ "method": "GET", "path": "/fall" }], "upstreamFn": "app.get", "goFn": "Router.Get", "note": "next() with nothing left to match -> terminal 404 handler" },
    { "id": "basic-trailing-slash", "fn": "route.basic", "args": [{ "method": "GET", "path": "/trail/" }], "upstreamFn": "app.get", "goFn": "Router.Get", "note": "non-strict default: trailing slash tolerated" },
    { "id": "basic-trailing-slash-root", "fn": "route.basic", "args": [{ "method": "GET", "path": "/a/" }], "upstreamFn": "app.get", "goFn": "Router.Get" },
    { "id": "basic-double-slash", "fn": "route.basic", "args": [{ "method": "GET", "path": "//a" }], "upstreamFn": "app.get", "goFn": "Router.Get" },
    { "id": "basic-case-insensitive-default", "fn": "route.basic", "args": [{ "method": "GET", "path": "/case" }], "upstreamFn": "app.get", "goFn": "Router.Get", "note": "default routing is case-insensitive" },
    { "id": "basic-case-exact", "fn": "route.basic", "args": [{ "method": "GET", "path": "/Case" }], "upstreamFn": "app.get", "goFn": "Router.Get" },
    { "id": "basic-query-ignored", "fn": "route.basic", "args": [{ "method": "GET", "path": "/a?x=1&y=2" }], "upstreamFn": "app.get", "goFn": "Router.Get", "note": "query string must not affect matching" },
    { "id": "basic-encoded-path", "fn": "route.basic", "args": [{ "method": "GET", "path": "/a%2Fb" }], "upstreamFn": "app.get", "goFn": "Router.Get", "note": "percent-encoded slash must not match /a/b" }
  ]
}
