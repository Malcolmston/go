{
  "group": "response",
  "upstream": "express@4.21.2",
  "note": "res.send/json/status/sendStatus/redirect/type/set/append/cookie/location/links/vary/jsonp/end plus a few req accessors.",
  "cases": [
    { "id": "res-send-string", "fn": "res", "args": [{ "method": "GET", "path": "/send-string" }], "upstreamFn": "res.send", "goFn": "Response.Send" },
    { "id": "res-send-object", "fn": "res", "args": [{ "method": "GET", "path": "/send-obj" }], "upstreamFn": "res.send", "goFn": "Response.Send" },
    { "id": "res-send-buffer", "fn": "res", "args": [{ "method": "GET", "path": "/send-buf" }], "upstreamFn": "res.send", "goFn": "Response.Send" },
    { "id": "res-json", "fn": "res", "args": [{ "method": "GET", "path": "/json" }], "upstreamFn": "res.json", "goFn": "Response.JSON" },
    { "id": "res-json-key-order", "fn": "res", "args": [{ "method": "GET", "path": "/json-key-order" }], "upstreamFn": "res.json", "goFn": "Response.JSON", "note": "JS preserves insertion order; Go map marshalling sorts keys" },
    { "id": "res-json-null", "fn": "res", "args": [{ "method": "GET", "path": "/json-null" }], "upstreamFn": "res.json", "goFn": "Response.JSON" },
    { "id": "res-status", "fn": "res", "args": [{ "method": "GET", "path": "/status" }], "upstreamFn": "res.status", "goFn": "Response.Status" },
    { "id": "res-send-status", "fn": "res", "args": [{ "method": "GET", "path": "/send-status" }], "upstreamFn": "res.sendStatus", "goFn": "Response.SendStatus" },
    { "id": "res-send-status-418", "fn": "res", "args": [{ "method": "GET", "path": "/send-status-418" }], "upstreamFn": "res.sendStatus", "goFn": "Response.SendStatus" },
    { "id": "res-redirect-default", "fn": "res", "args": [{ "method": "GET", "path": "/redirect" }], "upstreamFn": "res.redirect", "goFn": "Response.Redirect" },
    { "id": "res-redirect-301", "fn": "res", "args": [{ "method": "GET", "path": "/redirect-301" }], "upstreamFn": "res.redirect", "goFn": "Response.Redirect" },
    { "id": "res-type-json", "fn": "res", "args": [{ "method": "GET", "path": "/type-json" }], "upstreamFn": "res.type", "goFn": "Response.Type" },
    { "id": "res-type-html", "fn": "res", "args": [{ "method": "GET", "path": "/type-html" }], "upstreamFn": "res.type", "goFn": "Response.Type" },
    { "id": "res-type-full", "fn": "res", "args": [{ "method": "GET", "path": "/type-full" }], "upstreamFn": "res.type", "goFn": "Response.Type" },
    { "id": "res-set", "fn": "res", "args": [{ "method": "GET", "path": "/set" }], "upstreamFn": "res.set", "goFn": "Response.Set" },
    { "id": "res-append", "fn": "res", "args": [{ "method": "GET", "path": "/append" }], "upstreamFn": "res.append", "goFn": "Response.Append" },
    { "id": "res-cookie-opts", "fn": "res", "args": [{ "method": "GET", "path": "/cookie" }], "upstreamFn": "res.cookie", "goFn": "Response.Cookie" },
    { "id": "res-cookie-plain", "fn": "res", "args": [{ "method": "GET", "path": "/cookie-plain" }], "upstreamFn": "res.cookie", "goFn": "Response.Cookie" },
    { "id": "res-clear-cookie", "fn": "res", "args": [{ "method": "GET", "path": "/clear-cookie" }], "upstreamFn": "res.clearCookie", "goFn": "Response.ClearCookie" },
    { "id": "res-location", "fn": "res", "args": [{ "method": "GET", "path": "/location" }], "upstreamFn": "res.location", "goFn": "Response.Location" },
    { "id": "res-links", "fn": "res", "args": [{ "method": "GET", "path": "/links" }], "upstreamFn": "res.links", "goFn": "Response.Links" },
    { "id": "res-vary", "fn": "res", "args": [{ "method": "GET", "path": "/vary" }], "upstreamFn": "res.vary", "goFn": "Response.Vary" },
    { "id": "res-jsonp", "fn": "res", "args": [{ "method": "GET", "path": "/jsonp?callback=cb" }], "upstreamFn": "res.jsonp", "goFn": "Response.JSONP" },
    { "id": "res-jsonp-nocb", "fn": "res", "args": [{ "method": "GET", "path": "/jsonp" }], "upstreamFn": "res.jsonp", "goFn": "Response.JSONP" },
    { "id": "res-end-204", "fn": "res", "args": [{ "method": "GET", "path": "/end" }], "upstreamFn": "res.end", "goFn": "Response.End" },
    { "id": "req-cookie", "fn": "res", "args": [{ "method": "GET", "path": "/read-cookie", "headers": { "Cookie": "c=vv" } }], "upstreamFn": "req.cookies", "goFn": "Request.Cookie", "deviation": "express needs the cookie-parser middleware for req.cookies, so upstream reports undefined; the Go port reads cookies natively" },
    { "id": "req-info", "fn": "res", "args": [{ "method": "GET", "path": "/req-info" }], "upstreamFn": "req.path", "goFn": "Request.Path" },
    { "id": "req-info-xhr", "fn": "res", "args": [{ "method": "GET", "path": "/req-info", "headers": { "X-Requested-With": "XMLHttpRequest" } }], "upstreamFn": "req.xhr", "goFn": "Request.Xhr" },
    { "id": "req-query", "fn": "res", "args": [{ "method": "GET", "path": "/query?a=1" }], "upstreamFn": "req.query", "goFn": "Request.QueryValues" },
    { "id": "req-query-empty", "fn": "res", "args": [{ "method": "GET", "path": "/query" }], "upstreamFn": "req.query", "goFn": "Request.QueryValues" },
    { "id": "req-query-blank-value", "fn": "res", "args": [{ "method": "GET", "path": "/query?a=&b=2" }], "upstreamFn": "req.query", "goFn": "Request.QueryValues" }
  ]
}
