{
  "group": "errors",
  "upstream": "express@4.21.2",
  "note": "Error-handling middleware: next(err), a synchronous throw/panic in a handler, whether an error raised before a mounted sub-router skips that sub-router, router-local error handlers, and the custom 404 handler.",
  "cases": [
    { "id": "err-next", "fn": "errors", "args": [{ "method": "GET", "path": "/next-err" }], "upstreamFn": "app.use(err,req,res,next)", "goFn": "ErrorHandler" },
    { "id": "err-throw", "fn": "errors", "args": [{ "method": "GET", "path": "/throw" }], "upstreamFn": "app.use(err,req,res,next)", "goFn": "ErrorHandler", "note": "express catches a synchronous throw in a handler; the Go port needs express.Recover()" },
    { "id": "err-none", "fn": "errors", "args": [{ "method": "GET", "path": "/ok" }], "upstreamFn": "app.get", "goFn": "Router.Get" },
    { "id": "err-custom-404", "fn": "errors", "args": [{ "method": "GET", "path": "/missing" }], "upstreamFn": "app.use(fn)", "goFn": "Router.Use" },
    { "id": "err-before-mount", "fn": "errors", "args": [{ "method": "GET", "path": "/pre-sub" }], "upstreamFn": "app.use(err,...)", "goFn": "ErrorHandler" },
    { "id": "err-skips-subrouter", "fn": "errors", "args": [{ "method": "GET", "path": "/sub/inside" }], "upstreamFn": "app.use(path, mw, router)", "goFn": "Router.Use", "note": "the mount middleware errors, so the sub-router must be skipped and the app error handler must answer" },
    { "id": "err-router-local", "fn": "errors", "args": [{ "method": "GET", "path": "/local/fail" }], "upstreamFn": "router.use(err,...)", "goFn": "ErrorHandler", "note": "a router-local error handler must win over the app-level one" },
    { "id": "err-post-unmatched", "fn": "errors", "args": [{ "method": "POST", "path": "/ok" }], "upstreamFn": "app.use(fn)", "goFn": "Router.Use" }
  ]
}
