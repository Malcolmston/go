{
  "group": "query",
  "upstream": "sequelize@6.37.8",
  "note": "findAll/findOne/findByPk over the seeded users, and the Op vocabulary. Same SQLite engine on both sides, so LIKE case-folding and collation match.",
  "cases": [
    { "id": "find-all-basic", "fn": "findAll", "args": [{}], "upstreamFn": "Model.findAll", "goFn": "Model.FindAll" },
    { "id": "find-all-where-eq", "fn": "findAll", "args": [{"where": {"age": 25}, "order": [["id", "ASC"]]}], "upstreamFn": "Op.eq", "goFn": "Op.Eq" },
    { "id": "find-all-where-gt", "fn": "findAll", "args": [{"where": {"age": {"gt": 26}}, "order": [["id", "ASC"]]}], "upstreamFn": "Op.gt", "goFn": "Op.Gt" },
    { "id": "find-all-where-gte", "fn": "findAll", "args": [{"where": {"age": {"gte": 30}}, "order": [["id", "ASC"]]}], "upstreamFn": "Op.gte", "goFn": "Op.Gte" },
    { "id": "find-all-where-lt", "fn": "findAll", "args": [{"where": {"age": {"lt": 30}}, "order": [["id", "ASC"]]}], "upstreamFn": "Op.lt", "goFn": "Op.Lt" },
    { "id": "find-all-where-lte", "fn": "findAll", "args": [{"where": {"age": {"lte": 25}}, "order": [["id", "ASC"]]}], "upstreamFn": "Op.lte", "goFn": "Op.Lte" },
    { "id": "find-all-where-ne", "fn": "findAll", "args": [{"where": {"age": {"ne": 25}}, "order": [["id", "ASC"]]}], "upstreamFn": "Op.ne", "goFn": "Op.Ne" },
    { "id": "find-all-where-in", "fn": "findAll", "args": [{"where": {"id": {"in": [1, 3]}}, "order": [["id", "ASC"]]}], "upstreamFn": "Op.in", "goFn": "Op.In" },
    { "id": "find-all-where-in-shorthand", "fn": "findAll", "args": [{"where": {"id": [1, 3]}, "order": [["id", "ASC"]]}], "upstreamFn": "Op.in", "goFn": "Op.In" },
    { "id": "find-all-where-in-empty", "fn": "findAll", "args": [{"where": {"id": {"in": []}}}], "upstreamFn": "Op.in", "goFn": "Op.In", "note": "empty IN matches nothing, not invalid SQL" },
    { "id": "find-all-where-notin", "fn": "findAll", "args": [{"where": {"id": {"notIn": [1, 2]}}, "order": [["id", "ASC"]]}], "upstreamFn": "Op.notIn", "goFn": "Op.NotIn" },
    { "id": "find-all-where-notin-empty", "fn": "findAll", "args": [{"where": {"id": {"notIn": []}}, "order": [["id", "ASC"]]}], "upstreamFn": "Op.notIn", "goFn": "Op.NotIn", "note": "empty NOT IN matches everything" },
    { "id": "find-all-where-like", "fn": "findAll", "args": [{"where": {"name": {"like": "%a%"}}, "order": [["id", "ASC"]]}], "upstreamFn": "Op.like", "goFn": "Op.Like" },
    { "id": "find-all-where-notlike", "fn": "findAll", "args": [{"where": {"name": {"notLike": "%a%"}}, "order": [["id", "ASC"]]}], "upstreamFn": "Op.notLike", "goFn": "Op.NotLike" },
    { "id": "find-all-where-null", "fn": "findAll", "args": [{"where": {"email": null}, "order": [["id", "ASC"]]}], "upstreamFn": "Op.is", "goFn": "Op.IsNull" },
    { "id": "find-all-where-is-null", "fn": "findAll", "args": [{"where": {"email": {"is": null}}, "order": [["id", "ASC"]]}], "upstreamFn": "Op.is", "goFn": "Op.Is" },
    { "id": "find-all-where-not-null", "fn": "findAll", "args": [{"where": {"email": {"not": null}}, "order": [["id", "ASC"]]}], "upstreamFn": "Op.not", "goFn": "Op.NotNull" },
    { "id": "find-all-where-between", "fn": "findAll", "args": [{"where": {"age": {"between": [25, 30]}}, "order": [["id", "ASC"]]}], "upstreamFn": "Op.between", "goFn": "Op.Between" },
    { "id": "find-all-where-notbetween", "fn": "findAll", "args": [{"where": {"age": {"notBetween": [25, 30]}}, "order": [["id", "ASC"]]}], "upstreamFn": "Op.notBetween", "goFn": "Op.NotBetween" },
    { "id": "find-all-and", "fn": "findAll", "args": [{"where": {"and": [{"age": {"gte": 25}}, {"age": {"lt": 35}}]}, "order": [["id", "ASC"]]}], "upstreamFn": "Op.and", "goFn": "And" },
    { "id": "find-all-or", "fn": "findAll", "args": [{"where": {"or": [{"age": 35}, {"id": 1}]}, "order": [["id", "ASC"]]}], "upstreamFn": "Op.or", "goFn": "Or" },
    { "id": "find-all-not", "fn": "findAll", "args": [{"where": {"not": {"age": 25}}, "order": [["id", "ASC"]]}], "upstreamFn": "Op.not", "goFn": "Not" },
    { "id": "find-all-order-desc", "fn": "findAll", "args": [{"order": [["age", "DESC"], ["id", "ASC"]]}], "upstreamFn": "order", "goFn": "Query.Order" },
    { "id": "find-all-limit", "fn": "findAll", "args": [{"order": [["id", "ASC"]], "limit": 2}], "upstreamFn": "limit", "goFn": "Query.Limit" },
    { "id": "find-all-limit-offset", "fn": "findAll", "args": [{"order": [["id", "ASC"]], "limit": 2, "offset": 1}], "upstreamFn": "offset", "goFn": "Query.Offset" },
    { "id": "find-all-attributes", "fn": "findAll", "args": [{"attributes": ["id", "name"], "order": [["id", "ASC"]]}], "upstreamFn": "attributes", "goFn": "Query.Attrs" },
    { "id": "find-one-match", "fn": "findOne", "args": [{"where": {"name": "Bob"}}], "upstreamFn": "Model.findOne", "goFn": "Model.FindOne" },
    { "id": "find-by-pk-match", "fn": "findByPk", "args": [2], "upstreamFn": "Model.findByPk", "goFn": "Model.FindByPk" },
    { "id": "find-one-miss", "fn": "findOne", "args": [{"where": {"name": "Zed"}}], "upstreamFn": "Model.findOne", "goFn": "Model.FindOne", "deviation": "upstream returns null on a miss; the port returns a typed *RecordNotFoundError wrapping ErrRecordNotFound so a missing row cannot be mistaken for an empty record" },
    { "id": "find-by-pk-miss", "fn": "findByPk", "args": [999], "upstreamFn": "Model.findByPk", "goFn": "Model.FindByPk", "deviation": "upstream returns null on a miss; the port returns a typed *RecordNotFoundError" }
  ]
}
