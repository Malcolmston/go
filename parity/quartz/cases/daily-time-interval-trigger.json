{
  "group": "daily-time-interval-trigger",
  "upstream": "org.quartz-scheduler:quartz@2.5.0",
  "note": "DailyTimeIntervalTrigger. args = [tz, startInstantUTC, startTimeOfDay, endTimeOfDay, unit, count, daysOfWeek, afterInstantUTC, n]. daysOfWeek is a CSV of SUN..SAT, or \"*\" for all seven. Upstream has no per-trigger time zone in 2.5.0, so the runner installs the requested zone as the JVM default around the call.",
  "cases": [
    { "id": "dtit-hourly-window-utc", "fn": "dailyTimeIntervalNext", "args": ["UTC", "2026-01-01T00:00:00Z", "09:00:00", "17:00:00", "HOUR", 2, "*", "2026-01-01T00:00:00Z", 6], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.getFireTimeAfter", "goFn": "quartz.DailyTimeIntervalTrigger.ComputeFirstFireTime" },
    { "id": "dtit-window-rolls-to-next-day", "fn": "dailyTimeIntervalNext", "args": ["UTC", "2026-01-01T00:00:00Z", "09:00:00", "17:00:00", "HOUR", 4, "*", "2026-01-01T00:00:00Z", 6], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.getFireTimeAfter", "goFn": "quartz.DailyTimeIntervalTrigger.Triggered", "note": "09,13,17 then roll" },
    { "id": "dtit-step-lands-exactly-on-end", "fn": "dailyTimeIntervalNext", "args": ["UTC", "2026-01-01T00:00:00Z", "09:00:00", "17:00:00", "HOUR", 8, "*", "2026-01-01T00:00:00Z", 5], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.getFireTimeAfter", "goFn": "quartz.DailyTimeIntervalTrigger.Triggered", "note": "is the window end itself a fire time?" },
    { "id": "dtit-step-overshoots-end", "fn": "dailyTimeIntervalNext", "args": ["UTC", "2026-01-01T00:00:00Z", "09:00:00", "17:00:00", "HOUR", 5, "*", "2026-01-01T00:00:00Z", 5], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.getFireTimeAfter", "goFn": "quartz.DailyTimeIntervalTrigger.Triggered" },
    { "id": "dtit-minute-step", "fn": "dailyTimeIntervalNext", "args": ["UTC", "2026-01-01T00:00:00Z", "08:00:00", "08:30:00", "MINUTE", 10, "*", "2026-01-01T00:00:00Z", 6], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.getFireTimeAfter", "goFn": "quartz.DailyTimeIntervalTrigger.Triggered" },
    { "id": "dtit-second-step", "fn": "dailyTimeIntervalNext", "args": ["UTC", "2026-01-01T00:00:00Z", "00:00:00", "00:00:10", "SECOND", 4, "*", "2026-01-01T00:00:00Z", 6], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.getFireTimeAfter", "goFn": "quartz.DailyTimeIntervalTrigger.Triggered" },
    { "id": "dtit-single-instant-window", "fn": "dailyTimeIntervalNext", "args": ["UTC", "2026-01-01T00:00:00Z", "12:00:00", "12:00:00", "HOUR", 1, "*", "2026-01-01T00:00:00Z", 4], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.getFireTimeAfter", "goFn": "quartz.DailyTimeIntervalTrigger.Triggered", "note": "one fire per day" },
    { "id": "dtit-inverted-window", "fn": "dailyTimeIntervalNext", "args": ["UTC", "2026-01-01T00:00:00Z", "17:00:00", "09:00:00", "HOUR", 1, "*", "2026-01-01T00:00:00Z", 3], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.setEndTimeOfDay", "goFn": "quartz.NewDailyTimeIntervalTrigger", "note": "end-of-day before start-of-day" },
    { "id": "dtit-full-day-window", "fn": "dailyTimeIntervalNext", "args": ["UTC", "2026-01-01T00:00:00Z", "00:00:00", "23:59:59", "HOUR", 6, "*", "2026-01-01T00:00:00Z", 6], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.getFireTimeAfter", "goFn": "quartz.DailyTimeIntervalTrigger.Triggered" },
    { "id": "dtit-monday-only", "fn": "dailyTimeIntervalNext", "args": ["UTC", "2026-01-01T00:00:00Z", "09:00:00", "10:00:00", "HOUR", 1, "MON", "2026-01-01T00:00:00Z", 4], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.getFireTimeAfter", "goFn": "quartz.DailyTimeIntervalTrigger.OnDaysOfWeek" },
    { "id": "dtit-mon-through-fri", "fn": "dailyTimeIntervalNext", "args": ["UTC", "2026-01-01T00:00:00Z", "09:00:00", "09:00:00", "HOUR", 1, "MON,TUE,WED,THU,FRI", "2026-01-02T00:00:00Z", 6], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.getFireTimeAfter", "goFn": "quartz.DailyTimeIntervalTrigger.OnDaysOfWeek", "note": "must skip the weekend" },
    { "id": "dtit-weekend-only", "fn": "dailyTimeIntervalNext", "args": ["UTC", "2026-01-01T00:00:00Z", "10:00:00", "10:00:00", "HOUR", 1, "SAT,SUN", "2026-01-01T00:00:00Z", 5], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.getFireTimeAfter", "goFn": "quartz.DailyTimeIntervalTrigger.OnDaysOfWeek" },
    { "id": "dtit-sunday-only", "fn": "dailyTimeIntervalNext", "args": ["UTC", "2026-01-01T00:00:00Z", "06:00:00", "06:00:00", "HOUR", 1, "SUN", "2026-01-01T00:00:00Z", 4], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.getFireTimeAfter", "goFn": "quartz.DailyTimeIntervalTrigger.OnDaysOfWeek", "note": "weekday numbering: Calendar.SUNDAY == 1 upstream, time.Sunday == 0 in the port" },
    { "id": "dtit-after-before-start", "fn": "dailyTimeIntervalNext", "args": ["UTC", "2026-06-01T00:00:00Z", "09:00:00", "17:00:00", "HOUR", 4, "*", "2026-01-01T00:00:00Z", 4], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.getFireTimeAfter", "goFn": "quartz.DailyTimeIntervalTrigger.ComputeFirstFireTime" },
    { "id": "dtit-start-mid-window", "fn": "dailyTimeIntervalNext", "args": ["UTC", "2026-01-01T11:30:00Z", "09:00:00", "17:00:00", "HOUR", 2, "*", "2026-01-01T00:00:00Z", 4], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.getFireTimeAfter", "goFn": "quartz.DailyTimeIntervalTrigger.ComputeFirstFireTime", "note": "start time falls between two slots" },
    { "id": "dtit-after-mid-window", "fn": "dailyTimeIntervalNext", "args": ["UTC", "2026-01-01T00:00:00Z", "09:00:00", "17:00:00", "HOUR", 2, "*", "2026-01-05T12:15:00Z", 4], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.getFireTimeAfter", "goFn": "quartz.DailyTimeIntervalTrigger.ComputeFirstFireTime" },
    { "id": "dtit-after-past-window", "fn": "dailyTimeIntervalNext", "args": ["UTC", "2026-01-01T00:00:00Z", "09:00:00", "17:00:00", "HOUR", 2, "*", "2026-01-05T20:00:00Z", 3], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.getFireTimeAfter", "goFn": "quartz.DailyTimeIntervalTrigger.ComputeFirstFireTime" },
    { "id": "dtit-zoned-ny", "fn": "dailyTimeIntervalNext", "args": ["America/New_York", "2026-01-01T00:00:00Z", "09:00:00", "17:00:00", "HOUR", 4, "*", "2026-01-01T00:00:00Z", 5], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.getFireTimeAfter", "goFn": "quartz.DailyTimeIntervalTrigger.In" },
    { "id": "dtit-zoned-ny-across-spring-forward", "fn": "dailyTimeIntervalNext", "args": ["America/New_York", "2026-03-06T00:00:00Z", "09:00:00", "09:00:00", "HOUR", 1, "*", "2026-03-06T00:00:00Z", 5], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.getFireTimeAfter", "goFn": "quartz.DailyTimeIntervalTrigger.In", "note": "the 09:00 local window must stay at 09:00 local across 2026-03-08" },
    { "id": "dtit-zoned-ny-window-in-gap", "fn": "dailyTimeIntervalNext", "args": ["America/New_York", "2026-03-06T00:00:00Z", "02:00:00", "03:00:00", "MINUTE", 30, "*", "2026-03-07T12:00:00Z", 6], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.getFireTimeAfter", "goFn": "quartz.DailyTimeIntervalTrigger.In", "note": "the 02:00-03:00 local window does not exist on 2026-03-08" },
    { "id": "dtit-zoned-ny-across-fall-back", "fn": "dailyTimeIntervalNext", "args": ["America/New_York", "2026-10-30T00:00:00Z", "01:00:00", "02:00:00", "MINUTE", 30, "*", "2026-10-31T12:00:00Z", 6], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.getFireTimeAfter", "goFn": "quartz.DailyTimeIntervalTrigger.In", "note": "the 01:00-02:00 local window happens twice on 2026-11-01" },
    { "id": "dtit-zoned-berlin", "fn": "dailyTimeIntervalNext", "args": ["Europe/Berlin", "2026-03-28T00:00:00Z", "08:00:00", "10:00:00", "HOUR", 1, "*", "2026-03-28T00:00:00Z", 6], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.getFireTimeAfter", "goFn": "quartz.DailyTimeIntervalTrigger.In" },
    { "id": "dtit-day-unit-unsupported", "fn": "dailyTimeIntervalNext", "args": ["UTC", "2026-01-01T00:00:00Z", "09:00:00", "17:00:00", "DAY", 1, "*", "2026-01-01T00:00:00Z", 3], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.setRepeatIntervalUnit", "goFn": "quartz.NewDailyTimeIntervalTrigger", "note": "only SECOND/MINUTE/HOUR are valid units" },
    { "id": "dtit-count-zero", "fn": "dailyTimeIntervalNext", "args": ["UTC", "2026-01-01T00:00:00Z", "09:00:00", "17:00:00", "HOUR", 0, "*", "2026-01-01T00:00:00Z", 3], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.setRepeatInterval", "goFn": "quartz.NewDailyTimeIntervalTrigger" },
    { "id": "dtit-empty-days", "fn": "dailyTimeIntervalNext", "args": ["UTC", "2026-01-01T00:00:00Z", "09:00:00", "17:00:00", "HOUR", 1, "", "2026-01-01T00:00:00Z", 3], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.setDaysOfWeek", "goFn": "quartz.DailyTimeIntervalTrigger.OnDaysOfWeek", "note": "an empty CSV means all seven days on both sides" },
    { "id": "dtit-interval-larger-than-window", "fn": "dailyTimeIntervalNext", "args": ["UTC", "2026-01-01T00:00:00Z", "09:00:00", "09:30:00", "HOUR", 3, "*", "2026-01-01T00:00:00Z", 4], "upstreamFn": "org.quartz.impl.triggers.DailyTimeIntervalTriggerImpl.getFireTimeAfter", "goFn": "quartz.DailyTimeIntervalTrigger.Triggered" }
  ]
