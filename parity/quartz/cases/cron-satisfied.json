    { "id": "sat-noon-yes", "fn": "cronSatisfiedBy", "args": ["0 0 12 * * ?", "UTC", "2026-01-01T12:00:00Z"], "upstreamFn": "org.quartz.CronExpression.isSatisfiedBy", "goFn": "quartz.CronExpression.IsSatisfiedBy" },
    { "id": "sat-noon-no", "fn": "cronSatisfiedBy", "args": ["0 0 12 * * ?", "UTC", "2026-01-01T12:00:01Z"], "upstreamFn": "org.quartz.CronExpression.isSatisfiedBy", "goFn": "quartz.CronExpression.IsSatisfiedBy" },
    { "id": "sat-noon-off-by-minute", "fn": "cronSatisfiedBy", "args": ["0 0 12 * * ?", "UTC", "2026-01-01T12:01:00Z"], "upstreamFn": "org.quartz.CronExpression.isSatisfiedBy", "goFn": "quartz.CronExpression.IsSatisfiedBy" },
    { "id": "sat-zone-shifts-answer", "fn": "cronSatisfiedBy", "args": ["0 0 12 * * ?", "America/New_York", "2026-01-01T12:00:00Z"], "upstreamFn": "org.quartz.CronExpression.isSatisfiedBy", "goFn": "quartz.CronExpression.IsSatisfiedBy", "note": "12:00 UTC is 07:00 in New York" },
