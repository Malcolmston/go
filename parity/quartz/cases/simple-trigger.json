{
  "group": "simple-trigger",
  "upstream": "org.quartz-scheduler:quartz@2.5.0",
  "note": "SimpleTrigger repeat/interval. args = [startInstantUTC, repeatIntervalMillis, repeatCount, endInstantUTC|null, afterInstantUTC, n]. repeatCount -1 == REPEAT_INDEFINITELY on both sides.",
  "cases": [
    { "id": "simple-forever-15s", "fn": "simpleNext", "args": ["2026-01-01T00:00:00Z", 15000, -1, null, "2026-01-01T00:00:00Z", 5], "upstreamFn": "org.quartz.impl.triggers.SimpleTriggerImpl.getFireTimeAfter", "goFn": "quartz.SimpleTrigger.FireTimeAfter" },
    { "id": "simple-forever-after-before-start", "fn": "simpleNext", "args": ["2026-06-01T00:00:00Z", 60000, -1, null, "2026-01-01T00:00:00Z", 3], "upstreamFn": "org.quartz.impl.triggers.SimpleTriggerImpl.getFireTimeAfter", "goFn": "quartz.SimpleTrigger.FireTimeAfter", "note": "must clamp to the start time" },
    { "id": "simple-forever-after-exactly-start", "fn": "simpleNext", "args": ["2026-06-01T00:00:00Z", 60000, -1, null, "2026-06-01T00:00:00Z", 3], "upstreamFn": "org.quartz.impl.triggers.SimpleTriggerImpl.getFireTimeAfter", "goFn": "quartz.SimpleTrigger.FireTimeAfter" },
    { "id": "simple-forever-mid-interval", "fn": "simpleNext", "args": ["2026-01-01T00:00:00Z", 60000, -1, null, "2026-01-01T00:00:30Z", 3], "upstreamFn": "org.quartz.impl.triggers.SimpleTriggerImpl.getFireTimeAfter", "goFn": "quartz.SimpleTrigger.FireTimeAfter", "note": "must land on the interval grid, not on after+interval" },
    { "id": "simple-repeat-0", "fn": "simpleNext", "args": ["2026-01-01T00:00:00Z", 60000, 0, null, "2025-12-31T00:00:00Z", 3], "upstreamFn": "org.quartz.impl.triggers.SimpleTriggerImpl.getFireTimeAfter", "goFn": "quartz.SimpleTrigger.FireTimeAfter", "note": "repeatCount 0 fires exactly once" },
    { "id": "simple-repeat-0-after-start", "fn": "simpleNext", "args": ["2026-01-01T00:00:00Z", 60000, 0, null, "2026-01-01T00:00:00Z", 3], "upstreamFn": "org.quartz.impl.triggers.SimpleTriggerImpl.getFireTimeAfter", "goFn": "quartz.SimpleTrigger.FireTimeAfter", "note": "the single fire is already past" },
    { "id": "simple-repeat-3", "fn": "simpleNext", "args": ["2026-01-01T00:00:00Z", 3600000, 3, null, "2025-12-31T00:00:00Z", 8], "upstreamFn": "org.quartz.impl.triggers.SimpleTriggerImpl.getFireTimeAfter", "goFn": "quartz.SimpleTrigger.FireTimeAfter", "note": "repeatCount 3 == 4 total fires" },
    { "id": "simple-repeat-3-from-middle", "fn": "simpleNext", "args": ["2026-01-01T00:00:00Z", 3600000, 3, null, "2026-01-01T01:30:00Z", 8], "upstreamFn": "org.quartz.impl.triggers.SimpleTriggerImpl.getFireTimeAfter", "goFn": "quartz.SimpleTrigger.FireTimeAfter" },
    { "id": "simple-repeat-1", "fn": "simpleNext", "args": ["2026-01-01T00:00:00Z", 1000, 1, null, "2025-12-31T23:59:59Z", 5], "upstreamFn": "org.quartz.impl.triggers.SimpleTriggerImpl.getFireTimeAfter", "goFn": "quartz.SimpleTrigger.FireTimeAfter" },
    { "id": "simple-end-time-before-fire", "fn": "simpleNext", "args": ["2026-01-01T00:00:00Z", 3600000, -1, "2026-01-01T02:30:00Z", "2025-12-31T00:00:00Z", 6], "upstreamFn": "org.quartz.impl.triggers.SimpleTriggerImpl.getFireTimeAfter", "goFn": "quartz.SimpleTrigger.FireTimeAfter" },
    { "id": "simple-end-time-equals-fire", "fn": "simpleNext", "args": ["2026-01-01T00:00:00Z", 3600000, -1, "2026-01-01T03:00:00Z", "2025-12-31T00:00:00Z", 6], "upstreamFn": "org.quartz.impl.triggers.SimpleTriggerImpl.getFireTimeAfter", "goFn": "quartz.SimpleTrigger.FireTimeAfter", "note": "is a fire exactly at the end time included?" },
    { "id": "simple-end-time-before-start", "fn": "simpleNext", "args": ["2026-06-01T00:00:00Z", 60000, -1, "2026-01-01T00:00:00Z", "2025-01-01T00:00:00Z", 3], "upstreamFn": "org.quartz.impl.triggers.SimpleTriggerImpl.getFireTimeAfter", "goFn": "quartz.SimpleTrigger.FireTimeAfter" },
    { "id": "simple-end-time-equals-after", "fn": "simpleNext", "args": ["2026-01-01T00:00:00Z", 3600000, -1, "2026-01-01T05:00:00Z", "2026-01-01T05:00:00Z", 3], "upstreamFn": "org.quartz.impl.triggers.SimpleTriggerImpl.getFireTimeAfter", "goFn": "quartz.SimpleTrigger.FireTimeAfter" },
    { "id": "simple-interval-1ms", "fn": "simpleNext", "args": ["2026-01-01T00:00:00Z", 1, -1, null, "2026-01-01T00:00:00Z", 3], "upstreamFn": "org.quartz.impl.triggers.SimpleTriggerImpl.getFireTimeAfter", "goFn": "quartz.SimpleTrigger.FireTimeAfter", "note": "sub-second interval; the wire format is second precision so all three collapse" },
    { "id": "simple-interval-zero", "fn": "simpleNext", "args": ["2026-01-01T00:00:00Z", 0, -1, null, "2026-01-01T00:00:00Z", 3], "upstreamFn": "org.quartz.impl.triggers.SimpleTriggerImpl.getFireTimeAfter", "goFn": "quartz.SimpleTrigger.FireTimeAfter", "note": "a zero interval cannot make progress" },
    { "id": "simple-interval-negative", "fn": "simpleNext", "args": ["2026-01-01T00:00:00Z", -1000, -1, null, "2026-01-01T00:00:00Z", 3], "upstreamFn": "org.quartz.impl.triggers.SimpleTriggerImpl.setRepeatInterval", "goFn": "quartz.NewSimpleTrigger", "note": "upstream rejects a negative interval" },
    { "id": "simple-repeat-negative-2", "fn": "simpleNext", "args": ["2026-01-01T00:00:00Z", 60000, -2, null, "2026-01-01T00:00:00Z", 3], "upstreamFn": "org.quartz.impl.triggers.SimpleTriggerImpl.setRepeatCount", "goFn": "quartz.NewSimpleTrigger", "note": "-2 is not REPEAT_INDEFINITELY; upstream rejects it" },
    { "id": "simple-daily-across-dst", "fn": "simpleNext", "args": ["2026-03-06T14:00:00Z", 86400000, -1, null, "2026-03-06T14:00:00Z", 4], "upstreamFn": "org.quartz.impl.triggers.SimpleTriggerImpl.getFireTimeAfter", "goFn": "quartz.SimpleTrigger.FireTimeAfter", "note": "a fixed 24h interval is absolute and must ignore DST entirely" },
    { "id": "simple-week-interval", "fn": "simpleNext", "args": ["2026-01-01T00:00:00Z", 604800000, -1, null, "2026-01-15T00:00:00Z", 3], "upstreamFn": "org.quartz.impl.triggers.SimpleTriggerImpl.getFireTimeAfter", "goFn": "quartz.SimpleTrigger.FireTimeAfter" },
    { "id": "simple-far-past-start", "fn": "simpleNext", "args": ["1970-01-01T00:00:00Z", 86400000, -1, null, "2026-01-01T00:00:00Z", 3], "upstreamFn": "org.quartz.impl.triggers.SimpleTriggerImpl.getFireTimeAfter", "goFn": "quartz.SimpleTrigger.FireTimeAfter", "note": "large multiple of the interval" }
  ]
}
