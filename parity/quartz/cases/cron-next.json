{
  "group": "cron-next",
  "upstream": "org.quartz-scheduler:quartz@2.5.0",
  "note": "Pure next-fire-time sequences. args = [expr, tz, afterInstantUTC, n]; value = the n fire times strictly after afterInstant, chained, as UTC ISO-8601 with offset. Sequences stop early when the side reports no further fire.",
  "cases": [
    { "id": "next-daily-noon", "fn": "cronNext", "args": ["0 0 12 * * ?", "UTC", "2026-01-01T00:00:00Z", 5], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-daily-noon-from-noon", "fn": "cronNext", "args": ["0 0 12 * * ?", "UTC", "2026-01-01T12:00:00Z", 3], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next", "note": "strictly-after semantics at an exact match" },
    { "id": "next-daily-noon-mid-second", "fn": "cronNext", "args": ["0 0 12 * * ?", "UTC", "2026-01-01T11:59:59Z", 2], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-every-second", "fn": "cronNext", "args": ["* * * * * ?", "UTC", "2026-06-15T23:59:57Z", 6], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next", "note": "rolls minute, hour, day, month boundary" },
    { "id": "next-every-10-seconds", "fn": "cronNext", "args": ["*/10 * * * * ?", "UTC", "2026-02-28T23:59:31Z", 8], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-second-list", "fn": "cronNext", "args": ["0,15,30,45 * * * * ?", "UTC", "2026-03-01T00:00:00Z", 6], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-minute-range", "fn": "cronNext", "args": ["0 0-5 14 * * ?", "UTC", "2026-04-10T13:00:00Z", 9], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-step-over-range", "fn": "cronNext", "args": ["0 10-30/5 * * * ?", "UTC", "2026-05-05T09:12:00Z", 8], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-step-from-value", "fn": "cronNext", "args": ["0 0/20 14,18 * * ?", "UTC", "2026-07-01T00:00:00Z", 8], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-hour-list", "fn": "cronNext", "args": ["0 0 0,6,12,18 * * ?", "UTC", "2026-08-31T19:00:00Z", 6], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-dom-31", "fn": "cronNext", "args": ["0 0 0 31 * ?", "UTC", "2026-01-01T00:00:00Z", 8], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next", "note": "skips months without a 31st" },
    { "id": "next-dom-29-feb", "fn": "cronNext", "args": ["0 0 0 29 2 ?", "UTC", "2026-01-01T00:00:00Z", 2], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next", "note": "leap-year-only date" },
    { "id": "next-dom-30-feb-impossible", "fn": "cronNext", "args": ["0 0 0 30 2 ?", "UTC", "2026-01-01T00:00:00Z", 1], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next", "note": "never fires" },
    { "id": "next-month-names", "fn": "cronNext", "args": ["0 0 0 1 JAN,JUL ?", "UTC", "2026-02-01T00:00:00Z", 4], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-month-name-range", "fn": "cronNext", "args": ["0 0 0 1 MAR-JUN ?", "UTC", "2026-01-01T00:00:00Z", 6], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-month-numeric-list", "fn": "cronNext", "args": ["0 0 0 1 1,4,7,10 ?", "UTC", "2026-01-02T00:00:00Z", 5], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-dow-name-monfri", "fn": "cronNext", "args": ["0 15 10 ? * MON-FRI", "UTC", "2026-01-02T00:00:00Z", 6], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next", "note": "weekday names must agree even though the numeric bases differ" },
    { "id": "next-dow-name-sun", "fn": "cronNext", "args": ["0 0 12 ? * SUN", "UTC", "2026-01-01T00:00:00Z", 4], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-dow-name-sat", "fn": "cronNext", "args": ["0 0 12 ? * SAT", "UTC", "2026-01-01T00:00:00Z", 4], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-dow-name-list", "fn": "cronNext", "args": ["0 0 12 ? * TUE,THU", "UTC", "2026-09-01T00:00:00Z", 6], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-dow-numeric-1", "fn": "cronNext", "args": ["0 0 12 ? * 1", "UTC", "2026-01-01T00:00:00Z", 4], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next", "note": "Quartz 1 == Sunday; Unix cron 1 == Monday" },
    { "id": "next-dow-numeric-2", "fn": "cronNext", "args": ["0 0 12 ? * 2", "UTC", "2026-01-01T00:00:00Z", 4], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next", "note": "Quartz 2 == Monday" },
    { "id": "next-dow-numeric-range", "fn": "cronNext", "args": ["0 0 12 ? * 2-6", "UTC", "2026-01-01T00:00:00Z", 7], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next", "note": "Quartz 2-6 == Mon-Fri" },
    { "id": "next-dow-numeric-7", "fn": "cronNext", "args": ["0 0 12 ? * 7", "UTC", "2026-01-01T00:00:00Z", 3], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next", "note": "Quartz 7 == Saturday; Unix cron 7 == Sunday" },
    { "id": "next-dow-and-dom-both-star", "fn": "cronNext", "args": ["0 0 12 * * *", "UTC", "2026-01-01T00:00:00Z", 3], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next", "note": "rejected by Quartz at parse time" },
    { "id": "next-dow-and-dom-both-set", "fn": "cronNext", "args": ["0 0 12 15 * 3", "UTC", "2026-01-01T00:00:00Z", 4], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next", "note": "Quartz rejects; Unix cron ORs the two day fields" },
    { "id": "next-question-both-day-fields", "fn": "cronNext", "args": ["0 0 12 ? * ?", "UTC", "2026-01-01T00:00:00Z", 3], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-l-last-day-of-month", "fn": "cronNext", "args": ["0 0 12 L * ?", "UTC", "2026-01-01T00:00:00Z", 5], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next", "note": "L is not implemented by the port" },
    { "id": "next-l-offset", "fn": "cronNext", "args": ["0 0 12 L-3 * ?", "UTC", "2026-01-01T00:00:00Z", 4], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-lw-last-weekday", "fn": "cronNext", "args": ["0 0 12 LW * ?", "UTC", "2026-01-01T00:00:00Z", 4], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-w-nearest-weekday", "fn": "cronNext", "args": ["0 0 12 15W * ?", "UTC", "2026-01-01T00:00:00Z", 5], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-w-first-of-month", "fn": "cronNext", "args": ["0 0 12 1W * ?", "UTC", "2026-01-01T00:00:00Z", 5], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-dow-last-friday", "fn": "cronNext", "args": ["0 0 12 ? * 6L", "UTC", "2026-01-01T00:00:00Z", 4], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-dow-third-friday", "fn": "cronNext", "args": ["0 0 12 ? * 6#3", "UTC", "2026-01-01T00:00:00Z", 4], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-dow-first-monday-name", "fn": "cronNext", "args": ["0 0 12 ? * MON#1", "UTC", "2026-01-01T00:00:00Z", 4], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-seven-field-year-bounded", "fn": "cronNext", "args": ["0 0 12 1 1 ? 2027", "UTC", "2026-01-01T00:00:00Z", 3], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next", "note": "single-year expression fires exactly once" },
    { "id": "next-seven-field-year-range", "fn": "cronNext", "args": ["0 0 12 1 1 ? 2027-2029", "UTC", "2026-01-01T00:00:00Z", 5], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-yearly-specific", "fn": "cronNext", "args": ["0 11 11 11 11 ?", "UTC", "2026-01-01T00:00:00Z", 3], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-from-year-end", "fn": "cronNext", "args": ["0 0 0 1 * ?", "UTC", "2026-12-31T23:59:59Z", 3], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-from-leap-day", "fn": "cronNext", "args": ["0 0 12 * * ?", "UTC", "2028-02-29T12:00:00Z", 3], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-from-epoch", "fn": "cronNext", "args": ["0 0 0 1 * ?", "UTC", "1970-01-01T00:00:00Z", 3], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-from-1999", "fn": "cronNext", "args": ["0 30 3 * * ?", "UTC", "1999-12-31T23:00:00Z", 3], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "next-far-future", "fn": "cronNext", "args": ["0 0 12 1 1 ?", "UTC", "2098-06-01T00:00:00Z", 3], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" }
  ]
}
