{
  "group": "cron-timezone",
  "upstream": "org.quartz-scheduler:quartz@2.5.0",
  "note": "Cron evaluation in a named zone, including both daylight-saving transitions. All instants in and out are UTC, so a wrong zone or a wrong DST decision shows up directly in the string.",
  "cases": [
    { "id": "tz-ny-daily-9am-winter", "fn": "cronNext", "args": ["0 0 9 * * ?", "America/New_York", "2026-01-05T00:00:00Z", 3], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "tz-ny-daily-9am-summer", "fn": "cronNext", "args": ["0 0 9 * * ?", "America/New_York", "2026-07-05T00:00:00Z", 3], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "tz-ny-spring-forward-across", "fn": "cronNext", "args": ["0 0 9 * * ?", "America/New_York", "2026-03-06T14:00:01Z", 4], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next", "note": "2026-03-08 is the US spring-forward day; the UTC offset moves -05:00 -> -04:00" },
    { "id": "tz-ny-spring-forward-nonexistent-0230", "fn": "cronNext", "args": ["0 30 2 * * ?", "America/New_York", "2026-03-07T08:00:00Z", 3], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next", "note": "02:30 local does not exist on 2026-03-08" },
    { "id": "tz-ny-spring-forward-hourly", "fn": "cronNext", "args": ["0 0 * * * ?", "America/New_York", "2026-03-08T06:00:00Z", 5], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next", "note": "hourly straight through the gap" },
    { "id": "tz-ny-fall-back-across", "fn": "cronNext", "args": ["0 0 9 * * ?", "America/New_York", "2026-10-30T13:00:01Z", 4], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next", "note": "2026-11-01 is the US fall-back day; the UTC offset moves -04:00 -> -05:00" },
    { "id": "tz-ny-fall-back-ambiguous-0130", "fn": "cronNext", "args": ["0 30 1 * * ?", "America/New_York", "2026-10-31T08:00:00Z", 3], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next", "note": "01:30 local occurs twice on 2026-11-01" },
    { "id": "tz-ny-fall-back-hourly", "fn": "cronNext", "args": ["0 0 * * * ?", "America/New_York", "2026-11-01T04:00:00Z", 5], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next", "note": "hourly straight through the repeated hour" },
    { "id": "tz-ny-every-15-min-through-gap", "fn": "cronNext", "args": ["0 0/15 * * * ?", "America/New_York", "2026-03-08T06:45:00Z", 6], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "tz-berlin-spring-forward", "fn": "cronNext", "args": ["0 0 2 * * ?", "Europe/Berlin", "2026-03-28T00:00:00Z", 3], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next", "note": "02:00 local does not exist on 2026-03-29 in Berlin" },
    { "id": "tz-berlin-fall-back", "fn": "cronNext", "args": ["0 30 2 * * ?", "Europe/Berlin", "2026-10-24T00:00:00Z", 3], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next", "note": "02:30 local occurs twice on 2026-10-25 in Berlin" },
    { "id": "tz-berlin-daily-midnight", "fn": "cronNext", "args": ["0 0 0 * * ?", "Europe/Berlin", "2026-03-27T00:00:00Z", 4], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "tz-tokyo-no-dst", "fn": "cronNext", "args": ["0 0 9 * * ?", "Asia/Tokyo", "2026-03-07T00:00:00Z", 3], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "tz-kolkata-half-hour-offset", "fn": "cronNext", "args": ["0 0 9 * * ?", "Asia/Kolkata", "2026-03-07T00:00:00Z", 3], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "tz-lordhowe-half-hour-dst", "fn": "cronNext", "args": ["0 0 2 * * ?", "Australia/Lord_Howe", "2026-10-03T00:00:00Z", 3], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next", "note": "Lord Howe shifts by 30 minutes" },
    { "id": "tz-santiago-southern-dst", "fn": "cronNext", "args": ["0 0 0 * * ?", "America/Santiago", "2026-09-05T00:00:00Z", 4], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next", "note": "southern-hemisphere transition at local midnight" },
    { "id": "tz-utc-explicit", "fn": "cronNext", "args": ["0 0 9 * * ?", "UTC", "2026-03-07T00:00:00Z", 3], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "tz-ny-weekly-monday-across-dst", "fn": "cronNext", "args": ["0 0 8 ? * MON", "America/New_York", "2026-03-01T00:00:00Z", 4], "upstreamFn": "org.quartz.CronExpression.getNextValidTimeAfter", "goFn": "quartz.CronExpression.Next" },
    { "id": "tz-unknown-zone", "fn": "cronNext", "args": ["0 0 9 * * ?", "Mars/Olympus_Mons", "2026-01-01T00:00:00Z", 1], "upstreamFn": "org.quartz.CronExpression.setTimeZone", "goFn": "time.LoadLocation", "note": "both sides must reject an unknown zone id" }
  ]
}
