{
  "group": "cron-parse",
  "upstream": "org.quartz-scheduler:quartz@2.5.0",
  "note": "Accept/reject parity for the whole CronExpression grammar. value is `true` when the expression parses; ok:false when it is rejected. Message text is deliberately not compared.",
  "cases": [
    { "id": "parse-every-day-noon", "fn": "cronParse", "args": ["0 0 12 * * ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-question-in-dom", "fn": "cronParse", "args": ["0 15 10 ? * *"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron", "note": "? in day-of-month, * in day-of-week" },
    { "id": "parse-question-both-day-fields", "fn": "cronParse", "args": ["0 15 10 ? * ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron", "note": "both day fields unspecified" },
    { "id": "parse-star-both-day-fields", "fn": "cronParse", "args": ["0 0 12 * * *"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron", "note": "Quartz forbids specifying BOTH day-of-month and day-of-week" },
    { "id": "parse-numeric-both-day-fields", "fn": "cronParse", "args": ["0 0 12 15 * 3"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron", "note": "Quartz forbids both restricted; Unix cron ORs them" },
    { "id": "parse-minute-list", "fn": "cronParse", "args": ["0 0,15,30,45 * * * ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-minute-range", "fn": "cronParse", "args": ["0 0-5 14 * * ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-step-over-star", "fn": "cronParse", "args": ["*/10 * * * * ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-step-over-range", "fn": "cronParse", "args": ["0 10-30/5 * * * ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-step-from-value", "fn": "cronParse", "args": ["0 0/5 14,18 * * ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-dom-step-from-value", "fn": "cronParse", "args": ["0 0 12 1/5 * ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-month-names", "fn": "cronParse", "args": ["0 0 0 1 JAN,JUL ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-month-name-range", "fn": "cronParse", "args": ["0 0 0 1 MAR-SEP ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-month-names-lowercase", "fn": "cronParse", "args": ["0 0 0 1 jan ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-dow-name-range", "fn": "cronParse", "args": ["0 15 10 ? * MON-FRI"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-dow-name-list", "fn": "cronParse", "args": ["0 15 10 ? * SUN,SAT"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-dow-numeric-1", "fn": "cronParse", "args": ["0 0 12 ? * 1"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron", "note": "Quartz: 1 == Sunday" },
    { "id": "parse-dow-numeric-7", "fn": "cronParse", "args": ["0 0 12 ? * 7"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron", "note": "Quartz: 7 == Saturday; Unix cron: 7 == Sunday" },
    { "id": "parse-dow-numeric-0", "fn": "cronParse", "args": ["0 0 12 ? * 0"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron", "note": "Quartz has no day 0" },
    { "id": "parse-dow-numeric-8", "fn": "cronParse", "args": ["0 0 12 ? * 8"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron", "note": "out of range on both sides" },
    { "id": "parse-seven-field-year", "fn": "cronParse", "args": ["0 15 10 * * ? 2026"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron", "note": "7-field form with a year field" },
    { "id": "parse-seven-field-year-range", "fn": "cronParse", "args": ["0 15 10 * * ? 2026-2028"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-seven-field-year-star", "fn": "cronParse", "args": ["0 15 10 * * ? *"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-five-field", "fn": "cronParse", "args": ["0 12 * * *"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron", "note": "Quartz requires 6 or 7 fields; the port also accepts the 5-field Unix form" },
    { "id": "parse-eight-field", "fn": "cronParse", "args": ["0 15 10 * * ? 2026 5"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-three-field", "fn": "cronParse", "args": ["* * *"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-empty", "fn": "cronParse", "args": [""], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-garbage", "fn": "cronParse", "args": ["bogus"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-l-dom", "fn": "cronParse", "args": ["0 15 10 L * ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron", "note": "L == last day of month" },
    { "id": "parse-l-offset-dom", "fn": "cronParse", "args": ["0 15 10 L-2 * ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-lw-dom", "fn": "cronParse", "args": ["0 15 10 LW * ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron", "note": "last weekday of month" },
    { "id": "parse-l-dow", "fn": "cronParse", "args": ["0 15 10 ? * 6L"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron", "note": "last Friday of month (Quartz 6 == Friday)" },
    { "id": "parse-w-dom", "fn": "cronParse", "args": ["0 15 10 15W * ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron", "note": "nearest weekday to the 15th" },
    { "id": "parse-w-bare", "fn": "cronParse", "args": ["0 15 10 W * ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron", "note": "bare W with no day is invalid" },
    { "id": "parse-hash-dow", "fn": "cronParse", "args": ["0 15 10 ? * 6#3"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron", "note": "third Friday of month" },
    { "id": "parse-hash-dow-name", "fn": "cronParse", "args": ["0 15 10 ? * FRI#1"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-hash-dow-six", "fn": "cronParse", "args": ["0 15 10 ? * 6#6"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron", "note": "there is no 6th weekday in a month" },
    { "id": "parse-second-60", "fn": "cronParse", "args": ["60 0 12 * * ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-minute-60", "fn": "cronParse", "args": ["0 60 12 * * ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-hour-24", "fn": "cronParse", "args": ["0 0 24 * * ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-dom-32", "fn": "cronParse", "args": ["0 0 12 32 * ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-dom-0", "fn": "cronParse", "args": ["0 0 12 0 * ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-month-13", "fn": "cronParse", "args": ["0 0 12 1 13 ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-month-0", "fn": "cronParse", "args": ["0 0 12 1 0 ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-bad-month-name", "fn": "cronParse", "args": ["0 0 12 1 FOO ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-bad-dow-name", "fn": "cronParse", "args": ["0 0 12 ? * FOO"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-step-zero", "fn": "cronParse", "args": ["0 */0 12 * * ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-step-negative", "fn": "cronParse", "args": ["0 */-1 12 * * ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-step-nonnumeric", "fn": "cronParse", "args": ["0 */x 12 * * ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-reversed-range", "fn": "cronParse", "args": ["0 30-10 12 * * ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-dow-reversed-range", "fn": "cronParse", "args": ["0 0 12 ? * FRI-MON"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron", "note": "Quartz wraps day-of-week ranges" },
    { "id": "parse-l-offset-too-large", "fn": "cronParse", "args": ["0 15 10 L-32 * ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-tabs-as-separator", "fn": "cronParse", "args": ["0\t0\t12\t*\t*\t?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-extra-spaces", "fn": "cronParse", "args": ["0  0   12 * * ?"], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" },
    { "id": "parse-leading-trailing-space", "fn": "cronParse", "args": [" 0 0 12 * * ? "], "upstreamFn": "org.quartz.CronExpression.<init>", "goFn": "quartz.ParseCron" }
  ]
}
