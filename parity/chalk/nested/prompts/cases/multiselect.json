  "cases": [
    {
      "id": "ms-none",
      "fn": "multiselect",
      "args": [
        {
          "message": "pick",
          "choices": [
            {
              "title": "Red"
            },
            {
              "title": "Green"
            },
            {
              "title": "Blue"
            }
          ]
        },
        [
          "<enter>"
        ]
      ],
      "goFn": "prompts.MultiSelect",
      "note": "nothing selected is an empty list, never null",
      "upstreamFn": "prompts.multiselect"
    },
