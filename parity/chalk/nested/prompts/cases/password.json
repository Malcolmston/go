{
  "group": "password",
  "upstream": "prompts@2.4.2",
  "cases": [
    {
      "id": "password-basic",
      "fn": "password",
      "args": [
        {
          "message": "secret"
        },
        [
          "s3cret",
          "<enter>"
        ]
      ],
      "goFn": "prompts.Password",
      "upstreamFn": "prompts.password"
    },
    {
      "id": "password-empty",
      "fn": "password",
      "args": [
        {
          "message": "secret"
        },
        [
          "<enter>"
        ]
      ],
      "goFn": "prompts.Password",
      "upstreamFn": "prompts.password"
    },
    {
      "id": "password-backspace",
      "fn": "password",
      "args": [
        {
          "message": "secret"
        },
        [
          "abcx",
          "<backspace>",
          "<enter>"
        ]
      ],
      "goFn": "prompts.Password",
      "upstreamFn": "prompts.password"
    },
    {
      "id": "password-unicode",
      "fn": "password",
      "args": [
        {
          "message": "secret"
        },
        [
          "pässwörd",
          "<enter>"
        ]
      ],
      "goFn": "prompts.Password",
      "upstreamFn": "prompts.password"
    },
    {
      "id": "password-mask-does-not-change-value",
      "fn": "password",
      "args": [
        {
          "message": "secret",
          "mask": "*"
        },
        [
          "abc",
          "<enter>"
        ]
      ],
      "goFn": "prompts.Password",
      "note": "Mask only changes the echo; upstream always renders * for style=password",
      "upstreamFn": "prompts.password"
    },
    {
      "id": "password-spaces",
      "fn": "password",
      "args": [
        {
          "message": "secret"
        },
        [
          "a b c",
          "<enter>"
        ]
      ],
      "goFn": "prompts.Password",
      "upstreamFn": "prompts.password"
    }
  ]
}
