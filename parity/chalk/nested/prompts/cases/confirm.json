    {
      "id": "dev-confirm-yes-inside-a-word",
      "fn": "confirm",
      "args": [
        {
          "message": "ok?"
        },
        [
          "maybe",
          "<enter>"
        ]
      ],
      "goFn": "prompts.Confirm",
      "deviation": "upstream submits on the first y/n keypress, so the y in \"maybe\" answers yes; the port reads a whole line and only accepts y/yes/n/no. See chalk/API-DEVIATIONS.md",
      "upstreamFn": "prompts.confirm"
