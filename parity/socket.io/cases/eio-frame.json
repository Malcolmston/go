{
  "group": "eio-frame",
  "upstream": "engine.io-parser@5.2.3",
  "note": "Engine.IO v4 transport framing — the layer that carries every Socket.IO packet. `type` is the numeric Engine.IO packet type (0 open, 1 close, 2 ping, 3 pong, 4 message, 5 upgrade, 6 noop); `binary` is a hex string for a binary MESSAGE. Payloads use the \\u001e record separator. encodePacket is compared with supportsBinary=false (the polling form, base64 with a \"b\" prefix), which is what Go's Packet.Encode produces.",
  "cases": [
    {
      "id": "eio-enc-open",
      "fn": "eio.encodePacket",
      "args": [
        {
          "type": 0,
          "data": "{\"sid\":\"x\",\"pingInterval\":25000}"
        }
      ],
      "upstreamFn": "encodePacket",
      "goFn": "engineio.Packet.Encode"
    },
    {
      "id": "eio-enc-close",
      "fn": "eio.encodePacket",
      "args": [
        {
          "type": 1
        }
      ],
      "upstreamFn": "encodePacket",
      "goFn": "engineio.Packet.Encode"
    },
