{
  "group": "behaviour",
  "upstream": "socket.io@4.8.1 + socket.io-client@4.8.1",
  "note": "Observable end-to-end behaviour. Each runner starts its OWN server on a random 127.0.0.1 port and connects with its OWN client over the websocket transport, then emits an ordered transcript of observation lines for a scripted scenario. `fn` names the scenario, built identically by both runners; the compared value is {transcript:[...]}. NORMALISATION: socket ids become <S1>,<S2>,... in first-seen order; a socket's implicit self-room becomes <self>; the port's client fires \"disconnect\" with no arguments, recorded as <no-reason>; the upstream client's connect-timeout message and the port's \"connect timeout\" both become <no reply>; the port's client error prefix \"client: \" is stripped so the message compares with Error.message. Ports and session ids never enter a transcript. Broadcast fan-out lines (cli:heard) are sorted because delivery order across sockets is unspecified.",
  "cases": [
    { "id": "emit-scalar-args", "fn": "scenario.emit-scalar-args", "upstreamFn": "socket.emit / socket.on", "goFn": "Socket.Emit / Socket.On", "note": "argument marshalling AND in-order delivery of five back-to-back events" },
    { "id": "ack-values", "fn": "scenario.ack-values", "upstreamFn": "socket.emit(ev, cb)", "goFn": "Client.EmitWithAck" },
    { "id": "ack-multi-values", "fn": "scenario.ack-multi-values", "upstreamFn": "ack callback arity", "goFn": "EventHandler return value" },
    { "id": "ack-empty-call", "fn": "scenario.ack-empty-call", "upstreamFn": "cb()", "goFn": "EventHandler returning []any{}" },
    { "id": "ack-no-handler", "fn": "scenario.ack-no-handler", "upstreamFn": "Socket._onevent", "goFn": "Socket.dispatch", "note": "upstream never acks an event with no handler; the port acks with an empty payload" },
    { "id": "ack-handler-never-calls", "fn": "scenario.ack-handler-never-calls", "upstreamFn": "Socket._onevent", "goFn": "Socket.dispatch", "note": "a handler that never invokes its callback must not produce an ack" },
    { "id": "ack-binary", "fn": "scenario.ack-binary", "upstreamFn": "BINARY_ACK round trip", "goFn": "Socket.dispatch + EncodeBinary" },
    { "id": "server-ack", "fn": "scenario.server-ack", "upstreamFn": "socket.timeout().emitWithAck", "goFn": "Socket.EmitAck" },
    { "id": "server-ack-no-handler", "fn": "scenario.server-ack-no-handler", "upstreamFn": "socket.timeout().emitWithAck", "goFn": "Socket.EmitAck", "note": "same auto-ack defect on the client side, so a server-side ack timeout is unreachable Go-to-Go" },
    { "id": "onany", "fn": "scenario.onany", "upstreamFn": "socket.onAny", "goFn": "Socket.OnAny" },
    { "id": "binary-server-to-client", "fn": "scenario.binary-server-to-client", "upstreamFn": "socket.emit(Buffer)", "goFn": "Socket.Emit([]byte)" },
    { "id": "binary-client-to-server", "fn": "scenario.binary-client-to-server", "upstreamFn": "socket.emit(Buffer)", "goFn": "Client.Emit([]byte)" },
    { "id": "namespace-connect", "fn": "scenario.namespace-connect", "upstreamFn": "io.of", "goFn": "Server.Of" },
    { "id": "namespace-middleware-accept", "fn": "scenario.namespace-middleware-accept", "upstreamFn": "nsp.use", "goFn": "Namespace.Use", "note": "middleware order, then the connection handler" },
    { "id": "namespace-middleware-reject", "fn": "scenario.namespace-middleware-reject", "upstreamFn": "nsp.use + connect_error", "goFn": "Namespace.Use + ConnectError" },
    { "id": "namespace-middleware-silent", "fn": "scenario.namespace-middleware-silent", "upstreamFn": "nsp.use", "goFn": "Namespace.runMiddleware", "note": "middleware that never calls next() must leave the handshake unanswered" },
    { "id": "namespace-invalid", "fn": "scenario.namespace-invalid", "upstreamFn": "\"Invalid namespace\" connect_error", "goFn": "conn.handleConnect" },
    { "id": "handshake-auth", "fn": "scenario.handshake-auth", "upstreamFn": "socket.handshake.auth", "goFn": "Socket.Auth" },
    { "id": "rooms-self-room", "fn": "scenario.rooms-self-room", "upstreamFn": "socket.rooms / join / leave", "goFn": "Socket.Rooms / Join / Leave" },
    { "id": "rooms-socket-to-excludes-sender", "fn": "scenario.rooms-socket-to-excludes-sender", "upstreamFn": "socket.to(room).emit", "goFn": "Socket.To().Emit" },
    { "id": "rooms-namespace-to-includes-sender", "fn": "scenario.rooms-namespace-to-includes-sender", "upstreamFn": "io.to(room).emit", "goFn": "Server.To().Emit" },
    { "id": "rooms-except", "fn": "scenario.rooms-except", "upstreamFn": "io.except(room).emit", "goFn": "Server.Except().Emit" },
    { "id": "rooms-broadcast-all", "fn": "scenario.rooms-broadcast-all", "upstreamFn": "io.emit", "goFn": "Server.Emit" },
    { "id": "rooms-socket-broadcast", "fn": "scenario.rooms-socket-broadcast", "upstreamFn": "socket.broadcast.emit", "goFn": "Socket.Broadcast().Emit" },
    { "id": "rooms-fetch-sockets", "fn": "scenario.rooms-fetch-sockets", "upstreamFn": "io.fetchSockets / io.in(room).fetchSockets", "goFn": "Server.FetchSockets / Namespace.SocketsInRoom" },
    { "id": "rooms-sockets-join-leave", "fn": "scenario.rooms-sockets-join-leave", "upstreamFn": "io.socketsJoin / io.socketsLeave", "goFn": "Server.SocketsJoin / SocketsLeave" },
    { "id": "disconnect-client-initiated", "fn": "scenario.disconnect-client-initiated", "upstreamFn": "socket.on(\"disconnecting\"/\"disconnect\")", "goFn": "Socket.OnDisconnect" },
    { "id": "disconnect-server-namespace", "fn": "scenario.disconnect-server-namespace", "upstreamFn": "socket.disconnect(false)", "goFn": "Socket.Disconnect(false)" },
    { "id": "disconnect-server-transport", "fn": "scenario.disconnect-server-transport", "upstreamFn": "socket.disconnect(true)", "goFn": "Socket.Disconnect(true)" },
    { "id": "disconnect-namespace-then-emit", "fn": "scenario.disconnect-namespace-then-emit", "upstreamFn": "socket.emit after disconnect", "goFn": "Socket.Emit after Disconnect" },
    { "id": "reserved-event-server-emit", "fn": "scenario.reserved-event-server-emit", "upstreamFn": "RESERVED_EVENTS guard (server)", "goFn": "Socket.Emit" },
    { "id": "reserved-event-client-emit", "fn": "scenario.reserved-event-client-emit", "upstreamFn": "RESERVED_EVENTS guard (client)", "goFn": "client.Client.Emit" },
    { "id": "handler-off", "fn": "scenario.handler-off", "upstreamFn": "socket.off(ev, fn)", "goFn": "Socket.Off(ev)" },
    { "id": "socket-data", "fn": "scenario.socket-data", "upstreamFn": "socket.data", "goFn": "Socket.Set / Socket.Data" }
  ]
}
