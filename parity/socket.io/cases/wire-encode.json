    {
      "id": "enc-binary-in-connect",
      "fn": "wire.encode",
      "args": [
        {
          "type": 0,
          "data": {
            "blob": {
              "$bin": "00ff"
            }
          }
        }
      ],
      "upstreamFn": "Encoder.encode",
      "goFn": "Encoder.Encode",
      "note": "only EVENT/ACK are promoted; a buffer in a CONNECT payload is not an attachment",
      "deviation": "Only EVENT/ACK carry binary attachments; a []byte in a CONNECT payload is serialised inline. Go renders it as base64; Node renders a Buffer as {\"type\":\"Buffer\",\"data\":[...]}. Neither is a valid attachment; the shapes just differ. Reachable only by a hand-built packet."
    },
