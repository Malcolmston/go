    },
    {
      "id": "decpay-many",
      "fn": "eio.decodePayload",
      "args": [
        {
          "encoded": "4a\u001e4b\u001e4c\u001e4d\u001e4e\u001e4f\u001e4g\u001e4h\u001e4i\u001e4j"
        }
      ],
      "upstreamFn": "decodePayload",
      "goFn": "engineio.DecodePayload",
      "note": "ten members, to pin down ordering"
    },
    {
      "id": "decpay-unicode",
      "fn": "eio.decodePayload",
      "args": [
        {
          "encoded": "4héllo\u001e4你好\u001e4🌍"
        }
      ],
      "upstreamFn": "decodePayload",
      "goFn": "engineio.DecodePayload"
    },
    {
      "id": "roundtrip-mixed",
      "fn": "eio.roundTrip",
      "args": [
        {
          "packets": [
            {
              "type": "open",
              "data": "{\"sid\":\"s\"}"
            },
            {
              "type": "message",
              "data": "42[\"ev\",{\"a\":1}]"
            },
            {
              "type": "message",
              "binary": "deadbeef"
            },
            {
              "type": "ping"
            },
            {
              "type": "noop"
            }
          ]
        }
      ],
      "upstreamFn": "encodePayload + decodePayload",
      "goFn": "engineio.EncodePayload + DecodePayload",
      "note": "the batching format's only real invariant: what goes in comes out, in order"
    },
    {
