{
  "group": "wire",
  "upstream": "socket.io-client@4.8.1 + socket.io-parser@4.2.7",
  "note": "The packets a client actually puts on the wire, encoded. Upstream builds them with the real Socket: an emit on a Socket that is not connected lands in sendBuffer, and _sendConnectPacket is intercepted by stubbing io._packet — no server is involved. The packets are then encoded with socket.io-parser's Encoder. The reply is the encoded frames: the text frame first, then each binary attachment as \"bin:<lowercase hex>\". A binary event argument is written {\"$bin\": \"<lowercase hex>\"} in the case and becomes a Buffer / []byte in the runner. Objects with more than one key are avoided: Go maps do not preserve insertion order, which is an already-documented deviation of the shared codec (see parity/socket.io/COVERAGE.md).",
  "cases": [
    {
      "id": "wire-connect-root",
      "fn": "wire.connect",
      "args": [
        {
          "namespace": "/"
        }
      ],
      "upstreamFn": "Socket._sendConnectPacket + socket.io-parser Encoder",
      "goFn": "client.ConnectPacket + socketio.Packet.EncodeBinary",
      "note": "CONNECT to the default namespace with no auth"
    },
    {
      "id": "wire-connect-namespace",
      "fn": "wire.connect",
      "args": [
        {
          "namespace": "/admin"
        }
      ],
      "upstreamFn": "Socket._sendConnectPacket + socket.io-parser Encoder",
      "goFn": "client.ConnectPacket + socketio.Packet.EncodeBinary"
    },
    {
      "id": "wire-connect-nested-namespace",
      "fn": "wire.connect",
      "args": [
        {
          "namespace": "/a/b"
        }
      ],
      "upstreamFn": "Socket._sendConnectPacket + socket.io-parser Encoder",
      "goFn": "client.ConnectPacket + socketio.Packet.EncodeBinary"
    },
    {
      "id": "wire-connect-auth-object",
      "fn": "wire.connect",
      "args": [
        {
          "namespace": "/",
          "auth": {
            "token": "abc"
          }
        }
      ],
      "upstreamFn": "Socket._sendConnectPacket + socket.io-parser Encoder",
      "goFn": "client.ConnectPacket + socketio.Packet.EncodeBinary",
      "note": "the auth payload rides in the CONNECT packet"
    },
    {
