      "fn": "expand",
      "args": [
        {
          "rule": "FREQ=DAILY;COUNT=5",
          "dtstart": "1997-09-02T09:00:00",
          "tz": "America/New_York",
          "limit": 7
        }
      ],
      "upstreamFn": "dateutil.rrule.rrulestr",
      "goFn": "rrule.Parse+rrule.New+RRule.Iterator"
    },
