{
  "group": "portbugs",
  "upstream": "python-dateutil@2.9.0.post0",
  "cases": [
    {
      "id": "bug-huge-interval",
      "fn": "expand",
      "args": [
        {
          "rule": "FREQ=DAILY;INTERVAL=9223372036854775807;COUNT=2",
          "dtstart": "1997-09-02T09:00:00",
          "tz": "UTC",
          "limit": 4
        }
      ],
      "upstreamFn": "dateutil.rrule.rrulestr",
      "goFn": "rrule.Parse+rrule.New+RRule.Iterator",
      "note": "port panics on an INTERVAL near max int64; upstream just returns few occurrences"
    },
    {
      "id": "bug-huge-interval-monthly",
      "fn": "expand",
      "args": [
        {
          "rule": "FREQ=MONTHLY;INTERVAL=9223372036854775807;COUNT=2",
          "dtstart": "1997-09-02T09:00:00",
          "tz": "UTC",
          "limit": 4
        }
      ],
      "upstreamFn": "dateutil.rrule.rrulestr",
      "goFn": "rrule.Parse+rrule.New+RRule.Iterator",
      "note": "same overflow, MONTHLY"
    },
    {
      "id": "bug-large-interval",
      "fn": "expand",
      "args": [
        {
          "rule": "FREQ=DAILY;INTERVAL=1000000000;COUNT=2",
          "dtstart": "1997-09-02T09:00:00",
          "tz": "UTC",
          "limit": 4
        }
      ],
      "upstreamFn": "dateutil.rrule.rrulestr",
      "goFn": "rrule.Parse+rrule.New+RRule.Iterator",
      "note": "a merely large INTERVAL"
    },
    {
      "id": "bug-missing-freq",
      "fn": "expand",
      "args": [
        {
          "rule": "COUNT=3",
          "dtstart": "1997-09-02T09:00:00",
          "tz": "UTC",
          "limit": 5
        }
      ],
      "upstreamFn": "dateutil.rrule.rrulestr",
      "goFn": "rrule.Parse+rrule.New+RRule.Iterator",
      "note": "upstream rejects a rule with no FREQ; the port silently treats it as YEARLY"
    },
    {
      "id": "bug-missing-freq-byday",
      "fn": "expand",
      "args": [
        {
          "rule": "BYDAY=MO;COUNT=3",
          "dtstart": "1997-09-02T09:00:00",
          "tz": "UTC",
          "limit": 5
        }
      ],
      "upstreamFn": "dateutil.rrule.rrulestr",
      "goFn": "rrule.Parse+rrule.New+RRule.Iterator",
      "note": "no FREQ, only a BYxxx part"
    },
    {
      "id": "bug-count-zero",
      "fn": "expand",
      "args": [
        {
          "rule": "FREQ=DAILY;COUNT=0",
          "dtstart": "1997-09-02T09:00:00",
          "tz": "UTC",
          "limit": 5
        }
      ],
      "upstreamFn": "dateutil.rrule.rrulestr",
      "goFn": "rrule.Parse+rrule.New+RRule.Iterator",
      "note": "upstream yields nothing for COUNT=0; the port reads 0 as unlimited"
    },
    {
      "id": "bug-interval-zero",
      "fn": "expand",
      "args": [
        {
          "rule": "FREQ=DAILY;INTERVAL=0;COUNT=3",
          "dtstart": "1997-09-02T09:00:00",
          "tz": "UTC",
          "limit": 5
        }
      ],
      "upstreamFn": "dateutil.rrule.rrulestr",
      "goFn": "rrule.Parse+rrule.New+RRule.Iterator",
      "note": "upstream repeats DTSTART; the port normalises INTERVAL=0 to 1"
    },
    {
      "id": "bug-interval-zero-hourly",
      "fn": "expand",
      "args": [
        {
          "rule": "FREQ=HOURLY;INTERVAL=0;COUNT=3",
          "dtstart": "1997-09-02T09:00:00",
          "tz": "UTC",
          "limit": 5
        }
      ],
      "upstreamFn": "dateutil.rrule.rrulestr",
      "goFn": "rrule.Parse+rrule.New+RRule.Iterator"
    },
    {
      "id": "bug-dst-spring-forward-daily",
      "fn": "expand",
      "args": [
        {
          "rule": "FREQ=DAILY;COUNT=4",
          "dtstart": "2024-03-09T02:30:00",
          "tz": "America/New_York",
          "limit": 6
        }
      ],
      "upstreamFn": "dateutil.rrule.rrulestr",
      "goFn": "rrule.Parse+rrule.New+RRule.Iterator",
      "note": "RFC 5545 skips the non-existent 02:30 on 2024-03-10; the port shifts the wall clock"
    },
    {
      "id": "bug-dst-spring-forward-weekly",
      "fn": "expand",
      "args": [
        {
          "rule": "FREQ=WEEKLY;COUNT=3",
          "dtstart": "2024-02-25T02:30:00",
          "tz": "America/New_York",
          "limit": 5
        }
      ],
      "upstreamFn": "dateutil.rrule.rrulestr",
      "goFn": "rrule.Parse+rrule.New+RRule.Iterator",
      "note": "weekly 02:30 crossing the same gap"
    },
    {
      "id": "bug-dst-spring-forward-berlin",
      "fn": "expand",
      "args": [
        {
          "rule": "FREQ=DAILY;COUNT=4",
          "dtstart": "2024-03-30T02:30:00",
          "tz": "Europe/Berlin",
          "limit": 6
        }
      ],
      "upstreamFn": "dateutil.rrule.rrulestr",
      "goFn": "rrule.Parse+rrule.New+RRule.Iterator",
      "note": "EU gap: 02:30 does not exist on 2024-03-31"
    },
    {
      "id": "bug-count-zero-with-until",
      "fn": "expand",
      "args": [
        {
          "rule": "FREQ=DAILY;COUNT=0;UNTIL=19970905T090000Z",
          "dtstart": "1997-09-02T09:00:00",
          "tz": "UTC",
          "limit": 5
        }
      ],
      "upstreamFn": "dateutil.rrule.rrulestr",
      "goFn": "rrule.Parse+rrule.New+RRule.Iterator"
    }
  ]
}
