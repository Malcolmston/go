      "args": [
        {
          "rule": "FREQ=MONTHLY;COUNT=3;BYDAY=TU,WE,TH;BYSETPOS=3",
          "dtstart": "1997-09-04T09:00:00",
          "tz": "UTC",
          "limit": 5
        }
      ],
      "upstreamFn": "dateutil.rrule.rrulestr",
      "goFn": "rrule.Parse+rrule.New+RRule.Iterator"
    },
