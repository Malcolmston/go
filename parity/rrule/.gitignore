# A local venv is only needed when the system python3 does not carry the
# pinned python-dateutil; it is never a deliverable.
python/.venv/
python/__pycache__/

# parity/.gitignore ignores parity.json globally (it is a run artifact for the
# older in-repo harness). Here it is a deliverable: the machine-readable score.
!parity.json
