    {
      "id": "equals-scalar",
      "fn": "script",
      "args": [
        [
          {
            "op": "reset"
          },
          {
            "op": "seed",
            "dataset": "base"
          },
          {
            "op": "findMany",
            "model": "user",
            "where": {
              "city": "Paris"
            },
            "orderBy": [
              {
                "id": "asc"
              }
            ]
          }
        ]
      ],
      "upstreamFn": "where: { city }",
      "goFn": "prisma.Equals"
    },
