      "id": "not-null-violation",
      "fn": "script",
      "args": [
        [
          {
            "op": "reset"
          },
          {
            "op": "seed",
            "dataset": "base"
          },
          {
            "op": "create",
            "model": "user",
            "data": {
              "name": null,
              "email": "nn@x.io",
              "score": 1
            }
          },
          {
            "op": "dump",
            "model": "user"
          }
        ]
      ],
      "upstreamFn": "prisma.user.create({ data: { name: null } })",
      "goFn": "Query.Create with a nil *string",
      "note": "Prisma refuses before any SQL runs and its validation error carries no code; the port lets SQLite refuse and reports P2011"
    },
