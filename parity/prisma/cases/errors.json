        [
          {
            "op": "reset"
          },
          {
            "op": "seed",
            "dataset": "base"
          },
          {
            "op": "create",
            "model": "user",
            "data": {
              "id": 99,
              "name": "Zed",
              "email": "zed@x.io",
              "score": 90
            }
          },
          {
            "op": "dump",
            "model": "user"
          }
        ]
      ],
      "upstreamFn": "create: { data: { id: 99 } }",
      "goFn": "Query.Create with User{ID: 99}",
      "note": "an integer primary key is unconditionally treated as database-generated and dropped from the INSERT: there is no tag that turns that off"
