    {
      "id": "some-with-filter",
      "fn": "script",
      "args": [
        [
          {
            "op": "reset"
          },
          {
            "op": "seed",
            "dataset": "base"
          },
          {
            "op": "findMany",
            "model": "user",
            "where": {
              "posts": {
                "some": {
                  "views": {
                    "gt": 80
                  }
                }
              }
            },
            "orderBy": [
              {
                "id": "asc"
              }
            ],
            "select": [
              "id"
            ]
          }
        ]
      ],
      "upstreamFn": "where: { posts: { some } }",
      "goFn": "prisma.Some(\"Posts\", ...)"
    },
