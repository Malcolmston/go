    {
      "id": "include-to-one",
      "fn": "script",
      "args": [
        [
          {
            "op": "reset"
          },
          {
            "op": "seed",
            "dataset": "base"
          },
          {
            "op": "findMany",
            "model": "post",
            "where": {
              "title": "Alpha"
            },
            "include": [
              "author"
            ]
          }
        ]
      ],
      "upstreamFn": "include: { author: true }",
      "goFn": "Query.Include(\"Author\")",
      "note": "the to-one LEFT JOIN, filtered on a column that exists in only one table"
    },
    {
      "id": "include-to-one-ambiguous-filter",
      "fn": "script",
      "args": [
        [
          {
            "op": "reset"
          },
          {
            "op": "seed",
            "dataset": "base"
          },
          {
            "op": "findMany",
            "model": "post",
            "where": {
              "id": {
                "in": [
                  1,
                  3
                ]
              }
            },
            "include": [
              "author"
            ],
            "orderBy": [
              {
                "id": "asc"
              }
            ]
          }
        ]
      ],
      "upstreamFn": "include: { author: true } with where: { id }",
      "goFn": "Query.Include(\"Author\") with prisma.In(\"id\", ...)",
      "note": "the port never qualifies Where/OrderBy columns with the base table, so any filter on a column both tables have becomes ambiguous SQL"
    },
    {
      "id": "include-to-many",
      "fn": "script",
      "args": [
        [
          {
            "op": "reset"
          },
          {
            "op": "seed",
            "dataset": "base"
          },
          {
            "op": "findMany",
            "model": "user",
            "where": {
              "id": 1
            },
            "include": [
              "posts"
            ]
          }
        ]
      ],
      "upstreamFn": "include: { posts: true }",
      "goFn": "Query.Include(\"Posts\")",
      "note": "a to-many include: the port joins on base.<fk> = target.<references>, which for a to-many relation names a column the base table does not have"
    },
