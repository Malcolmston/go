    },
    {
      "id": "opened-but-unwritten-tree-survives-reopen",
      "fn": "script",
      "args": [
        [
          {
            "op": "open_tree",
            "name": "ghost"
          },
          {
            "op": "tree_names"
          },
          {
            "op": "flush"
          },
          {
            "op": "reopen"
          },
          {
            "op": "tree_names"
          }
        ]
      ],
      "upstreamFn": "Db::open_tree",
      "goFn": "DB.OpenTree",
      "note": "sled persists a tree as soon as open_tree returns; the Go port drops a tree that never received a write",
      "deviation": "Go port documents that an opened-but-never-written tree does not survive a restart"
    },
    {
      "id": "emptied-tree-survives-reopen",
      "fn": "script",
      "args": [
        [
          {
            "op": "open_tree",
            "name": "t1"
          },
          {
            "op": "insert",
            "key": "61",
            "value": "31",
            "tree": "t1"
          },
          {
            "op": "remove",
            "key": "61",
            "tree": "t1"
          },
          {
            "op": "flush"
          },
          {
            "op": "reopen"
          },
          {
            "op": "tree_names"
          },
          {
            "op": "len",
            "tree": "t1"
          }
        ]
      ],
      "upstreamFn": "Db::open_tree",
      "goFn": "DB.OpenTree",
      "note": "a tree that received a write and was then emptied still exists after a plain reopen"
    },
