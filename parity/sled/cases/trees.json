          {
            "op": "open_tree",
            "name": "aaa"
          },
          {
            "op": "open_tree",
            "name": "mmm"
          },
          {
            "op": "insert",
            "key": "6b",
            "value": "76",
            "tree": "zzz"
          },
          {
            "op": "insert",
            "key": "6b",
            "value": "76",
            "tree": "aaa"
          },
          {
            "op": "insert",
            "key": "6b",
            "value": "76",
            "tree": "mmm"
          },
          {
            "op": "tree_names"
          }
        ]
