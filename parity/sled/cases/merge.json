    {
      "id": "merge-per-tree-operator",
      "fn": "script",
      "args": [
        [
          {
            "op": "open_tree",
            "name": "t1"
          },
          {
            "op": "set_merge_operator",
            "merge": "concat"
          },
          {
            "op": "merge",
            "key": "61",
            "value": "78"
          },
          {
            "op": "merge",
            "tree": "t1",
            "key": "61",
            "value": "78"
          },
          {
