{
  "group": "merge",
  "upstream": "sled@0.34.7",
  "encoding": "all keys, values and tree names are lowercase hex",
  "cases": [
    {
      "id": "merge-without-operator",
      "fn": "script",
      "args": [
        [
          {
            "op": "merge",
            "key": "61",
            "value": "31"
          },
          {
            "op": "len"
          }
        ]
      ],
      "upstreamFn": "Tree::merge",
      "goFn": "Tree.Merge",
      "note": "must fail on both sides: no merge operator installed"
    },
    {
      "id": "merge-concat",
      "fn": "script",
      "args": [
        [
          {
            "op": "set_merge_operator",
            "merge": "concat"
          },
          {
            "op": "merge",
            "key": "61",
            "value": "78"
          },
          {
            "op": "merge",
            "key": "61",
            "value": "79"
          },
          {
            "op": "merge",
            "key": "61",
            "value": ""
          },
          {
            "op": "get",
            "key": "61"
          },
          {
            "op": "iter"
          }
        ]
      ],
      "upstreamFn": "Tree::merge / Tree::set_merge_operator",
      "goFn": "Tree.Merge / Tree.SetMergeOperator",
      "note": "the operator sees None/nil for an absent key"
    },
