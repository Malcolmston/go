{
  "group": "cron-eval",
  "upstream": "oban@2.23.1",
  "note": "Evaluation of parsed expressions against an explicit reference instant. Every reference instant is an absolute UTC ISO-8601 string and every emitted fire time is UTC ISO-8601 with second precision; neither runner ever consults the wall clock. Timezone is fixed to Etc/UTC on both sides (see COVERAGE.md).",
  "cases": [
    {"id": "now-wild-true", "fn": "cron_now", "args": ["* * * * *", "2026-01-01T00:00:00Z"], "upstreamFn": "Oban.Cron.Expression.now?/2", "goFn": "(*oban.Schedule).Matches"},
