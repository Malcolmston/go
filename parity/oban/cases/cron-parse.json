{
  "group": "cron-parse",
  "upstream": "oban@2.23.1",
  "note": "Acceptance/rejection of 5-field cron expressions. Oban.Cron.Expression keeps its parsed field sets in private MapSets and the Go port keeps them in unexported bitmasks, so the parsed sets are compared indirectly through the cron-now/cron-next/cron-upcoming groups; this group compares only whether parsing succeeds.",
  "cases": [
    {"id": "parse-all-wild", "fn": "cron_parse", "args": ["* * * * *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec"},
    {"id": "parse-daily-1am", "fn": "cron_parse", "args": ["0 1 * * *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec"},
    {"id": "parse-step-wild", "fn": "cron_parse", "args": ["*/15 * * * *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec"},
    {"id": "parse-list", "fn": "cron_parse", "args": ["0 0,12 * * *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec"},
    {"id": "parse-range", "fn": "cron_parse", "args": ["0 9-17 * * *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec"},
    {"id": "parse-range-step", "fn": "cron_parse", "args": ["0 9-17/2 * * *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec"},
    {"id": "parse-open-range-step", "fn": "cron_parse", "args": ["5/10 * * * *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "bare value with a step means value-max/step"},
    {"id": "parse-dom-first", "fn": "cron_parse", "args": ["0 0 1 * *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec"},
    {"id": "parse-dow-sunday-0", "fn": "cron_parse", "args": ["0 0 * * 0"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec"},
    {"id": "parse-dow-saturday-6", "fn": "cron_parse", "args": ["0 0 * * 6"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec"},
    {"id": "parse-month-name", "fn": "cron_parse", "args": ["0 0 * JAN *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec"},
    {"id": "parse-month-name-list", "fn": "cron_parse", "args": ["0 0 * JAN,JUL *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec"},
    {"id": "parse-dow-name", "fn": "cron_parse", "args": ["0 0 * * MON"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec"},
    {"id": "parse-dow-name-range", "fn": "cron_parse", "args": ["0 0 * * MON-FRI"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec"},
    {"id": "parse-dow-name-and-number", "fn": "cron_parse", "args": ["0 0 * * 1,SUN"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec"},
    {"id": "parse-feb-29", "fn": "cron_parse", "args": ["0 0 29 2 *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "leap day is a legal pairing"},
    {"id": "parse-year-end", "fn": "cron_parse", "args": ["59 23 31 12 *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec"},
    {"id": "parse-dom-list", "fn": "cron_parse", "args": ["0 0 1,15 * *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec"},
    {"id": "parse-dom-step", "fn": "cron_parse", "args": ["0 0 */2 * *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec"},
    {"id": "parse-month-step", "fn": "cron_parse", "args": ["0 0 * */3 *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec"},
    {"id": "parse-dow-step", "fn": "cron_parse", "args": ["0 0 * * */2"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec"},
    {"id": "parse-both-day-fields", "fn": "cron_parse", "args": ["0 0 13 * 5"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "both day fields restricted"},
    {"id": "parse-extra-whitespace", "fn": "cron_parse", "args": ["0   0  *  *  *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec"},

    {"id": "parse-bad-four-fields", "fn": "cron_parse", "args": ["* * * *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "both sides must fail"},
    {"id": "parse-bad-six-fields", "fn": "cron_parse", "args": ["* * * * * *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "both sides must fail"},
    {"id": "parse-bad-empty", "fn": "cron_parse", "args": [""], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "both sides must fail"},
    {"id": "parse-bad-minute-60", "fn": "cron_parse", "args": ["60 * * * *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "both sides must fail"},
    {"id": "parse-bad-hour-24", "fn": "cron_parse", "args": ["* 24 * * *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "both sides must fail"},
    {"id": "parse-bad-dom-32", "fn": "cron_parse", "args": ["0 0 32 * *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "both sides must fail"},
    {"id": "parse-bad-dom-0", "fn": "cron_parse", "args": ["0 0 0 * *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "both sides must fail"},
    {"id": "parse-bad-month-13", "fn": "cron_parse", "args": ["0 0 * 13 *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "both sides must fail"},
    {"id": "parse-bad-feb-30", "fn": "cron_parse", "args": ["0 0 30 2 *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "validate_days: February never has 30 days"},
    {"id": "parse-bad-apr-31", "fn": "cron_parse", "args": ["0 0 31 4 *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "validate_days: April never has 31 days"},
    {"id": "parse-bad-step-zero", "fn": "cron_parse", "args": ["*/0 * * * *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "both sides must fail"},
    {"id": "parse-bad-negative", "fn": "cron_parse", "args": ["-1 * * * *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "both sides must fail"},
    {"id": "parse-bad-inverted-range", "fn": "cron_parse", "args": ["5-1 * * * *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "both sides must fail"},
    {"id": "parse-bad-range-out-of-range", "fn": "cron_parse", "args": ["1-70 * * * *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "both sides must fail"},
    {"id": "parse-bad-word", "fn": "cron_parse", "args": ["abc * * * *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "both sides must fail"},
    {"id": "parse-bad-long-dow-name", "fn": "cron_parse", "args": ["0 0 * * SATURDAY"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "both sides must fail"},
    {"id": "parse-dow-7", "fn": "cron_parse", "args": ["0 0 * * 7"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "7 as an alias for Sunday: upstream range is 0..6"},
    {"id": "parse-dow-range-to-7", "fn": "cron_parse", "args": ["0 0 * * 1-7"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "weekday range whose end is 7"},
    {"id": "parse-lowercase-dow", "fn": "cron_parse", "args": ["0 0 * * sun"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "upstream only substitutes uppercase names"},
    {"id": "parse-lowercase-month", "fn": "cron_parse", "args": ["0 0 * jan *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "upstream only substitutes uppercase names"},
    {"id": "parse-mixed-case-dow", "fn": "cron_parse", "args": ["0 0 * * Mon"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec"},
    {"id": "parse-step-100", "fn": "cron_parse", "args": ["*/100 * * * *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "upstream restricts a step to 1..99"},
    {"id": "parse-step-larger-than-range", "fn": "cron_parse", "args": ["*/90 * * * *"], "upstreamFn": "Oban.Cron.Expression.parse!/1", "goFn": "oban.ParseCronSpec", "note": "two-digit step beyond the field range"}
  ]
}
