{
  "group": "tokens",
  "upstream": "morgan@1.10.0",
  "note": "One case per token (and per :token[arg] variant). Formats wrap each token in a marker so the compared value is unambiguous.",
  "cases": [
    {
      "id": "tok-method-get",
      "fn": "log",
      "upstreamFn": "morgan.token('method')",
      "goFn": ":method",
      "args": [{
        "format": "M=:method",
        "request": {"method": "GET", "path": "/m", "headers": {"User-Agent": "parity-harness/1.0"}},
        "response": {"status": 200, "body": "ok", "contentLength": "explicit", "headers": {}},
        "options": {}
      }]
    },
    {
      "id": "tok-method-delete",
      "fn": "log",
      "upstreamFn": "morgan.token('method')",
