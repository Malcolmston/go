    {"id": "sort-unknown-key", "fn": "sort_by", "args": {"table": "sales", "keys": ["nope"], "ascending": [true]}, "upstreamFn": "pandas.DataFrame.sort_values", "goFn": "pandas.DataFrame.SortBy", "note": "must fail on both"},

