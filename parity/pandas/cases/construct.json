    {"id": "series-infer-ints", "fn": "series_infer", "args": {"name": "n", "values": [1, 2, 3], "kinds": ["int", "int", "int"]}, "upstreamFn": "pandas.Series", "goFn": "pandas.NewSeries", "note": "dtype inference from untyped values"},
    {"id": "series-infer-floats", "fn": "series_infer", "args": {"name": "n", "values": [1.5, 2.5], "kinds": ["float", "float"]}, "upstreamFn": "pandas.Series", "goFn": "pandas.NewSeries"},
    {"id": "series-infer-mixed-numeric", "fn": "series_infer", "args": {"name": "n", "values": [1, 2.5, 3], "kinds": ["int", "float", "int"]}, "upstreamFn": "pandas.Series", "goFn": "pandas.NewSeries", "note": "port takes dtype from first element and truncates 2.5 to 2; pandas promotes to float64"},
    {"id": "series-infer-mixed-types", "fn": "series_infer", "args": {"name": "m", "values": [1, "x", true], "kinds": ["int", "str", "bool"]}, "upstreamFn": "pandas.Series", "goFn": "pandas.NewSeries", "note": "pandas -> object; port coerces to first element's dtype"},
    {"id": "series-infer-strings", "fn": "series_infer", "args": {"name": "s", "values": ["a", "b"], "kinds": ["str", "str"]}, "upstreamFn": "pandas.Series", "goFn": "pandas.NewSeries"},

    {"id": "frame-sales", "fn": "frame", "args": {"table": "sales"}, "upstreamFn": "pandas.DataFrame", "goFn": "pandas.NewDataFrame"},
    {"id": "frame-nums", "fn": "frame", "args": {"table": "nums"}, "upstreamFn": "pandas.DataFrame", "goFn": "pandas.NewDataFrame"},
    {"id": "frame-gaps", "fn": "frame", "args": {"table": "gaps"}, "upstreamFn": "pandas.DataFrame", "goFn": "pandas.NewDataFrame"},
