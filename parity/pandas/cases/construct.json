    {"id": "frame-names-sales", "fn": "frame_names", "args": {"table": "sales"}, "upstreamFn": "pandas.DataFrame.columns", "goFn": "pandas.DataFrame.Names"},
    {"id": "frame-index-sales", "fn": "frame_index", "args": {"table": "sales"}, "upstreamFn": "pandas.DataFrame.index", "goFn": "pandas.DataFrame.Index"},
    {"id": "frame-dtypes-sales", "fn": "frame_dtypes", "args": {"table": "sales"}, "upstreamFn": "pandas.DataFrame.dtypes", "goFn": "pandas.Series.DType"},
    {"id": "frame-dtypes-nums", "fn": "frame_dtypes", "args": {"table": "nums"}, "upstreamFn": "pandas.DataFrame.dtypes", "goFn": "pandas.Series.DType"},
    {"id": "frame-from-map-order", "fn": "frame_from_map", "args": {"table": "sales", "order": ["price", "region", "units", "active"]}, "upstreamFn": "pandas.DataFrame", "goFn": "pandas.FromMap"},
    {"id": "frame-from-map-partial-order", "fn": "frame_from_map", "args": {"table": "sales", "order": ["units"]}, "upstreamFn": "pandas.DataFrame", "goFn": "pandas.FromMap", "note": "names absent from order are appended sorted"},

