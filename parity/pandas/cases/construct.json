    {"id": "astype-int-to-float", "fn": "series_astype", "args": {"name": "n", "dtype": "int64", "values": [1, 2, null], "to": "float64"}, "upstreamFn": "pandas.Series.astype", "goFn": "pandas.Series.Astype"},
    {"id": "astype-int-to-string", "fn": "series_astype", "args": {"name": "n", "dtype": "int64", "values": [1, 2, null], "to": "string"}, "upstreamFn": "pandas.Series.astype", "goFn": "pandas.Series.Astype"},
    {"id": "astype-string-to-float-bad", "fn": "series_astype", "args": {"name": "s", "dtype": "string", "values": ["1.5", "oops"], "to": "float64"}, "upstreamFn": "pandas.Series.astype", "goFn": "pandas.Series.Astype", "note": "must fail on both: unparseable text -> float"},
    {"id": "astype-bool-to-int", "fn": "series_astype", "args": {"name": "b", "dtype": "bool", "values": [true, false, null], "to": "int64"}, "upstreamFn": "pandas.Series.astype", "goFn": "pandas.Series.Astype"}
  ]
