    {"id": "series-int64", "fn": "series_new", "args": {"name": "n", "dtype": "int64", "values": [1, 2, null, -7]}, "upstreamFn": "pandas.Series", "goFn": "pandas.NewSeriesTyped"},
    {"id": "series-string", "fn": "series_new", "args": {"name": "s", "dtype": "string", "values": ["a", "", null, "Zz"]}, "upstreamFn": "pandas.Series", "goFn": "pandas.NewSeriesTyped"},
    {"id": "series-bool", "fn": "series_new", "args": {"name": "b", "dtype": "bool", "values": [true, false, null, true]}, "upstreamFn": "pandas.Series", "goFn": "pandas.NewSeriesTyped"},
    {"id": "series-empty", "fn": "series_new", "args": {"name": "e", "dtype": "float64", "values": []}, "upstreamFn": "pandas.Series", "goFn": "pandas.NewSeriesTyped"},
