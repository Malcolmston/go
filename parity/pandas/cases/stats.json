{
  "group": "stats",
  "upstream": "pandas==2.3.3",
  "cases": [
    {"id": "describe-nums", "fn": "describe", "args": {"table": "nums"}, "upstreamFn": "pandas.DataFrame.describe", "goFn": "pandas.DataFrame.Describe", "note": "the port emits count/mean/std/min/max in a 'stat' column; pandas adds 25%/50%/75% and uses the index"},
    {"id": "describe-sales", "fn": "describe", "args": {"table": "sales"}, "upstreamFn": "pandas.DataFrame.describe", "goFn": "pandas.DataFrame.Describe"},
    {"id": "describe-strings-only", "fn": "describe", "args": {"table": "words"}, "upstreamFn": "pandas.DataFrame.describe", "goFn": "pandas.DataFrame.Describe", "note": "no numeric columns: pandas falls back to count/unique/top/freq"},

    {"id": "frame-reduction-result-name", "fn": "frame_stat_name", "args": {"table": "nums", "stat": "sum"}, "upstreamFn": "pandas.DataFrame.sum", "goFn": "pandas.DataFrame.Sum", "note": "the name carried by a column-wise reduction result; compared once here so the other frame_stat cases can compare index/dtype/values alone"},
    {"id": "frame-sum", "fn": "frame_stat", "args": {"table": "nums", "stat": "sum"}, "upstreamFn": "pandas.DataFrame.sum", "goFn": "pandas.DataFrame.Sum"},
    {"id": "frame-mean", "fn": "frame_stat", "args": {"table": "nums", "stat": "mean"}, "upstreamFn": "pandas.DataFrame.mean", "goFn": "pandas.DataFrame.Mean"},
    {"id": "frame-min", "fn": "frame_stat", "args": {"table": "nums", "stat": "min"}, "upstreamFn": "pandas.DataFrame.min", "goFn": "pandas.DataFrame.Min"},
    {"id": "frame-max", "fn": "frame_stat", "args": {"table": "nums", "stat": "max"}, "upstreamFn": "pandas.DataFrame.max", "goFn": "pandas.DataFrame.Max"},
    {"id": "frame-std", "fn": "frame_stat", "args": {"table": "nums", "stat": "std"}, "upstreamFn": "pandas.DataFrame.std", "goFn": "pandas.DataFrame.Std"},
    {"id": "frame-var", "fn": "frame_stat", "args": {"table": "nums", "stat": "var"}, "upstreamFn": "pandas.DataFrame.var", "goFn": "pandas.DataFrame.Var"},
    {"id": "frame-median", "fn": "frame_stat", "args": {"table": "nums", "stat": "median"}, "upstreamFn": "pandas.DataFrame.median", "goFn": "pandas.DataFrame.Median"},
    {"id": "frame-nunique", "fn": "frame_stat", "args": {"table": "sales", "stat": "nunique"}, "upstreamFn": "pandas.DataFrame.nunique", "goFn": "pandas.DataFrame.Nunique", "note": "covers every dtype, not just numeric"},
    {"id": "frame-mean-mixed-dtypes", "fn": "frame_stat", "args": {"table": "sales", "stat": "mean"}, "upstreamFn": "pandas.DataFrame.mean", "goFn": "pandas.DataFrame.Mean", "note": "port drops non-numeric columns; pandas raises without numeric_only"},

    {"id": "series-sum", "fn": "series_stat", "args": {"name": "v", "dtype": "float64", "values": [1.5, null, 3.5], "stat": "sum"}, "upstreamFn": "pandas.Series.sum", "goFn": "pandas.Series.Sum"},
    {"id": "series-mean", "fn": "series_stat", "args": {"name": "v", "dtype": "float64", "values": [1.5, null, 3.5], "stat": "mean"}, "upstreamFn": "pandas.Series.mean", "goFn": "pandas.Series.Mean"},
    {"id": "series-min", "fn": "series_stat", "args": {"name": "v", "dtype": "float64", "values": [1.5, null, 3.5], "stat": "min"}, "upstreamFn": "pandas.Series.min", "goFn": "pandas.Series.Min"},
    {"id": "series-max", "fn": "series_stat", "args": {"name": "v", "dtype": "float64", "values": [1.5, null, 3.5], "stat": "max"}, "upstreamFn": "pandas.Series.max", "goFn": "pandas.Series.Max"},
    {"id": "series-count", "fn": "series_stat", "args": {"name": "v", "dtype": "float64", "values": [1.5, null, 3.5], "stat": "count"}, "upstreamFn": "pandas.Series.count", "goFn": "pandas.Series.Count"},
    {"id": "series-std", "fn": "series_stat", "args": {"name": "v", "dtype": "float64", "values": [1.0, 2.0, 4.0], "stat": "std"}, "upstreamFn": "pandas.Series.std", "goFn": "pandas.Series.Std"},
    {"id": "series-var", "fn": "series_stat", "args": {"name": "v", "dtype": "float64", "values": [1.0, 2.0, 4.0], "stat": "var"}, "upstreamFn": "pandas.Series.var", "goFn": "pandas.Series.Var"},
    {"id": "series-median-even", "fn": "series_stat", "args": {"name": "v", "dtype": "float64", "values": [1.0, 2.0, 3.0, 4.0], "stat": "median"}, "upstreamFn": "pandas.Series.median", "goFn": "pandas.Series.Median"},
    {"id": "series-prod", "fn": "series_stat", "args": {"name": "v", "dtype": "float64", "values": [2.0, 3.0, null], "stat": "prod"}, "upstreamFn": "pandas.Series.prod", "goFn": "pandas.Series.Prod"},
    {"id": "series-nunique", "fn": "series_stat", "args": {"name": "v", "dtype": "int64", "values": [1, 1, 2, null], "stat": "nunique"}, "upstreamFn": "pandas.Series.nunique", "goFn": "pandas.DataFrame.Nunique"},
    {"id": "series-std-single", "fn": "series_stat", "args": {"name": "v", "dtype": "float64", "values": [7.0], "stat": "std"}, "upstreamFn": "pandas.Series.std", "goFn": "pandas.Series.Std", "note": "ddof=1 with one observation is NA on both sides"},
    {"id": "series-sum-empty", "fn": "series_stat", "args": {"name": "v", "dtype": "float64", "values": [], "stat": "sum"}, "upstreamFn": "pandas.Series.sum", "goFn": "pandas.Series.Sum", "note": "pandas returns 0.0 for an empty sum; the port reports no value"},
    {"id": "series-mean-empty", "fn": "series_stat", "args": {"name": "v", "dtype": "float64", "values": [], "stat": "mean"}, "upstreamFn": "pandas.Series.mean", "goFn": "pandas.Series.Mean"},
    {"id": "series-mean-of-strings", "fn": "series_stat", "args": {"name": "s", "dtype": "string", "values": ["a", "b"], "stat": "mean"}, "upstreamFn": "pandas.Series.mean", "goFn": "pandas.Series.Mean", "note": "must fail on both: mean of a non-numeric Series"},
    {"id": "series-quantile-25", "fn": "series_stat", "args": {"name": "v", "dtype": "float64", "values": [1.0, 2.0, 3.0, 4.0], "stat": "quantile", "q": 0.25}, "upstreamFn": "pandas.Series.quantile", "goFn": "pandas.Series.Quantile"},
    {"id": "series-quantile-90", "fn": "series_stat", "args": {"name": "v", "dtype": "float64", "values": [1.0, 2.0, 3.0, 4.0, 10.0], "stat": "quantile", "q": 0.9}, "upstreamFn": "pandas.Series.quantile", "goFn": "pandas.Series.Quantile"},

    {"id": "series-cumsum", "fn": "series_op", "args": {"name": "v", "dtype": "float64", "values": [1.0, null, 3.0], "op": "cumsum"}, "upstreamFn": "pandas.Series.cumsum", "goFn": "pandas.Series.CumSum"},
    {"id": "series-cummax", "fn": "series_op", "args": {"name": "v", "dtype": "float64", "values": [1.0, 5.0, 3.0], "op": "cummax"}, "upstreamFn": "pandas.Series.cummax", "goFn": "pandas.Series.CumMax"},
    {"id": "series-diff", "fn": "series_op", "args": {"name": "v", "dtype": "float64", "values": [1.0, 4.0, null, 9.0], "op": "diff"}, "upstreamFn": "pandas.Series.diff", "goFn": "pandas.Series.Diff"},
    {"id": "series-pct-change", "fn": "series_op", "args": {"name": "v", "dtype": "float64", "values": [2.0, 4.0, 4.0], "op": "pct_change"}, "upstreamFn": "pandas.Series.pct_change", "goFn": "pandas.Series.PctChange"},
    {"id": "series-shift-down", "fn": "series_op", "args": {"name": "v", "dtype": "float64", "values": [1.0, 2.0, 3.0], "op": "shift", "arg": 1}, "upstreamFn": "pandas.Series.shift", "goFn": "pandas.Series.Shift"},
    {"id": "series-shift-up", "fn": "series_op", "args": {"name": "v", "dtype": "float64", "values": [1.0, 2.0, 3.0], "op": "shift", "arg": -1}, "upstreamFn": "pandas.Series.shift", "goFn": "pandas.Series.Shift"},
    {"id": "series-rank-average", "fn": "series_op", "args": {"name": "v", "dtype": "float64", "values": [3.0, 1.0, 3.0, null], "op": "rank"}, "upstreamFn": "pandas.Series.rank", "goFn": "pandas.Series.Rank"},
    {"id": "series-rank-min", "fn": "series_op", "args": {"name": "v", "dtype": "float64", "values": [3.0, 1.0, 3.0], "op": "rank", "arg": "min"}, "upstreamFn": "pandas.Series.rank", "goFn": "pandas.Series.RankBy"},
    {"id": "series-rank-dense", "fn": "series_op", "args": {"name": "v", "dtype": "float64", "values": [3.0, 1.0, 3.0], "op": "rank", "arg": "dense"}, "upstreamFn": "pandas.Series.rank", "goFn": "pandas.Series.RankBy"},
    {"id": "series-round-half-even", "fn": "series_op", "args": {"name": "v", "dtype": "float64", "values": [0.5, 1.5, 2.5, -0.5], "op": "round", "arg": 0}, "upstreamFn": "pandas.Series.round", "goFn": "pandas.Series.Round"},
    {"id": "series-abs", "fn": "series_op", "args": {"name": "v", "dtype": "float64", "values": [-1.5, 2.0, null], "op": "abs"}, "upstreamFn": "pandas.Series.abs", "goFn": "pandas.Series.Abs"},
    {"id": "series-clip", "fn": "series_op", "args": {"name": "v", "dtype": "float64", "values": [-5.0, 0.5, 9.0], "op": "clip", "arg": [0.0, 1.0]}, "upstreamFn": "pandas.Series.clip", "goFn": "pandas.Series.Clip"},
    {"id": "series-sort-asc", "fn": "series_op", "args": {"name": "v", "dtype": "float64", "values": [3.0, null, 1.0, 2.0], "op": "sort", "arg": true}, "upstreamFn": "pandas.Series.sort_values", "goFn": "pandas.Series.Sort"},
    {"id": "series-sort-desc", "fn": "series_op", "args": {"name": "v", "dtype": "float64", "values": [3.0, null, 1.0, 2.0], "op": "sort", "arg": false}, "upstreamFn": "pandas.Series.sort_values", "goFn": "pandas.Series.Sort"},
    {"id": "series-unique", "fn": "series_op", "args": {"name": "s", "dtype": "string", "values": ["b", "a", "b", null], "op": "unique"}, "upstreamFn": "pandas.Series.unique", "goFn": "pandas.Series.Unique"},
    {"id": "series-value-counts", "fn": "series_op", "args": {"name": "s", "dtype": "string", "values": ["b", "a", "b", null, "c"], "op": "value_counts"}, "upstreamFn": "pandas.Series.value_counts", "goFn": "pandas.Series.ValueCounts"},
    {"id": "series-mode", "fn": "series_op", "args": {"name": "n", "dtype": "int64", "values": [1, 2, 2, 3, 3], "op": "mode"}, "upstreamFn": "pandas.Series.mode", "goFn": "pandas.Series.Mode"},
    {"id": "series-nlargest", "fn": "series_op", "args": {"name": "v", "dtype": "float64", "values": [1.0, 9.0, 5.0, null], "op": "nlargest", "arg": 2}, "upstreamFn": "pandas.Series.nlargest", "goFn": "pandas.Series.NLargest"},
    {"id": "series-nsmallest", "fn": "series_op", "args": {"name": "v", "dtype": "float64", "values": [1.0, 9.0, 5.0, null], "op": "nsmallest", "arg": 2}, "upstreamFn": "pandas.Series.nsmallest", "goFn": "pandas.Series.NSmallest"},
    {"id": "series-isin", "fn": "series_mask_values", "args": {"name": "n", "dtype": "int64", "values": [1, 2, 3, null], "op": "isin", "arg": [1, 3]}, "upstreamFn": "pandas.Series.isin", "goFn": "pandas.Series.IsIn"},
    {"id": "series-between", "fn": "series_mask_values", "args": {"name": "v", "dtype": "float64", "values": [0.0, 1.0, 2.0, null], "op": "between", "arg": [0.5, 2.0]}, "upstreamFn": "pandas.Series.between", "goFn": "pandas.Series.Between"},

    {"id": "series-add", "fn": "series_arith", "args": {"dtype": "float64", "left": [1.0, 2.0, null], "right": [10.0, null, 30.0], "op": "add"}, "upstreamFn": "pandas.Series.add", "goFn": "pandas.Series.Add"},
    {"id": "series-sub", "fn": "series_arith", "args": {"dtype": "float64", "left": [1.0, 2.0], "right": [10.0, 20.0], "op": "sub"}, "upstreamFn": "pandas.Series.sub", "goFn": "pandas.Series.Sub"},
    {"id": "series-mul", "fn": "series_arith", "args": {"dtype": "float64", "left": [1.5, 2.0], "right": [4.0, 0.5], "op": "mul"}, "upstreamFn": "pandas.Series.mul", "goFn": "pandas.Series.Mul"},
    {"id": "series-div", "fn": "series_arith", "args": {"dtype": "float64", "left": [1.0, 2.0], "right": [4.0, 0.5], "op": "div"}, "upstreamFn": "pandas.Series.div", "goFn": "pandas.Series.Div"},
    {"id": "series-div-by-zero", "fn": "series_arith", "args": {"dtype": "float64", "left": [1.0, -1.0], "right": [0.0, 0.0], "op": "div"}, "upstreamFn": "pandas.Series.div", "goFn": "pandas.Series.Div", "note": "pandas yields +/-inf; the port yields NA"},
