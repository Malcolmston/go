    {"id": "str-lower", "fn": "str_op", "args": {"name": "s", "dtype": "string", "values": ["AB", null, "Cd"], "op": "lower"}, "upstreamFn": "pandas.Series.str.lower", "goFn": "pandas.StrAccessor.Lower"},
    {"id": "str-title", "fn": "str_op", "args": {"name": "s", "dtype": "string", "values": ["hello world", "aBC dEF"], "op": "title"}, "upstreamFn": "pandas.Series.str.title", "goFn": "pandas.StrAccessor.Title"},
    {"id": "str-strip", "fn": "str_op", "args": {"name": "s", "dtype": "string", "values": ["  x  ", "\ty\n"], "op": "strip"}, "upstreamFn": "pandas.Series.str.strip", "goFn": "pandas.StrAccessor.Strip"},
    {"id": "str-len", "fn": "str_op", "args": {"name": "s", "dtype": "string", "values": ["abc", null, "éè"], "op": "len"}, "upstreamFn": "pandas.Series.str.len", "goFn": "pandas.StrAccessor.Len"},
    {"id": "str-replace", "fn": "str_op", "args": {"name": "s", "dtype": "string", "values": ["a-b-c", null], "op": "replace", "arg": ["-", "+"]}, "upstreamFn": "pandas.Series.str.replace", "goFn": "pandas.StrAccessor.Replace"},
    {"id": "str-contains", "fn": "str_op", "args": {"name": "s", "dtype": "string", "values": ["abc", null, "xyz"], "op": "contains", "arg": "b"}, "upstreamFn": "pandas.Series.str.contains", "goFn": "pandas.StrAccessor.Contains", "note": "pandas yields NA for missing input; the port yields false"},
    {"id": "str-startswith", "fn": "str_op", "args": {"name": "s", "dtype": "string", "values": ["abc", null], "op": "startswith", "arg": "a"}, "upstreamFn": "pandas.Series.str.startswith", "goFn": "pandas.StrAccessor.StartsWith"},
    {"id": "str-endswith", "fn": "str_op", "args": {"name": "s", "dtype": "string", "values": ["abc", null], "op": "endswith", "arg": "c"}, "upstreamFn": "pandas.Series.str.endswith", "goFn": "pandas.StrAccessor.EndsWith"}
  ]
}
