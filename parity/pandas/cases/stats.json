    {"id": "corr-matrix", "fn": "frame_corr", "args": {"table": "nums"}, "upstreamFn": "pandas.DataFrame.corr", "goFn": "pandas.DataFrame.Corr"},
    {"id": "series-corr", "fn": "series_pair_stat", "args": {"dtype": "float64", "left": [1.0, 2.0, 3.0, 4.0], "right": [2.0, 4.1, 5.9, 8.2], "op": "corr"}, "upstreamFn": "pandas.Series.corr", "goFn": "pandas.Series.Corr"},
    {"id": "series-cov", "fn": "series_pair_stat", "args": {"dtype": "float64", "left": [1.0, 2.0, 3.0, 4.0], "right": [2.0, 4.1, 5.9, 8.2], "op": "cov"}, "upstreamFn": "pandas.Series.cov", "goFn": "pandas.Series.Cov"},
    {"id": "frame-abs", "fn": "frame_op", "args": {"table": "nums", "op": "abs"}, "upstreamFn": "pandas.DataFrame.abs", "goFn": "pandas.DataFrame.Abs"},
    {"id": "frame-round", "fn": "frame_op", "args": {"table": "nums", "op": "round", "arg": 1}, "upstreamFn": "pandas.DataFrame.round", "goFn": "pandas.DataFrame.Round"},
    {"id": "frame-transpose", "fn": "frame_op", "args": {"table": "whole", "op": "transpose"}, "upstreamFn": "pandas.DataFrame.transpose", "goFn": "pandas.DataFrame.Transpose"},

